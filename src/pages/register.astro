---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Crear Cuenta — Natura Manager">
  <div class="min-h-screen bg-surface flex relative overflow-hidden">
    
    <!-- Left Panel: Premium Branding -->
    <div class="hidden lg:flex flex-1 relative items-center justify-center p-16 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-secondary/6 via-primary/4 to-secondary-container/10"></div>
      <div class="absolute top-[-5%] left-[-10%] w-[30rem] h-[30rem] bg-secondary-container/15 rounded-full blur-3xl animate-pulse" style="animation-duration: 10s;"></div>
      <div class="absolute bottom-[-10%] right-[-5%] w-[25rem] h-[25rem] bg-primary-container/12 rounded-full blur-3xl animate-pulse" style="animation-duration: 8s;"></div>
      <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(circle, var(--color-secondary) 1px, transparent 1px); background-size: 32px 32px;"></div>

      <div class="relative z-10 text-center max-w-lg">
        <div class="w-20 h-20 mx-auto mb-8 rounded-3xl overflow-hidden shadow-2xl shadow-secondary/15 ring-4 ring-white/50">
          <img src="/logo.png" alt="Natura Manager" class="w-full h-full object-cover" />
        </div>
        
        <h1 class="text-5xl font-display font-extrabold text-on-surface mb-4 tracking-tight">
          Comienza <span class="text-secondary">hoy</span>
        </h1>
        <p class="text-lg text-on-surface-variant font-body leading-relaxed max-w-sm mx-auto">
          Únete a cientos de consultoras que ya gestionan su negocio de forma inteligente.
        </p>

        <!-- Benefits -->
        <div class="mt-10 space-y-4 text-left max-w-xs mx-auto">
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-secondary/10 flex items-center justify-center shrink-0 mt-0.5">
              <span class="material-symbols-outlined text-secondary text-base">rocket_launch</span>
            </div>
            <div>
              <p class="text-sm font-bold text-on-surface">15 días gratis</p>
              <p class="text-xs text-on-surface-variant">Acceso completo sin tarjeta de crédito</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center shrink-0 mt-0.5">
              <span class="material-symbols-outlined text-primary text-base">smartphone</span>
            </div>
            <div>
              <p class="text-sm font-bold text-on-surface">Desde cualquier dispositivo</p>
              <p class="text-xs text-on-surface-variant">Celular, tablet o computadora</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-secondary/10 flex items-center justify-center shrink-0 mt-0.5">
              <span class="material-symbols-outlined text-secondary text-base">lock</span>
            </div>
            <div>
              <p class="text-sm font-bold text-on-surface">100% seguro</p>
              <p class="text-xs text-on-surface-variant">Tus datos siempre protegidos</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Panel: Register Form -->
    <div class="w-full lg:w-[480px] xl:w-[520px] flex items-center justify-center p-6 sm:p-8 lg:p-12 z-20 relative">
      <div class="lg:hidden absolute top-8 left-1/2 -translate-x-1/2 flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl overflow-hidden shadow-lg">
          <img src="/logo.png" alt="Natura Manager" class="w-full h-full object-cover" />
        </div>
        <span class="text-lg font-display font-bold text-on-surface">Natura <span class="text-primary">Manager</span></span>
      </div>

      <div class="w-full max-w-sm">
        <div class="mb-8 mt-16 lg:mt-0">
          <div class="w-12 h-12 rounded-2xl bg-secondary/10 flex items-center justify-center mb-5">
            <span class="material-symbols-outlined text-secondary text-xl">person_add</span>
          </div>
          <h2 class="text-3xl font-display font-bold text-on-surface">Crea tu cuenta</h2>
          <p class="text-on-surface-variant mt-2 text-sm">Empieza tu prueba gratuita de 15 días</p>
        </div>

        <form id="register-form" class="space-y-4">
          <div id="error-message" class="hidden rounded-xl bg-error/8 border border-error/15 p-3.5 flex items-start gap-2.5">
            <span class="material-symbols-outlined text-error text-base mt-0.5 shrink-0">error</span>
            <p class="text-sm text-error font-medium" id="error-text"></p>
          </div>

          <div id="success-message" class="hidden rounded-xl bg-secondary/8 border border-secondary/15 p-3.5 flex items-start gap-2.5">
            <span class="material-symbols-outlined text-secondary text-base mt-0.5 shrink-0">check_circle</span>
            <p class="text-sm text-secondary font-medium" id="success-text"></p>
          </div>

          <div class="space-y-1.5">
            <label for="full-name" class="block text-xs font-bold text-on-surface-variant uppercase tracking-wider">Nombre completo</label>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-on-surface-variant/40 text-lg">person</span>
              <input type="text" id="full-name" name="full_name" class="w-full input-editorial pl-11" placeholder="María López" required autocomplete="name" />
            </div>
          </div>

          <div class="space-y-1.5">
            <label for="email" class="block text-xs font-bold text-on-surface-variant uppercase tracking-wider">Correo electrónico</label>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-on-surface-variant/40 text-lg">mail</span>
              <input type="email" id="email" name="email" class="w-full input-editorial pl-11" placeholder="tu@correo.com" required autocomplete="email" />
            </div>
          </div>

          <div class="space-y-1.5">
            <label for="password" class="block text-xs font-bold text-on-surface-variant uppercase tracking-wider">Contraseña</label>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-on-surface-variant/40 text-lg">lock</span>
              <input type="password" id="password" name="password" class="w-full input-editorial pl-11 pr-11" placeholder="Mínimo 6 caracteres" required minlength="6" autocomplete="new-password" />
              <button type="button" id="toggle-pw" class="absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant/40 hover:text-on-surface-variant transition-colors">
                <span class="material-symbols-outlined text-lg">visibility</span>
              </button>
            </div>
            <div class="flex gap-1 mt-2">
              <div id="str-1" class="h-1 flex-1 rounded-full bg-outline-variant/20 transition-colors"></div>
              <div id="str-2" class="h-1 flex-1 rounded-full bg-outline-variant/20 transition-colors"></div>
              <div id="str-3" class="h-1 flex-1 rounded-full bg-outline-variant/20 transition-colors"></div>
              <div id="str-4" class="h-1 flex-1 rounded-full bg-outline-variant/20 transition-colors"></div>
            </div>
            <p id="str-label" class="text-[10px] text-on-surface-variant/60 mt-0.5"></p>
          </div>

          <div class="flex items-start gap-2 pt-1">
            <input type="checkbox" id="terms" required class="mt-1 accent-primary" />
            <label for="terms" class="text-xs text-on-surface-variant">
              Acepto los <a href="#" class="text-primary font-bold hover:underline">Términos de Servicio</a> y la 
              <a href="#" class="text-primary font-bold hover:underline">Política de Privacidad</a>
            </label>
          </div>

          <button type="submit" class="w-full btn-primary flex items-center justify-center gap-2 !py-3.5 text-sm mt-2" id="submit-btn">
            <span class="material-symbols-outlined text-base">rocket_launch</span>
            Crear Cuenta Gratis
          </button>
        </form>

        <div class="relative my-6">
          <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-outline-variant/20"></div></div>
          <div class="relative flex justify-center"><span class="bg-surface px-4 text-xs text-on-surface-variant/60">o regístrate con</span></div>
        </div>

        <button id="btn-google" class="w-full flex items-center justify-center gap-3 py-3 rounded-full border-2 border-outline-variant/15 bg-surface-container-lowest hover:bg-surface-container-low transition-all font-bold text-sm text-on-surface shadow-sm hover:shadow-md">
          <svg class="w-5 h-5" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
          Google
        </button>

        <p class="mt-8 text-center text-sm text-on-surface-variant">
          ¿Ya tienes cuenta? 
          <a href="/login" class="font-bold text-primary hover:text-primary-container transition-colors">Inicia sesión</a>
        </p>
      </div>
    </div>

  </div>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  const form = document.getElementById('register-form') as HTMLFormElement;
  const errorDiv = document.getElementById('error-message') as HTMLDivElement;
  const errorText = document.getElementById('error-text') as HTMLParagraphElement;
  const successDiv = document.getElementById('success-message') as HTMLDivElement;
  const successText = document.getElementById('success-text') as HTMLParagraphElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const pwInput = document.getElementById('password') as HTMLInputElement;

  // Toggle password
  document.getElementById('toggle-pw')?.addEventListener('click', () => {
    const icon = document.querySelector('#toggle-pw .material-symbols-outlined') as HTMLElement;
    if (pwInput.type === 'password') { pwInput.type = 'text'; icon.textContent = 'visibility_off'; }
    else { pwInput.type = 'password'; icon.textContent = 'visibility'; }
  });

  // Password strength
  const bars = [document.getElementById('str-1')!, document.getElementById('str-2')!, document.getElementById('str-3')!, document.getElementById('str-4')!];
  const strLabel = document.getElementById('str-label')!;
  const strengthColors = ['bg-red-400', 'bg-orange-400', 'bg-amber-400', 'bg-green-500'];
  const strengthLabels = ['Muy débil', 'Débil', 'Buena', 'Excelente'];

  pwInput?.addEventListener('input', () => {
    const pw = pwInput.value;
    let score = 0;
    if (pw.length >= 6) score++;
    if (pw.length >= 8 && /[A-Z]/.test(pw)) score++;
    if (/[0-9]/.test(pw)) score++;
    if (/[^a-zA-Z0-9]/.test(pw)) score++;

    bars.forEach((bar, i) => {
      bar.className = 'h-1 flex-1 rounded-full transition-colors ' + (i < score ? strengthColors[Math.min(score - 1, 3)] : 'bg-outline-variant/20');
    });
    strLabel.textContent = pw.length > 0 ? strengthLabels[Math.min(score - 1, 3)] || '' : '';
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorDiv.classList.add('hidden');
    successDiv.classList.add('hidden');
    submitBtn.innerHTML = '<span class="material-symbols-outlined text-base animate-spin">progress_activity</span> Creando cuenta...';
    submitBtn.disabled = true;

    const fd = new FormData(form);
    const fullName = fd.get('full_name') as string;
    const email = fd.get('email') as string;
    const password = fd.get('password') as string;

    const { error } = await supabase.auth.signUp({
      email,
      password,
      options: {
        data: { full_name: fullName },
        emailRedirectTo: window.location.origin + '/login?verified=true',
      }
    });

    if (error) {
      const messages: Record<string, string> = {
        'User already registered': 'Este correo ya tiene una cuenta. Intenta iniciar sesión.',
        'Password should be at least 6 characters': 'La contraseña debe tener al menos 6 caracteres.',
      };
      errorText.textContent = messages[error.message] || error.message;
      errorDiv.classList.remove('hidden');
      submitBtn.innerHTML = '<span class="material-symbols-outlined text-base">rocket_launch</span> Crear Cuenta Gratis';
      submitBtn.disabled = false;
    } else {
      successText.textContent = '¡Cuenta creada! Revisa tu correo electrónico para confirmar tu cuenta. 📬';
      successDiv.classList.remove('hidden');
      form.classList.add('hidden');
    }
  });

  // Google Sign Up
  document.getElementById('btn-google')?.addEventListener('click', async () => {
    const { error } = await supabase.auth.signInWithOAuth({
      provider: 'google',
      options: { redirectTo: window.location.origin + '/' }
    });
    if (error) { errorText.textContent = error.message; errorDiv.classList.remove('hidden'); }
  });
</script>
