---
import DashboardLayout from '../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Logros">
  <header class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-10">
    <div>
      <p class="text-primary font-bold tracking-widest uppercase text-sm mb-1">ANALÍTICAS</p>
      <h2 class="text-3xl md:text-5xl font-display font-bold text-on-surface">Hitos y Desempeño 📊</h2>
      <p class="text-on-surface-variant mt-2 text-lg">Monitorea el crecimiento real de tu negocio Natura.</p>
    </div>
    <div class="flex items-center gap-3">
      <div class="bg-gradient-to-r from-primary/10 to-secondary/10 rounded-xl py-2.5 px-5 flex items-center gap-2">
        <span class="material-symbols-outlined text-primary text-lg">military_tech</span>
        <span id="my-level" class="font-bold text-on-surface text-sm">Bronce</span>
      </div>
    </div>
  </header>

  <!-- Stats Bar -->
  <section class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
    <div class="bg-gradient-to-br from-secondary/5 to-secondary-container/15 rounded-2xl p-5 text-center shadow-sm border border-secondary/5">
      <div class="w-10 h-10 mx-auto mb-2 bg-secondary/10 rounded-xl flex items-center justify-center">
        <span class="material-symbols-outlined text-secondary text-lg">emoji_events</span>
      </div>
      <p id="badge-unlocked" class="text-3xl font-display font-bold text-secondary">—</p>
      <p class="text-xs text-on-surface-variant mt-1 font-bold uppercase tracking-wider">Desbloqueados</p>
    </div>
    <div class="bg-surface-container-lowest rounded-2xl p-5 text-center shadow-sm">
      <div class="w-10 h-10 mx-auto mb-2 bg-surface-container rounded-xl flex items-center justify-center">
        <span class="material-symbols-outlined text-on-surface-variant text-lg">grid_view</span>
      </div>
      <p id="badge-total" class="text-3xl font-display font-bold text-on-surface">18</p>
      <p class="text-xs text-on-surface-variant mt-1 font-bold uppercase tracking-wider">Total Badges</p>
    </div>
    <div class="bg-gradient-to-br from-primary/5 to-primary-container/15 rounded-2xl p-5 text-center shadow-sm border border-primary/5">
      <div class="w-10 h-10 mx-auto mb-2 bg-primary/10 rounded-xl flex items-center justify-center">
        <span class="material-symbols-outlined text-primary text-lg">payments</span>
      </div>
      <p id="stat-revenue" class="text-3xl font-display font-bold text-primary">—</p>
      <p class="text-xs text-on-surface-variant mt-1 font-bold uppercase tracking-wider">Ventas Históricas</p>
    </div>
    <div class="bg-gradient-to-br from-tertiary/5 to-tertiary-container/15 rounded-2xl p-5 text-center shadow-sm border border-tertiary/5">
      <div class="w-10 h-10 mx-auto mb-2 bg-tertiary/10 rounded-xl flex items-center justify-center">
        <span class="material-symbols-outlined text-tertiary text-lg">group</span>
      </div>
      <p id="stat-clients" class="text-3xl font-display font-bold text-tertiary">—</p>
      <p class="text-xs text-on-surface-variant mt-1 font-bold uppercase tracking-wider">Clientes Activos</p>
    </div>
  </section>

  <!-- Natura Growth Progress & Benefits -->
  <section class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
    
    <!-- Real Progress -->
    <div class="lg:col-span-1 bg-surface-container-lowest rounded-[2rem] p-6 shadow-sm flex flex-col justify-between border-2 border-primary/5">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <span class="material-symbols-outlined text-primary text-2xl">stars</span>
          <div>
            <p class="font-bold text-on-surface text-sm uppercase tracking-widest">Camino de Crecimiento</p>
            <p id="level-desc" class="text-xs text-on-surface-variant font-medium">Conectando...</p>
          </div>
        </div>
        <div class="mt-6">
          <div class="flex justify-between items-end mb-2">
            <span id="level-current" class="text-3xl font-display font-bold text-primary">0</span>
            <span class="text-xs font-bold text-on-surface-variant uppercase">Puntos</span>
          </div>
          <div class="w-full h-3 bg-surface-container-highest rounded-full overflow-hidden">
            <div id="level-bar" class="h-full rounded-full transition-all duration-1000 ease-out" style="width:0%; background: linear-gradient(90deg, var(--color-primary) 0%, var(--color-secondary) 100%);"></div>
          </div>
          <div class="flex justify-between mt-2">
            <span id="level-gap" class="text-[11px] font-bold text-on-surface-variant">Faltan 0 pts</span>
            <span id="level-next" class="text-[11px] font-bold text-on-surface-variant">Meta: 0</span>
          </div>
        </div>
      </div>
      <div id="natura-cycle-info" class="mt-6 pt-4 border-t border-outline-variant/20 flex items-center gap-2 text-xs text-on-surface-variant hidden">
        <span class="material-symbols-outlined text-[16px] text-error">calendar_clock</span>
        <span>Cierre de ciclo en <strong id="natura-days-left" class="text-error"></strong> días</span>
      </div>
    </div>

    <!-- Official Benefits -->
    <div class="lg:col-span-2 bg-surface-container-lowest rounded-[2rem] p-6 shadow-sm border border-outline-variant/10">
      <h3 class="text-lg font-display font-bold text-on-surface mb-4 flex items-center gap-2">
        <span class="material-symbols-outlined text-secondary">workspace_premium</span>
        Tus Beneficios Comerciales
      </h3>
      <div id="benefits-grid" class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <!-- Hydrated by JS -->
      </div>
      <div id="benefits-empty" class="hidden py-8 text-center text-on-surface-variant">
         <span class="material-symbols-outlined text-3xl mb-2 opacity-50">link_off</span>
         <p class="text-sm">Sincroniza tu cuenta Natura en el Inicio para ver tus beneficios oficiales.</p>
      </div>
    </div>
  </section>

  <!-- Milestones Grid -->
  <section class="bg-surface-container-lowest rounded-[2rem] p-8 shadow-sm mb-8">
    <div class="flex items-center justify-between mb-6">
      <h3 class="text-xl font-display font-bold text-on-surface flex items-center gap-2">
         <span class="material-symbols-outlined text-secondary">emoji_events</span>
         Hitos Históricos
      </h3>
      <div class="flex gap-2">
        <button id="filter-all" class="text-xs font-bold px-3 py-1.5 rounded-full bg-primary text-white">Todos</button>
        <button id="filter-unlocked" class="text-xs font-bold px-3 py-1.5 rounded-full text-on-surface-variant hover:bg-surface-container transition-colors">Logrados</button>
        <button id="filter-locked" class="text-xs font-bold px-3 py-1.5 rounded-full text-on-surface-variant hover:bg-surface-container transition-colors">Pendientes</button>
      </div>
    </div>
    <div id="badges-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
    </div>
  </section>


</DashboardLayout>

<style>
  .badge-card { transition: all 0.3s cubic-bezier(0.4,0,0.2,1); position: relative; overflow: hidden; }
  .badge-card.unlocked:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(139,90,43,0.1); }
  .badge-card.locked { filter: none; }
  .badge-card.locked .badge-icon { filter: grayscale(100%); opacity: 0.4; }
  .badge-card.locked .lock-overlay {
    position: absolute; inset: 0; background: rgba(255,255,255,0.6);
    backdrop-filter: blur(2px); display: flex; align-items: center; justify-content: center;
    border-radius: inherit; opacity: 0; transition: opacity 0.2s;
  }
  .badge-card.locked:hover .lock-overlay { opacity: 1; }
  .badge-card .badge-glow {
    position: absolute; top: -20px; right: -20px; width: 60px; height: 60px;
    background: radial-gradient(circle, var(--color-secondary-container) 0%, transparent 70%);
    border-radius: 50%; opacity: 0; transition: opacity 0.3s;
  }
  .badge-card.unlocked:hover .badge-glow { opacity: 0.5; }
  .badge-progress { transition: width 0.6s cubic-bezier(0.4,0,0.2,1); }
  @keyframes shimmer { 0% { transform: translateX(-100%); } 100% { transform: translateX(100%); } }
  .animate-shimmer { animation: shimmer 2s infinite; }
</style>

<script>
  import { esc } from '../lib/security';
  import { supabase } from '../lib/supabase';
  import api from '../lib/api';
  import { loadAchievementStats, buildBadges } from '../lib/achievements';
  import { CAMINO_CRECIMIENTO } from '../lib/camino-crecimiento';
  import { toast } from '../lib/ui';

  const { data: { session } } = await supabase.auth.getSession();
  if (!session) { window.location.href = '/login'; throw new Error(''); }

  let stats = { orders: 0, revenue: 0, customers: 0, products: 0, weekOrders: 0, monthOrders: 0, posts: 0 };
  let growthData: any = null;
  try {
    const [s, profile] = await Promise.all([loadAchievementStats(), api.consultant.getProfile()]);
    stats = s;
    growthData = (profile as any)?.latest_growth_data || null;
  } catch(e) {
    console.warn('Error loading achievement data', e);
    toast.error('No se pudieron cargar tus logros. Intenta de nuevo.');
  }

  const totalCustomers = stats.customers;
  const totalRevenue = stats.revenue;
  // Same fields the render code below expects
  const badges = buildBadges(stats).map(b => ({ ...b, check: b.unlocked, tier: b.group }));

  const unlocked = badges.filter(b => b.check).length;

  // Levels mapping for UI
  if (growthData && growthData.level) {
    const levelDesc = growthData.level.description || 'Consultor';
    const currentPts = growthData.nextLevelProgress?.currentValue || 0;
    const nextPts = growthData.nextLevelProgress?.nextValueMin || 0;
    const gapPts = growthData.nextLevelProgress?.gap || 0;
    const pctLevel = Math.min(100, growthData.nextLevelProgress?.progressPercentage || 0);
    const nextLvlName = growthData.nextLevel || 'Siguiente';
    
    (document.getElementById('my-level') as HTMLElement).textContent = levelDesc;
    (document.getElementById('level-desc') as HTMLElement).textContent = `${esc(levelDesc)} → ${esc(nextLvlName)}`;
    (document.getElementById('level-current') as HTMLElement).textContent = currentPts.toLocaleString();
    (document.getElementById('level-next') as HTMLElement).textContent = `Meta: ${nextPts.toLocaleString()}`;
    (document.getElementById('level-gap') as HTMLElement).textContent = `Faltan ${gapPts.toLocaleString()} pts`;
    
    requestAnimationFrame(() => {
      (document.getElementById('level-bar') as HTMLElement).style.width = pctLevel + '%';
    });
    
    if (growthData.period?.daysFinalDate) {
       document.getElementById('natura-cycle-info')!.classList.remove('hidden');
       document.getElementById('natura-days-left')!.textContent = growthData.period.daysFinalDate;
    }
    
    // Render Benefits
    const benefitsGrid = document.getElementById('benefits-grid')!;
    const profit = CAMINO_CRECIMIENTO[levelDesc as keyof typeof CAMINO_CRECIMIENTO]?.profitPercentage || 25;
    
    // Calcula ganancia digital (-5% de penalización usualmente respecto a la presencial, basado en portal)
    const digitalProfit = profit > 30 ? profit - 5 : profit; 
    
    let benefitsHtml = `
      <div class="bg-primary/5 rounded-xl p-4 text-center border border-primary/10">
        <span class="material-symbols-outlined text-primary text-2xl mb-1">sell</span>
        <p class="text-2xl font-bold text-primary leading-none">${profit}%</p>
        <p class="text-[10px] font-bold uppercase tracking-wider text-on-surface-variant mt-1">Venta Directa</p>
      </div>
      <div class="bg-secondary/5 rounded-xl p-4 text-center border border-secondary/10">
        <span class="material-symbols-outlined text-secondary text-2xl mb-1">language</span>
        <p class="text-2xl font-bold text-secondary leading-none">${digitalProfit}%</p>
        <p class="text-[10px] font-bold uppercase tracking-wider text-on-surface-variant mt-1">Natura Digital</p>
      </div>
      <div class="bg-tertiary/5 rounded-xl p-4 text-center border border-tertiary/10">
        <span class="material-symbols-outlined text-tertiary text-2xl mb-1">home_repair_service</span>
        <p class="text-2xl font-bold text-tertiary leading-none">15-18%</p>
        <p class="text-[10px] font-bold uppercase tracking-wider text-on-surface-variant mt-1">Casa & Estilo</p>
      </div>
    `;
    
    if (levelDesc === 'Zafiro' || levelDesc === 'Diamante') {
      benefitsHtml += `
        <div class="bg-amber-50 rounded-xl p-4 text-center border border-amber-200/50">
          <span class="material-symbols-outlined text-amber-600 text-2xl mb-1">credit_card</span>
          <p class="text-lg font-bold text-amber-700 leading-tight">2 Cuotas</p>
          <p class="text-[10px] font-bold uppercase tracking-wider text-amber-800/70 mt-1">30 días crédito</p>
        </div>
      `;
    } else {
      benefitsHtml += `
        <div class="bg-surface-container rounded-xl p-4 text-center border border-outline-variant/10 opacity-50">
          <span class="material-symbols-outlined text-on-surface-variant text-2xl mb-1">lock</span>
          <p class="text-sm font-bold text-on-surface-variant leading-tight">Crédito<br/>Plazos</p>
          <p class="text-[10px] font-bold uppercase tracking-wider text-on-surface-variant/70 mt-1">Zafiro+</p>
        </div>
      `;
    }
    benefitsGrid.innerHTML = benefitsHtml;

  } else {
    document.getElementById('benefits-empty')!.classList.remove('hidden');
    document.getElementById('level-desc')!.textContent = 'Sincroniza en inicio';
    (document.getElementById('my-level') as HTMLElement).textContent = 'Consultor';
  }

  // Update stats
  (document.getElementById('badge-unlocked') as HTMLElement).textContent = String(unlocked);
  (document.getElementById('stat-revenue') as HTMLElement).textContent = '$' + totalRevenue.toLocaleString('es-MX', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
  (document.getElementById('stat-clients') as HTMLElement).textContent = String(totalCustomers);

  // Render badges
  let badgeFilter: 'all' | 'unlocked' | 'locked' = 'all';

  function renderBadges() {
    const grid = document.getElementById('badges-grid') as HTMLElement;
    grid.innerHTML = '';
    const filtered = badgeFilter === 'all' ? badges : badgeFilter === 'unlocked' ? badges.filter(b => b.check) : badges.filter(b => !b.check);

    if (!filtered.length) {
      grid.innerHTML = `<div class="col-span-full text-center py-8"><p class="text-on-surface-variant text-sm">${badgeFilter === 'unlocked' ? 'Aún no has desbloqueado hitos. ¡Empieza vendiendo!' : 'Ya desbloqueaste todos los hitos. 🏆'}</p></div>`;
      return;
    }

    filtered.forEach(b => {
      const pct = b.target > 0 ? Math.min(100, (b.current / b.target) * 100) : 0;
      const el = document.createElement('div');
      el.className = `badge-card rounded-2xl p-5 text-center ${b.check ? 'unlocked bg-gradient-to-br from-secondary-container/20 to-primary-container/10 border-2 border-secondary/15 cursor-default' : 'locked bg-surface-container-low border border-outline-variant/10 cursor-help'}`;
      el.innerHTML = `
        <div class="badge-glow"></div>
        <p class="badge-icon text-4xl mb-3 relative z-[1]">${b.icon}</p>
        <p class="font-bold text-on-surface text-sm relative z-[1]">${esc(b.name)}</p>
        <p class="text-xs text-on-surface-variant mt-1 relative z-[1]">${b.desc}</p>
        ${b.check
          ? '<span class="inline-flex items-center gap-1 mt-3 text-xs font-bold text-secondary bg-secondary/10 px-3 py-1 rounded-full"><span class="material-symbols-outlined text-xs">check_circle</span> Desbloqueado</span>'
          : `<div class="mt-3 relative z-[1]">
              <div class="w-full h-1.5 bg-surface-container-highest rounded-full overflow-hidden">
                <div class="badge-progress h-full bg-primary/40 rounded-full" style="width:0%;"></div>
              </div>
              <p class="text-[10px] text-on-surface-variant/60 mt-1 font-bold">${b.current}/${b.target}</p>
            </div>`
        }
        ${!b.check ? '<div class="lock-overlay"><span class="material-symbols-outlined text-on-surface-variant/40 text-2xl">lock</span></div>' : ''}`;
      grid.appendChild(el);

      // Animate progress bar
      if (!b.check) {
        requestAnimationFrame(() => {
          const bar = el.querySelector('.badge-progress') as HTMLElement;
          if (bar) bar.style.width = pct + '%';
        });
      }
    });
  }

  renderBadges();

  // Filter buttons
  function setFilter(f: 'all' | 'unlocked' | 'locked') {
    badgeFilter = f;
    renderBadges();
    ['filter-all', 'filter-unlocked', 'filter-locked'].forEach(id => {
      const btn = document.getElementById(id)!;
      const active = (id === 'filter-' + f);
      btn.className = active
        ? 'text-xs font-bold px-3 py-1.5 rounded-full bg-primary text-white'
        : 'text-xs font-bold px-3 py-1.5 rounded-full text-on-surface-variant hover:bg-surface-container transition-colors';
    });
  }
  document.getElementById('filter-all')!.addEventListener('click', () => setFilter('all'));
  document.getElementById('filter-unlocked')!.addEventListener('click', () => setFilter('unlocked'));
  document.getElementById('filter-locked')!.addEventListener('click', () => setFilter('locked'));

</script>
