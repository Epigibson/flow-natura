---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Recuperar Contraseña — Natura Manager">
  <div class="min-h-screen bg-surface flex items-center justify-center p-6 relative overflow-hidden">
    
    <!-- Background decoration -->
    <div class="absolute inset-0 bg-gradient-to-br from-primary/3 via-transparent to-secondary-container/5"></div>
    <div class="absolute top-[-10%] right-[-5%] w-[28rem] h-[28rem] bg-primary-container/8 rounded-full blur-3xl animate-pulse" style="animation-duration: 10s;"></div>
    <div class="absolute bottom-[-10%] left-[-5%] w-[22rem] h-[22rem] bg-secondary-container/10 rounded-full blur-3xl animate-pulse" style="animation-duration: 14s;"></div>
    <div class="absolute inset-0 opacity-[0.02]" style="background-image: radial-gradient(circle, var(--color-primary) 1px, transparent 1px); background-size: 40px 40px;"></div>

    <div class="relative z-10 w-full max-w-md">
      <!-- Back to login -->
      <a href="/login" class="inline-flex items-center gap-1.5 text-sm font-bold text-on-surface-variant hover:text-primary transition-colors mb-8 group">
        <span class="material-symbols-outlined text-base group-hover:-translate-x-1 transition-transform">arrow_back</span>
        Volver al inicio de sesión
      </a>

      <!-- Card -->
      <div class="bg-surface-container-lowest rounded-3xl p-8 sm:p-10 shadow-xl shadow-primary/5 border border-outline-variant/10">
        <!-- Header -->
        <div class="text-center mb-8">
          <div class="w-16 h-16 mx-auto rounded-2xl bg-primary/8 flex items-center justify-center mb-5">
            <span class="material-symbols-outlined text-primary text-2xl">lock_reset</span>
          </div>
          <h2 class="text-2xl font-display font-bold text-on-surface">¿Olvidaste tu contraseña?</h2>
          <p class="text-sm text-on-surface-variant mt-2 max-w-xs mx-auto">
            No te preocupes. Ingresa tu correo y te enviaremos un enlace para restablecerla.
          </p>
        </div>

        <!-- Send email form -->
        <form id="forgot-form" class="space-y-5">
          <div id="error-message" class="hidden rounded-xl bg-error/8 border border-error/15 p-3.5 flex items-start gap-2.5">
            <span class="material-symbols-outlined text-error text-base mt-0.5 shrink-0">error</span>
            <p class="text-sm text-error font-medium" id="error-text"></p>
          </div>

          <div class="space-y-1.5">
            <label for="email" class="block text-xs font-bold text-on-surface-variant uppercase tracking-wider">Correo electrónico</label>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-on-surface-variant/40 text-lg">mail</span>
              <input type="email" id="email" name="email" class="w-full input-editorial pl-11" placeholder="tu@correo.com" required autocomplete="email" />
            </div>
          </div>

          <button type="submit" class="w-full btn-primary flex items-center justify-center gap-2 !py-3.5 text-sm" id="submit-btn">
            <span class="material-symbols-outlined text-base">send</span>
            Enviar Enlace de Recuperación
          </button>
        </form>

        <!-- Success state (hidden by default) -->
        <div id="success-state" class="hidden text-center">
          <div class="w-20 h-20 mx-auto rounded-full bg-secondary/10 flex items-center justify-center mb-5">
            <span class="material-symbols-outlined text-secondary text-3xl">mark_email_read</span>
          </div>
          <h3 class="text-xl font-display font-bold text-on-surface mb-2">¡Correo enviado!</h3>
          <p class="text-sm text-on-surface-variant max-w-xs mx-auto mb-6">
            Revisa tu bandeja de entrada (y la carpeta de spam) para encontrar el enlace de recuperación.
          </p>
          <div class="space-y-3">
            <button id="btn-resend" class="w-full py-3 rounded-full border-2 border-outline-variant/15 font-bold text-sm text-on-surface-variant hover:text-primary hover:border-primary/20 transition-all">
              <span class="material-symbols-outlined text-base align-middle mr-1">refresh</span>
              Reenviar correo
            </button>
            <a href="/login" class="block w-full py-3 rounded-full bg-primary/5 font-bold text-sm text-primary text-center hover:bg-primary/10 transition-colors">
              Volver al login
            </a>
          </div>
        </div>
      </div>

      <!-- Help link -->
      <p class="text-center text-xs text-on-surface-variant/60 mt-6">
        ¿Necesitas ayuda? <a href="mailto:soporte@naturamanager.com" class="text-primary font-bold hover:underline">Contáctanos</a>
      </p>
    </div>

  </div>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  const form = document.getElementById('forgot-form') as HTMLFormElement;
  const errorDiv = document.getElementById('error-message') as HTMLDivElement;
  const errorText = document.getElementById('error-text') as HTMLParagraphElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const successState = document.getElementById('success-state') as HTMLDivElement;

  let lastEmail = '';

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorDiv.classList.add('hidden');
    submitBtn.innerHTML = '<span class="material-symbols-outlined text-base animate-spin">progress_activity</span> Enviando...';
    submitBtn.disabled = true;

    lastEmail = (new FormData(form).get('email') as string);

    const { error } = await supabase.auth.resetPasswordForEmail(lastEmail, {
      redirectTo: window.location.origin + '/reset-password',
    });

    if (error) {
      errorText.textContent = error.message;
      errorDiv.classList.remove('hidden');
      submitBtn.innerHTML = '<span class="material-symbols-outlined text-base">send</span> Enviar Enlace de Recuperación';
      submitBtn.disabled = false;
    } else {
      form.classList.add('hidden');
      successState.classList.remove('hidden');
    }
  });

  // Resend
  document.getElementById('btn-resend')?.addEventListener('click', async () => {
    const btn = document.getElementById('btn-resend') as HTMLButtonElement;
    btn.innerHTML = '<span class="material-symbols-outlined text-base align-middle mr-1 animate-spin">progress_activity</span> Reenviando...';
    btn.disabled = true;

    await supabase.auth.resetPasswordForEmail(lastEmail, {
      redirectTo: window.location.origin + '/reset-password',
    });

    btn.innerHTML = '<span class="material-symbols-outlined text-base align-middle mr-1">check</span> ¡Reenviado!';
    setTimeout(() => {
      btn.innerHTML = '<span class="material-symbols-outlined text-base align-middle mr-1">refresh</span> Reenviar correo';
      btn.disabled = false;
    }, 3000);
  });
</script>
