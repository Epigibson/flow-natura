---
import fs from 'fs';
import path from 'path';
import DashboardLayout from '../layouts/DashboardLayout.astro';
import DashboardSkeleton from '../components/skeletons/DashboardSkeleton.astro';
import PageLoader from '../components/PageLoader.astro';
---

<DashboardLayout>
  <!-- Skeleton state (visible by default) -->
  <div id="skeleton-state">
    <DashboardSkeleton />
  </div>

  <!-- Real content (hidden until data loads) -->
  <div id="real-content" class="hidden">
  <!-- Header -->
  <header class="flex flex-col md:flex-row md:justify-between md:items-center gap-6 mb-10">
    <div>
      <div class="flex flex-wrap items-center gap-3">
        <h2 id="greeting" class="text-4xl md:text-5xl font-display font-medium text-on-surface">¡Hola! ✨</h2>
      </div>
      <p id="subtitle" class="text-on-surface-variant mt-2 text-lg">Cargando tu resumen...</p>
    </div>
    <div class="flex items-center gap-4">
      <button id="btn-set-goal" class="flex items-center gap-2 py-2 px-5 rounded-xl font-bold border-2 border-primary/20 text-primary hover:bg-primary/5 transition-colors text-sm">
        <span class="material-symbols-outlined text-sm">flag</span> Mi Meta
      </button>
      <button id="btn-export" class="flex items-center gap-2 py-2 px-5 rounded-xl font-bold bg-secondary text-white hover:scale-[1.02] transition-all shadow-md text-sm">
        <span class="material-symbols-outlined text-sm">download</span> Exportar
      </button>
      <div class="h-14 w-14 rounded-full bg-surface-container-lowest shadow-sm border border-outline-variant/30 flex items-center justify-center overflow-hidden">
        <img id="user-avatar" src="https://api.dicebear.com/8.x/micah/svg?seed=User" alt="Avatar" />
      </div>
    </div>
  </header>

  </header>

  <!-- Premium Growth Widget (Client Hydrated) -->
  <section id="growth-widget-container" class="mb-10 relative overflow-hidden bg-surface-container-lowest rounded-4xl p-8 shadow-sm border border-outline-variant/30 hidden">
    <!-- Decorative background blur -->
    <div class="absolute -top-20 -right-20 w-64 h-64 bg-primary/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-20 -left-20 w-64 h-64 bg-secondary/10 rounded-full blur-3xl pointer-events-none"></div>
    
    <!-- Skeleton State -->
    <div id="growth-widget-skeleton" class="w-full flex flex-col md:flex-row gap-8 items-center justify-between animate-pulse">
        <div class="flex-1 w-full space-y-4">
           <div class="h-6 w-32 bg-surface-container-highest rounded-full"></div>
           <div class="h-12 w-48 bg-surface-container-highest rounded-2xl"></div>
           <div class="h-4 w-full bg-surface-container-highest rounded-full"></div>
        </div>
    </div>

    <!-- Prompto Form Conexión -->
    <div id="growth-widget-connect" class="relative z-10 w-full flex flex-col items-center justify-center text-center hidden">
        <span class="material-symbols-outlined text-4xl text-primary mb-2">link</span>
        <h3 class="text-2xl font-display font-medium text-on-surface">Conecta tu cuenta de Natura</h3>
        <p class="text-sm text-on-surface-variant max-w-md mx-auto mt-2 mb-6">Ingresa tus datos de Mi Negocio para sincronizar tus puntos reales y tu avance del ciclo automáticamente y de forma segura.</p>
        
        <form id="form-connect-natura" class="flex flex-col sm:flex-row gap-2 w-full max-w-lg">
          <input type="email" id="natura-email" placeholder="Correo de Mi Negocio" required class="flex-1 bg-surface-container rounded-xl px-4 py-3 text-sm border-2 border-transparent focus:border-primary/30 outline-none text-on-surface" />
          <input type="password" id="natura-password" placeholder="Contraseña" required class="flex-1 bg-surface-container rounded-xl px-4 py-3 text-sm border-2 border-transparent focus:border-primary/30 outline-none text-on-surface" />
          <button type="submit" id="btn-submit-connect" class="py-3 px-6 rounded-xl font-bold bg-primary text-white hover:scale-[1.02] transition-transform shadow-md disabled:opacity-50 flex items-center gap-2 shrink-0">
             Vincular <span class="material-symbols-outlined text-[1rem]">arrow_forward</span>
          </button>
        </form>
    </div>

    <!-- Data State -->
    <div id="growth-widget-content" class="relative z-10 w-full flex-col md:flex-row gap-8 items-center justify-between hidden">
      <div class="flex-1 w-full">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-bold tracking-widest uppercase text-primary bg-primary-container/30 px-3 py-1 rounded-full flex items-center gap-1">
            <span class="material-symbols-outlined text-[14px]">stars</span>
            Camino de Crecimiento
          </span>
          <div class="flex flex-col items-end">
            <span id="gw-timestamp" class="text-xs text-on-surface-variant flex items-center gap-1 hidden">
              <span class="material-symbols-outlined text-[12px]">update</span> <span id="gw-time-text"></span>
            </span>
            <span id="gw-alert" class="text-xs text-error font-bold mt-0.5 animate-pulse flex items-center gap-1 hidden">
               <span class="material-symbols-outlined text-[12px]">alarm</span> ¡Cierre inminente!
            </span>
          </div>
        </div>
        
        <div class="flex flex-col md:flex-row md:items-end gap-4 mt-6">
          <div class="shrink-0">
            <h3 id="gw-level-desc" class="text-4xl font-display font-medium text-on-surface leading-none">Consultor</h3>
            <span id="gw-profit-badge" class="hidden text-xs font-bold px-2 py-1 rounded-md mt-2 inline-block"></span>
            <p class="text-sm font-medium text-on-surface-variant mt-1">
              <span id="gw-current-pts" class="text-on-surface font-bold">0</span> pts acumulados
            </p>
          </div>
          <div class="flex-1 md:ml-8 mt-4 md:mt-0 w-full">
            <div class="flex justify-between items-end mb-2">
              <span class="text-sm font-bold text-on-surface-variant">Próximo: <span id="gw-next-level" class="text-on-surface">?</span></span>
              <span id="gw-percent-text" class="text-xs font-bold text-primary">0%</span>
            </div>
            <div class="w-full h-3 bg-surface-container-highest rounded-full overflow-hidden relative">
              <div id="gw-progress-bar" class="absolute top-0 left-0 h-full bg-linear-to-r from-primary to-secondary rounded-full" style="width: 0%"></div>
            </div>
            <div class="flex justify-between items-center mt-2">
              <span class="text-xs text-on-surface-variant font-medium text-left">Faltan <span id="gw-gap-pts" class="text-on-surface font-bold">0 pts</span></span>
              <span id="gw-days-left" class="text-xs text-on-surface-variant font-medium text-right text-error">0 días para cerrar</span>
            </div>
          </div>
        </div>
        
        <div id="gw-maintenance" class="mt-4 pt-4 border-t border-outline-variant/30 flex items-center gap-2 hidden">
          <span class="material-symbols-outlined text-error text-[16px]">info</span>
          <span class="text-xs text-on-surface-variant"><strong>Mantenimiento:</strong> Faltan <span id="gw-maintenance-pts"></span> pts para conservar el nivel <span id="gw-maintenance-level"></span>.</span>
        </div>
      </div>
      
      <div class="relative z-10 shrink-0 flex flex-col gap-2 w-full md:w-auto mt-4 md:mt-0">
        <button id="btn-sync-growth" class="relative flex items-center justify-center gap-2 py-3 px-6 rounded-2xl font-bold overflow-hidden transition-all duration-300 hover:scale-[1.02] hover:shadow-xl shadow-primary/20 active:scale-95 group">
          <!-- Background: Active Gradient -->
          <div id="btn-sync-bg" class="absolute inset-0 bg-gradient-to-br from-primary via-emerald-500 to-teal-600 transition-all duration-500"></div>
          
          <!-- Inner border for depth -->
          <div id="btn-sync-border" class="absolute inset-0 rounded-2xl border border-white/20 transition-all duration-500 pointer-events-none"></div>

          <!-- Shimmer Sweep -->
          <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-[150%] skew-x-[-20deg] group-hover:translate-x-[150%] transition-transform duration-1000 ease-out pointer-events-none"></div>
          
          <!-- Content -->
          <div id="btn-sync-content" class="relative z-10 flex items-center gap-2 text-white transition-colors duration-500">
            <span id="btn-sync-icon" class="material-symbols-outlined drop-shadow-md transition-all duration-500 group-hover:rotate-180">sync</span> 
            <span id="btn-sync-text" class="tracking-wide drop-shadow-md">Sincronizar</span>
          </div>
        </button>
      </div>
    </div>
  </section>

  <!-- KPI Grid -->
  <section class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-10">
    <div class="surface-layer p-6 rounded-[2rem] transition-transform hover:-translate-y-1">
      <span class="text-xs font-bold tracking-widest uppercase text-secondary">Ventas del Ciclo</span>
      <h3 id="kpi-revenue" class="text-3xl font-display mt-2 text-on-surface">—</h3>
      <div class="mt-4 w-full h-2 bg-white/50 rounded-full overflow-hidden">
        <div id="goal-bar" class="h-full bg-secondary rounded-full transition-all" style="width: 0%"></div>
      </div>
      <p id="goal-text" class="text-xs text-on-surface-variant mt-2 text-right">Definir meta →</p>
    </div>
    <div class="surface-layer p-6 rounded-[2rem] transition-transform hover:-translate-y-1">
      <span class="text-xs font-bold tracking-widest uppercase text-primary">Ventas del Mes</span>
      <h3 id="kpi-orders" class="text-3xl font-display mt-2 text-on-surface">—</h3>
      <a href="/ventas" class="mt-4 text-sm font-semibold text-primary-container hover:underline inline-block">Ver todas →</a>
    </div>
    <div class="surface-layer p-6 rounded-[2rem] transition-transform hover:-translate-y-1">
      <span class="text-xs font-bold tracking-widest uppercase text-error">Cobranza Pendiente</span>
      <h3 id="kpi-debt" class="text-3xl font-display mt-2 text-error">—</h3>
      <a href="/clientes/analisis" class="mt-4 text-sm font-semibold text-error hover:underline inline-block">Gestionar →</a>
    </div>
    <div class="surface-layer p-6 rounded-[2rem] transition-transform hover:-translate-y-1">
      <span class="text-xs font-bold tracking-widest uppercase text-on-surface-variant">Stock Agotado</span>
      <h3 id="kpi-outofstock" class="text-3xl font-display mt-2 text-on-surface">—</h3>
      <a href="/inventario" class="mt-4 text-sm font-semibold text-on-surface-variant hover:underline inline-block">Ver inventario →</a>
    </div>
  </section>

  <!-- Main Grid -->
  <section class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-10">
    <!-- Recent Activity -->
    <div class="lg:col-span-2 bg-surface-container-lowest rounded-[2rem] p-8 shadow-sm">
      <div class="flex justify-between items-center mb-6">
        <h3 class="text-xl font-display font-bold flex items-center gap-2">
          <span class="material-symbols-outlined text-secondary">receipt_long</span>
          Ventas Recientes
        </h3>
        <a href="/ventas/nueva" class="btn-primary text-sm px-4 py-2 flex items-center gap-1">
          <span class="material-symbols-outlined text-sm">add</span> Nueva Venta
        </a>
      </div>
      <div id="recent-orders" class="space-y-0">
        <div id="orders-loading" class="text-center py-8">
          <PageLoader inline={true} />
        </div>
      </div>
    </div>

    <!-- Quick Actions + Top Clients -->
    <div class="space-y-8">
      <!-- Quick Actions -->
      <div class="bg-surface-container-lowest rounded-[2rem] p-6 shadow-sm">
        <h3 class="text-lg font-display font-bold mb-4 flex items-center gap-2">
          <span class="material-symbols-outlined text-primary">bolt</span>
          Acciones Rápidas
        </h3>
        <div class="grid grid-cols-2 gap-3">
          <a href="/ventas/nueva" class="bg-primary/10 rounded-xl p-4 text-center hover:bg-primary/20 transition-colors">
            <span class="material-symbols-outlined text-primary text-2xl">point_of_sale</span>
            <p class="text-xs font-bold text-on-surface mt-1">Nueva Venta</p>
          </a>
          <a href="/inventario/nuevo" class="bg-secondary-container/20 rounded-xl p-4 text-center hover:bg-secondary-container/30 transition-colors">
            <span class="material-symbols-outlined text-secondary text-2xl">inventory_2</span>
            <p class="text-xs font-bold text-on-surface mt-1">Alta Stock</p>
          </a>
          <a href="/clientes" class="bg-primary-container/10 rounded-xl p-4 text-center hover:bg-primary-container/20 transition-colors">
            <span class="material-symbols-outlined text-primary text-2xl">person_add</span>
            <p class="text-xs font-bold text-on-surface mt-1">Nuevo Cliente</p>
          </a>
          <a href="/inventario/ajustes" class="bg-surface-container rounded-xl p-4 text-center hover:bg-surface-container-high transition-colors">
            <span class="material-symbols-outlined text-on-surface-variant text-2xl">tune</span>
            <p class="text-xs font-bold text-on-surface mt-1">Ajuste Stock</p>
          </a>
        </div>
      </div>

      <!-- Top Clients -->
      <div class="bg-surface-container-lowest rounded-[2rem] p-6 shadow-sm">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-lg font-display font-bold flex items-center gap-2">
            <span class="material-symbols-outlined text-secondary">stars</span>
            Top Clientes
          </h3>
          <a href="/clientes" class="text-primary text-sm font-bold hover:underline">Ver todos</a>
        </div>
        <div id="top-clients" class="space-y-0">
          <div class="text-center py-4 text-on-surface-variant text-sm">Cargando...</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Low Stock Alerts + Reorder Suggestions -->
  <section class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-10">
    <div class="bg-surface-container-lowest rounded-[2rem] p-8 shadow-sm">
      <h3 class="text-xl font-display font-bold mb-6 flex items-center gap-2">
        <span class="material-symbols-outlined text-error">warning</span>
        Alertas de Stock
      </h3>
      <div id="stock-alerts" class="space-y-0">
        <div class="text-center py-6 text-on-surface-variant text-sm">Cargando...</div>
      </div>
    </div>
    <div class="bg-surface-container-lowest rounded-[2rem] p-8 shadow-sm">
      <h3 class="text-xl font-display font-bold mb-6 flex items-center gap-2">
        <span class="material-symbols-outlined text-primary">trending_up</span>
        Productos Más Vendidos
      </h3>
      <div id="top-products" class="space-y-0">
        <div class="text-center py-6 text-on-surface-variant text-sm">Cargando...</div>
      </div>
    </div>
  </section>

  <!-- Upcoming Payments -->
  <section class="bg-surface-container-lowest rounded-[2rem] p-8 shadow-sm mb-10">
    <h3 class="text-xl font-display font-bold mb-6 flex items-center gap-2">
      <span class="material-symbols-outlined text-primary">schedule</span>
      Próximos Cobros
      <span id="cobros-count" class="px-2 py-0.5 rounded-full text-xs font-bold bg-primary-container text-primary"></span>
    </h3>
    <div id="upcoming-payments" class="space-y-0">
      <div class="text-center py-6 text-on-surface-variant text-sm">Cargando...</div>
    </div>
  </section>

  <!-- Goal Modal -->
  <dialog id="goal-modal" class="p-0 rounded-2xl shadow-2xl border-none backdrop:bg-on-surface/50 backdrop:backdrop-blur-sm m-auto w-full max-w-sm bg-transparent">
    <div class="bg-surface-container-lowest rounded-2xl p-8 w-full border border-outline-variant/20">
      <h3 class="text-xl font-display font-bold mb-4">🎯 Meta del Ciclo</h3>
      <p class="text-sm text-on-surface-variant mb-4">Define tu meta de ventas para este ciclo.</p>
      <input id="goal-input" type="number" placeholder="Ej: 6000" class="w-full bg-surface-container-highest border-none rounded-xl py-3 px-4 focus:ring-2 focus:ring-primary-container text-2xl font-bold text-center mb-4" />
      <button id="btn-save-goal" class="w-full py-3 rounded-xl font-bold bg-primary text-white shadow-lg shadow-primary/20 hover:scale-[1.02] transition-all">Guardar Meta</button>
      <button id="btn-close-goal" class="w-full py-2 mt-2 text-sm text-on-surface-variant hover:text-on-surface transition-colors">Cancelar</button>
    </div>
  </dialog>

  <!-- Export Modal -->
  <dialog id="export-modal" class="p-0 rounded-2xl shadow-2xl border-none backdrop:bg-on-surface/50 backdrop:backdrop-blur-sm m-auto w-full max-w-md bg-transparent">
    <div class="bg-surface-container-lowest rounded-2xl p-8 w-full border border-outline-variant/20">
      <h3 class="text-xl font-display font-bold mb-4 flex items-center gap-2"><span class="material-symbols-outlined text-secondary">download</span> Exportar Datos</h3>
      <div class="space-y-3">
        <button id="export-ventas-csv" class="w-full text-left flex items-center gap-3 p-4 rounded-xl bg-surface-container-low hover:bg-surface-container transition-colors">
          <span class="material-symbols-outlined text-secondary">table_view</span>
          <div><p class="font-bold text-on-surface">Ventas (CSV)</p><p class="text-xs text-on-surface-variant">Todas las ventas del ciclo en formato Excel.</p></div>
        </button>
        <button id="export-clientes-csv" class="w-full text-left flex items-center gap-3 p-4 rounded-xl bg-surface-container-low hover:bg-surface-container transition-colors">
          <span class="material-symbols-outlined text-secondary">people</span>
          <div><p class="font-bold text-on-surface">Clientes (CSV)</p><p class="text-xs text-on-surface-variant">Lista completa de clientes.</p></div>
        </button>
        <button id="export-inventario-csv" class="w-full text-left flex items-center gap-3 p-4 rounded-xl bg-surface-container-low hover:bg-surface-container transition-colors">
          <span class="material-symbols-outlined text-secondary">inventory</span>
          <div><p class="font-bold text-on-surface">Inventario (CSV)</p><p class="text-xs text-on-surface-variant">Stock actual con precios y categorías.</p></div>
        </button>
      </div>
      <button id="btn-close-export" class="w-full py-2 mt-4 text-sm text-on-surface-variant hover:text-on-surface transition-colors">Cerrar</button>
    </div>
  </dialog>
  </div>
</DashboardLayout>

<script>
  import { esc } from '../lib/security';
  import { supabase } from '../lib/supabase';
  import { authFetch } from '../lib/auth-fetch';
  import api, { dashboard, consultant } from '../lib/api';

  const { data: { session } } = await supabase.auth.getSession();
  if (!session) { window.location.href = '/login'; throw new Error('No session'); }
  const userId = session.user.id;
  const userEmail = session.user.email || 'Consultora';

  // Greeting
  const hour = new Date().getHours();
  const greeting = hour < 12 ? 'Buenos días' : hour < 18 ? 'Buenas tardes' : 'Buenas noches';
  const nameFromEmail = userEmail.split('@')[0].replace('.', ' ').replace(/\b\w/g, l => l.toUpperCase());
  (document.getElementById('greeting') as HTMLElement).textContent = `${greeting}, ${nameFromEmail}! ✨`;
  (document.getElementById('user-avatar') as HTMLImageElement).src = `https://api.dicebear.com/8.x/micah/svg?seed=${nameFromEmail}`;

  // 1. Fetch User Profile (from API)
  let profile: any = {};
  try { profile = await consultant.getProfile(); } catch(e) { console.warn('Profile fetch failed', e); }
  
  // 2. Hydrate Growth Widget
  const widgetContainer = document.getElementById('growth-widget-container')!;
  const wSkeleton = document.getElementById('growth-widget-skeleton')!;
  const wConnect = document.getElementById('growth-widget-connect')!;
  const wContent = document.getElementById('growth-widget-content')!;
  
  widgetContainer.classList.remove('hidden'); // unhide widget
  widgetContainer.classList.add('flex');

  if (!profile.is_natura_connected) {
    wSkeleton.classList.add('hidden');
    wConnect.classList.remove('hidden');
  } else {
    wSkeleton.classList.add('hidden');
    wContent.classList.remove('hidden');
    wContent.classList.add('flex');

    const gData = profile.latest_growth_data;
    if (gData && gData.level) {
      document.getElementById('gw-level-desc')!.textContent = gData.level.description || 'Consultor';
      document.getElementById('gw-current-pts')!.textContent = (gData.nextLevelProgress?.currentValue || 0).toLocaleString();
      document.getElementById('gw-next-level')!.textContent = gData.nextLevel || '?';
      
      const pct = Math.min(100, gData.nextLevelProgress?.progressPercentage || 0);
      document.getElementById('gw-percent-text')!.textContent = pct + '%';
      
      // Dynamic Level Styling
      const levelColors: Record<string, string> = {
        'Bronce': 'from-amber-700 to-orange-500',
        'Plata': 'from-slate-400 to-zinc-300',
        'Oro': 'from-yellow-400 to-amber-500',
        'Zafiro': 'from-blue-600 to-cyan-400',
        'Diamante': 'from-indigo-600 to-purple-500',
        'Diamante Azul': 'from-sky-500 to-blue-700'
      };
      const textColors: Record<string, string> = {
        'Bronce': 'text-amber-700',
        'Plata': 'text-slate-500',
        'Oro': 'text-amber-500',
        'Zafiro': 'text-blue-600',
        'Diamante': 'text-indigo-600',
        'Diamante Azul': 'text-sky-600'
      };
      
      const levelDesc = gData.level.description as string;
      const progressBgClass = levelColors[levelDesc] || 'from-primary to-secondary';
      const textColorClass = textColors[levelDesc] || 'text-on-surface';
      
      const gwLevelDesc = document.getElementById('gw-level-desc')!;
      gwLevelDesc.className = `text-4xl font-display font-medium leading-none ${textColorClass}`;
      
      const gwProfitBadge = document.getElementById('gw-profit-badge')!;
      // Import the config from our central module
      import('../lib/camino-crecimiento').then(({ CAMINO_CRECIMIENTO }) => {
        const profit = CAMINO_CRECIMIENTO[levelDesc as keyof typeof CAMINO_CRECIMIENTO]?.profitPercentage;
        if (profit) {
          gwProfitBadge.textContent = `Ganancia del ${profit}%`;
          gwProfitBadge.className = `text-xs font-bold px-2 py-1 rounded-md mt-2 inline-block bg-surface-container-high ${textColorClass}`;
          gwProfitBadge.classList.remove('hidden');
        }
      });
      
      const progressBar = document.getElementById('gw-progress-bar')!;
      progressBar.className = `absolute top-0 left-0 h-full bg-gradient-to-r ${progressBgClass} rounded-full`;
      progressBar.style.width = pct + '%';
      
      document.getElementById('gw-gap-pts')!.textContent = (gData.nextLevelProgress?.gap || 0).toLocaleString() + ' pts';
      document.getElementById('gw-days-left')!.textContent = (gData.period?.daysFinalDate || 0) + ' días para cerrar';
      
      if (gData.period?.daysFinalDate <= 7) {
        document.getElementById('gw-alert')?.classList.remove('hidden');
      }
      if (profile.growth_sync_date) {
        document.getElementById('gw-timestamp')?.classList.remove('hidden');
        document.getElementById('gw-time-text')!.textContent = new Date(profile.growth_sync_date).toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' });
      }
      if (gData.level.maintenanceGap > 0) {
        document.getElementById('gw-maintenance')?.classList.remove('hidden');
        document.getElementById('gw-maintenance-pts')!.textContent = gData.level.maintenanceGap;
        document.getElementById('gw-maintenance-level')!.textContent = gData.level.description;
      }
    } else {
       // Connected but never synced
       document.getElementById('gw-current-pts')!.textContent = "0 (Sin sincronizar)";
    }
  }

  // Handle Form Conexión Natura
  const formConnect = document.getElementById('form-connect-natura');
  if (formConnect) {
    formConnect.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (document.getElementById('natura-email') as HTMLInputElement).value;
      const pwd = (document.getElementById('natura-password') as HTMLInputElement).value;
      const btn = document.getElementById('btn-submit-connect') as HTMLButtonElement;
      
      btn.disabled = true;
      btn.innerHTML = `<span class="material-symbols-outlined animate-spin">refresh</span>`;
      
      try {
        const res = await authFetch('/api/connect-natura', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userId, natura_email: email, natura_password: pwd })
        });
        const d = await res.json();
        if (d.success) {
           window.location.reload();
        } else {
           alert('Error al vincular: ' + d.error);
        }
      } catch(e) { alert('Error de red'); }
      finally { btn.disabled = false; btn.innerHTML = `Vincular <span class="material-symbols-outlined text-[1rem]">arrow_forward</span>`;}
    });
  }

  // Handle Sincronizar — Abre modal interactivo
  const btnSyncGrowth = document.getElementById('btn-sync-growth') as HTMLButtonElement;
  if (btnSyncGrowth) {
    btnSyncGrowth.addEventListener('click', () => {
      const hasSyncedBefore = !!profile.growth_sync_date;
      
      const overlay = document.createElement('div');
      overlay.id = 'sync-modal-overlay';
      overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.7);backdrop-filter:blur(6px);z-index:9999;display:flex;align-items:center;justify-content:center;animation:fadeIn 0.2s ease';
      
      const isLinux = navigator.userAgent.toLowerCase().includes('linux') && !navigator.userAgent.toLowerCase().includes('android');

      const contentHasSynced = isLinux ? `
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
            <div style="width:40px;height:40px;background:linear-gradient(135deg,#10b981,#059669);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:20px;">🐧</div>
            <h3 style="font-size:18px;font-weight:700;color:#fff;">Sincronización Activa</h3>
          </div>
          <p style="color:rgba(255,255,255,0.7);font-size:14px;line-height:1.7;margin-bottom:20px;">
            Tu sistema detecta datos sincronizados. En <strong>Linux / Pop!_OS</strong>, la automatización ocurre de fondo.
          </p>
          <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:16px;margin-bottom:20px;">
            <p style="color:rgba(255,255,255,0.6);font-size:13px;line-height:1.6;margin:0;">
               Para forzar un escaneo ahora mismo, abre tu terminal y ejecuta:<br>
               <code style="background:rgba(0,0,0,0.3);padding:6px;border-radius:4px;display:block;margin-top:8px;color:#10b981;font-size:11px;overflow-x:auto;">node scripts/scrape-nivel-auto.mjs</code>
            </p>
          </div>
          <button onclick="this.closest('#sync-modal-overlay').remove()" 
                  style="display:block;width:100%;padding:14px;background:linear-gradient(135deg,#10b981,#059669);border-radius:12px;color:#fff;font-weight:600;font-size:15px;cursor:pointer;border:none;">
            Entendido
          </button>
      ` : `
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
            <div style="width:40px;height:40px;background:linear-gradient(135deg,#10b981,#059669);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:20px;">✅</div>
            <h3 style="font-size:18px;font-weight:700;color:#fff;">Sincronización Activa</h3>
          </div>
          <p style="color:rgba(255,255,255,0.7);font-size:14px;line-height:1.7;margin-bottom:20px;">
            Tu computadora ya tiene configurada la sincronización <strong>automática y silenciosa</strong> gracias a <strong style="color:#10b981">Natura Manager Sync</strong>.
          </p>
          <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:16px;margin-bottom:20px;">
            <p style="color:rgba(255,255,255,0.6);font-size:13px;line-height:1.6;margin:0;">
               Tus puntos se han actualizado al ras del arranque del sistema. Si aún deseas forzar un escaneo nuevo en este preciso instante, <strong>solo dale doble click a NaturaManager-Sync.exe</strong> en la carpeta de descargas o escritorio de tu PC.
            </p>
          </div>
          <button onclick="this.closest('#sync-modal-overlay').remove()" 
                  style="display:block;width:100%;padding:14px;background:linear-gradient(135deg,#10b981,#059669);border-radius:12px;color:#fff;font-weight:600;font-size:15px;cursor:pointer;border:none;">
            Entendido
          </button>
      `;

      const contentNeedsInstall = isLinux ? `
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
            <div style="width:40px;height:40px;background:linear-gradient(135deg,#10b981,#059669);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:20px;">🐧</div>
            <h3 style="font-size:18px;font-weight:700;color:#fff;">Sincronizar en Pop!_OS</h3>
          </div>
          <p style="color:rgba(255,255,255,0.6);font-size:14px;line-height:1.7;margin-bottom:10px;">
            En Pop!_OS, elige tu editor favorito (ej. nano) y configura cron agregando esta línea (<code style="background:rgba(0,0,0,0.3);padding:2px 4px;border-radius:4px;color:#10b981;">EDITOR=nano crontab -e</code>):
          </p>
          <div style="background:rgba(16,185,129,0.08);border:1px solid rgba(16,185,129,0.15);border-radius:12px;padding:16px;margin-bottom:20px;overflow-x:auto;">
            <pre style="color:rgba(255,255,255,0.8);font-size:11px;line-height:1.6;margin:0;">0 10 * * * NATURA_USER="correo" NATURA_PASS="pass" /usr/bin/node /ruta/a/scripts/scrape-nivel-auto.mjs</pre>
          </div>
          <button onclick="this.closest('#sync-modal-overlay').remove()" 
                  style="display:block;width:100%;margin-top:12px;padding:10px;background:transparent;border:1px solid rgba(255,255,255,0.1);border-radius:10px;color:rgba(255,255,255,0.8);font-size:13px;cursor:pointer;font-family:inherit;">
            Cerrar
          </button>
      ` : `
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
            <div style="width:40px;height:40px;background:linear-gradient(135deg,#10b981,#059669);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:20px;">🔄</div>
            <h3 style="font-size:18px;font-weight:700;color:#fff;">Sincronizar con Natura</h3>
          </div>
          <p style="color:rgba(255,255,255,0.6);font-size:14px;line-height:1.7;margin-bottom:20px;">
            Tus datos se sincronizarán <strong>automáticamente en segundo plano</strong> gracias a <strong style="color:#10b981">Natura Manager Sync</strong>. 
            Es invisible y solo necesitas instalarlo una vez.
          </p>
          <div style="background:rgba(16,185,129,0.08);border:1px solid rgba(16,185,129,0.15);border-radius:12px;padding:16px;margin-bottom:20px;">
            <p style="color:rgba(255,255,255,0.7);font-size:13px;line-height:1.8;margin:0;">
              ✨ Se ejecuta de forma segura al encender tu PC.<br>
              ✨ Tus credenciales nunca salen de tu equipo principal.<br>
              ✨ Actualiza tus puntos automáticamente.
            </p>
          </div>
          <p style="color:rgba(255,255,255,0.4);font-size:12px;margin-bottom:10px;text-align:center;">Descarga la herramienta aquí</p>
          <a href="https://github.com/Epigibson/flow-natura/releases/latest/download/NaturaManager-Sync.exe" 
             style="display:block;text-align:center;padding:14px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:12px;color:#fff;font-weight:600;font-size:14px;text-decoration:none;transition:background 0.2s;"
             onmouseover="this.style.background='rgba(255,255,255,0.1)'"
             onmouseout="this.style.background='rgba(255,255,255,0.05)'">
            ⬇️ Descargar Instalador
          </a>
          <button onclick="this.closest('#sync-modal-overlay').remove()" 
                  style="display:block;width:100%;margin-top:12px;padding:10px;background:transparent;border:1px solid rgba(255,255,255,0.1);border-radius:10px;color:rgba(255,255,255,0.5);font-size:13px;cursor:pointer;font-family:inherit;">
            Cerrar
          </button>
      `;

      overlay.innerHTML = `
        <div style="background:rgba(30,30,40,0.95);border:1px solid rgba(255,255,255,0.1);border-radius:20px;padding:36px;max-width:440px;width:90%;box-shadow:0 20px 60px rgba(0,0,0,0.5);">
          ${hasSyncedBefore ? contentHasSynced : contentNeedsInstall}
        </div>
      `;
      
      overlay.addEventListener('click', (e) => { if (e.target === overlay) overlay.remove(); });
      document.body.appendChild(overlay);
    });
  }

  if (profile.growth_sync_date) {
    const btnSyncGrowth2 = document.getElementById('btn-sync-growth');
    if (btnSyncGrowth2) {
      // Remove drop shadow from the main button container to make the border glow pop
      btnSyncGrowth2.classList.remove('shadow-primary/20');
      
      // Transform Background to a deep dark surface
      document.getElementById('btn-sync-bg')!.className = 'absolute inset-0 bg-surface-container-highest transition-all duration-500';
      
      // Add a subtle premium neon border and inner shadow
      document.getElementById('btn-sync-border')!.className = 'absolute inset-0 rounded-2xl border border-primary/30 group-hover:border-primary/70 transition-all duration-500 pointer-events-none shadow-[inset_0_0_12px_rgba(16,185,129,0.05)]';
      
      // Update Text colors
      const contentContainer = document.getElementById('btn-sync-content')!;
      contentContainer.classList.remove('text-white');
      contentContainer.classList.add('text-on-surface');
      
      // Update Icon with a glow effect
      const icon = document.getElementById('btn-sync-icon')!;
      icon.className = 'material-symbols-outlined text-primary drop-shadow-[0_0_8px_rgba(16,185,129,0.6)] transition-all duration-500 group-hover:scale-110';
      icon.textContent = 'cloud_done';
      
      // Update Text
      const textNode = document.getElementById('btn-sync-text')!;
      textNode.innerHTML = `Sincronización Silenciosa`;
      textNode.className = 'tracking-wide text-[0.95rem]';
    }
  }

  // ---- LOAD REAL DATA (from API) ----
  const now = new Date();
  let dashData: any = { kpis: {}, recent_orders: [], top_clients: [], stock_alerts: [], top_products: [], upcoming_payments: [] };
  try { dashData = await dashboard.getData(); } catch(e) { console.warn('Dashboard fetch failed', e); }

  const totalRevenue = Number(dashData.kpis.total_revenue || 0);
  const totalDebt = Number(dashData.kpis.pending_debt || 0);
  const outOfStock = dashData.kpis.out_of_stock || 0;
  const validOrders = dashData.recent_orders || [];

  (document.getElementById('kpi-revenue') as HTMLElement).textContent = '$' + totalRevenue.toLocaleString('es-MX', { minimumFractionDigits: 2 });
  (document.getElementById('kpi-orders') as HTMLElement).textContent = String(dashData.kpis.total_orders || 0);
  (document.getElementById('kpi-debt') as HTMLElement).textContent = totalDebt > 0 ? '$' + totalDebt.toFixed(2) : '$0';
  (document.getElementById('kpi-outofstock') as HTMLElement).textContent = String(outOfStock);

  // ⚡ Swap skeleton → real content with fade-in
  document.getElementById('skeleton-state')?.classList.add('hidden');
  const realContent = document.getElementById('real-content');
  if (realContent) {
    realContent.classList.remove('hidden');
    realContent.classList.add('content-loaded');
  }

  // Goal
  const savedGoal = Number(localStorage.getItem('natura_goal') || '0');
  const goalText = document.getElementById('goal-text') as HTMLElement;
  const goalBar = document.getElementById('goal-bar') as HTMLElement;
  if (savedGoal > 0) {
    const pct = Math.min(100, (totalRevenue / savedGoal) * 100);
    goalBar.style.width = pct + '%';
    goalText.textContent = `Meta: $${savedGoal.toLocaleString()} (${pct.toFixed(0)}%)`;
  }

  // Subtitle
  const subtitle = document.getElementById('subtitle') as HTMLElement;
  const daysLeft = new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate() - now.getDate();
  subtitle.textContent = `Faltan ${daysLeft} días para cerrar el ciclo. ${validOrders.length} ventas este mes.`;

  // ---- RECENT ORDERS (from API) ----
  const recentContainer = document.getElementById('recent-orders') as HTMLElement;
  (document.getElementById('orders-loading') as HTMLElement).classList.add('hidden');
  const recentOrders = dashData.recent_orders || [];

  if (!recentOrders.length) {
    recentContainer.innerHTML = '<div class="text-center py-8 text-on-surface-variant"><span class="material-symbols-outlined text-4xl">shopping_cart</span><p class="mt-2">Sin ventas este mes. ¡Empieza una!</p></div>';
  } else {
    recentOrders.forEach((o: any, idx: number) => {
      const custName = o.customer_name || 'Cliente';
      const statusLabel = o.status === 'cancelled' ? 'Cancelada' : (o.payment_method === 'abonos' ? 'Abonos' : 'Contado');
      const statusColor = o.status === 'cancelled' ? 'text-error bg-error-container/10' : (o.payment_method === 'abonos' ? 'text-primary bg-primary-container/10' : 'text-secondary bg-secondary-container/10');

      const row = document.createElement('a');
      row.href = '/ventas/detalle?id=' + o.id;
      row.className = 'flex items-center gap-4 py-4 hover:bg-surface-container-low/50 rounded-xl px-2 transition-colors' + (idx > 0 ? ' border-t border-surface-container' : '');
      row.innerHTML = `<div class="w-10 h-10 rounded-full bg-primary-container/15 flex items-center justify-center shrink-0"><span class="font-bold text-primary text-sm">${esc(custName.charAt(0))}</span></div>` +
        `<div class="flex-1 min-w-0"><h4 class="font-bold text-on-surface text-sm truncate">${esc(custName)}</h4><p class="text-xs text-on-surface-variant truncate">${esc(o.items_summary || '')}</p></div>` +
        `<div class="text-right shrink-0"><p class="font-bold text-on-surface">$${Number(o.total_amount).toFixed(2)}</p>` +
        `<span class="px-2 py-0.5 rounded-full text-xs font-bold ${statusColor}">${statusLabel}</span></div>`;
      recentContainer.appendChild(row);
    });
  }

  // ---- TOP CLIENTS (from API) ----
  const topClientsEl = document.getElementById('top-clients') as HTMLElement;
  const sortedClients = dashData.top_clients || [];
  topClientsEl.innerHTML = '';
  if (!sortedClients.length) {
    topClientsEl.innerHTML = '<p class="text-center py-4 text-on-surface-variant text-sm">Sin datos aún.</p>';
  } else {
    const medals = ['🥇', '🥈', '🥉'];
    sortedClients.forEach((c: any, idx: number) => {
      const el = document.createElement('div');
      el.className = 'flex items-center gap-3 py-3 hover:bg-surface-container-low/50 rounded-xl px-2 transition-colors' + (idx > 0 ? ' border-t border-surface-container' : '');
      el.innerHTML = `<span class="text-lg">${medals[idx] || ''}</span><div class="flex-1"><p class="font-bold text-on-surface text-sm">${esc(c.name)}</p></div><p class="font-bold text-primary text-sm">$${Number(c.total).toFixed(2)}</p>`;
      topClientsEl.appendChild(el);
    });
  }

  // ---- STOCK ALERTS (from API) ----
  const alertsEl = document.getElementById('stock-alerts') as HTMLElement;
  const lowStock = dashData.stock_alerts || [];
  alertsEl.innerHTML = '';
  if (!lowStock.length) {
    alertsEl.innerHTML = '<div class="text-center py-6"><span class="material-symbols-outlined text-secondary text-3xl">check_circle</span><p class="text-on-surface-variant mt-2">¡Todo en orden! No hay alertas de stock.</p></div>';
  } else {
    lowStock.forEach((p: any, idx: number) => {
      const el = document.createElement('div');
      el.className = 'flex items-center gap-3 py-3' + (idx > 0 ? ' border-t border-surface-container' : '');
      const color = p.is_out ? 'text-error bg-error-container/10' : 'text-primary bg-primary-container/10';
      el.innerHTML = `<span class="px-2 py-1 rounded-lg text-xs font-bold ${color}">${p.is_out ? 'AGOTADO' : p.stock + ' uds'}</span><p class="flex-1 font-bold text-on-surface text-sm">${esc(p.product_name)}</p><span class="text-xs text-on-surface-variant">${esc(p.category || '')}</span>`;
      alertsEl.appendChild(el);
    });
  }

  // ---- TOP PRODUCTS (from API) ----
  const topProdsEl = document.getElementById('top-products') as HTMLElement;
  const sortedProds = dashData.top_products || [];
  topProdsEl.innerHTML = '';
  if (!sortedProds.length) {
    topProdsEl.innerHTML = '<p class="text-center py-6 text-on-surface-variant text-sm">Sin ventas para analizar.</p>';
  } else {
    const maxRev = sortedProds[0]?.revenue || 1;
    sortedProds.forEach((data: any, idx: number) => {
      const pct = (data.revenue / maxRev) * 100;
      const el = document.createElement('div');
      el.className = 'py-3' + (idx > 0 ? ' border-t border-surface-container' : '');
      el.innerHTML = `<div class="flex justify-between items-center mb-1"><span class="font-bold text-on-surface text-sm">${esc(data.product_name)}</span><span class="text-sm font-bold text-secondary">$${Number(data.revenue).toFixed(0)}</span></div>` +
        `<div class="w-full h-1.5 bg-surface-container-highest rounded-full"><div class="h-full bg-secondary rounded-full" style="width:${pct}%"></div></div>` +
        `<p class="text-xs text-on-surface-variant mt-1">${data.units_sold} unidades vendidas</p>`;
      topProdsEl.appendChild(el);
    });
  }

  // ---- UPCOMING PAYMENTS (from API) ----
  const paymentsEl = document.getElementById('upcoming-payments') as HTMLElement;
  const cobrosCount = document.getElementById('cobros-count') as HTMLElement;
  const upcomingPayments = dashData.upcoming_payments || [];
  paymentsEl.innerHTML = '';

  if (!upcomingPayments.length) {
    paymentsEl.innerHTML = '<div class="text-center py-6"><span class="material-symbols-outlined text-secondary text-3xl">payments</span><p class="text-on-surface-variant mt-2">No hay pagos pendientes.</p></div>';
  } else {
    upcomingPayments.forEach((o: any, idx: number) => {
      const custName = o.customer_name || 'Cliente';
      const el = document.createElement('a');
      el.href = '/ventas/detalle?id=' + o.id;
      el.className = 'flex items-center gap-4 py-4 hover:bg-surface-container-low/50 rounded-xl px-2 transition-colors' + (idx > 0 ? ' border-t border-surface-container' : '');
      el.innerHTML = `<div class="w-10 h-10 rounded-full bg-primary-container/15 flex items-center justify-center shrink-0"><span class="material-symbols-outlined text-primary text-sm">payments</span></div>` +
        `<div class="flex-1"><h4 class="font-bold text-on-surface text-sm">${esc(custName)}</h4><p class="text-xs text-on-surface-variant">${esc(o.items_summary)}</p></div>` +
        `<span class="px-3 py-1 rounded-full text-xs font-bold text-primary bg-primary-container/10">Cobrar →</span>`;
      paymentsEl.appendChild(el);
    });
  }
  cobrosCount.textContent = upcomingPayments.length > 0 ? String(upcomingPayments.length) : '';

  // ---- GOAL MODAL ----
  const goalModal = document.getElementById('goal-modal') as HTMLDialogElement;
  const goalInput = document.getElementById('goal-input') as HTMLInputElement;
  document.getElementById('btn-set-goal')!.addEventListener('click', () => { goalInput.value = String(savedGoal || ''); goalModal.showModal(); });
  document.getElementById('btn-close-goal')!.addEventListener('click', () => goalModal.close());
  document.getElementById('btn-save-goal')!.addEventListener('click', () => {
    const val = Number(goalInput.value);
    if (val > 0) { localStorage.setItem('natura_goal', String(val)); window.location.reload(); }
  });

  // ---- EXPORT ----
  const exportModal = document.getElementById('export-modal') as HTMLDialogElement;
  document.getElementById('btn-export')!.addEventListener('click', () => exportModal.showModal());
  document.getElementById('btn-close-export')!.addEventListener('click', () => exportModal.close());

  function downloadCSV(filename: string, headers: string[], rows: string[][]) {
    const bom = '\uFEFF';
    const csv = bom + headers.join(',') + '\n' + rows.map(r => r.map(c => '"' + String(c || '').replace(/"/g, '""') + '"').join(',')).join('\n');
    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = filename; a.click();
    URL.revokeObjectURL(url);
    exportModal.close();
  }

  document.getElementById('export-ventas-csv')!.addEventListener('click', async () => {
    const data = await api.orders.list();
    const rows = (data || []).map((o: any) => {
      return [o.id, o.customer_name || '', o.total_amount, o.payment_method, o.status, o.items_summary || '', new Date(o.created_at).toLocaleDateString('es-MX')];
    });
    downloadCSV('ventas_naturaflow.csv', ['ID', 'Cliente', 'Total', 'Método Pago', 'Estado', 'Productos', 'Fecha'], rows);
  });

  document.getElementById('export-clientes-csv')!.addEventListener('click', async () => {
    const data = await api.customers.list();
    const rows = (data || []).map((c: any) => [c.id, c.full_name, c.phone, c.email || '', c.address || '', c.preferences || '', new Date(c.created_at).toLocaleDateString('es-MX')]);
    downloadCSV('clientes_naturaflow.csv', ['ID', 'Nombre', 'Teléfono', 'Correo', 'Dirección', 'Preferencias', 'Registro'], rows);
  });

  document.getElementById('export-inventario-csv')!.addEventListener('click', async () => {
    const data = await api.products.list();
    const rows = (data || []).map((p: any) => [p.id, p.name, p.category || '', p.price, p.stock || 0, new Date(p.created_at).toLocaleDateString('es-MX')]);
    downloadCSV('inventario_naturaflow.csv', ['ID', 'Nombre', 'Categoría', 'Precio', 'Stock', 'Registro'], rows);
  });

  // Confetti if goal reached
  if (savedGoal > 0 && totalRevenue >= savedGoal) {
    goalText.textContent = '🎉 ¡META ALCANZADA!';
    goalText.classList.add('text-secondary', 'font-bold');
  }
</script>
