  // ===== STOCK MANAGEMENT =====
  function bindStockButtons(root: HTMLElement) {
    root.querySelectorAll('.btn-minus-stock').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (btn as HTMLElement).dataset.id;
        if(id) updateStock(id, -1);
      });
    });
    root.querySelectorAll('.btn-plus-stock').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (btn as HTMLElement).dataset.id;
        if(id) updateStock(id, 1);
      });
    });
  }

  async function updateStock(productId: string, increment: number) {
    const product = fullInventory.find(p => p.id === productId);
    if (!product) return;
    
    // Optimistic update
    const newQty = Math.max(0, product.quantity + increment);
    if (newQty === product.quantity) return; // no change
    
    product.quantity = newQty;
    
    // Update DOM instantaneously
    document.querySelectorAll(`.stock-label-${productId}`).forEach(el => {
      el.textContent = newQty.toString();
      el.className = `text-sm lg:text-xs font-bold w-6 text-center text-${newQty > 0 ? 'green-600' : 'on-surface-variant'} stock-label-${productId}`;
    });
    
    document.querySelectorAll(`.btn-minus-stock[data-id="${productId}"]`).forEach(btn => {
       (btn as HTMLButtonElement).disabled = newQty === 0;
    });

    updateStats(fullInventory); 

    // Sync stock change with backend API
    try {
      await api.inventory.add([{ product_id: productId, quantity: newQty }]);
      if (!product.inv_id) product.inv_id = productId;
    } catch(e) { console.error('Error syncing stock', e); }
  }

  // ===== EVENT LISTENERS =====
  let searchTimer: ReturnType<typeof setTimeout>;
  searchInput?.addEventListener('input', () => {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(applyFilters, 200);
  });
  filterBrand?.addEventListener('change', () => applyFilters());
  filterCategory?.addEventListener('change', () => applyFilters());

  prevBtn?.addEventListener('click', () => { currentPage--; renderPage(); window.scrollTo({ top: 0, behavior: 'smooth' }); });
  nextBtn?.addEventListener('click', () => { currentPage++; renderPage(); window.scrollTo({ top: 0, behavior: 'smooth' }); });

  viewGridBtn?.addEventListener('click', () => {
    viewMode = 'grid';
    viewGridBtn.className = 'px-3 py-2 text-primary bg-primary/10';
    viewListBtn.className = 'px-3 py-2 text-on-surface-variant hover:text-primary transition-colors';
    renderPage();
  });

  viewListBtn?.addEventListener('click', () => {
    viewMode = 'list';
    viewListBtn.className = 'px-3 py-2 text-primary bg-primary/10';
    viewGridBtn.className = 'px-3 py-2 text-on-surface-variant hover:text-primary transition-colors';
    renderPage();
  });

  // ===== PRODUCT DETAIL MODAL =====
  let currentDetailId = '';
  const detailModal = document.getElementById('detail-modal')!;

  function openDetail(productId: string) {
    const p = fullInventory.find(i => i.id === productId);
    if (!p) return;
    currentDetailId = productId;

    // Image
    const img = document.getElementById('detail-img') as HTMLImageElement;
    const placeholder = document.getElementById('detail-img-placeholder')!;
    const imgSrc = sanitizeUrl(p.image_url);
    if (imgSrc) {
      img.src = imgSrc;
      img.alt = p.name;
      img.classList.remove('hidden');
      placeholder.classList.add('hidden');
      placeholder.style.display = 'none';
    } else {
      img.classList.add('hidden');
      placeholder.classList.remove('hidden');
      placeholder.style.display = 'flex';
    }

    // Badge
    const badge = document.getElementById('detail-badge')!;
    const brandColor = p.brand === 'Avon' ? 'bg-fuchsia-100 text-fuchsia-700' : p.brand === 'Casa & Estilo' ? 'bg-cyan-100 text-cyan-700' : 'bg-primary/10 text-primary backdrop-blur-sm';
    badge.className = `absolute top-3 left-3 px-3 py-1 rounded-full text-xs font-bold ${brandColor}`;
    badge.textContent = p.brand || 'Natura';

    // Text
    document.getElementById('detail-name')!.textContent = p.name;
    document.getElementById('detail-code')!.textContent = `Código: ${p.code}`;
    document.getElementById('detail-category')!.textContent = p.category || '—';

    // Prices
    document.getElementById('detail-cost')!.textContent = `$${(p.cost || 0).toFixed(0)}`;
    document.getElementById('detail-price')!.textContent = `$${(p.price || 0).toFixed(0)}`;

    const margin = p.price && p.cost ? ((p.price - p.cost) / p.price * 100) : 0;
    const marginEl = document.getElementById('detail-margin')!;
    marginEl.textContent = `${margin.toFixed(0)}%`;
    const marginCard = document.getElementById('detail-margin-card')!;
    if (margin >= 30) {
      marginCard.className = 'bg-green-50 rounded-xl p-3 text-center border border-green-200/30';
      marginEl.className = 'text-lg font-bold text-green-600';
    } else if (margin >= 15) {
      marginCard.className = 'bg-amber-50 rounded-xl p-3 text-center border border-amber-200/30';
      marginEl.className = 'text-lg font-bold text-amber-600';
    } else {
      marginCard.className = 'bg-red-50 rounded-xl p-3 text-center border border-red-200/30';
      marginEl.className = 'text-lg font-bold text-red-500';
    }

    // Profit
    const profit = (p.price || 0) - (p.cost || 0);
    document.getElementById('detail-profit')!.textContent = `$${profit.toFixed(0)}`;

    // Points
    const pointsRow = document.getElementById('detail-points-row')!;
    if (p.points) {
      pointsRow.classList.remove('hidden');
      document.getElementById('detail-points')!.textContent = `${p.points} puntos`;
    } else {
      pointsRow.classList.add('hidden');
    }

    // Description
    const descRow = document.getElementById('detail-desc-row')!;
    if (p.description) {
      descRow.classList.remove('hidden');
      document.getElementById('detail-desc')!.textContent = p.description;
    } else {
      descRow.classList.add('hidden');
    }

    // Stock
    document.getElementById('detail-qty')!.textContent = String(p.quantity || 0);

    // Reset to view mode
    document.getElementById('detail-view')!.classList.remove('hidden');
    document.getElementById('detail-edit')!.classList.add('hidden');

    // Show modal
    detailModal.style.display = 'flex';
    detailModal.classList.remove('hidden');
  }

  function closeDetail() {
    detailModal.style.display = 'none';
    detailModal.classList.add('hidden');
    currentDetailId = '';
  }

  document.getElementById('detail-close')!.addEventListener('click', closeDetail);
  detailModal.addEventListener('click', (e) => {
    if (e.target === detailModal) closeDetail();
  });

  // Stock controls in modal
  document.getElementById('detail-minus')!.addEventListener('click', () => {
    if (!currentDetailId) return;
    updateStock(currentDetailId, -1);
    const p = fullInventory.find(i => i.id === currentDetailId);
    if (p) document.getElementById('detail-qty')!.textContent = String(p.quantity);
  });
  document.getElementById('detail-plus')!.addEventListener('click', () => {
    if (!currentDetailId) return;
    updateStock(currentDetailId, 1);
    const p = fullInventory.find(i => i.id === currentDetailId);
    if (p) document.getElementById('detail-qty')!.textContent = String(p.quantity);
  });

  // ===== EDIT MODE =====
  document.getElementById('detail-edit-btn')!.addEventListener('click', () => {
    const p = fullInventory.find(i => i.id === currentDetailId);
    if (!p) return;

    // Populate edit form
    (document.getElementById('edit-name') as HTMLInputElement).value = p.name || '';
    (document.getElementById('edit-code') as HTMLInputElement).value = p.code || '';
    (document.getElementById('edit-brand') as HTMLInputElement).value = p.brand || '';
    (document.getElementById('edit-category') as HTMLInputElement).value = p.category || '';
    (document.getElementById('edit-cost') as HTMLInputElement).value = String(p.cost || '');
    (document.getElementById('edit-price') as HTMLInputElement).value = String(p.price || '');
    (document.getElementById('edit-points') as HTMLInputElement).value = String(p.points || '');
    (document.getElementById('edit-image') as HTMLInputElement).value = p.image_url || '';
    (document.getElementById('edit-description') as HTMLTextAreaElement).value = p.description || '';

    // Show image preview if exists
    const previewContainer = document.getElementById('edit-img-preview')!;
    const previewImg = document.getElementById('edit-img-preview-src') as HTMLImageElement;
    if (p.image_url) {
      previewImg.src = p.image_url;
      previewContainer.classList.remove('hidden');
      previewContainer.style.display = 'flex';
    } else {
      previewContainer.classList.add('hidden');
      previewContainer.style.display = 'none';
    }

    document.getElementById('edit-error')!.classList.add('hidden');

    // Toggle modes
    document.getElementById('detail-view')!.classList.add('hidden');
    document.getElementById('detail-edit')!.classList.remove('hidden');
  });

  // ===== IMAGE EDITING LOGIC =====
  const editImgPreview = document.getElementById('edit-img-preview')!;
  const editImgSrc = document.getElementById('edit-img-preview-src') as HTMLImageElement;
  const editUrlInput = document.getElementById('edit-image') as HTMLInputElement;
  const editImgDelete = document.getElementById('edit-img-delete')!;

  function setEditImage(url: string) {
    editUrlInput.value = url;
    if (url) {
      editImgSrc.src = url;
      editImgPreview.classList.remove('hidden');
      editImgPreview.style.display = 'flex';
      editUrlInput.closest('details')?.removeAttribute('open');
    } else {
      editImgSrc.src = '';
      editImgPreview.classList.add('hidden');
      editImgPreview.style.display = 'none';
      editUrlInput.closest('details')?.setAttribute('open', 'true');
    }
  }

  // URL input change
  editUrlInput.addEventListener('input', () => setEditImage(editUrlInput.value));

  // Delete image
  editImgDelete.addEventListener('click', (e) => {
    e.preventDefault();
    setEditImage('');
  });

  // File Upload
  document.getElementById('edit-img-file')?.addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;

    if (file.size > 5 * 1024 * 1024) return alert('La imagen es muy grande (máximo 5MB).');

    const reader = new FileReader();
    reader.onload = async (ev) => {
      const base64 = ev.target?.result as string;
      await uploadBase64(base64, file.name, file.type);
    };
    reader.readAsDataURL(file);
  });

  // Camera Capture
  const camArea = document.getElementById('edit-camera-area')!;
  const camVideo = document.getElementById('edit-camera-video') as HTMLVideoElement;
  let currentStream: MediaStream | null = null;

  document.getElementById('edit-img-camera')?.addEventListener('click', async (e) => {
    e.preventDefault();
    try {
      currentStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } });
      camVideo.srcObject = currentStream;
      camArea.classList.remove('hidden');
    } catch (err) {
      alert('No se pudo acceder a la cámara. Revisa los permisos.');
    }
  });

  document.getElementById('edit-camera-close')?.addEventListener('click', (e) => {
    e.preventDefault();
    currentStream?.getTracks().forEach(t => t.stop());
    camArea.classList.add('hidden');
  });

  document.getElementById('edit-camera-snap')?.addEventListener('click', async (e) => {
    e.preventDefault();
    if (!currentStream) return;
    
    const canvas = document.getElementById('edit-camera-canvas') as HTMLCanvasElement;
    canvas.width = camVideo.videoWidth;
    canvas.height = camVideo.videoHeight;
    canvas.getContext('2d')?.drawImage(camVideo, 0, 0);
    
    const base64 = canvas.toDataURL('image/jpeg', 0.8);
    currentStream.getTracks().forEach(t => t.stop());
    camArea.classList.add('hidden');
    
    await uploadBase64(base64, `cam_${Date.now()}.jpg`, 'image/jpeg');
  });

  // Upload helper
  async function uploadBase64(base64: string, fileName: string, mimeType: string) {
    const btn = document.getElementById('edit-save') as HTMLButtonElement;
    const oldText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="material-symbols-outlined text-sm animate-spin">refresh</span> Subiendo...';

    try {
      const res = await authFetch('/api/upload-product-image', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ imageBase64: base64, fileName, mimeType }),
      });
      const data = await res.json();
      if (data.url) setEditImage(data.url);
      else alert(data.error || 'Error subiendo imagen');
    } catch (err) {
      alert('Error de conexión al subir imagen');
    } finally {
      btn.disabled = false;
      btn.innerHTML = oldText;
      (document.getElementById('edit-img-file') as HTMLInputElement).value = '';
    }
  }

    // AI Studio Request
    async function processStudioImage(name: string, code: string, desc: string, currentImg: string) {
      const editAiStatus = document.getElementById('edit-ai-status')!;
      const editAiResult = document.getElementById('edit-ai-result')!;
      const editAiError = document.getElementById('edit-error')!;
      
      editAiStatus.classList.remove('hidden');
      editAiResult.classList.add('hidden');
      editAiError.classList.add('hidden');

      let originalBase64: string | null = null;
      let finalImgUrl: string | null = null;
      let aiNotes = "Edición completada.";

      try {
        if (currentImg && currentImg.startsWith('data:image')) {
          originalBase64 = currentImg;
        }

        // 30s timeout for enhance
        const enhanceController = new AbortController();
        const enhanceTimeout = setTimeout(() => enhanceController.abort(), 30000);

        const res = await authFetch('/api/enhance-product-image', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ productName: name, productCode: code, productDesc: desc, imageBase64: originalBase64, imageUrl: originalBase64 ? null : currentImg }),
          signal: enhanceController.signal,
        });
        clearTimeout(enhanceTimeout);
        const data = await res.json();

        editAiStatus.classList.add('hidden');

        if (data.error) throw new Error(data.error);

        if (data.suggested_image_url || data.image_base64) {
          finalImgUrl = data.suggested_image_url || null;
          aiNotes = data.notes || "Imagen mejorada con IA.";
          const strategy = data.strategy === 'imagen_bkg_removal' ? '🎯 Fondo removido' :
                           data.strategy === 'gemini_image_gen' ? '✨ Generada por IA' :
                           data.strategy === 'text_catalog_search' ? '📂 Catálogo oficial' : 'IA';
          
          (window as any).editAiFoundUrl = finalImgUrl;
          // Show base64 preview for instant feedback, or URL
          const previewSrc = data.image_base64 || finalImgUrl || '';
          (document.getElementById('edit-ai-img') as HTMLImageElement).src = previewSrc;
          document.getElementById('edit-ai-name')!.textContent = data.identified_name || name || "Producto AI";
          
          const confText = data.confidence === 'high' ? 'Alta confianza' : data.confidence === 'medium' ? 'Confianza media' : 'Baja confianza';
          document.getElementById('edit-ai-conf')!.textContent = `${strategy} • ${confText} • ${aiNotes}`;
          
          editAiResult.classList.remove('hidden');
        } else {
          editAiError.textContent = "La IA no pudo procesar la imagen. Intenta con otra foto o agrega más datos del producto.";
          editAiError.classList.remove('hidden');
        }
      } catch (err: any) {
        editAiStatus.classList.add('hidden');
        if (err.name === 'AbortError') {
          editAiError.textContent = 'La solicitud tardó demasiado (30s). Intenta de nuevo.';
        } else {
          editAiError.textContent = 'Error conectando con IA Studio: ' + (err.message || err);
        }
        editAiError.classList.remove('hidden');
      }
    }

  document.getElementById('edit-img-ai')?.addEventListener('click', async (e) => {
    e.preventDefault();
    const name = (document.getElementById('edit-name') as HTMLInputElement).value;
    const code = (document.getElementById('edit-code') as HTMLInputElement).value;
    const desc = (document.getElementById('edit-description') as HTMLTextAreaElement).value;
    const currentImg = (document.getElementById('edit-img-preview-src') as HTMLImageElement).src;

    if (!name && !code && !desc && !currentImg) {
      const err = document.getElementById('edit-error')!;
      err.textContent = 'Necesitas un nombre, código, descripción o foto original para procesar.';
      err.classList.remove('hidden');
      return;
    }
    await processStudioImage(name, code, desc, currentImg);
  });

  document.getElementById('edit-ai-apply')?.addEventListener('click', (e) => {
    e.preventDefault();
    const foundUrl = (window as any).editAiFoundUrl;
    if (foundUrl) {
      setEditImage(foundUrl);
    }
    document.getElementById('edit-ai-result')!.classList.add('hidden');
  });

  // ═══════════ FONDO BLANCO — Canvas crop + AI enhance ═══════════
  document.getElementById('edit-img-whitebg')?.addEventListener('click', async (e) => {
    e.preventDefault();
    const imgEl = document.getElementById('edit-img-preview-src') as HTMLImageElement;
    const preview = document.getElementById('edit-img-preview') as HTMLDivElement;

    if (!imgEl.src || imgEl.src === window.location.href) {
      const err = document.getElementById('edit-error')!;
      err.textContent = 'Primero necesitas tener una imagen del producto para limpiar.';
      err.classList.remove('hidden');
      return;
    }

    const editAiStatus = document.getElementById('edit-ai-status')!;
    const editAiText = document.getElementById('edit-ai-text')!;
    editAiText.textContent = 'Paso 1/2: Recortando bordes oscuros...';
    editAiStatus.classList.remove('hidden');

    try {
      // STEP 1: Canvas — detect and crop black bars
      const img = new Image();
      img.crossOrigin = 'anonymous';
      
      const croppedBase64: string = await new Promise((resolve, reject) => {
        img.onload = () => {
          const canvas = document.createElement('canvas');
          const ctx = canvas.getContext('2d')!;
          canvas.width = img.naturalWidth;
          canvas.height = img.naturalHeight;
          ctx.drawImage(img, 0, 0);

          const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
          const data = imageData.data;
          const w = canvas.width;
          const h = canvas.height;

          const threshold = 35;
          const isDark = (x: number, y: number) => {
            const i = (y * w + x) * 4;
            return data[i] < threshold && data[i + 1] < threshold && data[i + 2] < threshold;
          };

          let left = 0;
          for (let x = 0; x < w * 0.4; x++) {
            let darkCount = 0;
            for (let y = 0; y < h; y += 3) { if (isDark(x, y)) darkCount++; }
            if (darkCount > h / 3 / 2) left = x + 1; else break;
          }
          let right = w;
          for (let x = w - 1; x > w * 0.6; x--) {
            let darkCount = 0;
            for (let y = 0; y < h; y += 3) { if (isDark(x, y)) darkCount++; }
            if (darkCount > h / 3 / 2) right = x; else break;
          }
          let top = 0;
          for (let y = 0; y < h * 0.4; y++) {
            let darkCount = 0;
            for (let x = 0; x < w; x += 3) { if (isDark(x, y)) darkCount++; }
            if (darkCount > w / 3 / 2) top = y + 1; else break;
          }
          let bottom = h;
          for (let y = h - 1; y > h * 0.6; y--) {
            let darkCount = 0;
            for (let x = 0; x < w; x += 3) { if (isDark(x, y)) darkCount++; }
            if (darkCount > w / 3 / 2) bottom = y; else break;
          }

          const cropW = right - left;
          const cropH = bottom - top;

          // Crop to content area (even if no bars detected, just use the full image)
          const out = document.createElement('canvas');
          if (cropW > 50 && cropH > 50 && !(left === 0 && right === w && top === 0 && bottom === h)) {
            out.width = cropW;
            out.height = cropH;
            const outCtx = out.getContext('2d')!;
            outCtx.fillStyle = '#FFFFFF';
            outCtx.fillRect(0, 0, out.width, out.height);
            outCtx.drawImage(img, left, top, cropW, cropH, 0, 0, cropW, cropH);
          } else {
            out.width = w;
            out.height = h;
            const outCtx = out.getContext('2d')!;
            outCtx.drawImage(img, 0, 0);
          }

          resolve(out.toDataURL('image/jpeg', 0.95));
        };
        img.onerror = () => reject(new Error('No se pudo cargar la imagen'));
        img.src = imgEl.src;
      });

      // STEP 2: Send cropped (clean) image to Gemini for professional enhancement
      editAiText.textContent = 'Paso 2/2: Generando foto profesional con IA...';

      const productName = (document.getElementById('edit-name') as HTMLInputElement).value;
      const controller = new AbortController();
      const timeout = setTimeout(() => controller.abort(), 30000);

      const res = await authFetch('/api/gemini-generate-image', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          imageBase64: croppedBase64,
          mimeType: 'image/jpeg',
          productName: productName || undefined,
        }),
        signal: controller.signal,
      });
      clearTimeout(timeout);
      const result = await res.json();

      editAiStatus.classList.add('hidden');

      if (result.imageUrl) {
        // AI generated + uploaded — use the URL
        setEditImage(result.imageUrl);
      } else if (result.imageBase64) {
        // AI generated but upload failed — show base64 preview
        imgEl.src = result.imageBase64;
        preview.classList.remove('hidden');
        preview.style.display = 'flex';
      } else {
        // AI failed — fall back to the canvas-cropped version, upload it
        const fileName = `whitebg_${Date.now()}.jpg`;
        const uploadRes = await authFetch('/api/upload-product-image', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ imageBase64: croppedBase64, fileName, mimeType: 'image/jpeg' }),
        });
        const uploadData = await uploadRes.json();
        if (uploadData.url) {
          setEditImage(uploadData.url);
        } else {
          imgEl.src = croppedBase64;
          preview.classList.remove('hidden');
          preview.style.display = 'flex';
        }
      }
    } catch (err: any) {
      editAiStatus.classList.add('hidden');
      const errDiv = document.getElementById('edit-error')!;
      if (err.name === 'AbortError') {
        errDiv.textContent = 'La generación tardó demasiado (30s). Intenta de nuevo.';
      } else {
        errDiv.textContent = 'Error procesando imagen: ' + (err.message || err);
      }
      errDiv.classList.remove('hidden');
    }
  });

  document.getElementById('edit-cancel')!.addEventListener('click', () => {
    document.getElementById('detail-view')!.classList.remove('hidden');
    document.getElementById('detail-edit')!.classList.add('hidden');
  });

  document.getElementById('edit-save')!.addEventListener('click', async () => {
    if (!currentDetailId) return;
    const errEl = document.getElementById('edit-error')!;
    errEl.classList.add('hidden');

    const name = (document.getElementById('edit-name') as HTMLInputElement).value.trim();
    const code = (document.getElementById('edit-code') as HTMLInputElement).value.trim();
    const brand = (document.getElementById('edit-brand') as HTMLInputElement).value.trim();
    const category = (document.getElementById('edit-category') as HTMLInputElement).value.trim();
    const cost = parseFloat((document.getElementById('edit-cost') as HTMLInputElement).value) || 0;
    const price = parseFloat((document.getElementById('edit-price') as HTMLInputElement).value) || 0;
    const points = parseInt((document.getElementById('edit-points') as HTMLInputElement).value) || 0;
    const image_url = (document.getElementById('edit-image') as HTMLInputElement).value.trim();
    const description = (document.getElementById('edit-description') as HTMLTextAreaElement).value.trim();

    if (!name || !code) {
      errEl.textContent = 'Nombre y código son requeridos.';
      errEl.classList.remove('hidden');
      return;
    }

    const btn = document.getElementById('edit-save') as HTMLButtonElement;
    btn.disabled = true;
    btn.innerHTML = '<span class="material-symbols-outlined text-sm animate-spin">refresh</span> Guardando...';

    try {
      await api.products.update(currentDetailId, { name, code, brand, category, cost, price, points, image_url, description });

      // Update local data
      const p = fullInventory.find(i => i.id === currentDetailId);
      if (p) {
        p.name = name; p.code = code; p.brand = brand; p.category = category;
        p.cost = cost; p.price = price; p.points = points;
        p.image_url = image_url; p.description = description;
      }

      // Refresh views
      renderPage();
      openDetail(currentDetailId); // reopen in view mode with updated data

      btn.disabled = false;
      btn.innerHTML = '<span class="material-symbols-outlined text-sm">save</span> Guardar';
    } catch(e: any) {
      btn.disabled = false;
      btn.innerHTML = '<span class="material-symbols-outlined text-sm">save</span> Guardar';
      errEl.textContent = 'Error: ' + (e.message || 'No se pudo guardar');
      errEl.classList.remove('hidden');
    }
  });
</script>
