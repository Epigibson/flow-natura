---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import CardGridSkeleton from '../components/skeletons/CardGridSkeleton.astro';
---

<DashboardLayout>
      <header class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-10">
        <div>
          <h2 class="text-3xl md:text-5xl font-display font-bold text-on-surface">Tu Inventario 📦</h2>
          <p class="text-on-surface-variant mt-2 text-base md:text-lg">Controla tus productos de pronta entrega y catálogo.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <a href="/inventario/escanear" class="flex items-center gap-2 py-2.5 px-4 rounded-xl font-bold bg-secondary text-white shadow-md shadow-secondary/20 hover:scale-[1.02] transition-all text-sm">
            <span class="material-symbols-outlined text-lg">qr_code_scanner</span>
            Escanear
          </a>
          <a href="/inventario/nuevo" class="btn-secondary flex items-center gap-2 py-2.5 px-4 rounded-xl font-bold border-2 border-primary/20 hover:bg-primary/5 text-primary transition-colors text-sm">
            <span class="material-symbols-outlined text-lg">add_circle</span>
            Crear
          </a>
          <a href="/inventario/alta" class="btn-primary flex items-center gap-2 py-2.5 px-4 rounded-xl font-bold shadow-lg shadow-primary/20 hover:scale-[1.02] bg-primary text-white transition-all text-sm">
            <span class="material-symbols-outlined text-lg">inventory</span>
            Alta
          </a>
        </div>
      </header>

      <!-- Stats Row -->
      <div id="stats-row" class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        <div class="bg-surface-container-lowest rounded-2xl p-4 flex items-center gap-3 shadow-sm border border-outline-variant/5">
          <div class="w-11 h-11 rounded-xl bg-primary/10 flex items-center justify-center">
            <span class="material-symbols-outlined text-primary">inventory_2</span>
          </div>
          <div>
            <p id="stat-total" class="text-2xl font-display font-bold text-on-surface">—</p>
            <p class="text-xs text-on-surface-variant font-medium">Total productos</p>
          </div>
        </div>
        <div class="bg-surface-container-lowest rounded-2xl p-4 flex items-center gap-3 shadow-sm border border-outline-variant/5">
          <div class="w-11 h-11 rounded-xl bg-secondary/10 flex items-center justify-center">
            <span class="material-symbols-outlined text-secondary">local_offer</span>
          </div>
          <div>
            <p id="stat-brands" class="text-2xl font-display font-bold text-on-surface">—</p>
            <p class="text-xs text-on-surface-variant font-medium">Marcas</p>
          </div>
        </div>
        <div class="bg-surface-container-lowest rounded-2xl p-4 flex items-center gap-3 shadow-sm border border-outline-variant/5">
          <div class="w-11 h-11 rounded-xl bg-tertiary/10 flex items-center justify-center">
            <span class="material-symbols-outlined text-tertiary">category</span>
          </div>
          <div>
            <p id="stat-categories" class="text-2xl font-display font-bold text-on-surface">—</p>
            <p class="text-xs text-on-surface-variant font-medium">Categorías</p>
          </div>
        </div>
        <div class="bg-surface-container-lowest rounded-2xl p-4 flex items-center gap-3 shadow-sm border border-outline-variant/5">
          <div class="w-11 h-11 rounded-xl bg-primary/10 flex items-center justify-center">
            <span class="material-symbols-outlined text-primary">check_circle</span>
          </div>
          <div>
            <p id="stat-instock" class="text-2xl font-display font-bold text-on-surface">—</p>
            <p class="text-xs text-on-surface-variant font-medium">En stock</p>
          </div>
        </div>
      </div>

      <!-- Search and Filter Bar -->
      <div class="flex flex-wrap gap-3 mb-8">
        <div class="flex-1 min-w-[200px] relative">
          <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant">search</span>
          <input type="text" id="search-input" placeholder="Buscar por nombre, código o marca..." class="w-full bg-surface-container-highest border-none rounded-xl py-3 pl-10 pr-4 focus:ring-2 focus:ring-primary-container" />
        </div>
        <select id="filter-brand" class="bg-surface-container-highest border-none rounded-xl py-3 px-4 w-40 text-sm focus:ring-2 focus:ring-primary-container">
          <option value="all">Todas las marcas</option>
        </select>
        <select id="filter-category" class="bg-surface-container-highest border-none rounded-xl py-3 px-4 w-48 text-sm focus:ring-2 focus:ring-primary-container">
          <option value="all">Todas las categorías</option>
        </select>
        <!-- View Toggle -->
        <div class="flex bg-surface-container-highest rounded-xl overflow-hidden">
          <button id="view-grid" class="px-3 py-2 text-primary bg-primary/10" title="Vista cuadrícula">
            <span class="material-symbols-outlined text-lg">grid_view</span>
          </button>
          <button id="view-list" class="px-3 py-2 text-on-surface-variant hover:text-primary transition-colors" title="Vista lista">
            <span class="material-symbols-outlined text-lg">view_list</span>
          </button>
        </div>
      </div>

      <!-- Skeleton for products grid -->
      <div id="inventory-skeleton">
        <CardGridSkeleton count={8} />
      </div>

      <!-- Products Grid (hidden until loaded) -->
      <section id="products-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5 hidden">
        <div class="col-span-full text-center py-12 text-on-surface-variant hidden" id="empty-state">
          <span class="material-symbols-outlined text-5xl mb-4 text-primary/30">inventory_2</span>
          <p class="text-lg font-bold">No tienes productos en tu inventario aún.</p>
          <p class="text-sm mt-2">Ve a <a href="/inventario/importar" class="text-primary font-bold underline">Importar Natura</a> para cargar tu catálogo.</p>
        </div>
      </section>

      <!-- List View (hidden by default) -->
      <section id="list-container" class="hidden">
        <div class="bg-surface-container-lowest rounded-2xl shadow-sm border border-outline-variant/5 overflow-hidden">
          <table class="w-full text-left text-sm">
            <thead class="sticky top-0 bg-surface-container-high z-10">
              <tr class="text-xs uppercase tracking-wider text-on-surface-variant border-b border-outline-variant/10">
                <th class="px-4 py-3 w-14"></th>
                <th class="px-4 py-3">Producto</th>
                <th class="px-4 py-3">Marca</th>
                <th class="px-4 py-3">Categoría</th>
                <th class="px-4 py-3 text-right">Costo</th>
                <th class="px-4 py-3 text-right">Precio</th>
                <th class="px-4 py-3 text-right">Margen</th>
                <th class="px-4 py-3 text-center">Pts</th>
                <th class="px-4 py-3 text-center">Stock</th>
              </tr>
            </thead>
            <tbody id="list-tbody" class="divide-y divide-outline-variant/5"></tbody>
          </table>
        </div>
      </section>

      <!-- Pagination -->
      <div id="pagination" class="flex justify-center items-center gap-3 mt-8 hidden">
        <button id="prev-page" class="px-4 py-2 rounded-xl bg-surface-container-highest text-on-surface-variant hover:bg-primary/10 hover:text-primary transition-colors font-bold text-sm disabled:opacity-30" disabled>
          <span class="material-symbols-outlined text-sm">chevron_left</span> Anterior
        </button>
        <span id="page-info" class="text-sm text-on-surface-variant font-medium"></span>
        <button id="next-page" class="px-4 py-2 rounded-xl bg-surface-container-highest text-on-surface-variant hover:bg-primary/10 hover:text-primary transition-colors font-bold text-sm disabled:opacity-30" disabled>
          Siguiente <span class="material-symbols-outlined text-sm">chevron_right</span>
        </button>
      </div>

  <!-- Product Detail Modal -->
  <div id="detail-modal" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 hidden items-center justify-center p-4" style="display:none;">
    <div class="bg-surface-container-lowest rounded-[2rem] max-w-lg w-full max-h-[90vh] overflow-hidden flex flex-col shadow-2xl border border-surface-container/30 animate-[slideUp_0.3s_ease-out]">

      <!-- Image Header -->
      <div class="relative shrink-0">
        <div id="detail-img-container" class="w-full h-52 bg-white flex items-center justify-center overflow-hidden">
          <img id="detail-img" src="" alt="" class="max-h-full max-w-full object-contain" />
          <div id="detail-img-placeholder" class="hidden flex-col items-center justify-center text-on-surface-variant/30">
            <span class="material-symbols-outlined text-6xl">spa</span>
          </div>
        </div>
        <button id="detail-close" class="absolute top-3 right-3 w-10 h-10 rounded-full bg-black/30 backdrop-blur-sm text-white flex items-center justify-center hover:bg-black/50 transition-all">
          <span class="material-symbols-outlined">close</span>
        </button>
        <div id="detail-badge" class="absolute top-3 left-3 px-3 py-1 rounded-full text-xs font-bold"></div>
        <button id="detail-edit-btn" class="absolute bottom-3 right-3 flex items-center gap-1 px-3 py-1.5 rounded-full bg-white/90 backdrop-blur-sm text-xs font-bold text-on-surface shadow-md hover:bg-white transition-all">
          <span class="material-symbols-outlined text-sm">edit</span> Editar
        </button>
      </div>

      <!-- VIEW MODE -->
      <div id="detail-view" class="p-6 overflow-y-auto flex-1">
        <h3 id="detail-name" class="text-xl font-display font-bold text-on-surface leading-tight mb-1"></h3>
        <p id="detail-code" class="text-xs font-mono text-on-surface-variant mb-0.5"></p>
        <p id="detail-category" class="text-xs text-on-surface-variant mb-4"></p>

        <div id="detail-desc-row" class="mb-5 hidden">
          <p class="text-[9px] uppercase font-bold tracking-wider text-on-surface-variant mb-1">Descripcion</p>
          <p id="detail-desc" class="text-sm text-on-surface leading-relaxed bg-surface-container-highest/30 rounded-xl p-3"></p>
        </div>

        <div class="grid grid-cols-3 gap-3 mb-4">
          <div class="bg-surface-container-highest/50 rounded-xl p-3 text-center">
            <p class="text-[9px] uppercase font-bold tracking-wider text-on-surface-variant mb-1">Costo</p>
            <p id="detail-cost" class="text-lg font-bold text-on-surface"></p>
          </div>
          <div class="bg-primary/5 rounded-xl p-3 text-center border border-primary/10">
            <p class="text-[9px] uppercase font-bold tracking-wider text-primary mb-1">Precio</p>
            <p id="detail-price" class="text-lg font-bold text-primary"></p>
          </div>
          <div class="rounded-xl p-3 text-center" id="detail-margin-card">
            <p class="text-[9px] uppercase font-bold tracking-wider mb-1">Margen</p>
            <p id="detail-margin" class="text-lg font-bold"></p>
          </div>
        </div>

        <div class="bg-gradient-to-r from-green-50 to-emerald-50 dark:from-green-900/10 dark:to-emerald-900/10 rounded-xl p-4 mb-4 border border-green-200/30">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-green-600">trending_up</span>
              <span class="text-xs font-bold text-green-700">Ganancia por unidad</span>
            </div>
            <span id="detail-profit" class="text-lg font-bold text-green-700"></span>
          </div>
        </div>

        <div id="detail-points-row" class="flex items-center gap-2 mb-4">
          <span class="material-symbols-outlined text-amber-500">stars</span>
          <span id="detail-points" class="text-sm font-bold text-amber-600"></span>
        </div>

        <div class="bg-surface-container-highest/40 rounded-xl p-4">
          <p class="text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-3">Stock actual</p>
          <div class="flex items-center justify-center gap-4">
            <button id="detail-minus" class="w-12 h-12 rounded-xl bg-surface-container-lowest border border-outline-variant/10 flex items-center justify-center text-on-surface-variant hover:bg-error/10 hover:text-error hover:border-error/20 transition-all shadow-sm">
              <span class="material-symbols-outlined">remove</span>
            </button>
            <span id="detail-qty" class="text-4xl font-display font-bold text-on-surface min-w-[3rem] text-center"></span>
            <button id="detail-plus" class="w-12 h-12 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary hover:bg-primary/20 transition-all shadow-sm">
              <span class="material-symbols-outlined">add</span>
            </button>
          </div>
        </div>
      </div>

      <!-- EDIT MODE -->
      <div id="detail-edit" class="p-6 overflow-y-auto flex-1 hidden">
        <h4 class="font-display font-bold text-lg text-on-surface mb-4 flex items-center gap-2">
          <span class="material-symbols-outlined text-primary">edit_note</span> Editar Producto
        </h4>
        <div class="space-y-3">
          <div>
            <label class="text-[10px] font-bold text-on-surface-variant uppercase tracking-wider">Nombre</label>
            <input id="edit-name" type="text" class="w-full bg-surface-container-highest rounded-xl py-2.5 px-3 text-sm focus:ring-2 focus:ring-primary-container mt-1" />
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="text-[10px] font-bold text-on-surface-variant uppercase tracking-wider">Codigo</label>
              <input id="edit-code" type="text" class="w-full bg-surface-container-highest rounded-xl py-2.5 px-3 text-sm focus:ring-2 focus:ring-primary-container mt-1" />
            </div>
            <div>
              <label class="text-[10px] font-bold text-on-surface-variant uppercase tracking-wider">Marca</label>
              <input id="edit-brand" type="text" class="w-full bg-surface-container-highest rounded-xl py-2.5 px-3 text-sm focus:ring-2 focus:ring-primary-container mt-1" />
            </div>
          </div>
          <div>
            <label class="text-[10px] font-bold text-on-surface-variant uppercase tracking-wider">Categoria</label>
            <input id="edit-category" type="text" class="w-full bg-surface-container-highest rounded-xl py-2.5 px-3 text-sm focus:ring-2 focus:ring-primary-container mt-1" />
          </div>
          <div class="grid grid-cols-3 gap-3">
            <div>
              <label class="text-[10px] font-bold text-on-surface-variant uppercase tracking-wider">Costo</label>
              <input id="edit-cost" type="number" step="0.01" class="w-full bg-surface-container-highest rounded-xl py-2.5 px-3 text-sm focus:ring-2 focus:ring-primary-container mt-1" />
            </div>
            <div>
              <label class="text-[10px] font-bold text-on-surface-variant uppercase tracking-wider">Precio</label>
              <input id="edit-price" type="number" step="0.01" class="w-full bg-surface-container-highest rounded-xl py-2.5 px-3 text-sm focus:ring-2 focus:ring-primary-container mt-1" />
            </div>
            <div>
              <label class="text-[10px] font-bold text-on-surface-variant uppercase tracking-wider">Puntos</label>
              <input id="edit-points" type="number" class="w-full bg-surface-container-highest rounded-xl py-2.5 px-3 text-sm focus:ring-2 focus:ring-primary-container mt-1" />
            </div>
          </div>
          <div>
            <label class="text-[10px] font-bold text-on-surface-variant uppercase tracking-wider mb-2 block">Imagen del producto</label>
            <!-- Current image preview -->
            <div id="edit-img-preview" class="relative mb-3 h-32 bg-white rounded-xl hidden items-center justify-center overflow-hidden border border-outline-variant/10 group">
              <img id="edit-img-preview-src" src="" class="max-h-full max-w-full object-contain" />
              <button id="edit-img-delete" class="absolute top-2 right-2 w-7 h-7 rounded-full bg-red-500/80 text-white flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity hover:bg-red-600" title="Eliminar imagen">
                <span class="material-symbols-outlined text-sm">delete</span>
              </button>
            </div>
            <!-- Image actions -->
            <div class="grid grid-cols-4 gap-2 mb-2">
              <label class="flex flex-col items-center gap-1 py-2.5 px-2 rounded-xl bg-surface-container-highest hover:bg-primary/10 transition-colors cursor-pointer text-center">
                <span class="material-symbols-outlined text-lg text-primary">upload_file</span>
                <span class="text-[9px] font-bold text-on-surface-variant">Subir foto</span>
                <input id="edit-img-file" type="file" accept="image/*" class="hidden" />
              </label>
              <button id="edit-img-camera" class="flex flex-col items-center gap-1 py-2.5 px-2 rounded-xl bg-surface-container-highest hover:bg-primary/10 transition-colors text-center">
                <span class="material-symbols-outlined text-lg text-primary">photo_camera</span>
                <span class="text-[9px] font-bold text-on-surface-variant">Camara</span>
              </button>
              <button id="edit-img-whitebg" class="flex flex-col items-center gap-1 py-2.5 px-2 rounded-xl bg-gradient-to-br from-amber-50 to-yellow-50 border border-amber-200/30 hover:from-amber-100 hover:to-yellow-100 transition-colors text-center">
                <span class="material-symbols-outlined text-lg text-amber-600">crop</span>
                <span class="text-[9px] font-bold text-amber-700">Fondo Blanco</span>
              </button>
              <button id="edit-img-ai" class="flex flex-col items-center gap-1 py-2.5 px-2 rounded-xl bg-gradient-to-br from-purple-50 to-indigo-50 border border-purple-200/30 hover:from-purple-100 hover:to-indigo-100 transition-colors text-center">
                <span class="material-symbols-outlined text-lg text-purple-600">auto_awesome</span>
                <span class="text-[9px] font-bold text-purple-700">IA Studio</span>
              </button>
            </div>
            <!-- AI status -->
            <div id="edit-ai-status" class="hidden mb-2 p-3 rounded-xl bg-purple-50 border border-purple-200/30">
              <div class="flex items-center gap-2 text-sm text-purple-700">
                <span class="material-symbols-outlined text-sm animate-spin">progress_activity</span>
                <span id="edit-ai-text" class="font-bold text-xs">Buscando imagen de estudio con IA...</span>
              </div>
            </div>
            <!-- AI result -->
            <div id="edit-ai-result" class="hidden mb-2 p-3 rounded-xl bg-green-50 border border-green-200/30">
              <p class="text-xs font-bold text-green-700 mb-2 flex items-center gap-1">
                <span class="material-symbols-outlined text-sm">check_circle</span> Imagen encontrada
              </p>
              <div class="flex gap-3 items-center">
                <img id="edit-ai-img" src="" class="w-16 h-16 object-contain bg-white rounded-lg border" />
                <div class="flex-1">
                  <p id="edit-ai-name" class="text-[10px] text-on-surface font-bold truncate"></p>
                  <p id="edit-ai-conf" class="text-[9px] text-on-surface-variant"></p>
                  <button id="edit-ai-apply" class="mt-1 text-[10px] font-bold text-white bg-green-600 px-3 py-1 rounded-full hover:bg-green-700 transition-colors">
                    Usar esta imagen
                  </button>
                </div>
              </div>
            </div>
            <!-- Camera capture area -->
            <div id="edit-camera-area" class="hidden mb-2 rounded-xl overflow-hidden border border-outline-variant/10 bg-black">
              <video id="edit-camera-video" autoplay playsinline class="w-full h-40 object-cover"></video>
              <div class="flex gap-2 p-2 bg-surface-container-highest justify-center">
                <button id="edit-camera-snap" class="px-4 py-1.5 rounded-full bg-primary text-white text-xs font-bold">Capturar</button>
                <button id="edit-camera-close" class="px-4 py-1.5 rounded-full bg-surface-container-lowest text-on-surface-variant text-xs font-bold">Cancelar</button>
              </div>
              <canvas id="edit-camera-canvas" class="hidden"></canvas>
            </div>
            <!-- URL fallback -->
            <details class="text-xs">
              <summary class="text-on-surface-variant cursor-pointer hover:text-primary transition-colors font-medium">Ingresar URL manualmente</summary>
              <input id="edit-image" type="url" placeholder="https://..." class="w-full bg-surface-container-highest rounded-xl py-2 px-3 text-sm focus:ring-2 focus:ring-primary-container mt-2" />
            </details>
          </div>
          <div>
            <label class="text-[10px] font-bold text-on-surface-variant uppercase tracking-wider">Descripcion</label>
            <textarea id="edit-description" rows="3" class="w-full bg-surface-container-highest rounded-xl py-2.5 px-3 text-sm focus:ring-2 focus:ring-primary-container resize-none mt-1"></textarea>
          </div>
          <div id="edit-error" class="text-sm text-red-500 font-bold hidden"></div>
          <div class="flex gap-3 pt-2">
            <button id="edit-cancel" class="flex-1 py-3 rounded-xl font-bold border-2 border-outline-variant/20 text-on-surface-variant hover:bg-surface-container-highest transition-colors text-sm">Cancelar</button>
            <button id="edit-save" class="flex-1 py-3 rounded-xl font-bold bg-primary text-white shadow-lg shadow-primary/20 hover:scale-[1.02] transition-all text-sm flex items-center justify-center gap-2">
              <span class="material-symbols-outlined text-sm">save</span> Guardar
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

</DashboardLayout>

<style>
  @keyframes slideUp {
    from { opacity: 0; transform: translateY(20px) scale(0.97); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
</style>

<script>
  import { supabase } from '../lib/supabase';
  import { authFetch } from '../lib/auth-fetch';
  import api from '../lib/api';
  import { esc, sanitizeUrl } from '../lib/security';

  const container = document.getElementById('products-container') as HTMLElement;
  const listContainer = document.getElementById('list-container') as HTMLElement;
  const listTbody = document.getElementById('list-tbody') as HTMLElement;
  const emptyState = document.getElementById('empty-state') as HTMLElement;
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const filterBrand = document.getElementById('filter-brand') as HTMLSelectElement;
  const filterCategory = document.getElementById('filter-category') as HTMLSelectElement;
  const pagination = document.getElementById('pagination') as HTMLElement;
  const prevBtn = document.getElementById('prev-page') as HTMLButtonElement;
  const nextBtn = document.getElementById('next-page') as HTMLButtonElement;
  const pageInfo = document.getElementById('page-info') as HTMLElement;
  const viewGridBtn = document.getElementById('view-grid') as HTMLButtonElement;
  const viewListBtn = document.getElementById('view-list') as HTMLButtonElement;

  let currentUser = '';
  let fullInventory: any[] = [];
  let filteredInventory: any[] = [];
  let currentPage = 1;
  let viewMode: 'grid' | 'list' = 'grid';
  const PAGE_SIZE = 48;

  // Protect route & Load data
  supabase.auth.getSession().then(({ data: { session } }: any) => {
    if (!session) {
      window.location.href = '/login';
    } else {
      currentUser = session.user.id;
      loadProducts(currentUser);
    }
  });

  // Load Products using API
  async function loadProducts(consultantId: string) {
    try {
      // Fetch user's inventory — already includes product details
      const myInv = await api.inventory.list({ limit: 5000 });

      if (!myInv || myInv.length === 0) {
        emptyState.classList.remove('hidden');
        return;
      }

      emptyState.classList.add('hidden');

      // Swap skeleton → real content
      document.getElementById('inventory-skeleton')?.classList.add('hidden');
      container.classList.remove('hidden');
      container.classList.add('content-loaded');

      // Map inventory items to expected format
      fullInventory = myInv.map((item: any) => ({
        id: item.product_id,
        inv_id: item.product_id,
        name: item.product_name,
        code: item.product_code,
        category: item.category,
        brand: item.brand,
        price: parseFloat(item.price) || 0,
        cost: parseFloat(item.cost) || 0,
        quantity: item.quantity || 0,
        image_url: item.image_url,
        description: item.description || '',
        points: item.points || 0,
      }));

    // Populate filters dynamically
    populateFilters();
    updateStats(fullInventory);
    applyFilters();
    } catch(e) { console.error('Error loading products', e); emptyState.classList.remove('hidden'); }
  }

  function populateFilters() {
    const brands = [...new Set(fullInventory.map(p => p.brand).filter(Boolean))].sort();
    const categories = [...new Set(fullInventory.map(p => p.category).filter(Boolean))].sort();

    brands.forEach(b => {
      const opt = document.createElement('option');
      opt.value = b; opt.textContent = b;
      filterBrand.appendChild(opt);
    });

    categories.forEach(c => {
      const opt = document.createElement('option');
      opt.value = c; opt.textContent = c;
      filterCategory.appendChild(opt);
    });
  }

  function updateStats(items: any[]) {
    const el = (id: string) => document.getElementById(id) as HTMLElement;
    el('stat-total').textContent = items.length.toLocaleString();
    el('stat-brands').textContent = String([...new Set(items.map(p => p.brand).filter(Boolean))].length);
    el('stat-categories').textContent = String([...new Set(items.map(p => p.category).filter(Boolean))].length);
    el('stat-instock').textContent = String(items.filter(p => p.quantity > 0).length);
  }

  function applyFilters() {
    const query = searchInput.value.toLowerCase();
    const brand = filterBrand.value;
    const category = filterCategory.value;

    filteredInventory = fullInventory.filter(p => {
      const matchSearch = !query ||
        p.name?.toLowerCase().includes(query) ||
        p.code?.toLowerCase().includes(query) ||
        p.brand?.toLowerCase().includes(query);
      const matchBrand = brand === 'all' || p.brand === brand;
      const matchCategory = category === 'all' || p.category === category;
      return matchSearch && matchBrand && matchCategory;
    });

    currentPage = 1;
    renderPage();
  }

  function renderPage() {
    const totalPages = Math.ceil(filteredInventory.length / PAGE_SIZE);
    const startIdx = (currentPage - 1) * PAGE_SIZE;
    const pageItems = filteredInventory.slice(startIdx, startIdx + PAGE_SIZE);

    if (filteredInventory.length === 0) {
      emptyState.classList.remove('hidden');
    } else {
      emptyState.classList.add('hidden');
    }

    // Pagination
    if (totalPages > 1) {
      pagination.classList.remove('hidden');
      pageInfo.textContent = `${currentPage} / ${totalPages} (${filteredInventory.length} productos)`;
      prevBtn.disabled = currentPage <= 1;
      nextBtn.disabled = currentPage >= totalPages;
    } else {
      pagination.classList.add('hidden');
    }

    if (viewMode === 'grid') {
      container.classList.remove('hidden');
      listContainer.classList.add('hidden');
      renderGridView(pageItems);
    } else {
      container.classList.add('hidden');
      listContainer.classList.remove('hidden');
      renderListView(pageItems);
    }
  }

