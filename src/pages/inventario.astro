---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import CardGridSkeleton from '../components/skeletons/CardGridSkeleton.astro';
---

<DashboardLayout>
      <header class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-10">
        <div>
          <h2 class="text-3xl md:text-5xl font-display font-bold text-on-surface">Tu Inventario 📦</h2>
          <p class="text-on-surface-variant mt-2 text-base md:text-lg">Controla tus productos de pronta entrega y catálogo.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <a href="/inventario/escanear" class="flex items-center gap-2 py-2.5 px-4 rounded-xl font-bold bg-secondary text-white shadow-md shadow-secondary/20 hover:scale-[1.02] transition-all text-sm">
            <span class="material-symbols-outlined text-lg">qr_code_scanner</span>
            Escanear
          </a>
          <a href="/inventario/nuevo" class="btn-secondary flex items-center gap-2 py-2.5 px-4 rounded-xl font-bold border-2 border-primary/20 hover:bg-primary/5 text-primary transition-colors text-sm">
            <span class="material-symbols-outlined text-lg">add_circle</span>
            Crear
          </a>
          <a href="/inventario/alta" class="btn-primary flex items-center gap-2 py-2.5 px-4 rounded-xl font-bold shadow-lg shadow-primary/20 hover:scale-[1.02] bg-primary text-white transition-all text-sm">
            <span class="material-symbols-outlined text-lg">inventory</span>
            Alta
          </a>
        </div>
      </header>

      <!-- Stats Row -->
      <div id="stats-row" class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        <div class="bg-surface-container-lowest rounded-2xl p-4 flex items-center gap-3 shadow-sm border border-outline-variant/5">
          <div class="w-11 h-11 rounded-xl bg-primary/10 flex items-center justify-center">
            <span class="material-symbols-outlined text-primary">inventory_2</span>
          </div>
          <div>
            <p id="stat-total" class="text-2xl font-display font-bold text-on-surface">—</p>
            <p class="text-xs text-on-surface-variant font-medium">Total productos</p>
          </div>
        </div>
        <div class="bg-surface-container-lowest rounded-2xl p-4 flex items-center gap-3 shadow-sm border border-outline-variant/5">
          <div class="w-11 h-11 rounded-xl bg-secondary/10 flex items-center justify-center">
            <span class="material-symbols-outlined text-secondary">local_offer</span>
          </div>
          <div>
            <p id="stat-brands" class="text-2xl font-display font-bold text-on-surface">—</p>
            <p class="text-xs text-on-surface-variant font-medium">Marcas</p>
          </div>
        </div>
        <div class="bg-surface-container-lowest rounded-2xl p-4 flex items-center gap-3 shadow-sm border border-outline-variant/5">
          <div class="w-11 h-11 rounded-xl bg-tertiary/10 flex items-center justify-center">
            <span class="material-symbols-outlined text-tertiary">category</span>
          </div>
          <div>
            <p id="stat-categories" class="text-2xl font-display font-bold text-on-surface">—</p>
            <p class="text-xs text-on-surface-variant font-medium">Categorías</p>
          </div>
        </div>
        <div class="bg-surface-container-lowest rounded-2xl p-4 flex items-center gap-3 shadow-sm border border-outline-variant/5">
          <div class="w-11 h-11 rounded-xl bg-primary/10 flex items-center justify-center">
            <span class="material-symbols-outlined text-primary">check_circle</span>
          </div>
          <div>
            <p id="stat-instock" class="text-2xl font-display font-bold text-on-surface">—</p>
            <p class="text-xs text-on-surface-variant font-medium">En stock</p>
          </div>
        </div>
      </div>

      <!-- Search and Filter Bar -->
      <div class="flex flex-wrap gap-3 mb-8 items-center">
        <div class="flex-1 min-w-[200px] relative">
          <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-on-surface-variant/60 text-lg">search</span>
          <input type="text" id="search-input" placeholder="Buscar por nombre, código o marca..." class="w-full bg-surface-container-lowest border border-outline-variant/10 rounded-xl py-3 pl-11 pr-4 text-sm font-medium shadow-sm focus:ring-2 focus:ring-primary-container focus:border-primary/20 transition-all placeholder:text-on-surface-variant/40" />
        </div>

        <!-- Custom Brand Dropdown -->
        <div class="relative" id="dropdown-brand-wrapper">
          <select id="filter-brand" class="hidden"><option value="all">Todas las marcas</option></select>
          <button id="dropdown-brand-btn" type="button" class="flex items-center gap-2 bg-surface-container-lowest border border-outline-variant/10 rounded-xl py-3 pl-3.5 pr-3 text-sm font-bold text-on-surface shadow-sm cursor-pointer hover:border-primary/30 transition-all whitespace-nowrap">
            <span class="material-symbols-outlined text-on-surface-variant/60 text-base">storefront</span>
            <span id="dropdown-brand-label">Todas las marcas</span>
            <span class="material-symbols-outlined text-on-surface-variant/40 text-base transition-transform" id="dropdown-brand-arrow">expand_more</span>
          </button>
          <div id="dropdown-brand-menu" class="absolute top-full left-0 mt-1.5 min-w-full w-max bg-surface-container-lowest rounded-xl shadow-2xl border border-outline-variant/10 overflow-hidden z-50 hidden animate-[dropIn_0.15s_ease-out]">
            <div class="py-1.5 max-h-64 overflow-y-auto" id="dropdown-brand-list"></div>
          </div>
        </div>

        <!-- Custom Category Dropdown -->
        <div class="relative" id="dropdown-category-wrapper">
          <select id="filter-category" class="hidden"><option value="all">Todas las categorías</option></select>
          <button id="dropdown-category-btn" type="button" class="flex items-center gap-2 bg-surface-container-lowest border border-outline-variant/10 rounded-xl py-3 pl-3.5 pr-3 text-sm font-bold text-on-surface shadow-sm cursor-pointer hover:border-primary/30 transition-all whitespace-nowrap">
            <span class="material-symbols-outlined text-on-surface-variant/60 text-base">category</span>
            <span id="dropdown-category-label">Todas las categorías</span>
            <span class="material-symbols-outlined text-on-surface-variant/40 text-base transition-transform" id="dropdown-category-arrow">expand_more</span>
          </button>
          <div id="dropdown-category-menu" class="absolute top-full left-0 mt-1.5 min-w-full w-max bg-surface-container-lowest rounded-xl shadow-2xl border border-outline-variant/10 overflow-hidden z-50 hidden animate-[dropIn_0.15s_ease-out]">
            <div class="py-1.5 max-h-64 overflow-y-auto" id="dropdown-category-list"></div>
          </div>
        </div>

        <!-- View Toggle -->
        <div class="flex bg-surface-container-lowest rounded-xl overflow-hidden border border-outline-variant/10 shadow-sm">
          <button id="view-grid" class="px-3 py-2.5 text-primary bg-primary/10" title="Vista cuadrícula">
            <span class="material-symbols-outlined text-lg">grid_view</span>
          </button>
          <button id="view-list" class="px-3 py-2.5 text-on-surface-variant hover:text-primary hover:bg-primary/5 transition-colors" title="Vista lista">
            <span class="material-symbols-outlined text-lg">view_list</span>
          </button>
        </div>
      </div>

      <!-- Active Filters & Results Count -->
      <div id="active-filters-bar" class="hidden flex flex-wrap items-center gap-2 mb-5">
        <span id="results-count" class="text-xs font-bold text-on-surface-variant"></span>
        <div id="filter-chips" class="flex flex-wrap gap-1.5"></div>
        <button id="clear-filters" class="hidden text-[11px] font-bold text-primary hover:text-primary/80 transition-colors ml-1 flex items-center gap-0.5">
          <span class="material-symbols-outlined text-sm">close</span>
          Limpiar filtros
        </button>
      </div>

      <!-- Skeleton for products grid -->
      <div id="inventory-skeleton">
        <CardGridSkeleton count={8} />
      </div>

      <!-- Products Grid (hidden until loaded) -->
      <section id="products-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5 pb-20 hidden">
        <div class="col-span-full text-center py-12 text-on-surface-variant hidden" id="empty-state">
          <span class="material-symbols-outlined text-5xl mb-4 text-primary/30">inventory_2</span>
          <p class="text-lg font-bold">No tienes productos en tu inventario aún.</p>
          <p class="text-sm mt-2">Ve a <a href="/inventario/importar" class="text-primary font-bold underline">Importar Natura</a> para cargar tu catálogo.</p>
        </div>
      </section>

      <!-- List View (hidden by default) -->
      <section id="list-container" class="hidden pb-20">
        <div class="bg-surface-container-lowest rounded-2xl shadow-sm border border-outline-variant/5 overflow-hidden">
          <table class="w-full text-left text-sm">
            <thead class="sticky top-0 bg-surface-container-high z-10">
              <tr class="text-xs uppercase tracking-wider text-on-surface-variant border-b border-outline-variant/10">
                <th class="px-4 py-3 w-14"></th>
                <th class="px-4 py-3">Producto</th>
                <th class="px-4 py-3">Marca</th>
                <th class="px-4 py-3">Categoría</th>
                <th class="px-4 py-3 text-right">Costo</th>
                <th class="px-4 py-3 text-right">Precio</th>
                <th class="px-4 py-3 text-right">Margen</th>
                <th class="px-4 py-3 text-center">Pts</th>
                <th class="px-4 py-3 text-center">Stock</th>
              </tr>
            </thead>
            <tbody id="list-tbody" class="divide-y divide-outline-variant/5"></tbody>
          </table>
        </div>
      </section>

      <!-- Pagination — sticky floating bar -->
      <div id="pagination" class="fixed bottom-0 left-0 right-0 md:left-72 z-40 hidden">
        <div class="mx-auto max-w-xl px-4 pb-4">
          <div class="flex items-center justify-between gap-2 bg-surface-container-lowest/95 backdrop-blur-xl rounded-2xl shadow-2xl border border-outline-variant/10 px-4 py-2.5">
            <button id="prev-page" class="flex items-center gap-1 px-3 py-2 rounded-xl text-sm font-bold text-on-surface-variant hover:bg-primary/10 hover:text-primary transition-all disabled:opacity-30 disabled:pointer-events-none" disabled>
              <span class="material-symbols-outlined text-base">chevron_left</span>
              <span class="hidden sm:inline">Anterior</span>
            </button>
            <span id="page-info" class="text-xs font-bold text-on-surface-variant tabular-nums"></span>
            <button id="next-page" class="flex items-center gap-1 px-3 py-2 rounded-xl text-sm font-bold text-on-surface-variant hover:bg-primary/10 hover:text-primary transition-all disabled:opacity-30 disabled:pointer-events-none" disabled>
              <span class="hidden sm:inline">Siguiente</span>
              <span class="material-symbols-outlined text-base">chevron_right</span>
            </button>
          </div>
        </div>
      </div>

  <!-- Product Detail Modal -->
  <div id="detail-modal" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 hidden items-center justify-center p-4" style="display:none;">
    <div class="bg-surface-container-lowest rounded-[2rem] max-w-lg w-full max-h-[90vh] overflow-hidden flex flex-col shadow-2xl border border-surface-container/30 animate-[slideUp_0.3s_ease-out]">

      <!-- Image Header -->
      <div class="relative shrink-0">
        <div id="detail-img-container" class="w-full h-52 bg-white flex items-center justify-center overflow-hidden">
          <img id="detail-img" src="" alt="" class="max-h-full max-w-full object-contain" />
          <div id="detail-img-placeholder" class="hidden flex-col items-center justify-center text-on-surface-variant/30">
            <span class="material-symbols-outlined text-6xl">spa</span>
          </div>
        </div>
        <button id="detail-close" class="absolute top-3 right-3 w-10 h-10 rounded-full bg-black/30 backdrop-blur-sm text-white flex items-center justify-center hover:bg-black/50 transition-all">
          <span class="material-symbols-outlined">close</span>
        </button>
        <div id="detail-badge" class="absolute top-3 left-3 px-3 py-1 rounded-full text-xs font-bold"></div>
        <a id="detail-edit-btn" href="#" class="absolute bottom-3 right-3 flex items-center gap-1 px-3 py-1.5 rounded-full bg-white/90 backdrop-blur-sm text-xs font-bold text-on-surface shadow-md hover:bg-white transition-all">
          <span class="material-symbols-outlined text-sm">edit</span> Editar
        </a>
      </div>

      <!-- VIEW MODE -->
      <div id="detail-view" class="p-6 overflow-y-auto flex-1">
        <h3 id="detail-name" class="text-xl font-display font-bold text-on-surface leading-tight mb-1"></h3>
        <p id="detail-code" class="text-xs font-mono text-on-surface-variant mb-0.5"></p>
        <p id="detail-category" class="text-xs text-on-surface-variant mb-4"></p>

        <div id="detail-desc-row" class="mb-5 hidden">
          <p class="text-[9px] uppercase font-bold tracking-wider text-on-surface-variant mb-1">Descripcion</p>
          <p id="detail-desc" class="text-sm text-on-surface leading-relaxed bg-surface-container-highest/30 rounded-xl p-3"></p>
        </div>

        <div class="grid grid-cols-3 gap-3 mb-4">
          <div class="bg-surface-container-highest/50 rounded-xl p-3 text-center">
            <p class="text-[9px] uppercase font-bold tracking-wider text-on-surface-variant mb-1">Costo</p>
            <p id="detail-cost" class="text-lg font-bold text-on-surface"></p>
          </div>
          <div class="bg-primary/5 rounded-xl p-3 text-center border border-primary/10">
            <p class="text-[9px] uppercase font-bold tracking-wider text-primary mb-1">Precio</p>
            <p id="detail-price" class="text-lg font-bold text-primary"></p>
          </div>
          <div class="rounded-xl p-3 text-center" id="detail-margin-card">
            <p class="text-[9px] uppercase font-bold tracking-wider mb-1">Margen</p>
            <p id="detail-margin" class="text-lg font-bold"></p>
          </div>
        </div>

        <div class="bg-gradient-to-r from-green-50 to-emerald-50 dark:from-green-900/10 dark:to-emerald-900/10 rounded-xl p-4 mb-4 border border-green-200/30">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-green-600">trending_up</span>
              <span class="text-xs font-bold text-green-700">Ganancia por unidad</span>
            </div>
            <span id="detail-profit" class="text-lg font-bold text-green-700"></span>
          </div>
        </div>

        <div id="detail-points-row" class="flex items-center gap-2 mb-4">
          <span class="material-symbols-outlined text-amber-500">stars</span>
          <span id="detail-points" class="text-sm font-bold text-amber-600"></span>
        </div>

        <div class="bg-surface-container-highest/40 rounded-xl p-4">
          <p class="text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-3">Stock actual</p>
          <div class="flex items-center justify-center gap-4">
            <button id="detail-minus" class="w-12 h-12 rounded-xl bg-surface-container-lowest border border-outline-variant/10 flex items-center justify-center text-on-surface-variant hover:bg-error/10 hover:text-error hover:border-error/20 transition-all shadow-sm">
              <span class="material-symbols-outlined">remove</span>
            </button>
            <span id="detail-qty" class="text-4xl font-display font-bold text-on-surface min-w-[3rem] text-center"></span>
            <button id="detail-plus" class="w-12 h-12 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary hover:bg-primary/20 transition-all shadow-sm">
              <span class="material-symbols-outlined">add</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

</DashboardLayout>

<style>
  @keyframes slideUp {
    from { opacity: 0; transform: translateY(20px) scale(0.97); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  @keyframes dropIn {
    from { opacity: 0; transform: translateY(-4px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
</style>

<script>
  import { supabase } from '../lib/supabase';
  import api from '../lib/api';
  import { esc, sanitizeUrl } from '../lib/security';
  import { calculateConsultantPrice } from '../lib/camino-crecimiento';
  import type { ConsultantLevel } from '../lib/camino-crecimiento';

  const container = document.getElementById('products-container') as HTMLElement;
  const listContainer = document.getElementById('list-container') as HTMLElement;
  const listTbody = document.getElementById('list-tbody') as HTMLElement;
  const emptyState = document.getElementById('empty-state') as HTMLElement;
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const filterBrand = document.getElementById('filter-brand') as HTMLSelectElement;
  const filterCategory = document.getElementById('filter-category') as HTMLSelectElement;
  const pagination = document.getElementById('pagination') as HTMLElement;
  const prevBtn = document.getElementById('prev-page') as HTMLButtonElement;
  const nextBtn = document.getElementById('next-page') as HTMLButtonElement;
  const pageInfo = document.getElementById('page-info') as HTMLElement;
  const viewGridBtn = document.getElementById('view-grid') as HTMLButtonElement;
  const viewListBtn = document.getElementById('view-list') as HTMLButtonElement;

  let currentUser = '';
  let fullInventory: any[] = [];
  let filteredInventory: any[] = [];
  let currentPage = 1;
  let viewMode: 'grid' | 'list' = 'grid';
  const PAGE_SIZE = 48;
  
  let userLevel: ConsultantLevel = (localStorage.getItem('natura_level') as ConsultantLevel) || 'Bronce';

  // Protect route & Load data
  supabase.auth.getSession().then(async ({ data: { session } }: any) => {
    if (!session) {
      window.location.href = '/login';
    } else {
      currentUser = session.user.id;

      try {
        const { data: profile } = await supabase
          .from('consultant_profiles')
          .select('latest_growth_data')
          .eq('id', session.user.id)
          .single();

        if (profile?.latest_growth_data?.level?.description) {
          const desc = profile.latest_growth_data.level.description as string;
          const levelMap: Record<string, ConsultantLevel> = {
            'Bronce': 'Bronce', 'Plata': 'Plata', 'Oro': 'Oro',
            'Zafiro': 'Zafiro', 'Diamante': 'Diamante',
            'BRONCE': 'Bronce', 'PLATA': 'Plata', 'ORO': 'Oro',
            'ZAFIRO': 'Zafiro', 'DIAMANTE': 'Diamante',
          };
          const detectedLevel = Object.entries(levelMap).find(([key]) => desc.includes(key));
          if (detectedLevel) {
            userLevel = detectedLevel[1];
            localStorage.setItem('natura_level', userLevel);
          }
        }
      } catch (e) { /* use localStorage fallback */ }

      loadProducts(currentUser);
    }
  });

  // Load Products using API
  async function loadProducts(consultantId: string) {
    try {
      // Clean up any duplicate inventory records first
      await api.inventory.cleanupDuplicates().catch(() => {});
      
      // Fetch user's inventory — already includes product details
      const myInv = await api.inventory.list({ limit: 5000 });

      if (!myInv || myInv.length === 0) {
        emptyState.classList.remove('hidden');
        return;
      }

      emptyState.classList.add('hidden');

      // Swap skeleton → real content
      document.getElementById('inventory-skeleton')?.classList.add('hidden');
      container.classList.remove('hidden');
      container.classList.add('content-loaded');

      // Map inventory items to expected format
      fullInventory = myInv.map((item: any) => {
        let price = parseFloat(item.price) || 0;
        let cost = parseFloat(item.cost) || 0;
        
        if (cost === 0 && price > 0) {
          cost = calculateConsultantPrice(price, userLevel, item.brand, item.category);
        }

        return {
          id: item.product_id,
          inv_id: item.product_id,
          name: item.product_name,
          code: item.product_code,
          category: item.category,
          brand: item.brand,
          price: price,
          cost: cost,
          quantity: item.quantity || 0,
          image_url: item.image_url,
          description: item.description || '',
          points: item.points || 0,
        };
      });

    // Populate filters dynamically
    populateFilters();
    updateStats(fullInventory);
    applyFilters();
    } catch(e) { console.error('Error loading products', e); emptyState.classList.remove('hidden'); }
  }

  function populateFilters() {
    const brands = [...new Set(fullInventory.map(p => p.brand).filter(Boolean))].sort();
    const categories = [...new Set(fullInventory.map(p => p.category).filter(Boolean))].sort();

    // Keep hidden selects in sync for applyFilters()
    brands.forEach(b => {
      const opt = document.createElement('option');
      opt.value = b; opt.textContent = b;
      filterBrand.appendChild(opt);
    });
    categories.forEach(c => {
      const opt = document.createElement('option');
      opt.value = c; opt.textContent = c;
      filterCategory.appendChild(opt);
    });

    // Render custom dropdown items
    renderDropdownItems('brand', ['all', ...brands], 'Todas las marcas');
    renderDropdownItems('category', ['all', ...categories], 'Todas las categorías');
  }

  function renderDropdownItems(type: string, values: string[], allLabel: string) {
    const list = document.getElementById(`dropdown-${type}-list`)!;
    list.innerHTML = '';
    values.forEach(val => {
      const label = val === 'all' ? allLabel : val;
      const count = val === 'all' ? fullInventory.length : fullInventory.filter(p => type === 'brand' ? p.brand === val : p.category === val).length;
      const isSelected = (type === 'brand' ? filterBrand.value : filterCategory.value) === val;
      const item = document.createElement('button');
      item.type = 'button';
      item.className = `w-full flex items-center gap-2.5 px-3.5 py-2.5 text-left text-sm transition-colors ${isSelected ? 'bg-primary/8 text-primary font-bold' : 'text-on-surface hover:bg-surface-container-highest font-medium'}`;
      item.dataset.value = val;
      item.innerHTML = `
        <span class="material-symbols-outlined text-base ${isSelected ? 'text-primary' : 'text-transparent'}" style="font-size:18px">${isSelected ? 'check' : 'check'}</span>
        <span class="flex-1 truncate">${esc(label)}</span>
        <span class="text-[10px] font-bold ${isSelected ? 'text-primary/60' : 'text-on-surface-variant/40'} tabular-nums">${count}</span>
      `;
      item.addEventListener('click', () => {
        const select = type === 'brand' ? filterBrand : filterCategory;
        select.value = val;
        document.getElementById(`dropdown-${type}-label`)!.textContent = label;
        document.getElementById(`dropdown-${type}-menu`)!.classList.add('hidden');
        document.getElementById(`dropdown-${type}-arrow`)!.style.transform = '';
        // Re-render items to update check marks
        renderDropdownItems(type, values, allLabel);
        applyFilters();
      });
      list.appendChild(item);
    });
  }

  // Custom dropdown toggle logic
  function setupDropdown(type: string) {
    const btn = document.getElementById(`dropdown-${type}-btn`)!;
    const menu = document.getElementById(`dropdown-${type}-menu`)!;
    const arrow = document.getElementById(`dropdown-${type}-arrow`)!;

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = !menu.classList.contains('hidden');
      // Close all dropdowns first
      document.querySelectorAll('[id$="-menu"]').forEach(m => m.classList.add('hidden'));
      document.querySelectorAll('[id$="-arrow"]').forEach(a => (a as HTMLElement).style.transform = '');
      if (!isOpen) {
        menu.classList.remove('hidden');
        arrow.style.transform = 'rotate(180deg)';
      }
    });
  }
  setupDropdown('brand');
  setupDropdown('category');

  // Close dropdowns on outside click
  document.addEventListener('click', () => {
    document.querySelectorAll('[id$="-menu"]').forEach(m => m.classList.add('hidden'));
    document.querySelectorAll('[id$="-arrow"]').forEach(a => (a as HTMLElement).style.transform = '');
  });
  // Prevent closing when clicking inside dropdown
  document.getElementById('dropdown-brand-menu')?.addEventListener('click', e => e.stopPropagation());
  document.getElementById('dropdown-category-menu')?.addEventListener('click', e => e.stopPropagation());

  function updateStats(items: any[]) {
    const el = (id: string) => document.getElementById(id) as HTMLElement;
    el('stat-total').textContent = items.length.toLocaleString();
    el('stat-brands').textContent = String([...new Set(items.map(p => p.brand).filter(Boolean))].length);
    el('stat-categories').textContent = String([...new Set(items.map(p => p.category).filter(Boolean))].length);
    el('stat-instock').textContent = String(items.filter(p => p.quantity > 0).length);
  }

  function applyFilters() {
    const query = searchInput.value.toLowerCase();
    const brand = filterBrand.value;
    const category = filterCategory.value;

    filteredInventory = fullInventory.filter(p => {
      const matchSearch = !query ||
        p.name?.toLowerCase().includes(query) ||
        p.code?.toLowerCase().includes(query) ||
        p.brand?.toLowerCase().includes(query);
      const matchBrand = brand === 'all' || p.brand === brand;
      const matchCategory = category === 'all' || p.category === category;
      return matchSearch && matchBrand && matchCategory;
    });

    currentPage = 1;
    updateActiveFiltersBar();
    renderPage();
  }

  function updateActiveFiltersBar() {
    const bar = document.getElementById('active-filters-bar')!;
    const countEl = document.getElementById('results-count')!;
    const chipsEl = document.getElementById('filter-chips')!;
    const clearBtn = document.getElementById('clear-filters')!;

    const query = searchInput.value.trim();
    const brand = filterBrand.value;
    const category = filterCategory.value;
    const hasFilters = query || brand !== 'all' || category !== 'all';
    const isFiltered = filteredInventory.length !== fullInventory.length;

    if (!isFiltered && !hasFilters) {
      bar.classList.add('hidden');
      return;
    }

    bar.classList.remove('hidden');
    countEl.textContent = `Mostrando ${filteredInventory.length} de ${fullInventory.length}`;
    chipsEl.innerHTML = '';

    if (query) {
      chipsEl.appendChild(makeChip(`"${query}"`, () => { searchInput.value = ''; applyFilters(); }));
    }
    if (brand !== 'all') {
      chipsEl.appendChild(makeChip(brand, () => {
        filterBrand.value = 'all';
        document.getElementById('dropdown-brand-label')!.textContent = 'Todas las marcas';
        const brands = [...new Set(fullInventory.map(p => p.brand).filter(Boolean))].sort();
        renderDropdownItems('brand', ['all', ...brands], 'Todas las marcas');
        applyFilters();
      }));
    }
    if (category !== 'all') {
      chipsEl.appendChild(makeChip(category, () => {
        filterCategory.value = 'all';
        document.getElementById('dropdown-category-label')!.textContent = 'Todas las categorías';
        const categories = [...new Set(fullInventory.map(p => p.category).filter(Boolean))].sort();
        renderDropdownItems('category', ['all', ...categories], 'Todas las categorías');
        applyFilters();
      }));
    }

    if (hasFilters) {
      clearBtn.classList.remove('hidden');
    } else {
      clearBtn.classList.add('hidden');
    }
  }

  function makeChip(label: string, onRemove: () => void): HTMLElement {
    const chip = document.createElement('span');
    chip.className = 'inline-flex items-center gap-1 bg-primary/8 text-primary text-[11px] font-bold px-2.5 py-1 rounded-full';
    chip.innerHTML = `${esc(label)}<button class="ml-0.5 hover:text-primary/60 transition-colors"><span class="material-symbols-outlined" style="font-size:13px">close</span></button>`;
    chip.querySelector('button')!.addEventListener('click', (e) => { e.stopPropagation(); onRemove(); });
    return chip;
  }

  // "Clear all" button
  document.getElementById('clear-filters')?.addEventListener('click', () => {
    searchInput.value = '';
    filterBrand.value = 'all';
    filterCategory.value = 'all';
    document.getElementById('dropdown-brand-label')!.textContent = 'Todas las marcas';
    document.getElementById('dropdown-category-label')!.textContent = 'Todas las categorías';
    const brands = [...new Set(fullInventory.map(p => p.brand).filter(Boolean))].sort();
    const categories = [...new Set(fullInventory.map(p => p.category).filter(Boolean))].sort();
    renderDropdownItems('brand', ['all', ...brands], 'Todas las marcas');
    renderDropdownItems('category', ['all', ...categories], 'Todas las categorías');
    applyFilters();
  });

  function renderPage() {
    const totalPages = Math.ceil(filteredInventory.length / PAGE_SIZE);
    const startIdx = (currentPage - 1) * PAGE_SIZE;
    const pageItems = filteredInventory.slice(startIdx, startIdx + PAGE_SIZE);

    if (filteredInventory.length === 0) {
      emptyState.classList.remove('hidden');
    } else {
      emptyState.classList.add('hidden');
    }

    // Pagination
    if (totalPages > 1) {
      pagination.classList.remove('hidden');
      pageInfo.textContent = `${currentPage} / ${totalPages} (${filteredInventory.length} productos)`;
      prevBtn.disabled = currentPage <= 1;
      nextBtn.disabled = currentPage >= totalPages;
    } else {
      pagination.classList.add('hidden');
    }

    if (viewMode === 'grid') {
      container.classList.remove('hidden');
      listContainer.classList.add('hidden');
      renderGridView(pageItems);
    } else {
      container.classList.add('hidden');
      listContainer.classList.remove('hidden');
      renderListView(pageItems);
    }
  }

  // ===== GRID VIEW =====
  function renderGridView(items: any[]) {
    container.querySelectorAll('.inv-card').forEach(e => e.remove());

    items.forEach(p => {
      const card = document.createElement('div');
      card.className = "inv-card bg-surface-container-lowest rounded-2xl shadow-[0_8px_20px_-4px_rgba(29,26,34,0.05)] border border-outline-variant/8 hover:shadow-lg hover:border-primary/15 transition-all group overflow-hidden flex flex-col cursor-pointer";
      card.dataset.productId = p.id;

      const margin = p.price && p.cost ? ((p.price - p.cost) / p.price * 100).toFixed(0) : '—';
      const marginColor = parseInt(margin) >= 30 ? 'text-green-600' : parseInt(margin) >= 15 ? 'text-amber-600' : 'text-red-500';
      const brandColor = p.brand === 'Avon' ? 'bg-fuchsia-100 text-fuchsia-700' : p.brand === 'Casa & Estilo' ? 'bg-cyan-100 text-cyan-700' : 'bg-primary/10 text-primary';
      
      const stockControls = `
        <div class="flex items-center gap-1 bg-surface-container-highest rounded-lg p-0.5 ml-auto" onclick="event.stopPropagation()">
          <button class="btn-minus-stock w-7 h-7 rounded-md flex items-center justify-center text-on-surface-variant hover:bg-error/10 hover:text-error transition-colors disabled:opacity-30" data-id="${p.id}" ${p.quantity === 0 ? 'disabled' : ''}>
            <span class="material-symbols-outlined text-sm pointer-events-none">remove</span>
          </button>
          <span class="text-sm font-bold w-6 text-center text-${p.quantity > 0 ? 'green-600' : 'on-surface-variant'} stock-label-${p.id}">${p.quantity}</span>
          <button class="btn-plus-stock w-7 h-7 rounded-md bg-primary/10 text-primary flex items-center justify-center hover:bg-primary/20 transition-colors" data-id="${p.id}">
            <span class="material-symbols-outlined text-sm pointer-events-none">add</span>
          </button>
        </div>
      `;

      const imgSrc = esc(sanitizeUrl(p.image_url));
      const imgEl = imgSrc
        ? `<img src="${imgSrc}" alt="${esc(p.name)}" class="w-full h-40 object-contain bg-white" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
           <div class="w-full h-40 bg-surface-container items-center justify-center hidden"><span class="material-symbols-outlined text-4xl text-on-surface-variant/30">image_not_supported</span></div>`
        : `<div class="w-full h-40 bg-surface-container flex items-center justify-center"><span class="material-symbols-outlined text-4xl text-on-surface-variant/30">spa</span></div>`;

      card.innerHTML = `
        ${imgEl}
        <div class="p-4 flex flex-col flex-1">
          <div class="flex justify-between items-start mb-2 gap-2">
            <span class="text-[10px] font-bold px-2 py-0.5 ${brandColor} rounded-full whitespace-nowrap">${esc(p.brand) || 'Natura'}</span>
            <span class="text-[10px] text-on-surface-variant font-mono bg-surface-container-highest px-1.5 py-0.5 rounded">${esc(p.code)}</span>
          </div>
          <h3 class="text-sm font-bold text-on-surface leading-tight line-clamp-2 mb-2 min-h-[2.5rem]" title="${esc(p.name)}">${esc(p.name)}</h3>
          <p class="text-[10px] font-medium text-on-surface-variant mb-3 truncate" title="${esc(p.category || '')}">${esc(p.category) || '—'}</p>
          <div class="mt-auto grid grid-cols-3 gap-2 pt-3 border-t border-outline-variant/10">
            <div>
              <p class="text-[9px] text-on-surface-variant uppercase font-bold tracking-wide">Costo</p>
              <p class="text-sm font-bold text-on-surface">$${(p.cost || 0).toFixed(0)}</p>
            </div>
            <div>
              <p class="text-[9px] text-on-surface-variant uppercase font-bold tracking-wide">Precio</p>
              <p class="text-sm font-bold text-primary">$${(p.price || 0).toFixed(0)}</p>
            </div>
            <div>
              <p class="text-[9px] text-on-surface-variant uppercase font-bold tracking-wide">Margen</p>
              <p class="text-sm font-bold ${marginColor}">${margin}%</p>
            </div>
          </div>
          <div class="flex items-center justify-between mt-3 pr-1">
            ${p.points ? `<div class="flex items-center gap-1"><span class="material-symbols-outlined text-xs text-amber-500">stars</span><span class="text-[10px] font-bold text-amber-600">${p.points} pts</span></div>` : '<div></div>'}
            ${stockControls}
          </div>
        </div>
      `;
      container.appendChild(card);
    });

    bindStockButtons(container);

    // Click to open detail
    container.querySelectorAll('.inv-card').forEach(card => {
      card.addEventListener('click', (e) => {
        // Don't open if clicking stock buttons
        if ((e.target as HTMLElement).closest('.btn-minus-stock, .btn-plus-stock')) return;
        const id = (card as HTMLElement).dataset.productId;
        if (id) openDetail(id);
      });
    });
  }

  // ===== LIST VIEW =====
  function renderListView(items: any[]) {
    listTbody.innerHTML = '';

    items.forEach(p => {
      const tr = document.createElement('tr');
      tr.className = 'hover:bg-surface-container-low/50 transition-colors cursor-pointer';
      tr.dataset.productId = p.id;

      const margin = p.price && p.cost ? ((p.price - p.cost) / p.price * 100).toFixed(0) : '—';
      const marginColor = parseInt(margin) >= 30 ? 'text-green-600' : parseInt(margin) >= 15 ? 'text-amber-600' : 'text-red-500';
      const imgSrc = esc(sanitizeUrl(p.image_url));

      tr.innerHTML = `
        <td class="px-3 py-2">
          ${imgSrc
            ? `<img src="${imgSrc}" alt="" class="w-10 h-10 object-contain rounded-lg bg-white" loading="lazy" />`
            : `<div class="w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center"><span class="material-symbols-outlined text-sm text-on-surface-variant/30">spa</span></div>`
          }
        </td>
        <td class="px-4 py-2">
          <p class="font-bold text-on-surface text-xs leading-tight line-clamp-1" title="${esc(p.name)}">${esc(p.name)}</p>
          <p class="text-[10px] font-mono text-on-surface-variant">${esc(p.code)}</p>
        </td>
        <td class="px-4 py-2 text-xs">${esc(p.brand) || '—'}</td>
        <td class="px-4 py-2 text-xs text-on-surface-variant">${esc(p.category) || '—'}</td>
        <td class="px-4 py-2 text-right font-mono text-xs">$${(p.cost || 0).toFixed(0)}</td>
        <td class="px-4 py-2 text-right font-mono text-xs font-bold text-primary">$${(p.price || 0).toFixed(0)}</td>
        <td class="px-4 py-2 text-right text-xs font-bold ${marginColor}">${margin}%</td>
        <td class="px-4 py-2 text-center">${p.points ? `<span class="text-[10px] font-bold text-amber-600">${p.points}</span>` : '—'}</td>
        <td class="px-4 py-2 text-center">
          <div class="flex justify-center" onclick="event.stopPropagation()">
            <div class="flex items-center gap-1 bg-surface-container-highest rounded-md p-1">
              <button class="btn-minus-stock w-6 h-6 rounded flex items-center justify-center hover:bg-error/10 hover:text-error transition-colors text-on-surface-variant disabled:opacity-30" data-id="${p.id}" ${p.quantity === 0 ? 'disabled' : ''}>
                <span class="material-symbols-outlined text-[12px] pointer-events-none">remove</span>
              </button>
              <span class="text-xs font-bold w-6 text-center text-${p.quantity > 0 ? 'green-600' : 'on-surface-variant'} stock-label-${p.id}">${p.quantity}</span>
              <button class="btn-plus-stock w-6 h-6 rounded bg-primary/10 text-primary flex items-center justify-center hover:bg-primary/20 transition-colors" data-id="${p.id}">
                <span class="material-symbols-outlined text-[12px] pointer-events-none">add</span>
              </button>
            </div>
          </div>
        </td>
      `;
      listTbody.appendChild(tr);
    });

    bindStockButtons(listTbody);

    // Click to open detail
    listTbody.querySelectorAll('tr').forEach(tr => {
      tr.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('.btn-minus-stock, .btn-plus-stock')) return;
        const id = (tr as HTMLElement).dataset.productId;
        if (id) openDetail(id);
      });
    });
  }

  // ===== STOCK MANAGEMENT =====
  function bindStockButtons(root: HTMLElement) {
    root.querySelectorAll('.btn-minus-stock').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (btn as HTMLElement).dataset.id;
        if(id) updateStock(id, -1);
      });
    });
    root.querySelectorAll('.btn-plus-stock').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (btn as HTMLElement).dataset.id;
        if(id) updateStock(id, 1);
      });
    });
  }

  async function updateStock(productId: string, increment: number) {
    const product = fullInventory.find(p => p.id === productId);
    if (!product) return;
    
    // Optimistic update
    const newQty = Math.max(0, product.quantity + increment);
    if (newQty === product.quantity) return; // no change
    
    product.quantity = newQty;
    
    // Update DOM instantaneously
    document.querySelectorAll(`.stock-label-${productId}`).forEach(el => {
      el.textContent = newQty.toString();
      el.className = `text-sm lg:text-xs font-bold w-6 text-center text-${newQty > 0 ? 'green-600' : 'on-surface-variant'} stock-label-${productId}`;
    });
    
    document.querySelectorAll(`.btn-minus-stock[data-id="${productId}"]`).forEach(btn => {
       (btn as HTMLButtonElement).disabled = newQty === 0;
    });

    updateStats(fullInventory); 

    // Sync stock change with backend API
    try {
      await api.inventory.add([{ product_id: productId, quantity: newQty }]);
      if (!product.inv_id) product.inv_id = productId;
    } catch(e) { console.error('Error syncing stock', e); }
  }

  // ===== EVENT LISTENERS =====
  let searchTimer: ReturnType<typeof setTimeout>;
  searchInput?.addEventListener('input', () => {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(applyFilters, 200);
  });

  prevBtn?.addEventListener('click', () => { currentPage--; renderPage(); });
  nextBtn?.addEventListener('click', () => { currentPage++; renderPage(); });

  viewGridBtn?.addEventListener('click', () => {
    viewMode = 'grid';
    viewGridBtn.className = 'px-3 py-2 text-primary bg-primary/10';
    viewListBtn.className = 'px-3 py-2 text-on-surface-variant hover:text-primary transition-colors';
    renderPage();
  });

  viewListBtn?.addEventListener('click', () => {
    viewMode = 'list';
    viewListBtn.className = 'px-3 py-2 text-primary bg-primary/10';
    viewGridBtn.className = 'px-3 py-2 text-on-surface-variant hover:text-primary transition-colors';
    renderPage();
  });

  // ===== PRODUCT DETAIL MODAL =====
  let currentDetailId = '';
  const detailModal = document.getElementById('detail-modal')!;

  function openDetail(productId: string) {
    const p = fullInventory.find(i => i.id === productId);
    if (!p) return;
    currentDetailId = productId;

    // Image
    const img = document.getElementById('detail-img') as HTMLImageElement;
    const placeholder = document.getElementById('detail-img-placeholder')!;
    const imgSrc = sanitizeUrl(p.image_url);
    if (imgSrc) {
      img.src = imgSrc;
      img.alt = p.name;
      img.classList.remove('hidden');
      placeholder.classList.add('hidden');
      placeholder.style.display = 'none';
    } else {
      img.classList.add('hidden');
      placeholder.classList.remove('hidden');
      placeholder.style.display = 'flex';
    }

    // Badge
    const badge = document.getElementById('detail-badge')!;
    const brandColor = p.brand === 'Avon' ? 'bg-fuchsia-100 text-fuchsia-700' : p.brand === 'Casa & Estilo' ? 'bg-cyan-100 text-cyan-700' : 'bg-primary/10 text-primary backdrop-blur-sm';
    badge.className = `absolute top-3 left-3 px-3 py-1 rounded-full text-xs font-bold ${brandColor}`;
    badge.textContent = p.brand || 'Natura';

    // Text
    document.getElementById('detail-name')!.textContent = p.name;
    document.getElementById('detail-code')!.textContent = `Código: ${p.code}`;
    document.getElementById('detail-category')!.textContent = p.category || '—';

    // Prices
    document.getElementById('detail-cost')!.textContent = `$${(p.cost || 0).toFixed(0)}`;
    document.getElementById('detail-price')!.textContent = `$${(p.price || 0).toFixed(0)}`;

    const margin = p.price && p.cost ? ((p.price - p.cost) / p.price * 100) : 0;
    const marginEl = document.getElementById('detail-margin')!;
    marginEl.textContent = `${margin.toFixed(0)}%`;
    const marginCard = document.getElementById('detail-margin-card')!;
    if (margin >= 30) {
      marginCard.className = 'bg-green-50 rounded-xl p-3 text-center border border-green-200/30';
      marginEl.className = 'text-lg font-bold text-green-600';
    } else if (margin >= 15) {
      marginCard.className = 'bg-amber-50 rounded-xl p-3 text-center border border-amber-200/30';
      marginEl.className = 'text-lg font-bold text-amber-600';
    } else {
      marginCard.className = 'bg-red-50 rounded-xl p-3 text-center border border-red-200/30';
      marginEl.className = 'text-lg font-bold text-red-500';
    }

    // Profit
    const profit = (p.price || 0) - (p.cost || 0);
    document.getElementById('detail-profit')!.textContent = `$${profit.toFixed(0)}`;

    // Points
    const pointsRow = document.getElementById('detail-points-row')!;
    if (p.points) {
      pointsRow.classList.remove('hidden');
      document.getElementById('detail-points')!.textContent = `${p.points} puntos`;
    } else {
      pointsRow.classList.add('hidden');
    }

    // Description
    const descRow = document.getElementById('detail-desc-row')!;
    if (p.description) {
      descRow.classList.remove('hidden');
      document.getElementById('detail-desc')!.textContent = p.description;
    } else {
      descRow.classList.add('hidden');
    }

    // Stock
    document.getElementById('detail-qty')!.textContent = String(p.quantity || 0);

    // Show view mode
    document.getElementById('detail-view')!.classList.remove('hidden');

    // Show modal
    detailModal.style.display = 'flex';
    detailModal.classList.remove('hidden');
  }

  function closeDetail() {
    detailModal.style.display = 'none';
    detailModal.classList.add('hidden');
    currentDetailId = '';
  }

  document.getElementById('detail-close')!.addEventListener('click', closeDetail);
  detailModal.addEventListener('click', (e) => {
    if (e.target === detailModal) closeDetail();
  });

  // Stock controls in modal
  document.getElementById('detail-minus')!.addEventListener('click', () => {
    if (!currentDetailId) return;
    updateStock(currentDetailId, -1);
    const p = fullInventory.find(i => i.id === currentDetailId);
    if (p) document.getElementById('detail-qty')!.textContent = String(p.quantity);
  });
  document.getElementById('detail-plus')!.addEventListener('click', () => {
    if (!currentDetailId) return;
    updateStock(currentDetailId, 1);
    const p = fullInventory.find(i => i.id === currentDetailId);
    if (p) document.getElementById('detail-qty')!.textContent = String(p.quantity);
  });

  // ===== EDIT → Navigate to edit page =====
  document.getElementById('detail-edit-btn')!.addEventListener('click', (e) => {
    e.preventDefault();
    if (currentDetailId) {
      window.location.href = `/inventario/editar?id=${currentDetailId}`;
    }
  });
</script>
