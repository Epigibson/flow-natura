---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import PageLoader from '../../components/PageLoader.astro';
---

<DashboardLayout>
  <header class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-10">
    <div>
      <p class="text-primary font-bold tracking-widest uppercase text-sm mb-1">ADMINISTRACIÓN</p>
      <h2 class="text-3xl md:text-5xl font-display font-bold text-on-surface">Catálogo de Productos</h2>
      <p class="text-on-surface-variant mt-2 text-base md:text-lg">Gestiona, edita y organiza todo tu catálogo global.</p>
    </div>
    <div class="flex items-center gap-3">
      <button id="btn-toggle-deleted" class="hidden sm:flex items-center gap-2 py-3 px-5 rounded-xl font-bold border-2 border-outline-variant/15 text-on-surface-variant hover:bg-amber-50 hover:text-amber-700 hover:border-amber-200 transition-all text-sm">
        <span class="material-symbols-outlined text-lg">visibility</span>
        <span id="toggle-deleted-label">Mostrar Eliminados</span>
      </button>
      <a href="/inventario/nuevo" class="flex items-center gap-2 py-3 px-5 rounded-xl font-bold shadow-lg shadow-primary/20 hover:scale-[1.02] bg-primary text-white transition-all text-sm">
        <span class="material-symbols-outlined text-lg">add_circle</span>
        Crear
      </a>
    </div>
  </header>

  <!-- KPIs -->
  <section class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-8">
    <div class="bg-surface-container-lowest rounded-2xl p-5 shadow-sm flex items-center gap-3 border border-outline-variant/5">
      <div class="w-11 h-11 rounded-xl bg-primary/10 flex items-center justify-center">
        <span class="material-symbols-outlined text-primary">inventory_2</span>
      </div>
      <div>
        <p id="kpi-total" class="text-2xl font-display font-bold text-on-surface">—</p>
        <p class="text-xs text-on-surface-variant font-medium">Productos</p>
      </div>
    </div>
    <div class="bg-surface-container-lowest rounded-2xl p-5 shadow-sm flex items-center gap-3 border border-outline-variant/5">
      <div class="w-11 h-11 rounded-xl bg-secondary/10 flex items-center justify-center">
        <span class="material-symbols-outlined text-secondary">local_offer</span>
      </div>
      <div>
        <p id="kpi-brands" class="text-2xl font-display font-bold text-on-surface">—</p>
        <p class="text-xs text-on-surface-variant font-medium">Marcas</p>
      </div>
    </div>
    <div class="bg-surface-container-lowest rounded-2xl p-5 shadow-sm flex items-center gap-3 border border-outline-variant/5">
      <div class="w-11 h-11 rounded-xl bg-tertiary/10 flex items-center justify-center">
        <span class="material-symbols-outlined text-tertiary">category</span>
      </div>
      <div>
        <p id="kpi-categories" class="text-2xl font-display font-bold text-on-surface">—</p>
        <p class="text-xs text-on-surface-variant font-medium">Categorías</p>
      </div>
    </div>
    <div class="bg-surface-container-lowest rounded-2xl p-5 shadow-sm flex items-center gap-3 border border-outline-variant/5">
      <div class="w-11 h-11 rounded-xl bg-green-500/10 flex items-center justify-center">
        <span class="material-symbols-outlined text-green-600">attach_money</span>
      </div>
      <div>
        <p id="kpi-avg-margin" class="text-2xl font-display font-bold text-green-600">—</p>
        <p class="text-xs text-on-surface-variant font-medium">Margen Prom.</p>
      </div>
    </div>
    <div class="bg-surface-container-lowest rounded-2xl p-5 shadow-sm flex items-center gap-3 border border-outline-variant/5">
      <div class="w-11 h-11 rounded-xl bg-red-500/10 flex items-center justify-center">
        <span class="material-symbols-outlined text-red-500">delete_sweep</span>
      </div>
      <div>
        <p id="kpi-deleted" class="text-2xl font-display font-bold text-red-500">0</p>
        <p class="text-xs text-on-surface-variant font-medium">Eliminados</p>
      </div>
    </div>
  </section>

  <!-- Search & Filters -->
  <section class="bg-surface-container-lowest rounded-[2rem] p-6 mb-8 shadow-sm border border-outline-variant/5">
    <div class="flex flex-wrap gap-3">
      <div class="w-full sm:flex-1 sm:min-w-[240px] relative">
        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-on-surface-variant">search</span>
        <input id="search" type="text" placeholder="Buscar por nombre, código, marca..."
          class="w-full bg-surface-container-highest border-none rounded-xl py-3 pl-11 pr-4 text-sm focus:ring-2 focus:ring-primary-container" />
      </div>
      <select id="filter-brand" class="flex-1 sm:flex-none bg-surface-container-highest border-none rounded-xl py-3 px-4 text-xs font-bold sm:min-w-[150px]">
        <option value="all">Todas las marcas</option>
      </select>
      <select id="filter-category" class="flex-1 sm:flex-none bg-surface-container-highest border-none rounded-xl py-3 px-4 text-xs font-bold sm:min-w-[170px]">
        <option value="all">Todas las categorías</option>
      </select>
      <div class="flex items-center gap-1 bg-surface-container-highest rounded-xl p-1 ml-auto">
        <button id="view-list" class="w-9 h-9 rounded-lg bg-primary text-white flex items-center justify-center transition-colors shadow-sm" title="Vista de Lista">
          <span class="material-symbols-outlined text-sm">list</span>
        </button>
        <button id="view-grid" class="w-9 h-9 rounded-lg text-on-surface-variant hover:bg-surface-container flex items-center justify-center transition-colors" title="Vista de Tarjetas">
          <span class="material-symbols-outlined text-sm">grid_view</span>
        </button>
      </div>
    </div>
    <p id="results-count" class="text-xs text-on-surface-variant mt-3 font-bold uppercase tracking-wider"></p>
  </section>

  <!-- Products Table / Grid -->
  <section class="bg-surface-container-lowest rounded-[2rem] shadow-sm border border-outline-variant/5 overflow-hidden mb-8 min-h-[400px] relative">
    
    <!-- List View -->
    <div id="list-view-container" class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="sticky top-0 bg-surface-container-high z-10">
          <tr class="text-[10px] uppercase tracking-wider text-on-surface-variant border-b border-outline-variant/10 font-bold">
            <th class="px-4 py-3.5 w-14"></th>
            <th class="px-4 py-3.5">Producto</th>
            <th class="px-4 py-3.5">Código</th>
            <th class="px-4 py-3.5">Marca</th>
            <th class="px-4 py-3.5">Categoría</th>
            <th class="px-4 py-3.5 text-center">Variantes</th>
            <th class="px-4 py-3.5 text-right">Costo</th>
            <th class="px-4 py-3.5 text-right">Precio</th>
            <th class="px-4 py-3.5 text-right">Margen</th>
            <th class="px-4 py-3.5 text-center">Pts</th>
            <th class="px-4 py-3.5 text-center">Estado</th>
            <th class="px-4 py-3.5 text-center w-32">Acciones</th>
          </tr>
        </thead>
        <tbody id="table-body" class="divide-y divide-outline-variant/5"></tbody>
      </table>
    </div>

    <!-- Grid View -->
    <div id="grid-view-container" class="hidden p-6 bg-surface-container-lowest">
      <div id="grid-body" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6"></div>
    </div>

    <!-- Loading -->
    <div id="loading" class="text-center py-16">
      <PageLoader inline={true} text="Cargando catálogo" />
    </div>
    <!-- Empty -->
    <div id="empty-state" class="text-center py-16 hidden">
      <span class="material-symbols-outlined text-5xl text-on-surface-variant/30">inventory_2</span>
      <p class="text-on-surface-variant mt-3 text-lg font-bold">No se encontraron productos.</p>
    </div>
  </section>

  <!-- Pagination -->
  <div id="pagination" class="flex justify-center items-center gap-3 mb-8 hidden">
    <button id="prev-page" class="px-4 py-2 rounded-xl bg-surface-container-highest text-on-surface-variant hover:bg-primary/10 hover:text-primary transition-colors font-bold text-sm disabled:opacity-30" disabled>
      <span class="material-symbols-outlined text-sm align-middle">chevron_left</span> Anterior
    </button>
    <span id="page-info" class="text-sm text-on-surface-variant font-medium"></span>
    <button id="next-page" class="px-4 py-2 rounded-xl bg-surface-container-highest text-on-surface-variant hover:bg-primary/10 hover:text-primary transition-colors font-bold text-sm disabled:opacity-30" disabled>
      Siguiente <span class="material-symbols-outlined text-sm align-middle">chevron_right</span>
    </button>
  </div>

  <!-- Edit Modal -->
  <dialog id="edit-modal" class="p-0 rounded-[2rem] shadow-2xl border-none backdrop:bg-on-surface/50 backdrop:backdrop-blur-sm m-auto w-full max-w-2xl bg-transparent">
    <div class="bg-surface-container-lowest rounded-[2rem] w-full border border-outline-variant/10 max-h-[90vh] overflow-y-auto">
      <div class="flex justify-between items-center p-6 pb-0">
        <h3 class="text-2xl font-display font-bold text-on-surface flex items-center gap-2">
          <span class="material-symbols-outlined text-primary">edit_note</span>
          Editar Producto
        </h3>
        <button id="edit-close" class="w-9 h-9 rounded-xl flex items-center justify-center hover:bg-error/10 hover:text-error transition-colors text-on-surface-variant">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
      <div class="p-6 space-y-5">
        <input type="hidden" id="edit-id" />
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label class="text-xs font-bold text-on-surface-variant block mb-1.5">Nombre <span class="text-error">*</span></label>
            <input type="text" id="edit-name" class="w-full bg-surface-container-highest border-none rounded-xl py-3 px-4 text-sm focus:ring-2 focus:ring-primary-container" />
          </div>
          <div>
            <label class="text-xs font-bold text-on-surface-variant block mb-1.5">Código <span class="text-error">*</span></label>
            <input type="text" id="edit-code" class="w-full bg-surface-container-highest border-none rounded-xl py-3 px-4 text-sm font-mono focus:ring-2 focus:ring-primary-container" />
          </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label class="text-xs font-bold text-on-surface-variant block mb-1.5">Marca</label>
            <input type="text" id="edit-brand" class="w-full bg-surface-container-highest border-none rounded-xl py-3 px-4 text-sm focus:ring-2 focus:ring-primary-container" />
          </div>
          <div>
            <label class="text-xs font-bold text-on-surface-variant block mb-1.5">Categoría</label>
            <select id="edit-category" class="w-full bg-surface-container-highest border-none rounded-xl py-3 px-4 text-sm focus:ring-2 focus:ring-primary-container">
              <option>Perfumería</option>
              <option>Maquillaje</option>
              <option>Cuerpo</option>
              <option>Cabello</option>
              <option>Rostro</option>
              <option>Hogar</option>
              <option>Accesorios</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
          <div>
            <label class="text-xs font-bold text-on-surface-variant block mb-1.5">Costo <span class="text-error">*</span></label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-on-surface-variant font-bold text-sm">$</span>
              <input type="number" step="0.01" id="edit-cost" class="w-full bg-surface-container-highest border-none rounded-xl py-3 pl-9 pr-4 text-sm focus:ring-2 focus:ring-primary-container" />
            </div>
          </div>
          <div>
            <label class="text-xs font-bold text-on-surface-variant block mb-1.5">Precio <span class="text-error">*</span></label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-primary font-bold text-sm">$</span>
              <input type="number" step="0.01" id="edit-price" class="w-full bg-surface-container-highest border-none rounded-xl py-3 pl-9 pr-4 text-sm focus:ring-2 focus:ring-primary-container" />
            </div>
          </div>
          <div>
            <label class="text-xs font-bold text-on-surface-variant block mb-1.5">Puntos</label>
            <input type="number" id="edit-points" class="w-full bg-surface-container-highest border-none rounded-xl py-3 px-4 text-sm focus:ring-2 focus:ring-primary-container" />
          </div>
        </div>
        <div>
          <label class="text-xs font-bold text-on-surface-variant block mb-1.5">URL de Imagen</label>
          <input type="url" id="edit-image" placeholder="https://..." class="w-full bg-surface-container-highest border-none rounded-xl py-3 px-4 text-sm focus:ring-2 focus:ring-primary-container" />
        </div>
        <div>
          <label class="text-xs font-bold text-on-surface-variant block mb-1.5">Descripción</label>
          <textarea id="edit-description" rows="2" class="w-full bg-surface-container-highest border-none rounded-xl py-3 px-4 text-sm focus:ring-2 focus:ring-primary-container resize-none"></textarea>
        </div>
        <!-- Margin preview -->
        <div id="edit-margin-preview" class="flex items-center gap-4 bg-green-50 rounded-xl p-4 border border-green-200">
          <span class="material-symbols-outlined text-green-600">trending_up</span>
          <div>
            <p class="text-[10px] text-green-700 uppercase font-bold">Margen de Ganancia</p>
            <p id="edit-margin-value" class="text-xl font-display font-bold text-green-600">—%</p>
          </div>
          <div class="ml-auto text-right">
            <p class="text-[10px] text-green-700 uppercase font-bold">Ganancia por unidad</p>
            <p id="edit-profit-value" class="text-xl font-display font-bold text-green-600">$—</p>
          </div>
        </div>
        <div id="edit-error" class="hidden text-error bg-error-container p-3 rounded-xl text-sm font-bold"></div>
        <div class="flex gap-3 pt-2">
          <button id="edit-save" class="flex-1 flex items-center justify-center gap-2 py-3.5 rounded-xl font-bold bg-primary text-white shadow-lg shadow-primary/20 hover:scale-[1.02] transition-all">
            <span class="material-symbols-outlined text-sm">save</span>
            Guardar Cambios
          </button>
          <button id="edit-cancel" class="py-3.5 px-6 rounded-xl font-bold border-2 border-outline-variant/15 text-on-surface-variant hover:bg-surface-container-highest transition-colors">
            Cancelar
          </button>
        </div>
      </div>
    </div>
  </dialog>

  <!-- Delete Confirmation Modal -->
  <dialog id="delete-modal" class="p-0 rounded-2xl shadow-2xl border-none backdrop:bg-on-surface/50 backdrop:backdrop-blur-sm m-auto w-full max-w-md bg-transparent">
    <div class="bg-surface-container-lowest rounded-2xl p-8 w-full border border-outline-variant/10">
      <div class="text-center mb-6">
        <div class="w-16 h-16 rounded-full bg-red-100 flex items-center justify-center mx-auto mb-4">
          <span class="material-symbols-outlined text-red-500 text-3xl">delete_forever</span>
        </div>
        <h3 class="text-xl font-display font-bold text-on-surface">¿Desactivar producto?</h3>
        <p id="delete-product-name" class="text-sm text-on-surface-variant mt-2 font-medium"></p>
      </div>
      <div class="bg-amber-50 rounded-xl p-4 border border-amber-200 mb-6">
        <div class="flex items-start gap-3">
          <span class="material-symbols-outlined text-amber-600 mt-0.5">info</span>
          <div>
            <p class="text-sm text-amber-800 font-bold">Borrado lógico</p>
            <p class="text-xs text-amber-700 mt-1">El producto será desactivado del catálogo pero se conservarán todos los datos históricos. Podrás restaurarlo en cualquier momento.</p>
          </div>
        </div>
      </div>
      <input type="hidden" id="delete-id" />
      <div class="flex gap-3">
        <button id="delete-confirm" class="flex-1 flex items-center justify-center gap-2 py-3 rounded-xl font-bold bg-red-500 text-white hover:bg-red-600 transition-colors">
          <span class="material-symbols-outlined text-sm">delete</span>
          Sí, desactivar
        </button>
        <button id="delete-cancel" class="py-3 px-6 rounded-xl font-bold border-2 border-outline-variant/15 text-on-surface-variant hover:bg-surface-container-highest transition-colors">
          Cancelar
        </button>
      </div>
    </div>
  </dialog>

  <!-- Variants Detail Modal -->
  <dialog id="variants-detail-modal" class="p-0 rounded-2xl shadow-2xl border-none backdrop:bg-on-surface/50 backdrop:backdrop-blur-sm m-auto w-full max-w-lg bg-transparent">
    <div class="bg-surface-container-lowest rounded-2xl w-full border border-outline-variant/10 max-h-[85vh] overflow-y-auto">
      <div class="flex justify-between items-center p-6 pb-3">
        <h3 id="variants-detail-title" class="text-xl font-display font-bold text-on-surface flex items-center gap-2">
          <span class="material-symbols-outlined text-tertiary">palette</span>
          Variantes
        </h3>
        <button id="variants-detail-close" class="w-9 h-9 rounded-xl flex items-center justify-center hover:bg-error/10 hover:text-error transition-colors text-on-surface-variant">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
      <p id="variants-detail-subtitle" class="px-6 text-xs text-on-surface-variant mb-3"></p>
      <div id="variants-detail-list" class="px-6 pb-6 space-y-2"></div>
    </div>
  </dialog>

  <!-- Details Slide-Over Modal -->
  <dialog id="detail-slideover" class="fixed right-0 top-0 bottom-0 m-0 mr-0 h-full max-h-screen w-full max-w-md bg-transparent border-none p-0 z-50">
    <div class="drawer-content bg-surface-container-lowest h-full w-full rounded-l-[2rem] shadow-[-10px_0_40px_rgba(0,0,0,0.1)] flex flex-col overflow-hidden will-change-transform translate-x-full">
      <!-- Header Image Area -->
      <div class="relative h-64 shrink-0 bg-surface-container flex items-center justify-center p-6 overflow-hidden">
        <div id="detail-bg-blur" class="absolute inset-0 opacity-40 blur-2xl scale-125 transition-all"></div>
        <img id="detail-img" src="" class="relative z-10 w-full h-full object-contain filter drop-shadow-xl transition-transform hover:scale-105 duration-500" />
        <button id="detail-close" class="absolute top-4 right-4 z-20 w-10 h-10 rounded-full bg-white/80 backdrop-blur text-on-surface-variant flex items-center justify-center hover:bg-white hover:text-error hover:scale-110 shadow-sm transition-all">
          <span class="material-symbols-outlined">close</span>
        </button>
        <div id="detail-badge-status" class="absolute top-4 left-4 z-20 px-3 py-1 rounded-full text-[10px] uppercase font-bold tracking-wider backdrop-blur shadow-sm"></div>
      </div>

      <!-- Content Area -->
      <div class="flex-1 overflow-y-auto p-6 scrollbar-hide">
        <div class="mb-6">
          <div class="flex items-center gap-2 mb-2">
            <span id="detail-brand" class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-primary/10 text-primary uppercase"></span>
            <span id="detail-category" class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-surface-container-highest text-on-surface-variant uppercase"></span>
          </div>
          <h2 id="detail-name" class="text-2xl font-display font-bold text-on-surface leading-tight mb-2"></h2>
          <div class="flex items-center gap-2 text-on-surface-variant font-mono text-sm bg-surface-container-highest w-max px-2 py-1 rounded-lg">
            <span class="material-symbols-outlined text-[16px]">qr_code_2</span>
            <span id="detail-code"></span>
          </div>
          <p id="detail-desc" class="mt-4 text-sm text-on-surface-variant leading-relaxed hidden"></p>
        </div>

        <!-- Financial Dashboard Grid -->
        <div class="grid grid-cols-2 gap-3 mb-6">
          <div class="bg-surface-container-highest rounded-xl p-4">
            <p class="text-xs text-on-surface-variant font-bold uppercase tracking-wider mb-1">Costo</p>
            <p id="detail-cost" class="text-xl font-display font-bold text-on-surface"></p>
          </div>
          <div class="bg-surface-container-highest rounded-xl p-4">
            <p class="text-xs text-on-surface-variant font-bold uppercase tracking-wider mb-1">Precio</p>
            <p id="detail-price" class="text-xl font-display font-bold text-primary"></p>
          </div>
          <div id="detail-margin-box" class="col-span-2 rounded-xl p-4 flex items-center justify-between border">
            <div>
              <p class="text-xs font-bold uppercase tracking-wider mb-1" id="detail-margin-label">Margen Libre</p>
              <p id="detail-margin" class="text-2xl font-display font-bold"></p>
            </div>
            <div class="text-right">
              <p class="text-[10px] uppercase font-bold opacity-80 mb-1">Ganancia / u.</p>
              <p id="detail-profit" class="text-xl font-display font-bold"></p>
            </div>
          </div>
        </div>

        <!-- Variants Section -->
        <div id="detail-variants-container" class="hidden mb-6">
          <div class="flex items-center justify-between mb-3 border-b border-outline-variant/10 pb-2">
            <h4 class="font-bold text-sm text-on-surface">Variantes Activas</h4>
            <span id="detail-variants-count" class="text-xs font-bold px-2 py-1 rounded-full bg-tertiary/10 text-tertiary"></span>
          </div>
          <div id="detail-variants-list" class="space-y-2"></div>
        </div>
      </div>

      <!-- Action Footer -->
      <div class="p-6 bg-surface-container-lowest border-t border-outline-variant/10 flex gap-3">
        <button id="detail-btn-edit" class="flex-1 flex items-center justify-center gap-2 py-3.5 rounded-xl font-bold bg-primary text-white shadow-lg shadow-primary/20 hover:scale-[1.02] hover:shadow-primary/30 transition-all">
          <span class="material-symbols-outlined text-sm">edit</span> Editar
        </button>
        <button id="detail-btn-delete" class="w-14 h-14 rounded-xl flex items-center justify-center border-2 border-red-100 text-red-500 hover:bg-red-50 hover:border-red-200 transition-all font-bold">
          <span class="material-symbols-outlined">delete</span>
        </button>
      </div>
    </div>
  </dialog>

  <!-- Toast -->
  <div id="toast" class="fixed bottom-6 right-6 bg-green-600 text-white py-3 px-5 rounded-xl shadow-lg flex items-center gap-3 transform translate-y-20 opacity-0 transition-all duration-300 z-[100] pointer-events-none">
    <span class="material-symbols-outlined">check_circle</span>
    <span id="toast-msg" class="font-bold text-sm"></span>
  </div>
</DashboardLayout>

<style>
  .row-deleted { opacity: 0.5; }
  .row-deleted:hover { opacity: 0.8; }
  .row-deleted td { position: relative; }
  tbody tr { transition: background-color 0.15s; }
  tbody tr:hover { background-color: rgba(139, 90, 43, 0.03); }
  
  /* Buttons */
  .action-btn {
    width: 32px; height: 32px; border-radius: 8px;
    display: inline-flex; align-items: center; justify-content: center;
    transition: all 0.15s;
  }
  .action-btn:hover { transform: scale(1.1); }
  .action-edit { color: var(--color-primary); }
  .action-edit:hover { background: rgba(139, 90, 43, 0.1); }
  .action-delete { color: var(--color-error); }
  .action-delete:hover { background: rgba(179, 38, 30, 0.1); }
  .action-restore { color: #16a34a; }
  .action-restore:hover { background: rgba(22, 163, 74, 0.1); }
  .action-variants { color: var(--color-tertiary); }
  .action-variants:hover { background: rgba(125, 82, 96, 0.1); }
  .action-view { color: #0284c7; }
  .action-view:hover { background: rgba(2, 132, 199, 0.1); }
  
  .variant-row { transition: all 0.2s; }
  .variant-row:hover { background: rgba(139, 90, 43, 0.04); }

  /* Product Card Grid Styles */
  .admin-card {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
  }
  .admin-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.06);
    border-color: rgba(139, 90, 43, 0.2);
  }
  .admin-card-img { transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1); }
  .admin-card:hover .admin-card-img { transform: scale(1.1); }
  .admin-card-actions { opacity: 0; transform: translateY(10px); transition: all 0.3s; }
  .admin-card:hover .admin-card-actions { opacity: 1; transform: translateY(0); }

  /* Slide-over animations */
  #detail-slideover::backdrop {
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  #detail-slideover[open]::backdrop {
    opacity: 1;
  }
  #detail-slideover[open] .drawer-content {
    animation: slide-in-right 0.4s cubic-bezier(0.1, 0.9, 0.2, 1) forwards;
  }
  #detail-slideover.closing .drawer-content {
    animation: slide-out-right 0.3s ease-in forwards;
  }
  
  @keyframes slide-in-right {
    0% { transform: translateX(100%); }
    100% { transform: translateX(0); }
  }
  @keyframes slide-out-right {
    0% { transform: translateX(0); }
    100% { transform: translateX(100%); }
  }
  
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<script>
  import { esc } from '../../lib/security';
  import { supabase } from '../../lib/supabase';
  import api from '../../lib/api';
  import { calculateConsultantPrice } from '../../lib/camino-crecimiento';
  import type { ConsultantLevel } from '../../lib/camino-crecimiento';

  // ═════════ STATE ═════════
  let allProducts: any[] = [];
  let userLevel: ConsultantLevel = (localStorage.getItem('natura_level') as ConsultantLevel) || 'Bronce';
  let filteredProducts: any[] = [];
  let showDeleted = false;
  let viewMode: 'list' | 'grid' = 'list';
  let currentPage = 1;
  const PAGE_SIZE = 50;

  // ═════════ ELEMENTS ═════════
  const tableBody = document.getElementById('table-body')!;
  const listViewContainer = document.getElementById('list-view-container')!;
  const gridViewContainer = document.getElementById('grid-view-container')!;
  const gridBody = document.getElementById('grid-body')!;
  const btnViewList = document.getElementById('view-list')!;
  const btnViewGrid = document.getElementById('view-grid')!;
  
  const loadingEl = document.getElementById('loading')!;
  const emptyEl = document.getElementById('empty-state')!;
  const searchInput = document.getElementById('search') as HTMLInputElement;
  const filterBrand = document.getElementById('filter-brand') as HTMLSelectElement;
  const filterCat = document.getElementById('filter-category') as HTMLSelectElement;
  const toggleDeletedBtn = document.getElementById('btn-toggle-deleted')!;
  const toggleDeletedLabel = document.getElementById('toggle-deleted-label')!;
  const pagination = document.getElementById('pagination')!;
  const prevBtn = document.getElementById('prev-page') as HTMLButtonElement;
  const nextBtn = document.getElementById('next-page') as HTMLButtonElement;
  const pageInfo = document.getElementById('page-info')!;

  // Modals
  const editModal = document.getElementById('edit-modal') as HTMLDialogElement;
  const deleteModal = document.getElementById('delete-modal') as HTMLDialogElement;
  const detailModal = document.getElementById('detail-slideover') as HTMLDialogElement;
  
  let currentDetailProduct: any = null;

  // ═════════ AUTH ═════════
  supabase.auth.getSession().then(async ({ data: { session } }: any) => {
    if (!session) { window.location.href = '/login'; return; }
    
    try {
      const { data: profile } = await supabase
        .from('consultant_profiles')
        .select('latest_growth_data')
        .eq('id', session.user.id)
        .single();

      if (profile?.latest_growth_data?.level?.description) {
        const desc = profile.latest_growth_data.level.description as string;
        const levelMap: Record<string, ConsultantLevel> = {
          'Bronce': 'Bronce', 'Plata': 'Plata', 'Oro': 'Oro',
          'Zafiro': 'Zafiro', 'Diamante': 'Diamante',
          'BRONCE': 'Bronce', 'PLATA': 'Plata', 'ORO': 'Oro',
          'ZAFIRO': 'Zafiro', 'DIAMANTE': 'Diamante',
        };
        const detectedLevel = Object.entries(levelMap).find(([key]) => desc.includes(key));
        if (detectedLevel) {
          userLevel = detectedLevel[1];
          localStorage.setItem('natura_level', userLevel);
        }
      }
    } catch (e) { /* use localStorage fallback */ }

    loadProducts();
  });

  // ═════════ LOAD PRODUCTS ═════════
  async function loadProducts() {
    loadingEl.classList.remove('hidden');
    emptyEl.classList.add('hidden');
    tableBody.innerHTML = '';

    let data: any[] = [];
    let error: any = null;
    try {
      data = await api.products.listAll(true);
    } catch(e: any) {
      // Fallback to regular list if listAll not deployed yet
      try { data = await api.products.list({ limit: 5000 }); } catch(e2: any) { error = e2; }
    }

    loadingEl.classList.add('hidden');

    if (error) {
      console.error('Error loading products:', error);
      emptyEl.classList.remove('hidden');
      return;
    }

    allProducts = (data || []).map((item: any) => {
      let price = parseFloat(item.price) || 0;
      let cost = parseFloat(item.cost) || 0;
      if (cost === 0 && price > 0) {
        cost = calculateConsultantPrice(price, userLevel, item.brand, item.category);
      }
      return { ...item, cost, price };
    });
    
    populateFilters();
    updateKPIs();
    applyFilters();
  }

  // ═════════ FILTERS ═════════
  function populateFilters() {
    const active = allProducts.filter(p => !p.deleted_at);
    const brands = [...new Set(active.map(p => p.brand).filter(Boolean))].sort() as string[];
    const cats = [...new Set(active.map(p => p.category).filter(Boolean))].sort() as string[];

    filterBrand.innerHTML = '<option value="all">Todas las marcas</option>';
    brands.forEach(b => { const o = document.createElement('option'); o.value = b; o.textContent = b; filterBrand.appendChild(o); });

    filterCat.innerHTML = '<option value="all">Todas las categorías</option>';
    cats.forEach(c => { const o = document.createElement('option'); o.value = c; o.textContent = c; filterCat.appendChild(o); });
  }

  function applyFilters() {
    const q = searchInput.value.toLowerCase().trim();
    const brand = filterBrand.value;
    const cat = filterCat.value;

    filteredProducts = allProducts.filter(p => {
      if (!showDeleted && p.deleted_at) return false;
      const ms = !q || p.name?.toLowerCase().includes(q) || p.code?.toLowerCase().includes(q) || p.brand?.toLowerCase().includes(q);
      const mb = brand === 'all' || p.brand === brand;
      const mc = cat === 'all' || p.category === cat;
      return ms && mb && mc;
    });

    currentPage = 1;
    renderTable();
  }

  // ═════════ KPIs ═════════
  function updateKPIs() {
    const active = allProducts.filter(p => !p.deleted_at);
    const deleted = allProducts.filter(p => p.deleted_at);

    (document.getElementById('kpi-total') as HTMLElement).textContent = String(active.length);
    (document.getElementById('kpi-brands') as HTMLElement).textContent = String([...new Set(active.map(p => p.brand).filter(Boolean))].length);
    (document.getElementById('kpi-categories') as HTMLElement).textContent = String([...new Set(active.map(p => p.category).filter(Boolean))].length);
    (document.getElementById('kpi-deleted') as HTMLElement).textContent = String(deleted.length);

    // Avg margin
    const withMargin = active.filter(p => Number(p.price) > 0 && Number(p.cost) > 0);
    if (withMargin.length > 0) {
      const avgMargin = withMargin.reduce((sum, p) => sum + ((Number(p.price) - Number(p.cost)) / Number(p.price) * 100), 0) / withMargin.length;
      (document.getElementById('kpi-avg-margin') as HTMLElement).textContent = avgMargin.toFixed(0) + '%';
    }
  }

  // ═════════ RENDER TABLE ═════════
  // ═════════ RENDER TABLE & GRID ═════════
  function renderTable() {
    tableBody.innerHTML = '';
    gridBody.innerHTML = '';
    const totalPages = Math.ceil(filteredProducts.length / PAGE_SIZE);
    const start = (currentPage - 1) * PAGE_SIZE;
    const page = filteredProducts.slice(start, start + PAGE_SIZE);

    (document.getElementById('results-count') as HTMLElement).textContent = `${filteredProducts.length} productos${showDeleted ? ' (incluyendo eliminados)' : ''}`;

    if (filteredProducts.length === 0) {
      emptyEl.classList.remove('hidden');
    } else {
      emptyEl.classList.add('hidden');
    }

    // Pagination
    if (totalPages > 1) {
      pagination.classList.remove('hidden');
      pageInfo.textContent = `${currentPage} / ${totalPages}`;
      prevBtn.disabled = currentPage <= 1;
      nextBtn.disabled = currentPage >= totalPages;
    } else {
      pagination.classList.add('hidden');
    }

    page.forEach(p => {
      const isDeleted = !!p.deleted_at;
      const margin = Number(p.price) && Number(p.cost) ? ((Number(p.price) - Number(p.cost)) / Number(p.price) * 100).toFixed(0) : '—';
      const marginColor = parseInt(margin) >= 30 ? 'text-green-600' : parseInt(margin) >= 15 ? 'text-amber-600' : 'text-red-500';
      const marginBg = parseInt(margin) >= 30 ? 'bg-green-100/50 text-green-700' : parseInt(margin) >= 15 ? 'bg-amber-100/50 text-amber-700' : 'bg-red-100/50 text-red-700';
      const brandColor = p.brand === 'Avon' ? 'bg-fuchsia-100 text-fuchsia-700'
        : p.brand === 'Casa & Estilo' ? 'bg-cyan-100 text-cyan-700'
          : 'bg-primary/10 text-primary';
      const vc = p.variant_count || 0;
      
      const variantCell = vc > 0
        ? `<button class="action-btn action-variants" data-variants="${p.id}" title="Ver ${vc} variantes"><span class="inline-flex items-center gap-0.5 text-[10px] font-bold px-2 py-0.5 bg-tertiary/10 text-tertiary rounded-full"><span class="material-symbols-outlined text-xs">palette</span>${vc}</span></button>`
        : `<span class="text-on-surface-variant/30 text-xs">—</span>`;

      // --- RENDER LIST ROW ---
      const tr = document.createElement('tr');
      tr.className = isDeleted ? 'row-deleted' : '';
      tr.innerHTML = `
        <td class="px-3 py-2.5">
          ${p.image_url
          ? `<img src="${p.image_url}" alt="" class="w-10 h-10 object-contain rounded-lg bg-white shadow-sm" loading="lazy" />`
          : `<div class="w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center"><span class="material-symbols-outlined text-sm text-on-surface-variant/30">spa</span></div>`}
        </td>
        <td class="px-4 py-2.5 cursor-pointer action-view group" data-view="${p.id}">
          <p class="font-bold text-on-surface text-xs leading-tight line-clamp-1 group-hover:text-primary transition-colors" title="${esc(p.name)}">${esc(p.name)}</p>
          ${p.description ? `<p class="text-[10px] text-on-surface-variant/60 truncate max-w-[200px]" title="${p.description}">${p.description}</p>` : ''}
        </td>
        <td class="px-4 py-2.5"><span class="text-xs font-mono text-on-surface-variant bg-surface-container-highest px-1.5 py-0.5 rounded">${p.code}</span></td>
        <td class="px-4 py-2.5"><span class="text-[10px] font-bold px-2 py-0.5 ${brandColor} rounded-full">${p.brand || '—'}</span></td>
        <td class="px-4 py-2.5 text-xs text-on-surface-variant">${p.category || '—'}</td>
        <td class="px-4 py-2.5 text-center">${variantCell}</td>
        <td class="px-4 py-2.5 text-right font-mono text-xs">$${Number(p.cost || 0).toFixed(0)}</td>
        <td class="px-4 py-2.5 text-right font-mono text-xs font-bold text-primary">$${Number(p.price || 0).toFixed(0)}</td>
        <td class="px-4 py-2.5 text-right text-xs font-bold ${marginColor}">${margin}%</td>
        <td class="px-4 py-2.5 text-center">${p.points ? `<span class="text-[10px] font-bold text-amber-600">${p.points}</span>` : '<span class="text-on-surface-variant/30">—</span>'}</td>
        <td class="px-4 py-2.5 text-center">
          ${isDeleted
          ? `<span class="text-[10px] font-bold px-2 py-0.5 bg-red-100 text-red-600 rounded-full">Eliminado</span>`
          : `<span class="text-[10px] font-bold px-2 py-0.5 bg-green-100 text-green-700 rounded-full">Activo</span>`}
        </td>
        <td class="px-4 py-2.5 text-center">
          ${isDeleted
          ? `<button class="action-btn action-restore" data-restore="${p.id}" title="Restaurar"><span class="material-symbols-outlined text-base">undo</span></button>`
          : `<button class="action-btn action-view" data-view="${p.id}" title="Ver Detalles"><span class="material-symbols-outlined text-base">visibility</span></button>
             <button class="action-btn action-edit" data-edit="${p.id}" title="Editar"><span class="material-symbols-outlined text-base">edit</span></button>`}
        </td>
      `;
      tableBody.appendChild(tr);

      // --- RENDER GRID CARD ---
      const card = document.createElement('div');
      card.className = `admin-card bg-surface-container-lowest rounded-2xl overflow-hidden shadow-sm border border-outline-variant/10 flex flex-col relative group ${isDeleted ? 'opacity-50 grayscale' : ''}`;
      
      const badgeHTML = isDeleted 
        ? `<span class="absolute top-3 left-3 text-[10px] font-bold px-2.5 py-1 rounded-full bg-red-500 text-white shadow-sm z-10">Eliminado</span>`
        : `<span class="absolute top-3 left-3 text-[10px] font-bold px-2.5 py-1 rounded-full ${brandColor} shadow-sm z-10">${p.brand || 'General'}</span>`;

      card.innerHTML = `
        <div class="h-44 bg-gradient-to-br from-primary-container/10 to-secondary-container/10 flex items-center justify-center overflow-hidden relative" data-view="${p.id}">
          ${p.image_url
            ? `<img src="${p.image_url}" class="admin-card-img w-full h-full object-contain p-2 relative z-0" loading="lazy"/>`
            : `<span class="material-symbols-outlined text-primary/20 text-6xl relative z-0">spa</span>`}
          ${badgeHTML}
          <div class="absolute top-3 right-3 flex flex-col gap-1 items-end z-10">
            <span class="text-[10px] font-bold px-2 py-1 rounded-full ${marginBg} backdrop-blur">Margen ${margin}%</span>
            ${vc > 0 ? `<span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-tertiary/90 text-white shadow-sm flex items-center gap-1"><span class="material-symbols-outlined text-xs">palette</span>${vc} vars</span>` : ''}
          </div>
        </div>
        <div class="p-4 flex-1 flex flex-col">
          <span class="text-[10px] font-bold uppercase tracking-wider text-primary/70">${esc(p.category) || 'General'}</span>
          <h3 class="font-bold text-on-surface text-sm mt-0.5 leading-tight line-clamp-2 cursor-pointer hover:underline" data-view="${p.id}">${esc(p.name)}</h3>
          <p class="text-[10px] text-on-surface-variant/50 font-mono mt-1">#${esc(p.code)}</p>
          
          <div class="mt-auto pt-3 flex items-end justify-between">
            <div>
              <p class="text-[10px] text-on-surface-variant uppercase font-bold">Precio / Costo</p>
              <div class="flex items-baseline gap-1.5">
                <p class="text-lg font-display font-bold text-primary">$${Number(p.price || 0).toFixed(0)}</p>
                <p class="text-xs font-mono text-on-surface-variant/60 line-through">$${Number(p.cost || 0).toFixed(0)}</p>
              </div>
            </div>
            <div class="admin-card-actions flex gap-1">
              ${isDeleted
                ? `<button class="w-8 h-8 rounded-lg bg-green-50 text-green-600 flex items-center justify-center hover:bg-green-100 transition-colors" data-restore="${p.id}" title="Restaurar"><span class="material-symbols-outlined text-sm">undo</span></button>`
                : `<button class="w-8 h-8 rounded-lg bg-primary/10 text-primary flex items-center justify-center hover:bg-primary/20 transition-colors" data-edit="${p.id}" title="Editar"><span class="material-symbols-outlined text-sm">edit</span></button>
                   <button class="w-8 h-8 rounded-lg bg-red-50 text-red-500 flex items-center justify-center hover:bg-red-100 transition-colors" data-delete="${p.id}" data-name="${encodeURIComponent(p.name)}" title="Eliminar"><span class="material-symbols-outlined text-sm">delete</span></button>`}
            </div>
          </div>
        </div>
      `;
      gridBody.appendChild(card);
    });

    bindActions();
  }

  // ═════════ BIND ROW ACTIONS ═════════
  const variantsDetailModal = document.getElementById('variants-detail-modal') as HTMLDialogElement;
  document.getElementById('variants-detail-close')!.addEventListener('click', () => variantsDetailModal.close());

  function bindActions() {
    // Both Table and Grid bindings
    const bindGroup = (selector: string, cb: (btn: HTMLElement, p: any) => void) => {
      document.querySelectorAll(selector).forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const id = (btn as HTMLElement).dataset[selector.replace('[data-', '').replace(']', '')];
          const product = allProducts.find(p => p.id === id);
          if (product) cb(btn as HTMLElement, product);
        });
      });
    };

    bindGroup('[data-view]', (btn, p) => openDetailSlideover(p));
    bindGroup('[data-edit]', (btn, p) => openEditModal(p));
    bindGroup('[data-variants]', (btn, p) => openVariantsDetail(p));
    
    // Delete
    document.querySelectorAll('[data-delete]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = (btn as HTMLElement).dataset.delete!;
        const name = decodeURIComponent((btn as HTMLElement).dataset.name || '');
        openDeleteModal(id, name);
      });
    });

    // Restore
    tableBody.querySelectorAll('[data-restore]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = (btn as HTMLElement).dataset.restore!;
        try {
          await api.products.restore(id);
          showToast('¡Producto restaurado! ✅');
          await loadProducts();
        } catch(e: any) { showToast('Error al restaurar: ' + e.message, true); }
      });
    });

    // Variants
    tableBody.querySelectorAll('[data-variants]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const pid = (btn as HTMLElement).dataset.variants!;
        const product = allProducts.find(p => p.id === pid);
        if (!product) return;
        await openVariantsDetail(product);
      });
    });
  }

  // ═════════ VARIANTS DETAIL ═════════
  async function openVariantsDetail(product: any) {
    const title = document.getElementById('variants-detail-title') as HTMLElement;
    const subtitle = document.getElementById('variants-detail-subtitle') as HTMLElement;
    const list = document.getElementById('variants-detail-list') as HTMLElement;

    title.innerHTML = `<span class="material-symbols-outlined text-tertiary">palette</span> ${esc(product.name)}`;
    subtitle.textContent = 'Cargando variantes...';
    list.innerHTML = '';
    variantsDetailModal.showModal();

    // Fetch variants from Supabase
    const { data: variants, error } = await supabase
      .from('product_variants')
      .select('id, code, variant_label, variant_type, price, points, image_url, sort_order')
      .eq('product_id', product.id)
      .is('deleted_at', null)
      .order('sort_order', { ascending: true });

    if (error || !variants) {
      subtitle.textContent = 'Error al cargar variantes';
      return;
    }

    subtitle.textContent = `${variants.length} variantes • ${product.category || 'Sin categoría'}`;

    variants.forEach((v: any) => {
      const vPrice = v.price || product.price;
      const row = document.createElement('div');
      row.className = 'variant-row flex items-center gap-3 p-3 rounded-xl bg-surface-container border border-outline-variant/10';
      row.innerHTML = `
        ${v.image_url
          ? `<img src="${v.image_url}" class="w-10 h-10 object-contain rounded-lg bg-white shadow-sm"/>`
          : `<div class="w-10 h-10 rounded-lg bg-surface-container-highest flex items-center justify-center"><span class="material-symbols-outlined text-on-surface-variant/30 text-sm">spa</span></div>`}
        <div class="flex-1 min-w-0">
          <p class="font-bold text-on-surface text-sm">${esc(v.variant_label)}</p>
          <div class="flex items-center gap-2 mt-0.5">
            <span class="text-[10px] font-mono text-on-surface-variant bg-surface-container-highest px-1.5 py-0.5 rounded">${v.code}</span>
            <span class="text-[10px] font-bold px-1.5 py-0.5 bg-tertiary/10 text-tertiary rounded-full">${v.variant_type || 'tono'}</span>
          </div>
        </div>
        <div class="text-right">
          <p class="font-display font-bold text-primary text-sm">$${Number(vPrice).toFixed(0)}</p>
          ${v.points ? `<p class="text-[10px] text-amber-600 font-bold">${v.points} pts</p>` : ''}
        </div>`;
      list.appendChild(row);
    });
  }

  // ═════════ DETAILS SLIDEOVER ═════════
  async function openDetailSlideover(product: any) {
    currentDetailProduct = product;
    const isDeleted = !!product.deleted_at;

    // Header/Image
    const imgEl = document.getElementById('detail-img') as HTMLImageElement;
    const bgBlur = document.getElementById('detail-bg-blur')!;
    if (product.image_url) {
      imgEl.src = product.image_url;
      imgEl.style.display = 'block';
      bgBlur.style.backgroundImage = `url(${product.image_url})`;
      bgBlur.style.backgroundSize = 'cover';
      bgBlur.style.backgroundPosition = 'center';
    } else {
      imgEl.style.display = 'none';
      bgBlur.style.backgroundImage = 'none';
      bgBlur.style.backgroundColor = 'var(--color-primary-container)';
    }

    const badge = document.getElementById('detail-badge-status')!;
    if (isDeleted) {
      badge.textContent = 'Eliminado';
      badge.className = 'absolute top-4 left-4 z-20 px-3 py-1 rounded-full text-[10px] uppercase font-bold tracking-wider backdrop-blur shadow-sm bg-red-500/80 text-white';
    } else {
      badge.textContent = 'Activo';
      badge.className = 'absolute top-4 left-4 z-20 px-3 py-1 rounded-full text-[10px] uppercase font-bold tracking-wider backdrop-blur shadow-sm bg-green-500/80 text-white';
    }

    // Top data
    document.getElementById('detail-name')!.textContent = product.name;
    document.getElementById('detail-code')!.textContent = product.code;
    document.getElementById('detail-brand')!.textContent = product.brand || 'Natura';
    document.getElementById('detail-category')!.textContent = product.category || 'Categoría';

    const descEl = document.getElementById('detail-desc')!;
    if (product.description) {
      descEl.textContent = product.description;
      descEl.classList.remove('hidden');
    } else {
      descEl.classList.add('hidden');
    }

    // Financials
    const cost = parseFloat(product.cost) || 0;
    const price = parseFloat(product.price) || 0;
    const margin = price > 0 ? ((price - cost) / price * 100) : 0;
    
    document.getElementById('detail-cost')!.textContent = `$${cost.toFixed(2)}`;
    document.getElementById('detail-price')!.textContent = `$${price.toFixed(2)}`;
    document.getElementById('detail-margin')!.textContent = `${margin.toFixed(1)}%`;
    document.getElementById('detail-profit')!.textContent = `$${(price - cost).toFixed(2)}`;
    
    const marginBox = document.getElementById('detail-margin-box')!;
    if (margin >= 25) {
      marginBox.className = 'col-span-2 rounded-xl p-4 flex items-center justify-between border bg-green-50 border-green-200 text-green-700';
    } else if (margin >= 15) {
      marginBox.className = 'col-span-2 rounded-xl p-4 flex items-center justify-between border bg-amber-50 border-amber-200 text-amber-700';
    } else {
      marginBox.className = 'col-span-2 rounded-xl p-4 flex items-center justify-between border bg-red-50 border-red-200 text-red-700';
    }

    // Action buttons in footer
    const btnEdit = document.getElementById('detail-btn-edit') as HTMLButtonElement;
    const btnDel = document.getElementById('detail-btn-delete') as HTMLButtonElement;
    
    if (isDeleted) {
      btnDel.innerHTML = '<span class="material-symbols-outlined">undo</span>';
      btnDel.title = 'Restaurar';
      btnDel.className = 'w-14 h-14 rounded-xl flex items-center justify-center border-2 border-green-100 text-green-500 hover:bg-green-50 hover:border-green-200 transition-all font-bold';
    } else {
      btnDel.innerHTML = '<span class="material-symbols-outlined">delete</span>';
      btnDel.title = 'Eliminar';
      btnDel.className = 'w-14 h-14 rounded-xl flex items-center justify-center border-2 border-red-100 text-red-500 hover:bg-red-50 hover:border-red-200 transition-all font-bold';
    }

    // Variants (lazy load if has any)
    const varContainer = document.getElementById('detail-variants-container')!;
    const varCount = document.getElementById('detail-variants-count')!;
    const varList = document.getElementById('detail-variants-list')!;
    
    if (product.variant_count > 0) {
      varContainer.classList.remove('hidden');
      varCount.textContent = 'Cargando...';
      varList.innerHTML = '';
      
      const { data: variants } = await supabase
        .from('product_variants')
        .select('id, code, variant_label, variant_type, price, points, image_url, sort_order')
        .eq('product_id', product.id)
        .is('deleted_at', null)
        .order('sort_order', { ascending: true });

      if (variants) {
        varCount.textContent = `${variants.length} opciones`;
        variants.forEach((v: any) => {
          const vPrice = v.price || product.price;
          const row = document.createElement('div');
          row.className = 'flex items-center gap-3 p-2 rounded-xl border border-outline-variant/10 shadow-sm bg-white';
          row.innerHTML = `
            ${v.image_url ? `<img src="${v.image_url}" class="w-8 h-8 object-contain rounded-lg"/>` : `<div class="w-8 h-8 rounded-lg bg-surface-container flex items-center justify-center"><span class="material-symbols-outlined text-[10px] opacity-30">spa</span></div>`}
            <div class="flex-1 min-w-0">
              <p class="font-bold text-on-surface text-xs truncate">${esc(v.variant_label)}</p>
              <p class="text-[10px] text-on-surface-variant font-mono">#${v.code}</p>
            </div>
            <p class="font-display font-bold text-primary text-sm">$${Number(vPrice).toFixed(0)}</p>`;
          varList.appendChild(row);
        });
      }
    } else {
      varContainer.classList.add('hidden');
    }

    detailModal.showModal();
  }

  // Slideover close animation
  document.getElementById('detail-close')!.addEventListener('click', () => {
    detailModal.classList.add('closing');
    setTimeout(() => {
      detailModal.close();
      detailModal.classList.remove('closing');
    }, 300);
  });

  // Slideover footer actions
  document.getElementById('detail-btn-edit')!.addEventListener('click', () => {
    if (currentDetailProduct) {
      detailModal.close();
      openEditModal(currentDetailProduct);
    }
  });

  document.getElementById('detail-btn-delete')!.addEventListener('click', async () => {
    if (currentDetailProduct) {
      const isDeleted = !!currentDetailProduct.deleted_at;
      detailModal.close();
      if (isDeleted) {
        // Restore
        try {
          await api.products.restore(currentDetailProduct.id);
          showToast('¡Producto restaurado! ✅'); loadProducts();
        } catch(e) { console.warn('[Productos] Failed to restore product:', e); }
      } else {
        openDeleteModal(currentDetailProduct.id, currentDetailProduct.name);
      }
    }
  });

  // ═════════ EDIT MODAL ═════════
  function openEditModal(product: any) {
    (document.getElementById('edit-id') as HTMLInputElement).value = product.id;
    (document.getElementById('edit-name') as HTMLInputElement).value = product.name || '';
    (document.getElementById('edit-code') as HTMLInputElement).value = product.code || '';
    (document.getElementById('edit-brand') as HTMLInputElement).value = product.brand || '';
    (document.getElementById('edit-category') as HTMLSelectElement).value = product.category || 'Perfumería';
    (document.getElementById('edit-cost') as HTMLInputElement).value = product.cost || '';
    (document.getElementById('edit-price') as HTMLInputElement).value = product.price || '';
    (document.getElementById('edit-points') as HTMLInputElement).value = product.points || '';
    (document.getElementById('edit-image') as HTMLInputElement).value = product.image_url || '';
    (document.getElementById('edit-description') as HTMLTextAreaElement).value = product.description || '';
    document.getElementById('edit-error')!.classList.add('hidden');
    updateMarginPreview();
    editModal.showModal();
  }

  function updateMarginPreview() {
    const cost = parseFloat((document.getElementById('edit-cost') as HTMLInputElement).value) || 0;
    const price = parseFloat((document.getElementById('edit-price') as HTMLInputElement).value) || 0;
    const preview = document.getElementById('edit-margin-preview')!;
    const marginEl = document.getElementById('edit-margin-value')!;
    const profitEl = document.getElementById('edit-profit-value')!;

    if (price > 0 && cost > 0) {
      const margin = ((price - cost) / price * 100);
      const profit = price - cost;
      marginEl.textContent = margin.toFixed(1) + '%';
      profitEl.textContent = '$' + profit.toFixed(2);

      const isGood = margin >= 25;
      preview.className = `flex items-center gap-4 rounded-xl p-4 border ${isGood ? 'bg-green-50 border-green-200' : 'bg-amber-50 border-amber-200'}`;
      const color = isGood ? 'text-green-600' : 'text-amber-600';
      marginEl.className = `text-xl font-display font-bold ${color}`;
      profitEl.className = `text-xl font-display font-bold ${color}`;
    } else {
      marginEl.textContent = '—%';
      profitEl.textContent = '$—';
    }
  }

  document.getElementById('edit-cost')!.addEventListener('input', updateMarginPreview);
  document.getElementById('edit-price')!.addEventListener('input', updateMarginPreview);

  document.getElementById('edit-close')!.addEventListener('click', () => editModal.close());
  document.getElementById('edit-cancel')!.addEventListener('click', () => editModal.close());

  document.getElementById('edit-save')!.addEventListener('click', async () => {
    const id = (document.getElementById('edit-id') as HTMLInputElement).value;
    const name = (document.getElementById('edit-name') as HTMLInputElement).value.trim();
    const code = (document.getElementById('edit-code') as HTMLInputElement).value.trim();
    const brand = (document.getElementById('edit-brand') as HTMLInputElement).value.trim();
    const category = (document.getElementById('edit-category') as HTMLSelectElement).value;
    const cost = parseFloat((document.getElementById('edit-cost') as HTMLInputElement).value);
    const price = parseFloat((document.getElementById('edit-price') as HTMLInputElement).value);
    const points = parseInt((document.getElementById('edit-points') as HTMLInputElement).value) || 0;
    const image_url = (document.getElementById('edit-image') as HTMLInputElement).value.trim() || null;
    const description = (document.getElementById('edit-description') as HTMLTextAreaElement).value.trim() || null;

    if (!name || !code || !cost || !price) {
      const errEl = document.getElementById('edit-error')!;
      errEl.textContent = 'Nombre, código, costo y precio son requeridos.';
      errEl.classList.remove('hidden');
      return;
    }

    const btn = document.getElementById('edit-save') as HTMLButtonElement;
    btn.disabled = true;
    btn.innerHTML = '<span class="material-symbols-outlined text-sm animate-spin">refresh</span> Guardando...';

    let error: any = null;
    try {
      await api.products.update(id, { name, code, brand, category, cost, price, points, image_url, description });
    } catch(e: any) { error = e; }

    btn.disabled = false;
    btn.innerHTML = '<span class="material-symbols-outlined text-sm">save</span> Guardar Cambios';

    if (error) {
      const errEl = document.getElementById('edit-error')!;
      errEl.textContent = 'Error: ' + error.message;
      errEl.classList.remove('hidden');
      return;
    }

    editModal.close();
    showToast('¡Producto actualizado! ✅');
    await loadProducts();
  });

  // ═════════ DELETE MODAL ═════════
  function openDeleteModal(id: string, name: string) {
    (document.getElementById('delete-id') as HTMLInputElement).value = id;
    document.getElementById('delete-product-name')!.textContent = `"${name}" será removido del catálogo activo.`;
    deleteModal.showModal();
  }

  document.getElementById('delete-cancel')!.addEventListener('click', () => deleteModal.close());

  document.getElementById('delete-confirm')!.addEventListener('click', async () => {
    const id = (document.getElementById('delete-id') as HTMLInputElement).value;

    const btn = document.getElementById('delete-confirm') as HTMLButtonElement;
    btn.disabled = true;
    btn.innerHTML = '<span class="material-symbols-outlined text-sm animate-spin">refresh</span> Eliminando...';

    let error: any = null;
    try { await api.products.delete(id); } catch(e: any) { error = e; }

    btn.disabled = false;
    btn.innerHTML = '<span class="material-symbols-outlined text-sm">delete</span> Sí, desactivar';

    if (error) {
      showToast('Error: ' + error.message, true);
      return;
    }

    deleteModal.close();
    showToast('Producto desactivado correctamente');
    await loadProducts();
  });

  // ═════════ TOGGLE DELETED ═════════
  toggleDeletedBtn.addEventListener('click', () => {
    showDeleted = !showDeleted;
    toggleDeletedLabel.textContent = showDeleted ? 'Ocultar Eliminados' : 'Mostrar Eliminados';

    if (showDeleted) {
      toggleDeletedBtn.className = 'flex items-center gap-2 py-3 px-5 rounded-xl font-bold bg-amber-100 text-amber-700 border-2 border-amber-300 transition-all text-sm';
    } else {
      toggleDeletedBtn.className = 'flex items-center gap-2 py-3 px-5 rounded-xl font-bold border-2 border-outline-variant/15 text-on-surface-variant hover:bg-amber-50 hover:text-amber-700 hover:border-amber-200 transition-all text-sm';
    }

    applyFilters();
  });

  // ═════════ VIEW TOGGLES ═════════
  function updateViewMode() {
    if (viewMode === 'list') {
      listViewContainer.classList.remove('hidden');
      gridViewContainer.classList.add('hidden');
      btnViewList.className = 'w-9 h-9 rounded-lg bg-primary text-white flex items-center justify-center transition-colors shadow-sm';
      btnViewGrid.className = 'w-9 h-9 rounded-lg text-on-surface-variant hover:bg-surface-container flex items-center justify-center transition-colors';
    } else {
      listViewContainer.classList.add('hidden');
      gridViewContainer.classList.remove('hidden');
      btnViewGrid.className = 'w-9 h-9 rounded-lg bg-primary text-white flex items-center justify-center transition-colors shadow-sm';
      btnViewList.className = 'w-9 h-9 rounded-lg text-on-surface-variant hover:bg-surface-container flex items-center justify-center transition-colors';
    }
  }

  btnViewList.addEventListener('click', () => { viewMode = 'list'; updateViewMode(); });
  btnViewGrid.addEventListener('click', () => { viewMode = 'grid'; updateViewMode(); });

  // Init views
  updateViewMode();

  // ═════════ FILTER EVENTS ═════════
  let searchTimer: any;
  searchInput.addEventListener('input', () => { clearTimeout(searchTimer); searchTimer = setTimeout(applyFilters, 150); });
  filterBrand.addEventListener('change', applyFilters);
  filterCat.addEventListener('change', applyFilters);

  // Pagination
  prevBtn.addEventListener('click', () => { currentPage--; renderTable(); window.scrollTo({ top: 0, behavior: 'smooth' }); });
  nextBtn.addEventListener('click', () => { currentPage++; renderTable(); window.scrollTo({ top: 0, behavior: 'smooth' }); });

  // ═════════ TOAST ═════════
  function showToast(message: string, isError = false) {
    const toast = document.getElementById('toast')!;
    const msgEl = document.getElementById('toast-msg')!;
    msgEl.textContent = message;
    toast.className = `fixed bottom-6 right-6 ${isError ? 'bg-red-500' : 'bg-green-600'} text-white py-3 px-5 rounded-xl shadow-lg flex items-center gap-3 transform translate-y-0 opacity-100 transition-all duration-300 z-50`;

    setTimeout(() => {
      toast.className = 'fixed bottom-6 right-6 bg-green-600 text-white py-3 px-5 rounded-xl shadow-lg flex items-center gap-3 transform translate-y-20 opacity-0 transition-all duration-300 z-50 pointer-events-none';
    }, 3000);
  }
</script>
