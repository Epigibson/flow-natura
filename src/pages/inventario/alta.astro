---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout>
  <div class="max-w-7xl mx-auto space-y-10">
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4">
      <div>
        <h1 class="text-3xl md:text-5xl font-extrabold text-primary mb-2 font-headline">Alta de Stock</h1>
        <p class="text-on-surface-variant text-base md:text-xl">Digitaliza tu inventario con precisión editorial.</p>
      </div>
      <button id="btn-confirm-all" class="w-full sm:w-auto bg-gradient-to-r from-primary to-primary-container text-white px-6 py-3.5 rounded-xl font-bold text-sm md:text-lg shadow-xl hover:shadow-primary-container/20 transition-all flex items-center justify-center gap-2 active:scale-95 disabled:opacity-50">
        <span class="material-symbols-outlined shrink-0" style="font-variation-settings: 'FILL' 1;">check_circle</span>
        Confirmar Entrada
      </button>
    </div>

    <div id="global-error" class="hidden bg-error-container text-error px-6 py-4 rounded-2xl font-bold"></div>
    <div id="global-success" class="hidden bg-secondary-container text-secondary px-6 py-4 rounded-2xl font-bold flex items-center gap-2">
      <span class="material-symbols-outlined text-2xl">check_circle</span>
      ¡Inventario actualizado correctamente!
    </div>

    <!-- Bento Grid Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 md:gap-8">
      <!-- Section: Escaneo Rápido -->
      <div class="lg:col-span-7 bg-surface-container-low rounded-[2rem] p-6 md:p-8 space-y-6">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-3">
            <span class="p-3 bg-primary-container/20 text-primary rounded-xl material-symbols-outlined">barcode_scanner</span>
            <h2 class="text-2xl font-bold text-on-surface font-headline">Búsqueda Rápida</h2>
          </div>
        </div>
        
        <div class="relative group">
          <input id="search-code" autofocus class="w-full bg-surface-container-lowest border-none rounded-2xl p-6 text-2xl font-mono text-primary placeholder:text-outline-variant focus:ring-4 focus:ring-primary-container/10 transition-all shadow-inner" placeholder="Escanear código o nombre..." type="text"/>
          <div class="absolute right-6 top-1/2 -translate-y-1/2 flex items-center gap-4">
            <button id="btn-search" class="text-primary hover:bg-primary-container/10 p-2 rounded-lg transition-colors">
              <span class="material-symbols-outlined">search</span>
            </button>
          </div>
        </div>

        <div id="search-results" class="hidden bg-surface-container-lowest p-6 rounded-2xl border border-primary/5 flex items-center justify-between mt-4">
          <div class="flex flex-col gap-1">
            <h3 id="res-name" class="text-xl font-bold text-primary font-headline">Natura Ekos Castanha</h3>
            <p id="res-cat" class="text-on-surface-variant font-medium text-sm">Cuerpo</p>
            <p id="res-code" class="text-sm text-outline mt-1 italic font-mono">Código: 789103345229</p>
          </div>
        </div>
        <div id="search-not-found" class="hidden px-4 py-3 bg-error-container text-error rounded-xl font-bold text-sm">
          Producto no encontrado en el catálogo. Necesitas <a href="/inventario/nuevo" class="underline">Crearlo Primero</a>.
        </div>
      </div>

      <!-- Section: Formulario de Entrada -->
      <div class="lg:col-span-5 bg-white rounded-[2rem] p-6 md:p-8 shadow-sm border border-surface-container">
        <h2 class="text-2xl font-bold text-on-surface mb-8 flex items-center gap-3 font-headline">
          <span class="material-symbols-outlined text-primary">edit_note</span>
          Detalles de Ingreso
        </h2>
        <form id="add-item-form" class="space-y-6">
          <!-- Nivel de Consultora -->
          <div>
            <label class="text-sm font-bold text-on-surface-variant ml-1 mb-2 block">Tu Nivel</label>
            <div id="alta-level-selector" class="flex flex-wrap gap-1.5">
              <button type="button" data-level="Bronce" class="alta-level-chip px-2.5 py-1.5 rounded-lg text-[10px] font-bold border-2 transition-all border-orange-300 bg-orange-50 text-orange-700">🥉 Bronce</button>
              <button type="button" data-level="Plata" class="alta-level-chip px-2.5 py-1.5 rounded-lg text-[10px] font-bold border-2 transition-all border-outline-variant/20 text-on-surface-variant">🥈 Plata</button>
              <button type="button" data-level="Oro" class="alta-level-chip px-2.5 py-1.5 rounded-lg text-[10px] font-bold border-2 transition-all border-outline-variant/20 text-on-surface-variant">🥇 Oro</button>
              <button type="button" data-level="Zafiro" class="alta-level-chip px-2.5 py-1.5 rounded-lg text-[10px] font-bold border-2 transition-all border-outline-variant/20 text-on-surface-variant">💎 Zafiro</button>
              <button type="button" data-level="Diamante" class="alta-level-chip px-2.5 py-1.5 rounded-lg text-[10px] font-bold border-2 transition-all border-outline-variant/20 text-on-surface-variant">💠 Diamante</button>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label class="text-sm font-bold text-on-surface-variant ml-1">Cantidad Recibida</label>
              <input id="input-qty" required class="w-full bg-surface-container-highest/50 border-none rounded-xl p-4 focus:ring-2 focus:ring-primary focus:bg-white transition-all font-mono text-lg" type="number" min="1" value="1"/>
            </div>
            <div class="space-y-2">
              <label class="text-sm font-bold text-on-surface-variant ml-1">Tu Costo <span id="alta-cost-badge" class="text-xs font-normal text-primary">(×0.7845)</span></label>
              <div class="relative flex items-center">
                <span class="absolute left-4 font-bold text-outline-variant">$</span>
                <input id="input-cost" class="w-full bg-surface-container-highest/50 border-none rounded-xl p-4 pl-8 focus:ring-2 focus:ring-primary focus:bg-white transition-all font-mono" type="number" step="0.01" value="0.00"/>
              </div>
              <p class="text-[10px] text-on-surface-variant ml-1">Auto-calculado por nivel. Puedes editarlo.</p>
            </div>
          </div>

          <!-- Profit per unit -->
          <div id="alta-profit-row" class="hidden flex items-center justify-between bg-green-50 rounded-xl px-4 py-2.5 border border-green-200/30">
            <span class="text-xs font-bold text-green-700 flex items-center gap-1">
              <span class="material-symbols-outlined text-sm">trending_up</span>
              Ganancia por unidad:
            </span>
            <span id="alta-profit-amount" class="text-sm font-bold text-green-700">$0</span>
          </div>
          
          <button id="btn-add-list" type="submit" disabled class="w-full bg-surface-container-high text-primary font-bold py-4 rounded-xl hover:bg-primary-container/10 transition-colors mt-4 flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed">
            <span class="material-symbols-outlined">add_box</span>
            Añadir a la lista temporal
          </button>
        </form>
      </div>

      <!-- Section: Productos por Cargar -->
      <div class="lg:col-span-12">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between mb-6 gap-3">
          <h2 class="text-2xl md:text-3xl font-bold text-primary flex items-center gap-3 font-headline">
            <span class="material-symbols-outlined text-3xl md:text-4xl">list_alt</span>
            Productos por Cargar
          </h2>
          <div class="flex items-center gap-4">
            <span id="pending-count" class="text-on-surface-variant font-medium text-sm">0 Productos pendientes</span>
            <div class="h-6 w-px bg-outline-variant"></div>
            <button id="btn-clear-list" class="text-error font-bold flex items-center gap-1 hover:underline text-sm">
              <span class="material-symbols-outlined text-sm">delete_sweep</span>
              Limpiar
            </button>
          </div>
        </div>

        <div class="bg-surface-container-low rounded-[2rem] overflow-hidden border border-outline-variant/10">
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="text-on-surface-variant uppercase text-xs tracking-[0.15em] font-bold border-b border-outline-variant/20">
                  <th class="px-4 md:px-8 py-4 md:py-6">Producto</th>
                  <th class="px-4 md:px-8 py-4 md:py-6 text-center">Cant.</th>
                  <th class="px-4 md:px-8 py-4 md:py-6 text-right hidden sm:table-cell">Costo Unit.</th>
                  <th class="px-4 md:px-8 py-4 md:py-6 text-right">Total</th>
                  <th class="px-4 md:px-8 py-4 md:py-6"></th>
                </tr>
              </thead>
              <tbody id="cart-tbody" class="text-on-surface font-medium divide-y divide-outline-variant/10">
                <!-- Rows injected by JS -->
                <tr id="empty-cart-row">
                  <td colspan="5" class="py-12 text-center text-on-surface-variant">Lista vacía. Escanea un producto para comenzar.</td>
                </tr>
              </tbody>
            </table>
          </div>
          <div class="p-4 md:p-8 bg-surface-container-highest flex justify-end">
            <div class="text-right space-y-1">
              <p class="text-on-surface-variant font-bold text-sm tracking-widest uppercase">Subtotal Estimado</p>
              <p id="total-estimado" class="text-4xl font-black text-primary font-headline">$ 0.00</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  import { esc } from '../../lib/security';
  import { supabase } from '../../lib/supabase';
  import { CAMINO_CRECIMIENTO, calculateConsultantPrice } from '../../lib/camino-crecimiento';
  import type { ConsultantLevel } from '../../lib/camino-crecimiento';

  let currentUserId = '';
  // The temporary list of items to add
  let tempStockList: any[] = [];
  
  // Current selected product from search
  let selectedProduct: any = null;

  const searchInput = document.getElementById('search-code') as HTMLInputElement;
  const btnSearch = document.getElementById('btn-search') as HTMLButtonElement;
  const resContainer = document.getElementById('search-results') as HTMLElement;
  const resNotFound = document.getElementById('search-not-found') as HTMLElement;
  const resName = document.getElementById('res-name') as HTMLElement;
  const resCat = document.getElementById('res-cat') as HTMLElement;
  const resCode = document.getElementById('res-code') as HTMLElement;
  
  const formAdd = document.getElementById('add-item-form') as HTMLFormElement;
  const inputQty = document.getElementById('input-qty') as HTMLInputElement;
  const inputCost = document.getElementById('input-cost') as HTMLInputElement;
  const btnAddList = document.getElementById('btn-add-list') as HTMLButtonElement;
  
  const tbody = document.getElementById('cart-tbody') as HTMLElement;
  const emptyRow = document.getElementById('empty-cart-row') as HTMLElement;
  const spanCount = document.getElementById('pending-count') as HTMLElement;
  const totalEstimado = document.getElementById('total-estimado') as HTMLElement;
  
  const btnClearList = document.getElementById('btn-clear-list') as HTMLButtonElement;
  const btnConfirmAll = document.getElementById('btn-confirm-all') as HTMLButtonElement;
  
  const globalError = document.getElementById('global-error') as HTMLElement;
  const globalSuccess = document.getElementById('global-success') as HTMLElement;

  // Level elements
  const altaLevelChips = document.querySelectorAll('.alta-level-chip') as NodeListOf<HTMLButtonElement>;
  const altaCostBadge = document.getElementById('alta-cost-badge') as HTMLElement;
  const altaProfitRow = document.getElementById('alta-profit-row') as HTMLElement;
  const altaProfitAmount = document.getElementById('alta-profit-amount') as HTMLElement;

  let altaSelectedLevel: ConsultantLevel = (localStorage.getItem('natura_level') as ConsultantLevel) || 'Bronce';

  const ALTA_LEVEL_STYLES: Record<ConsultantLevel, { border: string; bg: string; text: string }> = {
    Bronce:   { border: 'border-orange-300', bg: 'bg-orange-50',  text: 'text-orange-700' },
    Plata:    { border: 'border-gray-400',   bg: 'bg-gray-50',    text: 'text-gray-700' },
    Oro:      { border: 'border-yellow-400', bg: 'bg-yellow-50',  text: 'text-yellow-700' },
    Zafiro:   { border: 'border-blue-400',   bg: 'bg-blue-50',    text: 'text-blue-700' },
    Diamante: { border: 'border-purple-400', bg: 'bg-purple-50',  text: 'text-purple-700' },
  };

  function selectAltaLevel(level: ConsultantLevel) {
    altaSelectedLevel = level;
    localStorage.setItem('natura_level', level);
    const info = CAMINO_CRECIMIENTO[level];
    const style = ALTA_LEVEL_STYLES[level];

    altaLevelChips.forEach(chip => {
      const chipLevel = chip.dataset.level as ConsultantLevel;
      const s = ALTA_LEVEL_STYLES[chipLevel];
      if (chipLevel === level) {
        chip.className = `alta-level-chip px-2.5 py-1.5 rounded-lg text-[10px] font-bold border-2 transition-all ${s.border} ${s.bg} ${s.text}`;
      } else {
        chip.className = `alta-level-chip px-2.5 py-1.5 rounded-lg text-[10px] font-bold border-2 transition-all border-outline-variant/20 text-on-surface-variant`;
      }
    });

    altaCostBadge.textContent = `(×${info.priceFactor})`;

    // Recalculate cost if product selected
    if (selectedProduct?.price) {
      const cost = calculateConsultantPrice(selectedProduct.price, level);
      inputCost.value = cost.toFixed(2);
      updateAltaProfit();
    }
  }

  function updateAltaProfit() {
    if (!selectedProduct?.price) { altaProfitRow.classList.add('hidden'); return; }
    const price = selectedProduct.price;
    const cost = parseFloat(inputCost.value) || 0;
    const profit = price - cost;
    if (profit > 0) {
      altaProfitRow.classList.remove('hidden');
      altaProfitRow.className = 'flex items-center justify-between bg-green-50 rounded-xl px-4 py-2.5 border border-green-200/30';
      altaProfitAmount.textContent = '+$' + profit.toFixed(2) + ' (' + CAMINO_CRECIMIENTO[altaSelectedLevel].profitPercentage + '%)';
      altaProfitAmount.className = 'text-sm font-bold text-green-700';
    } else {
      altaProfitRow.classList.remove('hidden');
      altaProfitRow.className = 'flex items-center justify-between bg-red-50 rounded-xl px-4 py-2.5 border border-red-200/30';
      altaProfitAmount.textContent = '-$' + Math.abs(profit).toFixed(2);
      altaProfitAmount.className = 'text-sm font-bold text-red-700';
    }
  }

  altaLevelChips.forEach(chip => {
    chip.addEventListener('click', () => selectAltaLevel(chip.dataset.level as ConsultantLevel));
  });
  inputCost?.addEventListener('input', updateAltaProfit);

  supabase.auth.getSession().then(async ({ data: { session } }: any) => {
    if(session) {
      currentUserId = session.user.id;

      // Auto-detect level from profile
      try {
        const { data: profile } = await supabase
          .from('consultant_profiles')
          .select('latest_growth_data')
          .eq('id', session.user.id)
          .single();

        if (profile?.latest_growth_data?.level?.description) {
          const desc = profile.latest_growth_data.level.description as string;
          const levelMap: Record<string, ConsultantLevel> = {
            'Bronce': 'Bronce', 'Plata': 'Plata', 'Oro': 'Oro',
            'Zafiro': 'Zafiro', 'Diamante': 'Diamante',
            'BRONCE': 'Bronce', 'PLATA': 'Plata', 'ORO': 'Oro',
            'ZAFIRO': 'Zafiro', 'DIAMANTE': 'Diamante',
          };
          const detectedLevel = Object.entries(levelMap).find(([key]) => desc.includes(key));
          if (detectedLevel) {
            altaSelectedLevel = detectedLevel[1];
            localStorage.setItem('natura_level', altaSelectedLevel);
          }
        }
      } catch (e) { /* use localStorage fallback */ }

      selectAltaLevel(altaSelectedLevel);
    }
  });

  // SEARCH LOGIC
  async function performSearch() {
    const q = searchInput.value.trim();
    if(!q) return;

    resContainer.classList.add('hidden');
    resNotFound.classList.add('hidden');
    btnAddList.disabled = true;
    selectedProduct = null;
    
    // First try by exact code
    let { data, error } = await supabase
      .from('products')
      .select('id, name, code, category, price, cost')
      .eq('code', q)
      .maybeSingle();

    // If not found by code, try by name
    if (!data) {
      const { data: nameData } = await supabase
        .from('products')
        .select('id, name, code, category, price, cost')
        .ilike('name', `%${q}%`)
        .limit(1)
        .maybeSingle();
      data = nameData;
    }

    if(!data) {
      resNotFound.classList.remove('hidden');
      return;
    }

    selectedProduct = data;
    resName.textContent = data.name;
    resCat.textContent = data.category || 'Varios';
    resCode.textContent = 'Código: ' + data.code;

    // Auto-calculate cost by level
    if (data.price && data.price > 0) {
      const cost = calculateConsultantPrice(data.price, altaSelectedLevel);
      inputCost.value = cost.toFixed(2);
      updateAltaProfit();
    } else {
      inputCost.value = data.cost || '0.00';
      altaProfitRow.classList.add('hidden');
    }
    
    resContainer.classList.remove('hidden');
    btnAddList.disabled = false;
    inputQty.focus();
  }

  btnSearch?.addEventListener('click', performSearch);
  searchInput?.addEventListener('keydown', (e) => {
     if(e.key === 'Enter') performSearch();
  });

  // ADD TO TEMP LIST
  formAdd?.addEventListener('submit', (e) => {
    e.preventDefault();
    if(!selectedProduct) return;

    const qty = parseInt(inputQty.value) || 1;
    const cost = parseFloat(inputCost.value) || 0;

    // Determine if it already exists in the temp list to merge quantities
    const existingIndex = tempStockList.findIndex(item => item.product_id === selectedProduct.id);
    if(existingIndex >= 0) {
      tempStockList[existingIndex].qty += qty;
    } else {
      tempStockList.push({
        product_id: selectedProduct.id,
        name: selectedProduct.name,
        code: selectedProduct.code,
        price: selectedProduct.price, // for reference
        cost: cost,
        qty: qty
      });
    }

    // Reset Search
    searchInput.value = '';
    resContainer.classList.add('hidden');
    btnAddList.disabled = true;
    selectedProduct = null;
    inputQty.value = '1';
    searchInput.focus();

    renderTempList();
  });

  // RENDER TABLE
  function renderTempList() {
    if(tempStockList.length === 0) {
      tbody.innerHTML = '';
      tbody.appendChild(emptyRow);
      spanCount.textContent = '0 Productos pendientes';
      totalEstimado.textContent = '$ 0.00';
      btnConfirmAll.disabled = true;
      return;
    }

    tbody.innerHTML = '';
    let totalCost = 0;
    btnConfirmAll.disabled = false;

    tempStockList.forEach((item, index) => {
       const rowCost = item.cost * item.qty;
       totalCost += rowCost;

       const tr = document.createElement('tr');
       tr.className = 'group hover:bg-white transition-colors';
       tr.innerHTML = `
        <td class="px-8 py-6">
          <div>
            <p class="font-bold text-primary font-headline">${esc(item.name)}</p>
            <p class="text-xs text-on-surface-variant font-mono">ID: ${item.code}</p>
          </div>
        </td>
        <td class="px-8 py-6 text-center">
          <span class="px-4 py-1 bg-primary-container/10 text-primary font-bold rounded-lg font-mono">${item.qty}</span>
        </td>
        <td class="px-8 py-6 text-right font-mono">$ ${item.cost.toFixed(2)}</td>
        <td class="px-8 py-6 text-right font-bold text-primary font-mono">$ ${rowCost.toFixed(2)}</td>
        <td class="px-8 py-6 text-right">
          <button data-idx="${index}" class="btn-remove text-outline-variant hover:text-error transition-colors p-2 rounded-full hover:bg-error-container/20">
            <span class="material-symbols-outlined pointer-events-none">close</span>
          </button>
        </td>
       `;
       tbody.appendChild(tr);
    });

    spanCount.textContent = `${tempStockList.length} Productos pendientes`;
    totalEstimado.textContent = `$ ${totalCost.toFixed(2)}`;

    // Attach removes
    document.querySelectorAll('.btn-remove').forEach(btn => {
       btn.addEventListener('click', (e) => {
          const idx = parseInt((e.target as HTMLElement).getAttribute('data-idx') || '0');
          tempStockList.splice(idx, 1);
          renderTempList();
       });
    });
  }

  btnClearList?.addEventListener('click', () => {
    tempStockList = [];
    renderTempList();
  });

  // CONFIRM MASS ENTRY
  btnConfirmAll?.addEventListener('click', async () => {
     if(tempStockList.length === 0) return;
     globalError.classList.add('hidden');
     globalSuccess.classList.add('hidden');
     btnConfirmAll.disabled = true;
     btnConfirmAll.innerHTML = '<span class="material-symbols-outlined animate-spin">sync</span> Procesando...';

     // For each item, update or insert into inventory
     for(let item of tempStockList) {
        const { data: existingInv } = await supabase
          .from('inventory')
          .select('id, quantity')
          .eq('consultant_id', currentUserId)
          .eq('product_id', item.product_id)
          .maybeSingle();

        if(existingInv) {
           await supabase
            .from('inventory')
            .update({ quantity: existingInv.quantity + item.qty, updated_at: new Date().toISOString() })
            .eq('id', existingInv.id);
        } else {
           await supabase
            .from('inventory')
            .insert([{
               consultant_id: currentUserId,
               product_id: item.product_id,
               quantity: item.qty
            }]);
        }
     }

     globalSuccess.classList.remove('hidden');
     tempStockList = [];
     renderTempList();
     btnConfirmAll.innerHTML = '<span class="material-symbols-outlined">check_circle</span> Confirmar Entrada Masiva';
     
     setTimeout(() => {
        globalSuccess.classList.add('hidden');
     }, 5000);
  });
</script>
