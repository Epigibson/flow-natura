---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout>
  <header class="mb-10">
    <p class="text-primary font-bold tracking-widest uppercase text-sm mb-1">HERRAMIENTA</p>
    <h2 class="text-3xl md:text-5xl font-display font-bold text-on-surface">Importar Productos Natura 🌿</h2>
    <p class="text-on-surface-variant mt-2 text-base md:text-lg">Conecta con tu portal de consultora y descarga el catálogo del ciclo actual.</p>
  </header>

  <!-- Step 1: Load Products -->
  <section class="bg-surface-container-lowest rounded-[2rem] p-8 shadow-sm mb-8">
    <h3 class="text-xl font-display font-bold mb-6 flex items-center gap-3">
      <span class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-sm font-bold">1</span>
      Extraer Productos del Ciclo
    </h3>

    <!-- Option A: Console snippet (recommended) -->
    <div class="bg-primary/5 rounded-2xl p-6 mb-6">
      <h4 class="font-bold text-on-surface mb-3 flex items-center gap-2">
        <span class="material-symbols-outlined text-primary">terminal</span> Paso 1 — Extraer productos del Showcase
      </h4>
      <ol class="text-sm text-on-surface-variant space-y-3 list-decimal list-inside">
        <li>Abre <a href="https://natura-auth.prd.naturacloud.com/?company=natura&client_id=3ec6rhfe52b2k78h32kv7ml6ti&redirect_uri=https://gsp.natura.com/showcase/natura&country=MX&language=es" target="_blank" class="text-primary font-bold underline">Showcase MX</a> e inicia sesión</li>
        <li>Presiona <code class="bg-surface-container-highest px-2 py-0.5 rounded text-xs">F12</code> → <strong>Console</strong> → pega el contenido de <code class="bg-surface-container-highest px-2 py-0.5 rounded text-xs">scripts/scrape-console.js</code></li>
        <li>Se descarga <strong>natura-tokens.json</strong> — cópialo a la carpeta del proyecto</li>
        <li>En tu terminal: <code class="bg-surface-container-highest px-2 py-0.5 rounded text-xs">node scripts/scrape-natura.mjs</code></li>
        <li>Se genera el archivo <code class="text-xs">natura-ciclo-XXXXXX.json</code> con todos los productos</li>
      </ol>
      <p class="text-xs text-on-surface-variant mt-3 opacity-70">Extrae ~2000+ productos de Natura, Avon y Casa&Estilo con precios, puntos, categoría e imagen.</p>
    </div>

    <!-- Upload JSON -->
    <div class="bg-secondary/5 rounded-2xl p-6 mb-6">
      <h4 class="font-bold text-on-surface mb-3 flex items-center gap-2">
        <span class="material-symbols-outlined text-secondary">upload_file</span> Paso 2 — Subir el JSON generado
      </h4>
      <p class="text-sm text-on-surface-variant mb-4">Sube el archivo JSON generado por el script.</p>
      <label class="flex items-center gap-3 py-4 px-6 rounded-xl border-2 border-dashed border-primary/20 hover:border-primary/40 cursor-pointer transition-colors">
        <span class="material-symbols-outlined text-primary text-2xl">cloud_upload</span>
        <div>
          <p id="file-label" class="font-bold text-on-surface">Seleccionar archivo JSON</p>
          <p class="text-xs text-on-surface-variant">natura-ciclo-202605.json</p>
        </div>
        <input id="json-file" type="file" accept=".json" class="hidden" />
      </label>
    </div>

    <div id="load-result" class="hidden mt-4 py-3 px-4 rounded-xl text-sm font-bold"></div>
  </section>

  <!-- Step 2: Preview & Import -->
  <section id="step-import" class="bg-surface-container-lowest rounded-[2rem] p-8 shadow-sm mb-8 opacity-50 pointer-events-none transition-all">
    <h3 class="text-xl font-display font-bold mb-6 flex items-center gap-3">
      <span class="w-8 h-8 rounded-full bg-secondary text-white flex items-center justify-center text-sm font-bold">2</span>
      Previsualización e Importación
    </h3>
    <div id="preview-stats" class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6"></div>
    <div class="max-h-80 overflow-y-auto mb-6 rounded-2xl border border-outline-variant/10">
      <table class="w-full text-left text-sm">
        <thead class="sticky top-0 bg-surface-container-high">
          <tr class="text-xs uppercase tracking-wider text-on-surface-variant border-b border-outline-variant/10">
            <th class="px-4 py-3">Código</th>
            <th class="px-4 py-3">Producto</th>
            <th class="px-4 py-3">Categoría</th>
            <th class="px-4 py-3 text-right">Costo</th>
            <th class="px-4 py-3 text-right">Precio</th>
            <th class="px-4 py-3 text-right">Pts</th>
          </tr>
        </thead>
        <tbody id="preview-tbody" class="divide-y divide-outline-variant/5"></tbody>
      </table>
    </div>
    <div class="flex gap-4">
      <button id="btn-import-supabase" class="flex items-center gap-2 py-3 px-8 rounded-xl font-bold bg-primary text-white hover:scale-[1.02] transition-all shadow-md">
        <span class="material-symbols-outlined text-sm">database</span> Importar a mi BD
      </button>
      <button id="btn-download-json" class="flex items-center gap-2 py-3 px-6 rounded-xl font-bold border-2 border-primary/20 text-primary hover:bg-primary/5 transition-colors">
        <span class="material-symbols-outlined text-sm">download</span> Descargar JSON
      </button>
    </div>
    <div id="import-progress" class="hidden mt-4">
      <div class="w-full bg-surface-container-high rounded-full h-3 mb-3 overflow-hidden">
        <div id="import-bar" class="h-3 bg-gradient-to-r from-primary to-tertiary rounded-full transition-all" style="width: 0%"></div>
      </div>
      <p id="import-text" class="text-sm text-on-surface-variant"></p>
    </div>
    <div id="import-result" class="hidden mt-4 py-3 px-4 rounded-xl text-sm font-bold"></div>
  </section>
</DashboardLayout>

<script>
  import { supabase } from '../../lib/supabase';
  import api from '../../lib/api';
  import { esc } from '../../lib/security';

  let fetchedProducts: any[] = [];

  // ===== FILE UPLOAD =====
  document.getElementById('json-file')!.addEventListener('change', async (e: any) => {
    const file = e.target.files[0];
    if (!file) return;

    const label = document.getElementById('file-label') as HTMLElement;
    const result = document.getElementById('load-result') as HTMLElement;
    label.textContent = file.name;

    try {
      const text = await file.text();
      const data = JSON.parse(text);

      if (!Array.isArray(data) || data.length === 0) {
        showStatus(result, 'El archivo no contiene un array de productos.', true);
        return;
      }

      fetchedProducts = data;
      showStatus(result, `✅ ${data.length} productos cargados de ${file.name}`, false);
      renderPreview();
      enableStep('step-import');
    } catch (err: unknown) {
      showStatus(result, 'Error leyendo archivo: ' + (err instanceof Error ? err.message : 'Unknown error'), true);
    }
  });

  // ===== PREVIEW =====
  function renderPreview() {
    const tbody = document.getElementById('preview-tbody') as HTMLElement;
    const stats = document.getElementById('preview-stats') as HTMLElement;

    const totalProducts = fetchedProducts.length;
    const categories = [...new Set(fetchedProducts.map(p => p.category))];
    const avgPrice = fetchedProducts.reduce((s, p) => s + (p.price || 0), 0) / totalProducts || 0;
    const avgCost = fetchedProducts.reduce((s, p) => s + (p.cost || 0), 0) / totalProducts || 0;

    stats.innerHTML = `
      <div class="bg-primary/5 rounded-xl p-4 text-center"><p class="text-2xl font-display font-bold text-primary">${totalProducts}</p><p class="text-xs text-on-surface-variant font-bold">Productos</p></div>
      <div class="bg-secondary/5 rounded-xl p-4 text-center"><p class="text-2xl font-display font-bold text-secondary">${categories.length}</p><p class="text-xs text-on-surface-variant font-bold">Categorías</p></div>
      <div class="bg-tertiary/5 rounded-xl p-4 text-center"><p class="text-2xl font-display font-bold text-tertiary">$${avgCost.toFixed(0)}</p><p class="text-xs text-on-surface-variant font-bold">Costo Prom.</p></div>
      <div class="bg-primary/5 rounded-xl p-4 text-center"><p class="text-2xl font-display font-bold text-primary">$${avgPrice.toFixed(0)}</p><p class="text-xs text-on-surface-variant font-bold">Precio Prom.</p></div>
    `;

    tbody.innerHTML = '';
    fetchedProducts.forEach(p => {
      const tr = document.createElement('tr');
      tr.className = 'hover:bg-surface-container-low/50';
      tr.innerHTML = `
        <td class="px-4 py-2 font-mono text-xs text-primary font-bold">${esc(p.code || '—')}</td>
        <td class="px-4 py-2">${esc(p.name || 'Sin nombre')}</td>
        <td class="px-4 py-2 text-xs">${esc(p.category || '—')}</td>
        <td class="px-4 py-2 text-right font-mono">$${Number(p.cost || 0).toFixed(2)}</td>
        <td class="px-4 py-2 text-right font-mono font-bold">$${Number(p.price || 0).toFixed(2)}</td>
        <td class="px-4 py-2 text-right">${esc(p.points || 0)}</td>
      `;
      tbody.appendChild(tr);
    });
  }

  // ===== IMPORT VIA API =====
  document.getElementById('btn-import-supabase')!.addEventListener('click', async () => {
    if (!fetchedProducts.length) return;

    const { data: { session } } = await supabase.auth.getSession();
    if (!session) { alert('Necesitas iniciar sesión en Natura Manager primero.'); return; }

    const progress = document.getElementById('import-progress') as HTMLElement;
    const bar = document.getElementById('import-bar') as HTMLElement;
    const text = document.getElementById('import-text') as HTMLElement;
    const result = document.getElementById('import-result') as HTMLElement;
    const btn = document.getElementById('btn-import-supabase') as HTMLButtonElement;

    progress.classList.remove('hidden');
    result.classList.add('hidden');
    btn.disabled = true;

    // Process in batches of 100 via API
    const BATCH_SIZE = 100;
    const totalBatches = Math.ceil(fetchedProducts.length / BATCH_SIZE);
    let totalImported = 0;
    let totalErrors = 0;

    for (let batch = 0; batch < totalBatches; batch++) {
      const start = batch * BATCH_SIZE;
      const chunk = fetchedProducts.slice(start, start + BATCH_SIZE);
      const pct = ((batch + 1) / totalBatches) * 100;
      bar.style.width = `${pct}%`;
      text.textContent = `Lote ${batch + 1}/${totalBatches} (${start + 1}-${start + chunk.length} de ${fetchedProducts.length})`;

      const productRows = chunk.map((p: any) => ({
        code: String(p.code),
        name: p.name || '',
        brand: p.brand || 'Natura',
        category: p.category || null,
        price: p.price || 0,
        cost: p.cost || 0,
        points: p.points || 0,
        image_url: p.image || null,
      }));

      try {
        const res = await api.inventory.importProducts(productRows);
        totalImported += res.imported || 0;
        totalErrors += res.errors || 0;
      } catch(e) {
        totalErrors += chunk.length;
      }
    }

    bar.style.width = '100%';
    const msg = `✅ ${totalImported} productos importados${totalErrors > 0 ? ` (${totalErrors} errores)` : ''}. ¡Ve a Inventario > Alta de Stock para registrar cantidades!`;
    showStatus(result, msg, totalErrors > 0);
    progress.classList.add('hidden');
    btn.disabled = false;
  });

  // ===== DOWNLOAD JSON =====
  document.getElementById('btn-download-json')!.addEventListener('click', () => {
    if (!fetchedProducts.length) return;
    const blob = new Blob([JSON.stringify(fetchedProducts, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a'); a.href = url;
    a.download = 'natura-productos-importados.json'; a.click();
    URL.revokeObjectURL(url);
  });

  // ===== HELPERS =====
  function showStatus(el: HTMLElement, msg: string, isError: boolean) {
    el.textContent = msg;
    el.className = 'mt-4 py-3 px-4 rounded-xl text-sm font-bold ' + (isError ? 'bg-error-container/20 text-error' : 'bg-secondary/10 text-secondary');
    el.classList.remove('hidden');
  }
  function enableStep(id: string) {
    const el = document.getElementById(id);
    if (el) el.classList.remove('opacity-50', 'pointer-events-none');
  }
</script>
