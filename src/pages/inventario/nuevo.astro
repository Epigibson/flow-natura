---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
---

<DashboardLayout>
  <div class="flex justify-between items-center mb-8">
    <div>
      <h2
        class="text-3xl font-extrabold tracking-tight text-primary font-headline"
      >
        Crear Producto
      </h2>
      <p class="text-sm text-on-surface-variant mt-2">
        Toma una foto del producto y deja que la IA complete los datos por ti ✨
      </p>
    </div>
    <a href="/inventario" class="btn-secondary flex items-center gap-2">
      <span class="material-symbols-outlined">arrow_back</span>
      Volver
    </a>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
    <!-- Left Column: Form Details -->
    <div class="lg:col-span-7 space-y-10">
      <!-- AI Scanner Section -->
      <section class="relative">
        <div class="mb-6">
          <span
            class="inline-flex items-center gap-1.5 px-3 py-1 bg-gradient-to-r from-purple-100 to-primary-container/30 text-primary text-[10px] font-bold uppercase tracking-widest rounded-full mb-2"
          >
            <span class="material-symbols-outlined text-xs">auto_awesome</span>
            Inteligencia Artificial
          </span>
          <h3 class="text-2xl font-bold text-on-surface font-headline">
            Escanear con Cámara
          </h3>
          <p class="text-sm text-on-surface-variant mt-1">
            Toma una foto del producto y Gemini extraerá nombre, categoría, marca y más.
          </p>
        </div>

        <!-- Camera / Preview Area -->
        <div
          id="camera-area"
          class="relative aspect-[4/3] w-full max-w-lg rounded-3xl overflow-hidden border-2 border-dashed border-outline-variant bg-surface-container group transition-all"
        >
          <!-- Idle state -->
          <div
            id="camera-idle"
            class="absolute inset-0 flex flex-col items-center justify-center gap-4 p-8 cursor-pointer"
          >
            <div
              class="w-20 h-20 rounded-full bg-gradient-to-br from-primary/15 to-secondary/10 flex items-center justify-center group-hover:scale-110 transition-transform"
            >
              <span
                class="material-symbols-outlined text-primary text-4xl"
              >photo_camera</span>
            </div>
            <p class="text-center font-bold text-on-surface tracking-tight">
              Toca para abrir la cámara
            </p>
            <p class="text-xs text-on-surface-variant text-center">
              Apunta al producto para que la IA lo identifique
            </p>
          </div>

          <!-- Live camera feed -->
          <video
            id="camera-video"
            class="absolute inset-0 w-full h-full object-cover hidden"
            playsinline
            autoplay
            muted
          ></video>

          <!-- Capture overlay -->
          <div
            id="camera-controls"
            class="absolute bottom-0 left-0 right-0 p-4 bg-gradient-to-t from-black/60 to-transparent flex justify-center hidden"
          >
            <button
              id="btn-capture"
              class="w-16 h-16 rounded-full bg-white shadow-2xl flex items-center justify-center hover:scale-110 active:scale-95 transition-all ring-4 ring-white/30"
            >
              <div class="w-12 h-12 rounded-full bg-primary"></div>
            </button>
          </div>

          <!-- Photo preview -->
          <img
            id="photo-preview"
            class="absolute inset-0 w-full h-full object-contain bg-surface-container hidden"
            alt="Foto del producto"
          />

          <!-- Canvas (hidden, for capturing) -->
          <canvas id="capture-canvas" class="hidden"></canvas>
        </div>

        <!-- Camera action buttons -->
        <div class="flex flex-wrap gap-3 mt-4 max-w-lg">
          <button
            id="btn-open-camera"
            class="flex-1 flex items-center justify-center gap-2 py-3.5 px-5 rounded-xl font-bold bg-gradient-to-r from-primary to-primary-container text-white shadow-lg shadow-primary/20 hover:scale-[1.02] active:scale-95 transition-all text-sm"
          >
            <span class="material-symbols-outlined text-lg">photo_camera</span>
            Abrir Cámara
          </button>
          <button
            id="btn-analyze"
            class="flex-1 flex items-center justify-center gap-2 py-3.5 px-5 rounded-xl font-bold bg-gradient-to-r from-secondary to-green-600 text-white shadow-lg shadow-secondary/20 hover:scale-[1.02] active:scale-95 transition-all text-sm hidden"
          >
            <span class="material-symbols-outlined text-lg">auto_awesome</span>
            Analizar con IA
          </button>
          <button
            id="btn-retake"
            class="flex items-center justify-center gap-2 py-3.5 px-4 rounded-xl font-bold border-2 border-primary/20 text-primary hover:bg-primary/5 transition-colors text-sm hidden"
          >
            <span class="material-symbols-outlined text-lg">refresh</span>
            Otra foto
          </button>
        </div>

        <!-- AI Analysis Loading State -->
        <div
          id="ai-loading"
          class="hidden mt-4 max-w-lg bg-gradient-to-r from-purple-50 to-primary-container/10 rounded-2xl p-6 border border-primary/10"
        >
          <div class="flex items-center gap-4">
            <div class="relative w-12 h-12 flex-shrink-0">
              <div class="absolute inset-0 rounded-full border-4 border-primary/20"></div>
              <div class="absolute inset-0 rounded-full border-4 border-primary border-t-transparent animate-spin"></div>
              <span class="absolute inset-0 flex items-center justify-center material-symbols-outlined text-primary text-lg">auto_awesome</span>
            </div>
            <div>
              <p class="font-bold text-on-surface text-sm">Gemini está analizando el producto...</p>
              <p class="text-xs text-on-surface-variant mt-0.5">Esto toma 2-3 segundos</p>
            </div>
          </div>
        </div>

        <!-- AI Success indicator -->
        <div
          id="ai-success"
          class="hidden mt-4 max-w-lg bg-green-50 rounded-2xl p-4 border border-green-200"
        >
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-green-100 flex items-center justify-center flex-shrink-0">
              <span class="material-symbols-outlined text-green-600">check_circle</span>
            </div>
            <div class="flex-1">
              <p class="font-bold text-green-800 text-sm">¡Datos extraídos con IA! ✨</p>
              <p class="text-xs text-green-600 mt-0.5">Revisa y edita los campos si necesitas ajustar algo.</p>
            </div>
            <span
              id="ai-confidence"
              class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-green-200 text-green-800"
            >Alta confianza</span>
          </div>
        </div>
      </section>

      <!-- Form Fields -->
      <section>
        <div class="mb-8">
          <span
            class="inline-block px-3 py-1 bg-secondary-container text-on-secondary-container text-[10px] font-bold uppercase tracking-widest rounded-full mb-2"
          >Información del Producto</span>
          <h3 class="text-2xl font-bold text-on-surface font-headline">
            Detalles
          </h3>
        </div>

        <div class="space-y-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <!-- Code -->
            <div>
              <label
                class="block text-sm font-bold text-on-surface-variant mb-2 ml-1"
                for="product_code"
              >Código / SKU <span class="text-error">*</span></label>
              <div class="relative">
                <input
                  type="text"
                  id="product_code"
                  class="w-full px-5 py-4 bg-surface-container-highest border-none rounded-xl focus:ring-2 focus:ring-primary-container transition-all pr-12"
                  placeholder="Ej. 123456"
                />
                <button
                  type="button"
                  id="btn-scan-toggle"
                  class="absolute right-2 top-1/2 -translate-y-1/2 w-9 h-9 rounded-lg bg-primary/10 hover:bg-primary/20 flex items-center justify-center transition-colors"
                  title="Escanear código de barras"
                >
                  <span class="material-symbols-outlined text-primary text-lg"
                    >qr_code_scanner</span>
                </button>
              </div>
              <!-- Inline scanner -->
              <div
                id="inline-scanner-wrap"
                class="hidden mt-3 rounded-2xl overflow-hidden border-2 border-primary/20 bg-black shadow-lg"
              >
                <div id="inline-scanner" class="w-full" style="height:300px">
                </div>
                <div
                  class="flex justify-between items-center p-3 bg-surface-container"
                >
                  <p class="text-xs text-on-surface-variant flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-sm text-primary animate-pulse">qr_code_scanner</span>
                    Apunta al código de barras del producto
                  </p>
                  <button
                    type="button"
                    id="btn-scan-close"
                    class="text-xs font-bold text-error hover:underline px-2 py-1"
                    >Cerrar</button>
                </div>
              </div>
              <input type="hidden" id="scanned_ean" />
            </div>
            <!-- Name -->
            <div class="relative">
              <label
                class="block text-sm font-bold text-on-surface-variant mb-2 ml-1"
                for="product_name"
              >Nombre del Producto <span class="text-error">*</span></label>
              <input
                type="text"
                id="product_name"
                class="ai-field w-full px-5 py-4 bg-surface-container-highest border-none rounded-xl focus:ring-2 focus:ring-primary-container transition-all"
                placeholder="Ej. Ekos Castanha Hidratante"
              />
              <span class="ai-badge hidden absolute -top-1 -right-1 w-5 h-5 rounded-full bg-purple-500 text-white flex items-center justify-center text-[10px]">
                <span class="material-symbols-outlined text-[12px]">auto_awesome</span>
              </span>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
            <!-- Category -->
            <div class="relative">
              <label
                class="block text-sm font-bold text-on-surface-variant mb-2 ml-1"
                for="category"
              >Categoría</label>
              <div class="relative">
                <select
                  id="category"
                  class="ai-field w-full px-5 py-4 bg-surface-container-highest border-none rounded-xl focus:ring-2 focus:ring-primary-container appearance-none"
                >
                  <option value="">Seleccionar...</option>
                  <option>Perfumería</option>
                  <option>Maquillaje</option>
                  <option>Cuerpo</option>
                  <option>Cabello</option>
                  <option>Rostro</option>
                  <option>Cuidado Personal</option>
                  <option>Accesorios</option>
                </select>
                <span
                  class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none opacity-50"
                >expand_more</span>
              </div>
              <span class="ai-badge hidden absolute -top-1 -right-1 w-5 h-5 rounded-full bg-purple-500 text-white flex items-center justify-center text-[10px]">
                <span class="material-symbols-outlined text-[12px]">auto_awesome</span>
              </span>
            </div>
            <!-- Brand -->
            <div class="relative">
              <label
                class="block text-sm font-bold text-on-surface-variant mb-2 ml-1"
                for="brand"
              >Marca</label>
              <input
                type="text"
                id="brand"
                class="ai-field w-full px-5 py-4 bg-surface-container-highest border-none rounded-xl focus:ring-2 focus:ring-primary-container transition-all"
                placeholder="Ej. Natura"
              />
              <span class="ai-badge hidden absolute -top-1 -right-1 w-5 h-5 rounded-full bg-purple-500 text-white flex items-center justify-center text-[10px]">
                <span class="material-symbols-outlined text-[12px]">auto_awesome</span>
              </span>
            </div>
            <!-- Stock -->
            <div>
              <label
                class="block text-sm font-bold text-on-surface-variant mb-2 ml-1"
                for="stock"
              >Stock a Agregar <span class="text-error">*</span></label>
              <div class="relative">
                <input
                  type="number"
                  id="stock"
                  class="w-full px-5 py-4 bg-surface-container-highest border-none rounded-xl focus:ring-2 focus:ring-primary-container"
                  placeholder="10"
                  min="1"
                  value="1"
                />
                <span
                  class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none opacity-30"
                >inventory</span>
              </div>
            </div>
          </div>

          <!-- Product Image Management -->
          <div class="col-span-full">
            <label class="block text-sm font-bold text-on-surface-variant mb-2 ml-1">Imagen del Producto</label>
            <div class="bg-surface-container-lowest border-2 border-outline-variant/10 rounded-2xl p-4">
              <!-- Current image preview (if set manually) -->
              <div id="new-img-preview" class="relative mb-3 h-32 bg-surface-container rounded-xl hidden items-center justify-center overflow-hidden border border-outline-variant/10 group">
                <img id="new-img-preview-src" src="" class="max-h-full max-w-full object-contain" />
                <button type="button" id="new-img-delete" class="absolute top-2 right-2 w-7 h-7 rounded-full bg-red-500/80 text-white flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity hover:bg-red-600" title="Eliminar imagen">
                  <span class="material-symbols-outlined text-sm">delete</span>
                </button>
              </div>

              <div class="grid grid-cols-2 gap-3 mb-3">
                <label class="flex flex-col items-center gap-2 py-3 px-2 rounded-xl bg-surface-container-highest hover:bg-primary/10 transition-colors cursor-pointer text-center border border-transparent hover:border-primary/20">
                  <span class="material-symbols-outlined text-xl text-primary">upload_file</span>
                  <span class="text-[10px] font-bold text-on-surface-variant">Subir foto manual</span>
                  <input id="new-img-file" type="file" accept="image/*" class="hidden" />
                </label>
                <button type="button" id="new-img-ai" class="flex flex-col items-center gap-2 py-3 px-2 rounded-xl bg-gradient-to-br from-purple-50 to-indigo-50 border border-purple-200/50 hover:from-purple-100 hover:to-indigo-100 transition-colors text-center">
                  <span class="material-symbols-outlined text-xl text-purple-600">auto_awesome</span>
                  <span class="text-[10px] font-bold text-purple-700">Buscar en Natura con IA</span>
                </button>
              </div>

              <!-- AI status -->
              <div id="new-ai-status" class="hidden mb-3 p-3 rounded-xl bg-purple-50 border border-purple-200/30">
                <div class="flex items-center gap-2 text-sm text-purple-700">
                  <span class="material-symbols-outlined text-sm animate-spin">progress_activity</span>
                  <span id="new-ai-text" class="font-bold text-xs">Buscando imagen de estudio oficial...</span>
                </div>
              </div>

              <!-- AI result -->
              <div id="new-ai-result" class="hidden mb-3 p-3 rounded-xl bg-green-50 border border-green-200/30">
                <p class="text-xs font-bold text-green-700 mb-2 flex items-center gap-1">
                  <span class="material-symbols-outlined text-sm">check_circle</span> Imagen encontrada
                </p>
                <div class="flex gap-3 items-center">
                  <img id="new-ai-img" src="" class="w-16 h-16 object-contain bg-white rounded-lg border" />
                  <div class="flex-1">
                    <p id="new-ai-name" class="text-[10px] text-on-surface font-bold truncate"></p>
                    <p id="new-ai-conf" class="text-[9px] text-on-surface-variant"></p>
                    <button type="button" id="new-ai-apply" class="mt-1 text-[10px] font-bold text-white bg-green-600 px-3 py-1.5 rounded-full hover:bg-green-700 transition-colors">
                      Usar esta imagen
                    </button>
                  </div>
                </div>
              </div>

              <!-- Manual URL fallback -->
              <details class="text-xs">
                <summary class="text-on-surface-variant cursor-pointer hover:text-primary transition-colors font-medium">O pegar URL de imagen directamente</summary>
                <input id="new-image-url" type="url" placeholder="https://..." class="w-full bg-surface-container-highest rounded-xl py-2.5 px-3 text-sm focus:ring-2 focus:ring-primary-container mt-2" />
              </details>
            </div>
          </div>

          <!-- Description (new, AI-powered) -->
          <div class="relative">
            <label
              class="block text-sm font-bold text-on-surface-variant mb-2 ml-1"
              for="description"
            >Descripción</label>
            <textarea
              id="description"
              rows="2"
              class="ai-field w-full px-5 py-4 bg-surface-container-highest border-none rounded-xl focus:ring-2 focus:ring-primary-container transition-all resize-none"
              placeholder="Descripción del producto (generada por IA o manual)"
            ></textarea>
            <span class="ai-badge hidden absolute -top-1 -right-1 w-5 h-5 rounded-full bg-purple-500 text-white flex items-center justify-center text-[10px]">
              <span class="material-symbols-outlined text-[12px]">auto_awesome</span>
            </span>
          </div>

          <!-- Nivel de Consultora -->
          <div class="mb-2">
            <label class="block text-sm font-bold text-on-surface-variant mb-2 ml-1">Tu Nivel de Consultora</label>
            <div id="level-selector" class="flex flex-wrap gap-2">
              <button type="button" data-level="Bronce" class="level-chip px-3 py-2 rounded-xl text-xs font-bold border-2 transition-all flex items-center gap-1.5 border-orange-300 bg-orange-50 text-orange-700">
                🥉 Bronce <span class="text-[10px] opacity-60">×0.7845</span>
              </button>
              <button type="button" data-level="Plata" class="level-chip px-3 py-2 rounded-xl text-xs font-bold border-2 transition-all flex items-center gap-1.5 border-outline-variant/20 text-on-surface-variant hover:border-gray-300">
                🥈 Plata <span class="text-[10px] opacity-60">×0.7414</span>
              </button>
              <button type="button" data-level="Oro" class="level-chip px-3 py-2 rounded-xl text-xs font-bold border-2 transition-all flex items-center gap-1.5 border-outline-variant/20 text-on-surface-variant hover:border-yellow-300">
                🥇 Oro <span class="text-[10px] opacity-60">×0.6983</span>
              </button>
              <button type="button" data-level="Zafiro" class="level-chip px-3 py-2 rounded-xl text-xs font-bold border-2 transition-all flex items-center gap-1.5 border-outline-variant/20 text-on-surface-variant hover:border-blue-300">
                💎 Zafiro <span class="text-[10px] opacity-60">×0.6811</span>
              </button>
              <button type="button" data-level="Diamante" class="level-chip px-3 py-2 rounded-xl text-xs font-bold border-2 transition-all flex items-center gap-1.5 border-outline-variant/20 text-on-surface-variant hover:border-purple-300">
                💠 Diamante <span class="text-[10px] opacity-60">×0.6552</span>
              </button>
            </div>
          </div>

          <!-- Pricing -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label
                class="block text-sm font-bold text-on-surface-variant mb-2 ml-1"
                for="price"
              >Precio de Venta (Revista) <span class="text-error">*</span></label>
              <div class="relative flex items-center">
                <span class="absolute left-5 font-bold text-primary">$</span>
                <input
                  type="number"
                  step="0.01"
                  id="price"
                  class="ai-field w-full pl-10 pr-5 py-4 bg-surface-container-highest border-none rounded-xl focus:ring-2 focus:ring-primary-container font-headline text-xl"
                  placeholder="0.00"
                />
              </div>
              <span class="ai-badge hidden absolute -top-1 -right-1 w-5 h-5 rounded-full bg-purple-500 text-white flex items-center justify-center text-[10px]">
                <span class="material-symbols-outlined text-[12px]">auto_awesome</span>
              </span>
            </div>
            <div>
              <label
                class="block text-sm font-bold text-on-surface-variant mb-2 ml-1"
                for="cost"
              >Tu Costo <span id="cost-level-badge" class="text-xs font-normal text-primary">(Bronce ×0.7845)</span></label>
              <div class="relative flex items-center">
                <span class="absolute left-5 font-bold text-on-surface-variant"
                  >$</span>
                <input
                  type="number"
                  step="0.01"
                  id="cost"
                  class="w-full pl-10 pr-5 py-4 bg-surface-container-highest border-none rounded-xl focus:ring-2 focus:ring-primary-container"
                  placeholder="Auto"
                />
              </div>
              <p class="text-[10px] text-on-surface-variant mt-1 ml-1">Auto-calculado. Puedes sobrescribirlo.</p>
            </div>
          </div>

          <!-- Profit Panel -->
          <div id="profit-panel" class="hidden bg-gradient-to-r from-green-50 to-emerald-50 rounded-2xl p-4 border border-green-200/30">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span id="profit-icon" class="material-symbols-outlined text-green-600">trending_up</span>
                <div>
                  <p class="text-xs font-bold text-green-800">Ganancia Estimada</p>
                  <p id="profit-amount" class="text-lg font-bold text-green-700 font-headline">$0.00</p>
                </div>
              </div>
              <div class="text-right">
                <p id="profit-percent" class="text-sm font-bold text-green-700">0%</p>
                <p id="profit-net" class="text-[10px] text-green-600">neto desglosando IVA</p>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- Right Column: Preview & Actions -->
    <div class="lg:col-span-5 space-y-6">
      <!-- Product Preview Card -->
      <div
        class="bg-surface-container-lowest p-6 rounded-[2rem] shadow-[0_32px_32px_-4px_rgba(29,26,34,0.06)] border border-surface-container-low sticky top-6"
      >
        <h4 class="text-sm font-bold text-on-surface-variant mb-4 flex items-center gap-2">
          <span class="material-symbols-outlined text-tertiary text-lg">preview</span>
          Vista Previa del Producto
        </h4>

        <!-- Preview Image -->
        <div
          id="preview-card-img"
          class="aspect-square w-full rounded-2xl bg-surface-container flex items-center justify-center overflow-hidden mb-4 border border-outline-variant/10"
        >
          <div class="text-center p-6" id="preview-placeholder">
            <span class="material-symbols-outlined text-5xl text-on-surface-variant/20 mb-2">image</span>
            <p class="text-xs text-on-surface-variant/50">La foto aparecerá aquí</p>
          </div>
          <img id="preview-card-photo" class="w-full h-full object-contain hidden" alt="Preview" />
        </div>

        <!-- Preview Details -->
        <div class="space-y-3">
          <div>
            <p class="text-[9px] uppercase font-bold tracking-widest text-on-surface-variant">Nombre</p>
            <p id="preview-name" class="font-bold text-on-surface text-sm leading-tight">—</p>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div>
              <p class="text-[9px] uppercase font-bold tracking-widest text-on-surface-variant">Marca</p>
              <p id="preview-brand" class="font-bold text-primary text-sm">—</p>
            </div>
            <div>
              <p class="text-[9px] uppercase font-bold tracking-widest text-on-surface-variant">Categoría</p>
              <p id="preview-category" class="font-bold text-on-surface text-sm">—</p>
            </div>
            <div>
              <p class="text-[9px] uppercase font-bold tracking-widest text-on-surface-variant">Stock</p>
              <p id="preview-stock" class="font-bold text-secondary text-sm">1</p>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3 pt-3 border-t border-outline-variant/10">
            <div>
              <p class="text-[9px] uppercase font-bold tracking-widest text-on-surface-variant">Tu Costo</p>
              <p id="preview-cost" class="font-bold text-on-surface text-lg">$0</p>
            </div>
            <div>
              <p class="text-[9px] uppercase font-bold tracking-widest text-on-surface-variant">Precio Venta</p>
              <p id="preview-price" class="font-bold text-primary text-lg font-headline">$0</p>
            </div>
          </div>
          <div id="preview-profit-wrap" class="hidden pt-3 border-t border-outline-variant/10">
            <p class="text-[9px] uppercase font-bold tracking-widest text-on-surface-variant">Ganancia</p>
            <p id="preview-profit" class="font-bold text-green-600 text-sm">$0</p>
          </div>
          <div id="preview-desc-wrap" class="hidden pt-3 border-t border-outline-variant/10">
            <p class="text-[9px] uppercase font-bold tracking-widest text-on-surface-variant">Descripción</p>
            <p id="preview-desc" class="text-xs text-on-surface-variant leading-relaxed mt-1">—</p>
          </div>
