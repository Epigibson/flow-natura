        <!-- Feedback Area -->
        <div
          id="form-error"
          class="hidden text-error bg-error-container p-4 rounded-xl text-sm font-semibold mt-4"
        ></div>
        <div
          id="form-success"
          class="hidden text-secondary bg-secondary-container p-4 flex flex-col items-center rounded-xl text-sm font-semibold mt-4"
        >
          <span class="material-symbols-outlined text-3xl mb-2">check_circle</span>
          ¡Producto creado correctamente!
        </div>

        <!-- Save Button -->
        <button
          id="btn-save"
          class="w-full py-4 mt-6 bg-gradient-to-r from-primary to-primary-container text-white rounded-2xl font-bold font-headline shadow-lg shadow-primary/20 hover:scale-[1.02] active:scale-95 transition-all flex items-center justify-center gap-2"
        >
          <span class="material-symbols-outlined">save</span>
          Guardar Producto
        </button>
      </div>
    </div>
  </div>
</DashboardLayout>

<style>
  .ai-field.ai-filled {
    box-shadow: 0 0 0 2px rgba(139, 92, 246, 0.3);
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.03) 0%, transparent 100%);
  }

  .ai-badge {
    animation: badge-pulse 2s ease-in-out infinite;
  }

  @keyframes badge-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.7; transform: scale(0.9); }
  }

  @keyframes field-fill {
    0% { background-color: rgba(139, 92, 246, 0.15); }
    100% { background-color: transparent; }
  }

  .ai-field.flash {
    animation: field-fill 0.8s ease-out;
  }

  /* Camera shutter effect */
  @keyframes shutter {
    0% { opacity: 0; }
    30% { opacity: 1; }
    100% { opacity: 0; }
  }

  #camera-area .shutter-flash {
    animation: shutter 0.3s ease-out;
  }
</style>

<script>
  import { supabase } from "../../lib/supabase";
  import { authFetch } from "../../lib/auth-fetch";
  import api from '../../lib/api';
  import { NativeBarcodeScanner } from "../../lib/barcode-scanner";
  import { CAMINO_CRECIMIENTO, calculateConsultantPrice } from "../../lib/camino-crecimiento";
  import type { ConsultantLevel } from "../../lib/camino-crecimiento";

  // ═══════════ STATE ═══════════
  let currentUserId = "";
  let inlineScanner: NativeBarcodeScanner | null = null;
  let scannedEan = "";
  let cameraStream: MediaStream | null = null;
  let capturedImageBase64 = "";
  let capturedMimeType = "image/jpeg";
  let isAnalyzing = false;
  let aiGeneratedImageUrl = ""; // Pre-uploaded URL from AI generation
  let selectedLevel: ConsultantLevel = (localStorage.getItem('natura_level') as ConsultantLevel) || 'Bronce';
  let costManuallyEdited = false; // Track if user manually changed cost

  // ═══════════ DOM ELEMENTS ═══════════
  const codeInput = document.getElementById("product_code") as HTMLInputElement;
  const nameInput = document.getElementById("product_name") as HTMLInputElement;
  const categorySelect = document.getElementById("category") as HTMLSelectElement;
  const brandInput = document.getElementById("brand") as HTMLInputElement;
  const descInput = document.getElementById("description") as HTMLTextAreaElement;
  const stockInput = document.getElementById("stock") as HTMLInputElement;
  const costInput = document.getElementById("cost") as HTMLInputElement;
  const priceInput = document.getElementById("price") as HTMLInputElement;
  const btnSave = document.getElementById("btn-save") as HTMLButtonElement;
  const errorDiv = document.getElementById("form-error") as HTMLElement;
  const successDiv = document.getElementById("form-success") as HTMLElement;

  // Camera elements
  const cameraIdle = document.getElementById("camera-idle") as HTMLElement;
  const cameraVideo = document.getElementById("camera-video") as HTMLVideoElement;
  const cameraControls = document.getElementById("camera-controls") as HTMLElement;
  const captureCanvas = document.getElementById("capture-canvas") as HTMLCanvasElement;
  const photoPreview = document.getElementById("photo-preview") as HTMLImageElement;
  const btnOpenCamera = document.getElementById("btn-open-camera") as HTMLButtonElement;
  const btnCapture = document.getElementById("btn-capture") as HTMLButtonElement;
  const btnAnalyze = document.getElementById("btn-analyze") as HTMLButtonElement;
  const btnRetake = document.getElementById("btn-retake") as HTMLButtonElement;
  const aiLoading = document.getElementById("ai-loading") as HTMLElement;
  const aiSuccess = document.getElementById("ai-success") as HTMLElement;
  const aiConfidence = document.getElementById("ai-confidence") as HTMLElement;

  // Scanner elements
  const btnScanToggle = document.getElementById("btn-scan-toggle") as HTMLButtonElement;
  const btnScanClose = document.getElementById("btn-scan-close") as HTMLButtonElement;
  const inlineScannerWrap = document.getElementById("inline-scanner-wrap") as HTMLElement;
  const scannedEanInput = document.getElementById("scanned_ean") as HTMLInputElement;

  // Preview elements
  const previewName = document.getElementById("preview-name") as HTMLElement;
  const previewBrand = document.getElementById("preview-brand") as HTMLElement;
  const previewCategory = document.getElementById("preview-category") as HTMLElement;
  const previewStock = document.getElementById("preview-stock") as HTMLElement;
  const previewCost = document.getElementById("preview-cost") as HTMLElement;
  const previewPrice = document.getElementById("preview-price") as HTMLElement;
  const previewDesc = document.getElementById("preview-desc") as HTMLElement;
  const previewDescWrap = document.getElementById("preview-desc-wrap") as HTMLElement;
  const previewPhoto = document.getElementById("preview-card-photo") as HTMLImageElement;
  const previewPlaceholder = document.getElementById("preview-placeholder") as HTMLElement;
  const previewProfit = document.getElementById("preview-profit") as HTMLElement;
  const previewProfitWrap = document.getElementById("preview-profit-wrap") as HTMLElement;

  // Level elements
  const levelChips = document.querySelectorAll('.level-chip') as NodeListOf<HTMLButtonElement>;
  const costLevelBadge = document.getElementById('cost-level-badge') as HTMLElement;
  const profitPanel = document.getElementById('profit-panel') as HTMLElement;
  const profitAmount = document.getElementById('profit-amount') as HTMLElement;
  const profitPercent = document.getElementById('profit-percent') as HTMLElement;
  const profitNet = document.getElementById('profit-net') as HTMLElement;
  const profitIcon = document.getElementById('profit-icon') as HTMLElement;

  // ═══════════ LEVEL STYLES ═══════════
  const LEVEL_STYLES: Record<ConsultantLevel, { border: string; bg: string; text: string; emoji: string }> = {
    Bronce:   { border: 'border-orange-300', bg: 'bg-orange-50',  text: 'text-orange-700', emoji: '🥉' },
    Plata:    { border: 'border-gray-400',   bg: 'bg-gray-50',    text: 'text-gray-700',   emoji: '🥈' },
    Oro:      { border: 'border-yellow-400', bg: 'bg-yellow-50',  text: 'text-yellow-700', emoji: '🥇' },
    Zafiro:   { border: 'border-blue-400',   bg: 'bg-blue-50',    text: 'text-blue-700',   emoji: '💎' },
    Diamante: { border: 'border-purple-400', bg: 'bg-purple-50',  text: 'text-purple-700', emoji: '💠' },
  };

  // ═══════════ LEVEL SELECTOR ═══════════
  function selectLevel(level: ConsultantLevel) {
    selectedLevel = level;
    localStorage.setItem('natura_level', level);
    const info = CAMINO_CRECIMIENTO[level];
    const style = LEVEL_STYLES[level];

    // Update chip styles
    levelChips.forEach(chip => {
      const chipLevel = chip.dataset.level as ConsultantLevel;
      const s = LEVEL_STYLES[chipLevel];
      if (chipLevel === level) {
        chip.className = `level-chip px-3 py-2 rounded-xl text-xs font-bold border-2 transition-all flex items-center gap-1.5 ${s.border} ${s.bg} ${s.text} ring-2 ring-offset-1 ring-${s.border.replace('border-', '')}/50 scale-105`;
      } else {
        chip.className = `level-chip px-3 py-2 rounded-xl text-xs font-bold border-2 transition-all flex items-center gap-1.5 border-outline-variant/20 text-on-surface-variant hover:${s.border}`;
      }
    });

    // Update cost label badge
    costLevelBadge.textContent = `(${style.emoji} ${level} ×${info.priceFactor})`;

    // Recalculate cost from price
    recalculateCost();
  }

  function recalculateCost() {
    const price = parseFloat(priceInput.value);
    if (!price || price <= 0 || costManuallyEdited) return;

    const cost = calculateConsultantPrice(price, selectedLevel);
    costInput.value = cost.toFixed(2);
    updateProfitPanel();
    updatePreview();
  }

  function updateProfitPanel() {
    const price = parseFloat(priceInput.value) || 0;
    const cost = parseFloat(costInput.value) || 0;
    const profit = price - cost;

    if (price <= 0) {
      profitPanel.classList.add('hidden');
      previewProfitWrap.classList.add('hidden');
      return;
    }

    profitPanel.classList.remove('hidden');
    previewProfitWrap.classList.remove('hidden');

    const info = CAMINO_CRECIMIENTO[selectedLevel];

    if (profit > 0) {
      profitPanel.className = 'bg-gradient-to-r from-green-50 to-emerald-50 rounded-2xl p-4 border border-green-200/30';
      profitAmount.textContent = '$' + profit.toFixed(2);
      profitAmount.className = 'text-lg font-bold text-green-700 font-headline';
      profitPercent.textContent = info.profitPercentage + '% ganancia';
      profitPercent.className = 'text-sm font-bold text-green-700';
      profitNet.textContent = info.netProfitMsg + ' neto sin IVA';
      profitNet.className = 'text-[10px] text-green-600';
      profitIcon.textContent = 'trending_up';
      profitIcon.className = 'material-symbols-outlined text-green-600';
      previewProfit.textContent = '+$' + profit.toFixed(0) + ' (' + info.profitPercentage + '%)';
      previewProfit.className = 'font-bold text-green-600 text-sm';
    } else {
      profitPanel.className = 'bg-gradient-to-r from-red-50 to-rose-50 rounded-2xl p-4 border border-red-200/30';
      profitAmount.textContent = '-$' + Math.abs(profit).toFixed(2);
      profitAmount.className = 'text-lg font-bold text-red-700 font-headline';
      profitPercent.textContent = 'Sin ganancia';
      profitPercent.className = 'text-sm font-bold text-red-700';
      profitNet.textContent = 'El costo supera el precio de venta';
      profitNet.className = 'text-[10px] text-red-600';
      profitIcon.textContent = 'trending_down';
      profitIcon.className = 'material-symbols-outlined text-red-600';
      previewProfit.textContent = '-$' + Math.abs(profit).toFixed(0);
      previewProfit.className = 'font-bold text-red-600 text-sm';
    }
  }

  // Level chip click handlers
  levelChips.forEach(chip => {
    chip.addEventListener('click', () => {
      const level = chip.dataset.level as ConsultantLevel;
      costManuallyEdited = false; // Reset manual flag when switching levels
      selectLevel(level);
    });
  });

  // Listen for manual cost edits
  costInput?.addEventListener('input', () => {
    costManuallyEdited = true;
    updateProfitPanel();
    updatePreview();
  });

  // Listen for price changes -> auto-calculate cost
  priceInput?.addEventListener('input', () => {
    costManuallyEdited = false; // Reset so auto-calc kicks in
    recalculateCost();
  });

  // ═══════════ AUTH + LEVEL DETECTION ═══════════
  supabase.auth.getSession().then(async ({ data: { session } }: any) => {
    if (session) {
      currentUserId = session.user.id;

      // Try to auto-detect level from profile
      try {
        const { data: profile } = await supabase
          .from('consultant_profiles')
          .select('latest_growth_data')
          .eq('id', session.user.id)
          .single();

        if (profile?.latest_growth_data?.level?.description) {
          const desc = profile.latest_growth_data.level.description as string;
          // Map the level description to our ConsultantLevel type
          const levelMap: Record<string, ConsultantLevel> = {
            'Bronce': 'Bronce', 'Plata': 'Plata', 'Oro': 'Oro',
            'Zafiro': 'Zafiro', 'Diamante': 'Diamante',
            // Also handle possible Natura API level names
            'BRONCE': 'Bronce', 'PLATA': 'Plata', 'ORO': 'Oro',
            'ZAFIRO': 'Zafiro', 'DIAMANTE': 'Diamante',
          };
          const detectedLevel = Object.entries(levelMap).find(([key]) => desc.includes(key));
          if (detectedLevel) {
            selectedLevel = detectedLevel[1];
            localStorage.setItem('natura_level', selectedLevel);
          }
        }
      } catch (e) {
        // Fallback: use localStorage value (already set)
      }

      // Initialize level selector with detected/saved level
      selectLevel(selectedLevel);
    }
  });

  // ═══════════ CAMERA ═══════════
  async function openCamera() {
    try {
      // Stop barcode scanner if active
      await stopInlineScanner();

      cameraStream = await navigator.mediaDevices.getUserMedia({
        video: {
          facingMode: "environment",
          width: { ideal: 1920 },
          height: { ideal: 1080 },
        },
        audio: false,
      });

      cameraVideo.srcObject = cameraStream;
      await cameraVideo.play();

      // Show video, hide idle & preview
      cameraIdle.classList.add("hidden");
      photoPreview.classList.add("hidden");
      cameraVideo.classList.remove("hidden");
      cameraControls.classList.remove("hidden");

      // Update buttons
      btnOpenCamera.innerHTML = '<span class="material-symbols-outlined text-lg">videocam_off</span> Cerrar Cámara';
      btnAnalyze.classList.add("hidden");
      btnRetake.classList.add("hidden");
    } catch (err: unknown) {
      const msg = err instanceof Error ? err.message : String(err);
      showError("No se pudo abrir la cámara: " + msg);
    }
  }

  function closeCamera() {
    if (cameraStream) {
      cameraStream.getTracks().forEach((t) => t.stop());
      cameraStream = null;
    }
    cameraVideo.srcObject = null;
    cameraVideo.classList.add("hidden");
    cameraControls.classList.add("hidden");

    if (!capturedImageBase64) {
      cameraIdle.classList.remove("hidden");
    }

    btnOpenCamera.innerHTML = '<span class="material-symbols-outlined text-lg">photo_camera</span> Abrir Cámara';
  }

  function capturePhoto() {
    if (!cameraVideo.videoWidth) return;

    const canvas = captureCanvas;
    canvas.width = cameraVideo.videoWidth;
    canvas.height = cameraVideo.videoHeight;

    const ctx = canvas.getContext("2d")!;
    ctx.drawImage(cameraVideo, 0, 0);

    // Flash effect
    const flash = document.createElement("div");
    flash.className = "shutter-flash absolute inset-0 bg-white pointer-events-none z-10";
    document.getElementById("camera-area")!.appendChild(flash);
    setTimeout(() => flash.remove(), 300);

    // Haptic feedback
    if (navigator.vibrate) navigator.vibrate(50);

    // Get base64
    capturedImageBase64 = canvas.toDataURL("image/jpeg", 0.85);
    capturedMimeType = "image/jpeg";

    // Show preview
    photoPreview.src = capturedImageBase64;
    photoPreview.classList.remove("hidden");
    cameraVideo.classList.add("hidden");
    cameraControls.classList.add("hidden");

    // Update preview card
    previewPhoto.src = capturedImageBase64;
    previewPhoto.classList.remove("hidden");
    previewPlaceholder.classList.add("hidden");

    // Close camera stream
    closeCamera();

    // Show action buttons
    btnAnalyze.classList.remove("hidden");
    btnRetake.classList.remove("hidden");
    btnOpenCamera.classList.add("hidden");
  }

  function retakePhoto() {
    capturedImageBase64 = "";
    photoPreview.classList.add("hidden");
    aiSuccess.classList.add("hidden");
    btnAnalyze.classList.add("hidden");
    btnRetake.classList.add("hidden");
    btnOpenCamera.classList.remove("hidden");
    previewPhoto.classList.add("hidden");
    previewPlaceholder.classList.remove("hidden");
    openCamera();
  }

  // ═══════════ GEMINI ANALYSIS ═══════════
  async function analyzeWithGemini() {
    if (!capturedImageBase64 || isAnalyzing) return;

    isAnalyzing = true;
    aiLoading.classList.remove("hidden");
    aiSuccess.classList.add("hidden");
    btnAnalyze.disabled = true;
    btnAnalyze.innerHTML = '<span class="material-symbols-outlined text-lg animate-spin">progress_activity</span> Analizando...';

    try {
      const response = await authFetch("/api/gemini-analyze", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          imageBase64: capturedImageBase64,
          mimeType: capturedMimeType,
        }),
      });

      const data = await response.json();

      if (data.error) {
        showError("Error de IA: " + data.error);
        return;
      }

      // Auto-fill form with AI data
      fillFormWithAI(data);

      // Search for official catalog image
      let foundCatalogImage = false;
      if (data.name) {
        foundCatalogImage = await searchCatalogImage(data.name, data.brand || "");
      }

      // If no catalog image, generate a clean product photo with AI
      if (!foundCatalogImage) {
        await generateCleanImage();
      }

    } catch (err: unknown) {
      const msg = err instanceof Error ? err.message : String(err);
      showError("Error conectando con Gemini: " + msg);
    } finally {
      isAnalyzing = false;
      aiLoading.classList.add("hidden");
      btnAnalyze.disabled = false;
      btnAnalyze.innerHTML = '<span class="material-symbols-outlined text-lg">auto_awesome</span> Analizar con IA';
    }
  }

  // ═══════════ GENERATE CLEAN PRODUCT IMAGE (3-step pipeline) ═══════════
  function updateLoadingStep(step: number, text: string, subtext: string) {
    const loadingText = aiLoading.querySelector("p.font-bold");
    const loadingSub = aiLoading.querySelector("p.text-xs");
    if (loadingText) loadingText.textContent = text;
    if (loadingSub) loadingSub.textContent = subtext;
    aiLoading.classList.remove("hidden");

    // Update step indicators if they exist
    const steps = aiLoading.querySelectorAll('.ai-step-dot');
    steps.forEach((dot, i) => {
      if (i < step) dot.className = 'ai-step-dot w-2 h-2 rounded-full bg-green-500';
      else if (i === step) dot.className = 'ai-step-dot w-2 h-2 rounded-full bg-primary animate-pulse';
      else dot.className = 'ai-step-dot w-2 h-2 rounded-full bg-surface-container-highest';
    });
  }

  function showAiIndicator(message: string, color: string = 'purple') {
    // Remove any previous indicator
    document.querySelectorAll('.ai-image-indicator').forEach(el => el.remove());

    const indicator = document.createElement("div");
    indicator.className = `ai-image-indicator absolute bottom-3 left-3 right-3 bg-${color}-600/90 text-white text-xs font-bold px-3 py-2 rounded-xl flex items-center gap-2 backdrop-blur-sm z-10`;
    indicator.innerHTML = `
      <span class="material-symbols-outlined text-sm">auto_awesome</span>
      ${message}
      <button class="ml-auto text-[10px] underline opacity-80 hover:opacity-100 btn-use-original" title="Volver a usar la foto original">Usar mi foto</button>
    `;
    document.getElementById("camera-area")!.appendChild(indicator);

    // Allow switching back to original
    indicator.querySelector(".btn-use-original")?.addEventListener("click", () => {
      // We don't have the original anymore if it was replaced, but catalogImageUrl can be cleared
      catalogImageUrl = "";
      aiGeneratedImageUrl = "";
      indicator.remove();
    });
  }

  async function generateCleanImage() {
    // Step 1: Generate professional image with AI
    updateLoadingStep(0, "Generando foto profesional del producto...", "Esto puede tomar 5-15 segundos");

    // Add a 30-second timeout
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 30000);

    try {
      const res = await authFetch("/api/gemini-generate-image", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          imageBase64: capturedImageBase64,
          mimeType: capturedMimeType,
          productName: nameInput.value || undefined,
        }),
        signal: controller.signal,
      });

      clearTimeout(timeout);
      const result = await res.json();

      if (result.imageBase64) {
        // Replace preview with the generated clean image
        capturedImageBase64 = result.imageBase64;
        capturedMimeType = result.mimeType || "image/png";

        // Store the pre-uploaded URL (saves an upload at save time)
        if (result.imageUrl) {
          aiGeneratedImageUrl = result.imageUrl;
        }

        // Update previews
        photoPreview.src = capturedImageBase64;
        previewPhoto.src = capturedImageBase64;
        previewPhoto.classList.remove("hidden");
        previewPlaceholder.classList.add("hidden");

        showAiIndicator("Foto profesional generada por IA ✨", "purple");
      } else {
        console.warn("Image generation failed:", result.error);
        // Step 2: fallback — keep the original camera photo and upload it directly
        showAiIndicator("Usando foto original (la IA no pudo mejorarla)", "amber");
      }
    } catch (err: any) {
      clearTimeout(timeout);
      if (err.name === 'AbortError') {
        console.warn("Image generation timed out after 30s");
        showAiIndicator("Usando foto original (tiempo de espera agotado)", "amber");
      } else {
        console.warn("Image generation error:", err);
        showAiIndicator("Usando foto original", "amber");
      }
    } finally {
      aiLoading.classList.add("hidden");
      // Restore loading text for future use
      const loadingText = aiLoading.querySelector("p.font-bold");
      const loadingSub = aiLoading.querySelector("p.text-xs");
      if (loadingText) loadingText.textContent = "Gemini está analizando el producto...";
      if (loadingSub) loadingSub.textContent = "Esto toma 2-3 segundos";
    }
  }

  // ═══════════ CATALOG IMAGE SEARCH ═══════════
  let catalogImageUrl = "";

  async function searchCatalogImage(productName: string, brand: string): Promise<boolean> {
    // Search for matching product in the existing catalog
    // Use more keywords for stricter matching
    const keywords = productName.toLowerCase().split(/\s+/).filter(w => w.length > 2).slice(0, 6);
    if (keywords.length < 2) return false;

    // Try search with multiple keywords for better precision
    let query = supabase
      .from("products")
      .select("id, name, image_url")
      .not("image_url", "is", null)
      .neq("image_url", "");

    // Search using the two longest keywords (most distinctive)
    const sortedKeywords = [...keywords].sort((a, b) => b.length - a.length);
    query = query.ilike("name", `%${sortedKeywords[0]}%`);
    if (sortedKeywords[1]) {
      query = query.ilike("name", `%${sortedKeywords[1]}%`);
    }

    if (brand) {
      query = query.ilike("brand", `%${brand}%`);
    }

    const { data: matches } = await query.limit(10);

    if (matches && matches.length > 0) {
      // Score matches by how many keywords appear in the name
      const scored = matches.map(m => {
        const nameLower = m.name.toLowerCase();
        const matchCount = keywords.filter(k => nameLower.includes(k)).length;
        const matchRatio = matchCount / keywords.length;
        return { ...m, matchCount, matchRatio };
      }).sort((a, b) => b.matchRatio - a.matchRatio);

      const best = scored[0];
      // Require at least 60% keyword match to avoid false positives
      // (e.g., "Tododia Roll-on Leche" should NOT match "Tododia Shampoo Menta")
      if (best.matchRatio >= 0.6 && best.matchCount >= 2 && best.image_url) {
        catalogImageUrl = best.image_url;

        // Replace the preview with the catalog image
        previewPhoto.src = catalogImageUrl;
        previewPhoto.classList.remove("hidden");
        previewPlaceholder.classList.add("hidden");

        // Show a small indicator on the camera area
        const indicator = document.createElement("div");
        indicator.className = "absolute bottom-3 left-3 right-3 bg-green-600/90 text-white text-xs font-bold px-3 py-2 rounded-xl flex items-center gap-2 backdrop-blur-sm z-10";
        indicator.innerHTML = `
          <span class="material-symbols-outlined text-sm">auto_awesome</span>
          Imagen oficial del catálogo encontrada
          <button class="ml-auto text-[10px] underline opacity-80 hover:opacity-100 btn-use-my-photo">Usar mi foto</button>
        `;
        document.getElementById("camera-area")!.appendChild(indicator);

        // Allow switching back
        indicator.querySelector(".btn-use-my-photo")?.addEventListener("click", () => {
          catalogImageUrl = "";
          previewPhoto.src = capturedImageBase64;
          indicator.remove();
        });

        return true;
      }
    }

    return false;
  }

  function fillFormWithAI(data: any) {
    const fields: { el: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement; value: string }[] = [];

    if (data.code && !codeInput.value) {
      fields.push({ el: codeInput, value: data.code });
    }

    if (data.name) {
      fields.push({ el: nameInput, value: data.name });
    }

    if (data.brand) {
      fields.push({ el: brandInput, value: data.brand });
    }

    if (data.category) {
      // Try to match with existing options
      const opts = Array.from(categorySelect.options);
      const match = opts.find((o) => o.value.toLowerCase() === data.category.toLowerCase());
      if (match) {
        fields.push({ el: categorySelect, value: match.value });
      } else {
        // Add new option
        const newOpt = document.createElement("option");
        newOpt.value = data.category;
        newOpt.textContent = data.category;
        categorySelect.appendChild(newOpt);
        fields.push({ el: categorySelect, value: data.category });
      }
    }

    if (data.description) {
      fields.push({ el: descInput, value: data.description });
    }

    if (data.estimated_price && data.estimated_price > 0) {
      fields.push({ el: priceInput, value: String(Math.round(data.estimated_price)) });
    }

    if (data.estimated_cost && data.estimated_cost > 0) {
      fields.push({ el: costInput, value: String(Math.round(data.estimated_cost)) });
    }

    // Animate fill with stagger
    fields.forEach((f, i) => {
      setTimeout(() => {
        f.el.value = f.value;
        f.el.classList.add("ai-filled", "flash");

        // Show AI badge
        const badge = f.el.closest(".relative")?.querySelector(".ai-badge");
        if (badge) badge.classList.remove("hidden");

        // Update preview
        updatePreview();

        setTimeout(() => f.el.classList.remove("flash"), 800);
      }, i * 150);
    });

    // Show confidence
    const confLevel = data.confidence || "medium";
    const confMap: Record<string, { text: string; classes: string }> = {
      high: { text: "Alta confianza", classes: "bg-green-200 text-green-800" },
      medium: { text: "Confianza media", classes: "bg-amber-200 text-amber-800" },
      low: { text: "Baja confianza", classes: "bg-red-200 text-red-800" },
    };
    const conf = confMap[confLevel] || confMap.medium;
    aiConfidence.textContent = conf.text;
    aiConfidence.className = `px-2.5 py-1 rounded-full text-[10px] font-bold ${conf.classes}`;

    // Show success after all fields are filled
    setTimeout(() => {
      aiSuccess.classList.remove("hidden");
    }, fields.length * 150 + 100);
  }

  // ═══════════ MANUAL IMAGE MANAGEMENT ═══════════
  const newImgPreview = document.getElementById('new-img-preview')!;
  const newImgSrc = document.getElementById('new-img-preview-src') as HTMLImageElement;
  const newUrlInput = document.getElementById('new-image-url') as HTMLInputElement;
  const newImgDelete = document.getElementById('new-img-delete')!;

  function setNewImage(url: string) {
    newUrlInput.value = url;
    if (url) {
      newImgSrc.src = url;
      newImgPreview.classList.remove('hidden');
      newImgPreview.style.display = 'flex';
      
      catalogImageUrl = url;
      capturedImageBase64 = '';
      previewPhoto.src = url;
      previewPhoto.classList.remove("hidden");
      previewPlaceholder.classList.add("hidden");
    } else {
      newImgSrc.src = '';
      newImgPreview.classList.add('hidden');
      newImgPreview.style.display = 'none';
      if(catalogImageUrl === newUrlInput.value) catalogImageUrl = '';
      
      previewPhoto.classList.add("hidden");
      previewPlaceholder.classList.remove("hidden");
    }
  }

  newUrlInput?.addEventListener('input', () => setNewImage(newUrlInput.value));

  newImgDelete?.addEventListener('click', (e) => {
    e.preventDefault();
    setNewImage('');
  });

  document.getElementById('new-img-file')?.addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    if (file.size > 5 * 1024 * 1024) return alert('La imagen es muy grande (máximo 5MB).');

    const reader = new FileReader();
    reader.onload = async (ev) => {
      const base64 = ev.target?.result as string;
      await uploadNewBase64(base64, file.name, file.type);
    };
    reader.readAsDataURL(file);
  });

  async function uploadNewBase64(base64: string, fileName: string, mimeType: string) {
    const oldText = btnSave.innerHTML;
    btnSave.disabled = true;
    btnSave.innerHTML = '<span class="material-symbols-outlined text-sm animate-spin">refresh</span> Subiendo...';

    try {
      const res = await authFetch('/api/upload-product-image', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ imageBase64: base64, fileName, mimeType }),
      });
      const data = await res.json();
      if (data.url) setNewImage(data.url);
      else alert(data.error || 'Error subiendo imagen');
    } catch (err) {
      alert('Error de conexión al subir imagen');
    } finally {
      btnSave.disabled = false;
      btnSave.innerHTML = oldText;
      (document.getElementById('new-img-file') as HTMLInputElement).value = '';
    }
  }

  const newAiStatus = document.getElementById('new-ai-status') as HTMLDivElement;
  const newAiResult = document.getElementById('new-ai-result') as HTMLDivElement;
  let newAiFoundUrl = '';

  async function processStudioImage(name: string, code: string, desc: string, currentImg: string) {
    const newAiError = document.getElementById('new-error') || document.getElementById('new-ai-error') || newAiStatus; // fallback

    newAiStatus.classList.remove('hidden');
    newAiResult.classList.add('hidden');

    let originalBase64: string | null = null;
    let finalImgUrl: string | null = null;
    let aiNotes = "Edición completada.";

    try {
      if (currentImg && currentImg.startsWith('data:image')) {
        originalBase64 = currentImg;
      }

      // 30s timeout for enhance
      const enhanceController = new AbortController();
      const enhanceTimeout = setTimeout(() => enhanceController.abort(), 30000);

      const res = await authFetch('/api/enhance-product-image', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ productName: name, productCode: code, productDesc: desc, imageBase64: originalBase64, imageUrl: originalBase64 ? null : currentImg }),
        signal: enhanceController.signal,
      });
      clearTimeout(enhanceTimeout);
      const data = await res.json();

      newAiStatus.classList.add('hidden');

      if (data.error) throw new Error(data.error);

      if (data.suggested_image_url || data.image_base64) {
        finalImgUrl = data.suggested_image_url || null;
        aiNotes = data.notes || "Imagen mejorada con IA.";
        const strategy = data.strategy === 'imagen_bkg_removal' ? '🎯 Fondo removido' :
                         data.strategy === 'gemini_image_gen' ? '✨ Generada por IA' :
                         data.strategy === 'text_catalog_search' ? '📂 Catálogo oficial' : 'IA';
        
        newAiFoundUrl = finalImgUrl || '';
        // Show base64 preview for instant feedback, or URL
        const previewSrc = data.image_base64 || finalImgUrl || '';
        (document.getElementById('new-ai-img') as HTMLImageElement).src = previewSrc;
        document.getElementById('new-ai-name')!.textContent = data.identified_name || name || "Producto AI";
        
        const confText = data.confidence === 'high' ? 'Alta confianza' : data.confidence === 'medium' ? 'Confianza media' : 'Baja confianza';
        document.getElementById('new-ai-conf')!.textContent = `${strategy} • ${confText} • ${aiNotes}`;
        
        newAiResult.classList.remove('hidden');
      } else {
        alert("La IA no pudo procesar la imagen ni encontrar el oficial. Intenta con otra foto o ingresa más datos del producto.");
      }
    } catch (err: any) {
      newAiStatus.classList.add('hidden');
      if (err.name === 'AbortError') {
        alert('La solicitud tardó demasiado (30s). Intenta de nuevo.');
      } else {
        alert('Error conectando con IA Studio: ' + (err.message || err));
      }
    }
  }

  document.getElementById('new-img-ai')?.addEventListener('click', async (e) => {
    e.preventDefault();
    const name = nameInput.value;
    const code = codeInput.value;
    const desc = (document.getElementById('description') as HTMLTextAreaElement).value;
    const currentImg = (document.getElementById('new-img-preview-src') as HTMLImageElement).src;

    if (!name && !code && !desc && !currentImg) {
      return alert('Necesitas ingresar un nombre, código, descripción o tener una foto actual para procesar la imagen de estudio.');
    }

    await processStudioImage(name, code, desc, currentImg);
  });

  document.getElementById('new-ai-apply')?.addEventListener('click', (e) => {
    e.preventDefault();
    if (newAiFoundUrl) setNewImage(newAiFoundUrl);
    newAiResult.classList.add('hidden');
  });

  // ═══════════ LIVE PREVIEW ═══════════
  function updatePreview() {
    previewName.textContent = nameInput.value || "—";
    previewBrand.textContent = brandInput.value || "—";
    previewCategory.textContent = categorySelect.value || "—";
    previewStock.textContent = stockInput.value || "1";
    previewCost.textContent = "$" + (parseFloat(costInput.value) || 0).toFixed(0);
    previewPrice.textContent = "$" + (parseFloat(priceInput.value) || 0).toFixed(0);

    // Profit in preview
    const price = parseFloat(priceInput.value) || 0;
    const cost = parseFloat(costInput.value) || 0;
    if (price > 0 && cost > 0) {
      const profit = price - cost;
      previewProfitWrap.classList.remove('hidden');
      previewProfit.textContent = (profit >= 0 ? '+$' : '-$') + Math.abs(profit).toFixed(0);
      previewProfit.className = profit >= 0 ? 'font-bold text-green-600 text-sm' : 'font-bold text-red-600 text-sm';
    } else {
      previewProfitWrap.classList.add('hidden');
    }

    if (descInput.value) {
      previewDesc.textContent = descInput.value;
      previewDescWrap.classList.remove("hidden");
    } else {
      previewDescWrap.classList.add("hidden");
    }
  }

  // Listen for changes on all inputs
  [nameInput, brandInput, stockInput, descInput].forEach((el) => {
    el?.addEventListener("input", updatePreview);
  });
  categorySelect?.addEventListener("change", updatePreview);

  // ═══════════ INLINE BARCODE SCANNER ═══════════
  async function startInlineScanner() {
    await stopInlineScanner();
    // Close camera if active
    closeCamera();

    inlineScannerWrap.classList.remove("hidden");

    inlineScanner = new NativeBarcodeScanner({
      targetId: "inline-scanner",
      onScan: async (code) => {
        codeInput.value = code;
        scannedEan = code;
        scannedEanInput.value = code;
        await stopInlineScanner();
        updatePreview();
      },
    });

    await inlineScanner.start();
  }

  async function stopInlineScanner() {
    if (inlineScanner) {
      await inlineScanner.stop();
      inlineScanner = null;
    }
    inlineScannerWrap.classList.add("hidden");
  }

  // ═══════════ SAVE PRODUCT ═══════════
  btnSave?.addEventListener("click", async () => {
    errorDiv.classList.add("hidden");
    successDiv.classList.add("hidden");

    const code = codeInput.value.trim();
    const name = nameInput.value.trim();
    const category = categorySelect.value;
    const brand = brandInput.value.trim();
    const description = descInput.value.trim();
    const qty = parseInt(stockInput.value) || 0;
    const cost = parseFloat(costInput.value) || 0;
    const price = parseFloat(priceInput.value) || 0;

    if (!code || !name || qty < 1 || cost <= 0 || price <= 0) {
      showError("Por favor completa todos los campos requeridos con valores válidos.");
      return;
    }

    btnSave.disabled = true;
    btnSave.innerHTML =
      '<span class="material-symbols-outlined animate-spin">sync</span> Guardando...';

    // 1. Determine product image URL
    let imageUrl = "";
    if (catalogImageUrl) {
      // Use the official catalog image found by AI search
      imageUrl = catalogImageUrl;
    } else if (aiGeneratedImageUrl) {
      // Use the pre-uploaded AI-generated image (already in Supabase)
      imageUrl = aiGeneratedImageUrl;
    } else if (capturedImageBase64) {
      // Upload the camera photo to Supabase Storage as fallback
      try {
        const fileName = `${code}_${Date.now()}.jpg`;
        const uploadRes = await authFetch("/api/upload-product-image", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            imageBase64: capturedImageBase64,
            fileName,
            mimeType: capturedMimeType,
          }),
        });
        const uploadData = await uploadRes.json();
        if (uploadData.url) {
          imageUrl = uploadData.url;
        } else if (uploadData.error) {
          console.warn("Image upload failed:", uploadData.error);
        }
      } catch (err) {
        console.warn("Image upload error:", err);
      }
    }

    // 2. Create product via API (handles dedup by code internally or create+stock)
    try {
      const productPayload: Record<string, unknown> = {
        code,
        name,
        category: category || null,
        brand: brand || null,
        description: description || null,
        price,
        cost,
        stock: qty,
      };
      if (imageUrl) productPayload.image_url = imageUrl;

      await api.products.create(productPayload, selectedLevel || 'Bronce');
    } catch (err: any) {
      showError('Error registrando producto: ' + (err.message || err));
      return;
    }

    // Success!
    successDiv.classList.remove("hidden");

    // Clear form
    codeInput.value = "";
    nameInput.value = "";
    categorySelect.value = "";
    brandInput.value = "";
    descInput.value = "";
    stockInput.value = "1";
    costInput.value = "";
    priceInput.value = "";
    scannedEan = "";
    scannedEanInput.value = "";
    capturedImageBase64 = "";
    catalogImageUrl = "";

    // Remove catalog image indicator if present
    document.querySelector(".btn-use-my-photo")?.closest("div")?.remove();

    // Reset AI badges
    document.querySelectorAll(".ai-badge").forEach((b) => b.classList.add("hidden"));
    document.querySelectorAll(".ai-filled").forEach((el) => el.classList.remove("ai-filled"));
    document.querySelectorAll(".ai-image-indicator").forEach((el) => el.remove());
    aiSuccess.classList.add("hidden");
    aiGeneratedImageUrl = "";

    // Reset preview
    previewPhoto.classList.add("hidden");
    previewPlaceholder.classList.remove("hidden");
    photoPreview.classList.add("hidden");
    cameraIdle.classList.remove("hidden");
    btnOpenCamera.classList.remove("hidden");
    btnAnalyze.classList.add("hidden");
    btnRetake.classList.add("hidden");

    updatePreview();
    resetBtn();

    setTimeout(() => {
      successDiv.classList.add("hidden");
    }, 4000);
  });

  // ═══════════ HELPERS ═══════════
  function showError(msg: string) {
    errorDiv.textContent = msg;
    errorDiv.classList.remove("hidden");
    resetBtn();
  }

  function resetBtn() {
    btnSave.disabled = false;
    btnSave.innerHTML =
      '<span class="material-symbols-outlined">save</span> Guardar Producto';
  }

  // ═══════════ EVENT LISTENERS ═══════════
  btnOpenCamera?.addEventListener("click", () => {
    if (cameraStream) {
      closeCamera();
    } else {
      openCamera();
    }
  });

  cameraIdle?.addEventListener("click", () => openCamera());
  btnCapture?.addEventListener("click", capturePhoto);
  btnAnalyze?.addEventListener("click", analyzeWithGemini);
  btnRetake?.addEventListener("click", retakePhoto);

  btnScanToggle?.addEventListener("click", () => {
    if (inlineScannerWrap.classList.contains("hidden")) {
      startInlineScanner();
    } else {
      stopInlineScanner();
    }
  });
  btnScanClose?.addEventListener("click", () => stopInlineScanner());

  // Cleanup on page leave
  window.addEventListener("beforeunload", () => {
    closeCamera();
    if (inlineScanner?.running) inlineScanner.stop();
  });
</script>
