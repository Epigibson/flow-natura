---
import Layout from '../layouts/Layout.astro';
import PageLoader from '../components/PageLoader.astro';
---

<Layout title="Catálogo Digital - Natura">
  <div class="min-h-screen bg-surface">
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
      <header class="flex flex-col md:flex-row justify-between items-center mb-10 gap-4">
    <div>
      <p class="text-primary font-bold tracking-widest uppercase text-sm mb-1">HERRAMIENTAS</p>
      <h2 class="text-4xl md:text-5xl font-display font-bold text-on-surface">Catálogo Digital 💚</h2>
      <p class="text-on-surface-variant mt-2 text-lg">Explora productos y comparte con tus clientes por WhatsApp.</p>
    </div>
    <div class="flex items-center gap-3">
      <button id="btn-share-catalog" class="flex items-center gap-2 py-3 px-5 rounded-xl font-bold bg-secondary text-white shadow-md hover:scale-[1.02] transition-all">
        <span class="material-symbols-outlined text-lg">share</span>
        Compartir Catálogo
      </button>
    </div>
  </header>

  <!-- KPIs -->
  <section class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
    <div class="bg-surface-container-lowest rounded-2xl p-5 shadow-sm text-center">
      <p id="kpi-total" class="text-3xl font-display font-bold text-on-surface">—</p>
      <p class="text-xs text-on-surface-variant mt-1 font-bold uppercase tracking-wider">Productos</p>
    </div>
    <div class="bg-surface-container-lowest rounded-2xl p-5 shadow-sm text-center">
      <p id="kpi-stock" class="text-3xl font-display font-bold text-secondary">—</p>
      <p class="text-xs text-on-surface-variant mt-1 font-bold uppercase tracking-wider">Con Stock</p>
    </div>
    <div class="bg-surface-container-lowest rounded-2xl p-5 shadow-sm text-center">
      <p id="kpi-brands" class="text-3xl font-display font-bold text-primary">—</p>
      <p class="text-xs text-on-surface-variant mt-1 font-bold uppercase tracking-wider">Marcas</p>
    </div>
    <div class="bg-surface-container-lowest rounded-2xl p-5 shadow-sm text-center">
      <p id="kpi-categories" class="text-3xl font-display font-bold text-tertiary">—</p>
      <p class="text-xs text-on-surface-variant mt-1 font-bold uppercase tracking-wider">Categorías</p>
    </div>
  </section>

  <!-- Search & Filters -->
  <section class="bg-surface-container-lowest rounded-[2rem] p-6 mb-8 shadow-sm">
    <div class="flex flex-wrap gap-3">
      <div class="flex-1 min-w-[240px] relative">
        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-on-surface-variant">search</span>
        <input id="search" type="text" placeholder="Buscar por nombre, código o marca..."
          class="w-full bg-surface-container-highest border-none rounded-xl py-3 pl-11 pr-4 text-sm focus:ring-2 focus:ring-primary-container" />
      </div>
      <select id="filter-brand" class="bg-surface-container-highest border-none rounded-xl py-3 px-4 text-xs font-bold min-w-[150px]">
        <option value="">Todas las marcas</option>
      </select>
      <select id="filter-category" class="bg-surface-container-highest border-none rounded-xl py-3 px-4 text-xs font-bold min-w-[170px]">
        <option value="">Todas las categorías</option>
      </select>
      <div class="flex items-center gap-1 bg-surface-container-highest rounded-xl p-1">
        <button id="view-grid" class="w-9 h-9 rounded-lg bg-primary text-white flex items-center justify-center transition-colors" title="Grid">
          <span class="material-symbols-outlined text-sm">grid_view</span>
        </button>
        <button id="view-list" class="w-9 h-9 rounded-lg text-on-surface-variant hover:bg-surface-container flex items-center justify-center transition-colors" title="Lista">
          <span class="material-symbols-outlined text-sm">list</span>
        </button>
      </div>
    </div>
    <p id="results-count" class="text-xs text-on-surface-variant mt-3 font-bold uppercase tracking-wider"></p>
  </section>

  <!-- Products Grid -->
  <section>
    <div id="products-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      <div id="loading" class="col-span-full text-center py-16">
        <div class="inline-flex items-center gap-3 bg-surface-container-lowest rounded-2xl px-8 py-5 shadow-sm">
          <PageLoader inline={true} text="Cargando catálogo" />
        </div>
      </div>
    </div>
    <div id="load-more-wrap" class="hidden text-center mt-8">
      <button id="btn-load-more" class="inline-flex items-center gap-2 py-3 px-8 rounded-xl font-bold border-2 border-primary/20 text-primary hover:bg-primary/5 transition-colors">
        <span class="material-symbols-outlined">expand_more</span>
        <span id="load-more-text">Mostrar más</span>
      </button>
    </div>
  </section>

  <!-- Floating Cart Button -->
  <div id="cart-float" class="fixed bottom-6 right-6 hidden z-50">
    <button id="btn-show-cart" class="flex items-center gap-2 py-3.5 px-7 rounded-full font-bold bg-primary text-white shadow-2xl shadow-primary/30 hover:scale-105 transition-all">
      <span class="material-symbols-outlined">shopping_cart</span>
      <span id="cart-label">Ver Pedido (0)</span>
    </button>
  </div>

  <!-- Cart Modal -->
  <dialog id="cart-modal" class="p-0 rounded-2xl shadow-2xl border-none backdrop:bg-on-surface/50 backdrop:backdrop-blur-sm m-auto w-full max-w-lg bg-transparent">
    <div class="bg-surface-container-lowest rounded-2xl p-8 w-full border border-outline-variant/20 max-h-[80vh] overflow-y-auto">
      <div class="flex justify-between items-center mb-6">
        <h3 class="text-2xl font-display font-bold flex items-center gap-2">
          <span class="material-symbols-outlined text-primary">shopping_cart</span>
          Tu Pedido
        </h3>
        <button id="btn-close-cart" class="w-9 h-9 rounded-xl flex items-center justify-center hover:bg-error/10 hover:text-error transition-colors text-on-surface-variant">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
      <div id="cart-items" class="space-y-3 mb-6"></div>
      <div id="cart-empty" class="text-center py-6">
        <span class="material-symbols-outlined text-4xl text-on-surface-variant/30">shopping_bag</span>
        <p class="text-on-surface-variant mt-2 text-sm">Tu carrito está vacío</p>
      </div>
      <div class="border-t border-surface-container pt-4 flex justify-between items-center mb-6">
        <span class="font-bold text-on-surface text-lg">Total:</span>
        <span id="cart-total" class="text-2xl font-display font-bold text-primary">$0</span>
      </div>
      <div class="space-y-3">
        <button id="btn-send-whatsapp" class="w-full flex items-center justify-center gap-2 py-3.5 rounded-xl font-bold bg-secondary text-white hover:scale-[1.02] transition-all shadow-md">
          <span class="material-symbols-outlined">chat</span> Enviar por WhatsApp
        </button>
        <button id="btn-copy-order" class="w-full flex items-center justify-center gap-2 py-3 rounded-xl font-bold border-2 border-primary/20 text-primary hover:bg-primary/5 transition-colors">
          <span class="material-symbols-outlined">content_copy</span> Copiar Pedido
        </button>
      </div>
    </div>
  </dialog>
  <!-- Product Detail View (full-screen PDP) -->
  <div id="product-view" class="fixed inset-0 z-[90] bg-surface overflow-y-auto hidden">
    <div class="sticky top-0 z-10 bg-surface/90 backdrop-blur-md border-b border-outline-variant/10">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <button id="pv-back" class="flex items-center gap-2 text-on-surface-variant hover:text-primary font-bold text-sm transition-colors">
          <span class="material-symbols-outlined">arrow_back</span> Volver al catálogo
        </button>
        <button id="pv-close" class="w-10 h-10 rounded-full hover:bg-surface-container flex items-center justify-center text-on-surface-variant hover:text-error transition-colors" title="Cerrar">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 grid grid-cols-1 lg:grid-cols-2 gap-10">
      <!-- Galería -->
      <div class="pv-anim">
        <div id="pv-main-wrap" class="relative rounded-3xl bg-gradient-to-br from-primary-container/10 to-secondary-container/10 flex items-center justify-center overflow-hidden h-[360px] sm:h-[520px] cursor-zoom-in group">
          <img id="pv-img" class="max-h-full max-w-full object-contain p-6 transition-transform duration-500 group-hover:scale-[1.03]" alt="" />
          <span id="pv-img-fallback" class="material-symbols-outlined text-primary/20 text-9xl hidden">spa</span>
          <span id="pv-brand" class="absolute top-4 left-4 text-[10px] font-bold px-2.5 py-1 rounded-full"></span>
          <span class="absolute bottom-4 right-4 text-[10px] font-bold text-on-surface-variant/70 bg-white/85 px-2.5 py-1 rounded-full flex items-center gap-1 shadow-sm">
            <span class="material-symbols-outlined text-sm">zoom_in</span> Clic para ampliar
          </span>
        </div>
        <div id="pv-thumbs" class="flex gap-3 mt-4 overflow-x-auto pb-2"></div>
      </div>

      <!-- Info -->
      <div class="flex flex-col">
        <p id="pv-category" class="pv-anim pv-d1 text-xs font-bold uppercase tracking-widest text-primary/70"></p>
        <h2 id="pv-name" class="pv-anim pv-d1 text-3xl sm:text-4xl font-display font-bold text-on-surface mt-2 leading-tight"></h2>
        <p id="pv-code" class="pv-anim pv-d2 text-xs text-on-surface-variant/50 font-mono mt-2"></p>
        <div class="pv-anim pv-d2 flex items-center gap-3 mt-5">
          <p id="pv-price" class="text-4xl font-display font-bold text-primary"></p>
          <span id="pv-stock" class="text-xs font-bold px-2.5 py-1 rounded-full"></span>
        </div>
        <div id="pv-details" class="pv-anim pv-d3 mt-6"></div>

        <div id="pv-variants" class="pv-anim pv-d3 mt-7 hidden">
          <p class="text-xs font-bold uppercase tracking-widest text-on-surface-variant mb-3">Elige tu opción</p>
          <div id="pv-variants-list" class="flex flex-wrap gap-2.5"></div>
        </div>

        <div class="pv-anim pv-d4 flex items-center gap-3 mt-8">
          <div class="flex items-center gap-1 bg-surface-container-highest rounded-2xl p-1.5">
            <button id="pv-qty-minus" class="w-11 h-11 rounded-xl flex items-center justify-center text-on-surface-variant hover:bg-surface-container transition-colors">
              <span class="material-symbols-outlined">remove</span>
            </button>
            <span id="pv-qty" class="w-10 text-center font-bold text-on-surface text-lg">1</span>
            <button id="pv-qty-plus" class="w-11 h-11 rounded-xl flex items-center justify-center text-on-surface-variant hover:bg-surface-container transition-colors">
              <span class="material-symbols-outlined">add</span>
            </button>
          </div>
          <button id="pv-add" class="flex-1 flex items-center justify-center gap-2 py-4 rounded-2xl font-bold bg-primary text-white shadow-lg shadow-primary/25 hover:scale-[1.01] active:scale-[0.99] transition-transform">
            <span class="material-symbols-outlined text-lg">add_shopping_cart</span> Agregar al pedido
          </button>
        </div>
        <p class="pv-anim pv-d4 mt-4 text-xs text-on-surface-variant/70 flex items-center gap-1.5">
          <span class="material-symbols-outlined text-sm">local_shipping</span> Pide por WhatsApp — tu consultora confirma disponibilidad y entrega.
        </p>
      </div>
    </div>

    <!-- Relacionados -->
    <div id="pv-related-wrap" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 hidden">
      <div class="border-t border-outline-variant/10 pt-10">
        <h3 class="text-xl font-display font-bold text-on-surface">También te puede interesar</h3>
        <div id="pv-related" class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-6"></div>
      </div>
    </div>
  </div>

  <!-- Lightbox -->
  <div id="pv-lightbox" class="fixed inset-0 z-[100] bg-on-surface/95 hidden items-center justify-center cursor-zoom-out">
    <img id="pv-lightbox-img" class="max-w-[94vw] max-h-[92vh] object-contain rounded-2xl shadow-2xl transition-transform duration-300 cursor-zoom-in" alt="" />
    <button id="pv-lightbox-close" class="absolute top-5 right-5 w-11 h-11 rounded-full bg-white/10 text-white flex items-center justify-center hover:bg-white/20 transition-colors">
      <span class="material-symbols-outlined">close</span>
    </button>
  </div>
  <!-- Variants Modal -->
  <dialog id="variants-modal" class="p-0 rounded-2xl shadow-2xl border-none backdrop:bg-on-surface/50 backdrop:backdrop-blur-sm m-auto w-full max-w-md bg-transparent">
    <div class="bg-surface-container-lowest rounded-2xl p-6 w-full border border-outline-variant/20 max-h-[85vh] overflow-y-auto">
      <div class="flex justify-between items-center mb-4">
        <h3 id="variants-title" class="text-xl font-display font-bold text-on-surface"></h3>
        <button id="btn-close-variants" class="w-9 h-9 rounded-xl flex items-center justify-center hover:bg-error/10 hover:text-error transition-colors text-on-surface-variant">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
      <div id="variants-product-img" class="h-40 bg-gradient-to-br from-primary-container/10 to-secondary-container/10 rounded-2xl flex items-center justify-center overflow-hidden mb-4"></div>
      <p id="variants-subtitle" class="text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-3"></p>
      <div id="variants-list" class="space-y-2"></div>
    </div>
  </dialog>
    </main>
  </div>
</Layout>

<style>
  .product-card { transition: all 0.25s cubic-bezier(0.4,0,0.2,1); }
  .product-card:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(139,90,43,0.08); }
  .product-card .card-img { transition: transform 0.4s; }
  .product-card:hover .card-img { transform: scale(1.05); }
  .brand-natura { background: linear-gradient(135deg, #e8f5e9 0%, #f1f8e9 100%); color: #2e7d32; }
  .brand-avon { background: linear-gradient(135deg, #fce4ec 0%, #f8e8ff 100%); color: #ad1457; }
  .brand-default { background: linear-gradient(135deg, #e3f2fd 0%, #e8eaf6 100%); color: #1565c0; }
  .list-mode .product-card { display: flex !important; flex-direction: row !important; }
  .list-mode .product-card .card-media { width: 100px !important; min-height: 80px !important; height: auto !important; border-radius: 1rem !important; }
  .list-mode .product-card .card-body { flex: 1; }
  .btn-add-cart { transition: all 0.2s; }
  .btn-add-cart:active { transform: scale(0.92); }
  .variant-chip { transition: all 0.2s; cursor: pointer; }
  .variant-chip:hover { transform: scale(1.02); box-shadow: 0 4px 16px rgba(139,90,43,0.12); }
  .variants-badge { animation: pulse-badge 2s infinite; }
  @keyframes pulse-badge { 0%,100% { opacity: 1; } 50% { opacity: 0.7; } }
  /* PDP product detail view */
  #pv-img { transition: opacity .25s ease, transform .5s ease; }
  .pv-anim { animation: pv-fade-up .55s cubic-bezier(.2,.7,.2,1) both; }
  .pv-d1 { animation-delay: .07s; }
  .pv-d2 { animation-delay: .14s; }
  .pv-d3 { animation-delay: .21s; }
  .pv-d4 { animation-delay: .28s; }
  @keyframes pv-fade-up { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .pv-anim { animation: none; }
    #pv-img { transition: none; }
  }
</style>

<script>
  import { supabase } from '../lib/supabase';
  import { esc, sanitizeUrl } from '../lib/security';

  const params = new URLSearchParams(window.location.search);
  // `id` is the param older app builds shared; keep accepting it so old links work.
  let activeConsultantId = params.get('c') || params.get('id') || '';

  const grid = document.getElementById('products-grid') as HTMLElement;
  const loading = document.getElementById('loading') as HTMLElement;
  const search = document.getElementById('search') as HTMLInputElement;
  const filterBrand = document.getElementById('filter-brand') as HTMLSelectElement;
  const filterCat = document.getElementById('filter-category') as HTMLSelectElement;
  const cartFloat = document.getElementById('cart-float') as HTMLElement;
  const cartLabel = document.getElementById('cart-label') as HTMLElement;
  const cartModal = document.getElementById('cart-modal') as HTMLDialogElement;
  const cartItemsEl = document.getElementById('cart-items') as HTMLElement;
  const cartTotalEl = document.getElementById('cart-total') as HTMLElement;
  const cartEmpty = document.getElementById('cart-empty') as HTMLElement;

  interface Variant { id: string; code: string; label: string; type: string; price: number; imageUrl: string; }
  interface CartItem { id: string; name: string; variantLabel: string; price: number; qty: number; imageUrl: string; }
  let cart: CartItem[] = [];
  let allProducts: any[] = [];
  let viewMode: 'grid' | 'list' = 'grid';
  let displayCount = 40;
  const variantsModal = document.getElementById('variants-modal') as HTMLDialogElement;

  async function loadProducts() {
    let cid = activeConsultantId;
    const { data: { session } } = await supabase.auth.getSession();
    const currentUserId = session?.user?.id || '';

    if (!cid) {
      if (currentUserId) cid = currentUserId;
    }
    if (!cid) { loading.innerHTML = '<p class="text-on-surface-variant">No se encontró el catálogo. Verifica el link.</p>'; return; }
    activeConsultantId = cid; // Save resolved ID for the share button

    // Determine if this is the owner viewing their own catalog or a shared view
    const isOwner = currentUserId === cid;

    if (!isOwner) {
      // ── Shared catalog: use RPC (bypasses RLS safely) ──
      const { data: rpcResult, error: rpcError } = await supabase.rpc('get_public_catalog', {
        p_consultant_id: cid
      });

      if (rpcError || !rpcResult?.success) {
        loading.innerHTML = '<p class="text-on-surface-variant">No se pudo cargar el catálogo. Verifica el link.</p>';
        console.error('Catalog RPC error:', rpcError || rpcResult?.error);
        return;
      }

      allProducts = (rpcResult.products || []).map((p: any) => ({
        id: p.id,
        name: p.name || 'Producto',
        price: Number(p.price) || 0,
        category: p.category || '',
        code: p.code || '',
        brand: p.brand || '',
        description: p.description || '',
        descriptionData: p.description_data || null,
        imageUrl: p.image_url || '',
        hasVariants: p.has_variants || false,
        variants: (p.variants || []).map((v: any) => ({
          id: v.id, code: v.code, label: v.label,
          type: v.type || 'tono',
          price: Number(v.price) || 0, imageUrl: v.image_url || ''
        })),
        stock: Number(p.stock) || 0
      }));

      // Hide the share button for visitors
      const shareBtn = document.getElementById('btn-share-catalog');
      if (shareBtn) shareBtn.style.display = 'none';

    } else {
      // ── Owner: direct query (RLS allows it) ──
      // Paginated fetch (bypass 1000-row limit)
      let all: any[] = [];
      let from = 0;
      const BATCH = 1000;
      while (true) {
        const { data, error } = await supabase
          .from('inventory')
          .select('quantity, product_id, variant_id, price, products(id, name, price, category, code, brand, description, description_data, image_url, has_variants)')
          .eq('consultant_id', cid)
          .gt('quantity', 0)
          .range(from, from + BATCH - 1);
        if (error || !data || data.length === 0) break;
        all = all.concat(data);
        if (data.length < BATCH) break;
        from += BATCH;
      }

      // Fetch all product variants for products that have them
      const productIds = [...new Set(all.map((inv: any) => inv.products?.id).filter(Boolean))];
      let variantsMap: Record<string, Variant[]> = {};
      if (productIds.length > 0) {
        const { data: vData } = await supabase
          .from('product_variants')
          .select('id, product_id, code, variant_label, variant_type, price, image_url')
          .in('product_id', productIds);
        if (vData) {
          for (const v of vData) {
            if (!variantsMap[v.product_id]) variantsMap[v.product_id] = [];
            variantsMap[v.product_id].push({
              id: v.id, code: v.code, label: v.variant_label,
              type: v.variant_type || 'tono',
              price: v.price || 0, imageUrl: v.image_url || ''
            });
          }
        }
      }

      // Group inventory by product, summing stock across variants
      const productMap: Record<string, any> = {};
      for (const inv of all) {
        const pid = inv.products?.id || inv.product_id;
        if (!productMap[pid]) {
          productMap[pid] = {
            id: pid,
            name: inv.products?.name || 'Producto',
            price: Number(inv.price ?? inv.products?.price ?? 0),
            category: inv.products?.category || '',
            code: inv.products?.code || '',
            brand: inv.products?.brand || '',
            description: inv.products?.description || '',
            descriptionData: inv.products?.description_data || null,
            imageUrl: inv.products?.image_url || '',
            hasVariants: inv.products?.has_variants || false,
            variants: variantsMap[pid] || [],
            stock: 0
          };
        }
        productMap[pid].stock += inv.quantity;
      }

      allProducts = Object.values(productMap).sort((a: any, b: any) => a.name.localeCompare(b.name));
    }

    // Populate filters
    const brands = [...new Set(allProducts.map((p: any) => p.brand).filter(Boolean))].sort();
    brands.forEach(b => { const o = document.createElement('option'); o.value = b; o.textContent = b; filterBrand.appendChild(o); });
    const cats = [...new Set(allProducts.map((p: any) => p.category).filter(Boolean))].sort();
    cats.forEach(c => { const o = document.createElement('option'); o.value = c; o.textContent = c; filterCat.appendChild(o); });

    // KPIs
    (document.getElementById('kpi-total') as HTMLElement).textContent = String(allProducts.length);
    (document.getElementById('kpi-stock') as HTMLElement).textContent = String(allProducts.filter((p: any) => p.stock > 0).length);
    (document.getElementById('kpi-brands') as HTMLElement).textContent = String(brands.length);
    (document.getElementById('kpi-categories') as HTMLElement).textContent = String(cats.length);

    renderProducts();
  }

  function getFilteredProducts() {
    const q = search.value.toLowerCase().trim();
    const brand = filterBrand.value;
    const cat = filterCat.value;
    return allProducts.filter((p: any) => {
      const ms = !q || p.name.toLowerCase().includes(q) || p.code.toLowerCase().includes(q) || p.brand.toLowerCase().includes(q);
      const mb = !brand || p.brand === brand;
      const mc = !cat || p.category === cat;
      return ms && mb && mc;
    });
  }

  function renderProducts() {
    loading.classList.add('hidden');
    grid.querySelectorAll('.product-card').forEach(el => el.remove());
    const filtered = getFilteredProducts();
    const page = filtered.slice(0, displayCount);

    (document.getElementById('results-count') as HTMLElement).textContent = `${filtered.length} productos encontrados`;

    if (!filtered.length) {
      const empty = document.createElement('div');
      empty.className = 'product-card col-span-full text-center py-16';
      empty.innerHTML = `
        <span class="material-symbols-outlined text-5xl text-on-surface-variant/30">search_off</span>
        <p class="text-on-surface-variant mt-3 text-lg font-bold">No se encontraron productos</p>
        <p class="text-on-surface-variant/70 text-sm mt-1">Intenta con otra búsqueda o filtro.</p>`;
      grid.appendChild(empty);
      document.getElementById('load-more-wrap')!.classList.add('hidden');
      return;
    }

    page.forEach((p: any) => {
      const bc = p.brand === 'Avon' ? 'brand-avon' : p.brand === 'Natura' ? 'brand-natura' : 'brand-default';
      const card = document.createElement('div');
      card.className = 'product-card bg-surface-container-lowest rounded-2xl overflow-hidden shadow-sm';
      const sUrl = esc(sanitizeUrl(p.imageUrl));
      const hasV = p.hasVariants && p.variants.length > 0;
      const variantBadge = hasV
        ? `<span class="variants-badge absolute bottom-3 left-3 text-[10px] font-bold px-2.5 py-1 rounded-full bg-tertiary/90 text-white shadow-sm flex items-center gap-1"><span class="material-symbols-outlined text-xs">palette</span>${p.variants.length} opciones</span>`
        : '';
      const actionBtn = hasV
        ? `<button data-pid="${p.id}" class="btn-variants flex items-center gap-1 py-2 px-4 rounded-xl font-bold bg-tertiary text-white text-xs hover:shadow-md"><span class="material-symbols-outlined text-sm">palette</span> Elegir</button>`
        : `<button data-id="${p.id}" data-name="${enc(p.name)}" data-price="${p.price}" data-img="${enc(p.imageUrl)}" class="btn-add-cart flex items-center gap-1 py-2 px-4 rounded-xl font-bold bg-primary text-white text-xs hover:shadow-md"><span class="material-symbols-outlined text-sm">add_shopping_cart</span> Agregar</button>`;

      card.innerHTML = `
        <div class="card-media h-44 bg-gradient-to-br from-primary-container/10 to-secondary-container/10 flex items-center justify-center overflow-hidden relative cursor-pointer" data-detail="${p.id}">
          ${sUrl
            ? `<img src="${sUrl}" alt="${esc(p.name)}" class="card-img w-full h-full object-contain p-2" loading="lazy"/>`
            : `<span class="material-symbols-outlined text-primary/20 text-6xl">spa</span>`}
          <span class="absolute top-3 left-3 text-[10px] font-bold px-2.5 py-1 rounded-full ${bc}">${esc(p.brand) || 'General'}</span>
          <span class="absolute top-3 right-3 text-[10px] font-bold px-2 py-0.5 rounded-full bg-white/80 text-on-surface-variant shadow-sm">${p.stock} uds</span>
          ${variantBadge}
        </div>
        <div class="card-body p-4">
          <span class="text-[10px] font-bold uppercase tracking-wider text-primary/70">${esc(p.category) || 'General'}</span>
          <h3 class="font-bold text-on-surface text-sm mt-0.5 leading-tight line-clamp-2 cursor-pointer hover:text-primary transition-colors" title="${esc(p.name)}" data-detail="${p.id}">${esc(p.name)}</h3>
          <p class="text-[10px] text-on-surface-variant/50 font-mono mt-1">#${esc(p.code)}</p>
          <div class="flex items-center justify-between mt-3">
            <p class="text-xl font-display font-bold text-primary">$${Number(p.price).toFixed(2)}</p>
            ${actionBtn}
          </div>
        </div>`;
      grid.appendChild(card);
    });

    // Load more
    const wrap = document.getElementById('load-more-wrap')!;
    if (filtered.length > displayCount) {
      wrap.classList.remove('hidden');
      (document.getElementById('load-more-text') as HTMLElement).textContent = `Mostrar más (${filtered.length - displayCount} restantes)`;
    } else {
      wrap.classList.add('hidden');
    }

    // Bind add-to-cart buttons (products without variants)
    grid.querySelectorAll('.btn-add-cart').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const el = btn as HTMLElement;
        addToCart(el.dataset.id!, dec(el.dataset.name!), '', Number(el.dataset.price), dec(el.dataset.img || ''));
        el.innerHTML = '<span class="material-symbols-outlined text-sm">check</span> ✓';
        setTimeout(() => { el.innerHTML = '<span class="material-symbols-outlined text-sm">add_shopping_cart</span> Agregar'; }, 800);
      });
    });

    // Bind variant buttons
    grid.querySelectorAll('.btn-variants').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const pid = (btn as HTMLElement).dataset.pid!;
        const product = allProducts.find((p: any) => p.id === pid);
        if (product) openVariantsModal(product);
      });
    });

    // Bind product detail (image / title)
    bindProductDetail();
  }

  // ---- Product detail view (full-screen PDP) ----
  const pvView = document.getElementById('product-view') as HTMLElement;
  const pvLightbox = document.getElementById('pv-lightbox') as HTMLElement;
  const pvLightboxImg = document.getElementById('pv-lightbox-img') as HTMLImageElement;
  let pvProduct: any = null;
  let pvQty = 1;
  let pvSelectedVariant: Variant | null = null;
  let pvImages: { url: string; label: string }[] = [];
  let pvImageIndex = 0;

  function pvSetImage(i: number) {
    if (!pvImages.length) return;
    pvImageIndex = Math.max(0, Math.min(i, pvImages.length - 1));
    const img = document.getElementById('pv-img') as HTMLImageElement;
    const fallback = document.getElementById('pv-img-fallback') as HTMLElement;
    const url = esc(sanitizeUrl(pvImages[pvImageIndex].url));
    img.style.opacity = '0';
    setTimeout(() => {
      if (url) {
        img.src = url;
        img.classList.remove('hidden');
        fallback.classList.add('hidden');
      } else {
        img.classList.add('hidden');
        fallback.classList.remove('hidden');
      }
      img.style.opacity = '1';
    }, 120);
    (document.getElementById('pv-thumbs') as HTMLElement).querySelectorAll('button').forEach((b, idx) => {
      b.className = `shrink-0 w-16 h-16 rounded-xl overflow-hidden border-2 transition-all ${idx === pvImageIndex ? 'border-primary shadow-md scale-[1.03]' : 'border-outline-variant/20 opacity-60 hover:opacity-100'}`;
    });
  }

  function pvRenderThumbs() {
    const wrap = document.getElementById('pv-thumbs') as HTMLElement;
    wrap.innerHTML = '';
    pvImages.forEach((im, idx) => {
      const u = esc(sanitizeUrl(im.url));
      const b = document.createElement('button');
      b.title = im.label;
      b.innerHTML = u
        ? `<img src="${u}" class="w-full h-full object-contain bg-white p-1" alt="${esc(im.label)}"/>`
        : `<span class="material-symbols-outlined text-on-surface-variant/30 text-xl">spa</span>`;
      b.addEventListener('click', () => pvSetImage(idx));
      wrap.appendChild(b);
    });
    pvSetImage(0);
  }

  function pvRenderQty() {
    (document.getElementById('pv-qty') as HTMLElement).textContent = String(pvQty);
    const max = Number(pvProduct?.stock) || 1;
    (document.getElementById('pv-qty-minus') as HTMLButtonElement).disabled = pvQty <= 1;
    (document.getElementById('pv-qty-plus') as HTMLButtonElement).disabled = pvQty >= max;
  }

  function pvSelectVariant(v: Variant | null) {
    pvSelectedVariant = v;
    const price = Number(v?.price || pvProduct?.price || 0);
    (document.getElementById('pv-price') as HTMLElement).textContent = `$${price.toFixed(2)}`;
    if (v && v.imageUrl) pvSetImage(pvImages.findIndex(im => im.url === v.imageUrl && im.label === v.label));
    (document.getElementById('pv-variants-list') as HTMLElement).querySelectorAll('button').forEach(b => {
      const active = b.dataset.vid === (v?.id || '');
      b.className = `flex items-center gap-2 p-2 pr-3 rounded-2xl border transition-all ${active ? 'border-primary bg-primary/5 shadow-md scale-[1.02]' : 'border-outline-variant/15 hover:border-primary/40'}`;
    });
  }

  function pvRenderVariants() {
    const wrap = document.getElementById('pv-variants') as HTMLElement;
    const list = document.getElementById('pv-variants-list') as HTMLElement;
    const hasV = pvProduct.hasVariants && pvProduct.variants.length > 0;
    list.innerHTML = '';
    if (!hasV) { wrap.classList.add('hidden'); pvSelectVariant(null); return; }
    wrap.classList.remove('hidden');
    pvProduct.variants.forEach((v: Variant) => {
      const u = esc(sanitizeUrl(v.imageUrl || pvProduct.imageUrl));
      const b = document.createElement('button');
      b.dataset.vid = v.id;
      b.innerHTML = `
        ${u ? `<img src="${u}" class="w-10 h-10 object-contain rounded-xl bg-white shadow-sm"/>` : `<div class="w-10 h-10 rounded-xl bg-surface-container-highest flex items-center justify-center"><span class="material-symbols-outlined text-on-surface-variant/30 text-lg">spa</span></div>`}
        <span class="text-xs font-bold text-on-surface">${esc(v.label)}</span>`;
      b.addEventListener('click', () => pvSelectVariant(v));
      list.appendChild(b);
    });
    pvSelectVariant(pvProduct.variants[0] || null);
  }

  function pvRenderRelated() {
    const wrap = document.getElementById('pv-related-wrap') as HTMLElement;
    const grid = document.getElementById('pv-related') as HTMLElement;
    const related = allProducts.filter((x: any) => x.id !== pvProduct.id).sort(() => Math.random() - 0.5).slice(0, 4);
    if (!related.length) { wrap.classList.add('hidden'); return; }
    wrap.classList.remove('hidden');
    grid.innerHTML = '';
    related.forEach((p: any) => {
      const u = esc(sanitizeUrl(p.imageUrl));
      const card = document.createElement('button');
      card.className = 'text-left group';
      card.innerHTML = `
        <div class="h-36 rounded-2xl bg-gradient-to-br from-primary-container/10 to-secondary-container/10 flex items-center justify-center overflow-hidden">
          ${u ? `<img src="${u}" class="max-h-full max-w-full object-contain p-2 transition-transform duration-300 group-hover:scale-105" alt="${esc(p.name)}"/>` : `<span class="material-symbols-outlined text-primary/20 text-5xl">spa</span>`}
        </div>
        <p class="font-bold text-on-surface text-xs mt-2 line-clamp-2 group-hover:text-primary transition-colors">${esc(p.name)}</p>
        <p class="font-display font-bold text-primary text-sm mt-0.5">$${Number(p.price).toFixed(2)}</p>`;
      card.addEventListener('click', () => openProductDetail(p));
      grid.appendChild(card);
    });
  }

  // ---- Structured product info (design spec: NoteRow / SpecRow / Chip / HighlightBox) ----
  function pvChip(text: string, tone: 'primary' | 'muted' = 'primary'): string {
    const cls = tone === 'primary'
      ? 'bg-primary/5 text-primary border border-primary/10'
      : 'bg-surface-container text-on-surface-variant border border-outline-variant/10';
    return `<span class="inline-flex items-center gap-1 px-3 py-1.5 rounded-full text-xs font-bold ${cls}">${esc(text)}</span>`;
  }

  function pvNoteRow(icon: string, label: string, value: string): string {
    return `
      <div class="flex items-start gap-3 p-3 rounded-2xl bg-surface-container/60 border border-outline-variant/10">
        <span class="material-symbols-outlined text-primary/80 text-xl mt-0.5">${icon}</span>
        <div class="flex-1 min-w-0">
          <p class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">${esc(label)}</p>
          <p class="text-sm text-on-surface mt-0.5 leading-6">${esc(value)}</p>
        </div>
      </div>`;
  }

  function pvSpecRow(label: string, value: string): string {
    return `
      <div class="flex items-start justify-between gap-4 py-2.5 border-b border-outline-variant/10">
        <p class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant pt-0.5 shrink-0">${esc(label)}</p>
        <p class="text-sm text-on-surface text-right leading-6">${esc(value)}</p>
      </div>`;
  }

  function pvHighlight(text: string, icon = 'auto_awesome'): string {
    return `
      <div class="flex items-start gap-3 p-4 rounded-2xl bg-primary/5 border border-primary/10">
        <span class="material-symbols-outlined text-primary text-xl mt-0.5">${icon}</span>
        <p class="text-sm text-on-surface leading-6">${esc(text)}</p>
      </div>`;
  }

  function pvRenderDetails(data: any, fallbackText: string) {
    const wrap = document.getElementById('pv-details') as HTMLElement;
    const d = data && typeof data === 'object' ? data : null;
    let html = '';

    if (d && d.type === 'perfume') {
      const notas = d.notas || {};
      html += `<p class="text-xs font-bold uppercase tracking-widest text-on-surface-variant">Pirámide olfativa</p>`;
      html += `<div class="grid gap-2.5 mt-3">`;
      if (notas.salida) html += pvNoteRow('wb_sunny', 'Notas de salida', notas.salida);
      if (notas.corazon) html += pvNoteRow('local_florist', 'Notas de corazón', notas.corazon);
      if (notas.fondo) html += pvNoteRow('eco', 'Notas de fondo', notas.fondo);
      html += `</div>`;
      if (d.sensacion) html += `<div class="mt-3">${pvHighlight(d.sensacion, 'spa')}</div>`;
      const chips = [d.family && `Familia ${d.family}`, d.publico, d.estilo && `Estilo: ${d.estilo}`, d.presentacion].filter(Boolean);
      if (chips.length) html += `<div class="flex flex-wrap gap-2 mt-4">${chips.map((c: string) => pvChip(c)).join('')}</div>`;
    } else if (d && d.type === 'care') {
      html += `<p class="text-xs font-bold uppercase tracking-widest text-on-surface-variant">Detalles del producto</p>`;
      if (d.beneficio) html += `<div class="mt-3">${pvHighlight(d.beneficio, 'verified')}</div>`;
      html += `<div class="mt-3">`;
      if (d.ingredientes) html += pvSpecRow('Ingredientes clave', d.ingredientes);
      if (d.textura) html += pvSpecRow('Textura', d.textura);
      if (d.resultado) html += pvSpecRow('Resultado', d.resultado);
      if (d.uso) html += pvSpecRow('Cómo usarlo', d.uso);
      html += `</div>`;
      const chips = [d.category, d.presentacion].filter(Boolean);
      if (chips.length) html += `<div class="flex flex-wrap gap-2 mt-4">${chips.map((c: string) => pvChip(c)).join('')}</div>`;
    } else if (d && d.type === 'home') {
      html += `<p class="text-xs font-bold uppercase tracking-widest text-on-surface-variant">Detalles del producto</p>`;
      html += `<div class="mt-3">`;
      if (d.tipo) html += pvSpecRow('Tipo', d.tipo);
      if (d.uso) html += pvSpecRow('Uso', d.uso);
      if (d.material) html += pvSpecRow('Material', d.material);
      if (d.cuidado) html += pvSpecRow('Cuidado', d.cuidado);
      html += `</div>`;
      if (d.highlight) html += `<div class="mt-3">${pvHighlight(d.highlight, 'star')}</div>`;
      const chips = [d.licencia, d.presentacion].filter(Boolean);
      if (chips.length) html += `<div class="flex flex-wrap gap-2 mt-4">${chips.map((c: string) => pvChip(c, 'muted')).join('')}</div>`;
    } else if (d && d.type === 'kit') {
      html += `<p class="text-xs font-bold uppercase tracking-widest text-on-surface-variant">Detalles del kit</p>`;
      if (d.components && d.components.length) {
        html += `<div class="flex flex-wrap gap-2 mt-3">${d.components.map((c: string) => pvChip('Incluye ' + c, 'muted')).join('')}</div>`;
      }
      if (d.facts_text) html += `<div class="mt-3">${pvHighlight(d.facts_text, 'redeem')}</div>`;
      const chips = [d.presentacion].filter(Boolean);
      if (chips.length) html += `<div class="flex flex-wrap gap-2 mt-4">${chips.map((c: string) => pvChip(c)).join('')}</div>`;
    } else if (fallbackText) {
      html += `<p class="text-xs font-bold uppercase tracking-widest text-on-surface-variant">Descripción</p>`;
      html += `<p class="text-base text-on-surface-variant mt-3 leading-7 max-w-[60ch]">${esc(fallbackText)}</p>`;
    } else {
      html += `<p class="text-base text-on-surface-variant/50 italic mt-2">Sin descripción disponible para este producto.</p>`;
    }

    wrap.innerHTML = html;
    wrap.classList.remove('pv-anim');
    void wrap.offsetWidth;
    wrap.classList.add('pv-anim');
  }

  function openProductDetail(p: any) {
    pvProduct = p;
    pvQty = 1;
    pvSelectedVariant = null;

    pvImages = [];
    if (p.imageUrl) pvImages.push({ url: p.imageUrl, label: p.name });
    if (p.hasVariants) {
      p.variants.forEach((v: Variant) => {
        if (v.imageUrl && !pvImages.some(im => im.url === v.imageUrl)) pvImages.push({ url: v.imageUrl, label: v.label });
      });
    }

    const bc = p.brand === 'Avon' ? 'brand-avon' : p.brand === 'Natura' ? 'brand-natura' : 'brand-default';
    const brandEl = document.getElementById('pv-brand') as HTMLElement;
    brandEl.className = `absolute top-4 left-4 text-[10px] font-bold px-2.5 py-1 rounded-full ${bc}`;
    brandEl.textContent = p.brand || 'General';

    (document.getElementById('pv-category') as HTMLElement).textContent = [p.category, p.brand].filter(Boolean).join(' · ') || 'Catálogo Natura';
    (document.getElementById('pv-name') as HTMLElement).textContent = p.name;
    (document.getElementById('pv-code') as HTMLElement).textContent = p.code ? `Código #${p.code}` : '';
    (document.getElementById('pv-price') as HTMLElement).textContent = `$${Number(p.price).toFixed(2)}`;

    const stockEl = document.getElementById('pv-stock') as HTMLElement;
    stockEl.textContent = p.stock > 0 ? `${p.stock} disponibles` : 'Agotado';
    stockEl.className = `text-xs font-bold px-2.5 py-1 rounded-full ${p.stock > 0 ? 'bg-green-100 text-green-700' : 'bg-error/10 text-error'}`;

    pvRenderDetails(p.descriptionData, p.description);

    pvRenderThumbs();
    pvRenderVariants();
    pvRenderRelated();
    pvRenderQty();

    // Re-trigger entrance animations
    pvView.querySelectorAll('.pv-anim').forEach(el => {
      el.classList.remove('pv-anim');
      void (el as HTMLElement).offsetWidth;
      el.classList.add('pv-anim');
    });

    pvView.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    pvView.scrollTop = 0;
  }

  function closeProductDetail() {
    pvView.classList.add('hidden');
    pvLightbox.classList.add('hidden');
    pvLightbox.classList.remove('flex');
    document.body.style.overflow = '';
  }

  document.getElementById('pv-back')!.addEventListener('click', closeProductDetail);
  document.getElementById('pv-close')!.addEventListener('click', closeProductDetail);
  document.getElementById('pv-qty-minus')!.addEventListener('click', () => { if (pvQty > 1) { pvQty--; pvRenderQty(); } });
  document.getElementById('pv-qty-plus')!.addEventListener('click', () => { if (pvQty < (Number(pvProduct?.stock) || 1)) { pvQty++; pvRenderQty(); } });
  document.getElementById('pv-add')!.addEventListener('click', () => {
    if (!pvProduct) return;
    const v = pvSelectedVariant;
    addToCart(pvProduct.id, pvProduct.name, v?.label || '', Number(v?.price || pvProduct.price), v?.imageUrl || pvProduct.imageUrl, pvQty);
    const btn = document.getElementById('pv-add') as HTMLElement;
    btn.innerHTML = '<span class="material-symbols-outlined text-lg">check</span> ¡Agregado!';
    setTimeout(() => { btn.innerHTML = '<span class="material-symbols-outlined text-lg">add_shopping_cart</span> Agregar al pedido'; }, 1200);
    updateCartUI();
  });

  // Lightbox (full image + click zoom)
  document.getElementById('pv-main-wrap')!.addEventListener('click', () => {
    const url = esc(sanitizeUrl(pvImages[pvImageIndex]?.url || ''));
    if (!url) return;
    pvLightboxImg.src = url;
    pvLightboxImg.style.transform = 'scale(1)';
    pvLightbox.classList.remove('hidden');
    pvLightbox.classList.add('flex');
  });
  pvLightbox.addEventListener('click', (e) => {
    if (e.target === pvLightboxImg) {
      pvLightboxImg.style.transform = pvLightboxImg.style.transform === 'scale(2)' ? 'scale(1)' : 'scale(2)';
      return;
    }
    pvLightbox.classList.add('hidden');
    pvLightbox.classList.remove('flex');
  });
  document.getElementById('pv-lightbox-close')!.addEventListener('click', () => {
    pvLightbox.classList.add('hidden');
    pvLightbox.classList.remove('flex');
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !pvLightbox.classList.contains('hidden')) {
      pvLightbox.classList.add('hidden');
      pvLightbox.classList.remove('flex');
    } else if (e.key === 'Escape' && !pvView.classList.contains('hidden')) {
      closeProductDetail();
    }
  });

  function bindProductDetail() {
    grid.querySelectorAll('[data-detail]').forEach(el => {
      el.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = (el as HTMLElement).dataset.detail;
        const p = allProducts.find((x: any) => x.id === id);
        if (p) openProductDetail(p);
      });
    });
  }

  function openVariantsModal(product: any) {
    const title = document.getElementById('variants-title') as HTMLElement;
    const imgWrap = document.getElementById('variants-product-img') as HTMLElement;
    const subtitle = document.getElementById('variants-subtitle') as HTMLElement;
    const list = document.getElementById('variants-list') as HTMLElement;

    title.textContent = product.name;
    subtitle.textContent = `${product.variants.length} variantes disponibles • ${product.category || 'General'}`;
    const sUrl = esc(sanitizeUrl(product.imageUrl));
    imgWrap.innerHTML = sUrl
      ? `<img src="${sUrl}" alt="${esc(product.name)}" class="w-full h-full object-contain p-2"/>`
      : `<span class="material-symbols-outlined text-primary/20 text-5xl">spa</span>`;

    list.innerHTML = '';
    product.variants.forEach((v: Variant) => {
      const vPrice = v.price || product.price;
      const vImg = v.imageUrl || product.imageUrl;
      const chip = document.createElement('div');
      chip.className = 'variant-chip flex items-center gap-3 p-3 rounded-xl bg-surface-container hover:bg-primary-container/20 border border-outline-variant/10';
      const chipImgUrl = esc(sanitizeUrl(vImg));
      chip.innerHTML = `
        ${chipImgUrl ? `<img src="${chipImgUrl}" class="w-12 h-12 object-contain rounded-lg bg-white shadow-sm"/>` : `<div class="w-12 h-12 rounded-lg bg-surface-container-highest flex items-center justify-center"><span class="material-symbols-outlined text-on-surface-variant/30">spa</span></div>`}
        <div class="flex-1 min-w-0">
          <p class="font-bold text-on-surface text-sm">${esc(v.label)}</p>
          <p class="text-[10px] text-on-surface-variant font-mono">#${esc(v.code)}</p>
        </div>
        <p class="font-display font-bold text-primary text-sm">$${Number(vPrice).toFixed(2)}</p>
        <button class="btn-add-variant flex items-center gap-1 py-2 px-3 rounded-lg font-bold bg-primary text-white text-xs hover:shadow-md transition-all">
          <span class="material-symbols-outlined text-sm">add_shopping_cart</span>
        </button>`;
      list.appendChild(chip);

      chip.querySelector('.btn-add-variant')!.addEventListener('click', () => {
        addToCart(v.id, product.name, v.label, vPrice, vImg);
        const btn = chip.querySelector('.btn-add-variant') as HTMLElement;
        btn.innerHTML = '<span class="material-symbols-outlined text-sm">check</span>';
        setTimeout(() => { btn.innerHTML = '<span class="material-symbols-outlined text-sm">add_shopping_cart</span>'; }, 800);
      });
    });

    variantsModal.showModal();
  }

  document.getElementById('btn-close-variants')!.addEventListener('click', () => variantsModal.close());

  function enc(s: string) { return btoa(encodeURIComponent(s)); }
  function dec(s: string) { try { return decodeURIComponent(atob(s)); } catch { return s; } }

  document.getElementById('btn-load-more')!.addEventListener('click', () => { displayCount += 40; renderProducts(); });

  // View toggle
  document.getElementById('view-grid')!.addEventListener('click', () => {
    viewMode = 'grid';
    grid.classList.remove('list-mode');
    grid.className = 'grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6';
    document.getElementById('view-grid')!.className = 'w-9 h-9 rounded-lg bg-primary text-white flex items-center justify-center transition-colors';
    document.getElementById('view-list')!.className = 'w-9 h-9 rounded-lg text-on-surface-variant hover:bg-surface-container flex items-center justify-center transition-colors';
    renderProducts();
  });
  document.getElementById('view-list')!.addEventListener('click', () => {
    viewMode = 'list';
    grid.className = 'list-mode grid grid-cols-1 gap-3';
    document.getElementById('view-list')!.className = 'w-9 h-9 rounded-lg bg-primary text-white flex items-center justify-center transition-colors';
    document.getElementById('view-grid')!.className = 'w-9 h-9 rounded-lg text-on-surface-variant hover:bg-surface-container flex items-center justify-center transition-colors';
    renderProducts();
  });

  // Filters
  let filterTimer: any;
  search.addEventListener('input', () => { clearTimeout(filterTimer); filterTimer = setTimeout(() => { displayCount = 40; renderProducts(); }, 150); });
  filterBrand.addEventListener('change', () => { displayCount = 40; renderProducts(); });
  filterCat.addEventListener('change', () => { displayCount = 40; renderProducts(); });

  // Cart logic
  function addToCart(id: string, name: string, variantLabel: string, price: number, imageUrl: string, qty: number = 1) {
    const existing = cart.find(i => i.id === id && i.variantLabel === variantLabel);
    if (existing) { existing.qty += qty; } else { cart.push({ id, name, variantLabel, price, qty, imageUrl }); }
    updateCartUI();
  }

  function updateCartUI() {
    const totalItems = cart.reduce((s, i) => s + i.qty, 0);
    const totalPrice = cart.reduce((s, i) => s + (i.price * i.qty), 0);
    cartLabel.textContent = `Ver Pedido (${totalItems})`;
    cartFloat.classList.toggle('hidden', totalItems === 0);
    cartTotalEl.textContent = '$' + totalPrice.toFixed(2);
    cartEmpty.classList.toggle('hidden', cart.length > 0);

    cartItemsEl.innerHTML = '';
    cart.forEach((item, idx) => {
      const el = document.createElement('div');
      el.className = 'flex items-center gap-3 py-3 border-b border-surface-container last:border-b-0';
      const sUrl = esc(sanitizeUrl(item.imageUrl));
      const displayName = item.variantLabel ? `${item.name} — ${item.variantLabel}` : item.name;
      el.innerHTML = `
        ${sUrl ? `<img src="${sUrl}" class="w-10 h-10 object-contain rounded-lg bg-surface-container shadow-sm"/>` : `<div class="div w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center"><span class="material-symbols-outlined text-on-surface-variant/30 text-sm">spa</span></div>`}
        <div class="flex-1 min-w-0">
          <p class="font-bold text-on-surface text-sm truncate">${esc(displayName)}</p>
          <p class="text-xs text-on-surface-variant">$${item.price.toFixed(2)} c/u</p>
        </div>
        <div class="flex items-center gap-2">
          <button data-idx="${idx}" class="btn-minus w-7 h-7 rounded-full bg-surface-container-highest flex items-center justify-center text-sm hover:bg-error/10 hover:text-error transition-colors">−</button>
          <span class="font-bold w-6 text-center text-sm">${item.qty}</span>
          <button data-idx="${idx}" class="btn-plus w-7 h-7 rounded-full bg-primary-container/20 flex items-center justify-center text-sm hover:bg-primary-container/40 transition-colors">+</button>
        </div>
        <p class="font-bold text-primary w-20 text-right text-sm">$${(item.price * item.qty).toFixed(2)}</p>`;
      cartItemsEl.appendChild(el);
    });

    cartItemsEl.querySelectorAll('.btn-plus').forEach(btn => btn.addEventListener('click', () => { cart[Number((btn as HTMLElement).dataset.idx)].qty++; updateCartUI(); }));
    cartItemsEl.querySelectorAll('.btn-minus').forEach(btn => btn.addEventListener('click', () => {
      const idx = Number((btn as HTMLElement).dataset.idx);
      cart[idx].qty--;
      if (cart[idx].qty <= 0) cart.splice(idx, 1);
      updateCartUI();
    }));
  }

  function getOrderText() {
    const total = cart.reduce((s, i) => s + (i.price * i.qty), 0);
    let text = '🛒 *Mi Pedido Natura*\n\n';
    cart.forEach(i => {
      const label = i.variantLabel ? `${i.name} (${i.variantLabel})` : i.name;
      text += `• ${label} x${i.qty} — $${(i.price * i.qty).toFixed(2)}\n`;
    });
    text += `\n💰 *Total: $${total.toFixed(2)}*\n\n¡Gracias! 💚`;
    return text;
  }

  document.getElementById('btn-show-cart')!.addEventListener('click', () => cartModal.showModal());
  document.getElementById('btn-close-cart')!.addEventListener('click', () => cartModal.close());
  document.getElementById('btn-send-whatsapp')!.addEventListener('click', () => {
    window.open('https://wa.me/?text=' + encodeURIComponent(getOrderText()), '_blank');
  });
  document.getElementById('btn-copy-order')!.addEventListener('click', () => {
    navigator.clipboard.writeText(getOrderText());
    const btn = document.getElementById('btn-copy-order') as HTMLButtonElement;
    btn.innerHTML = '<span class="material-symbols-outlined">check</span> ¡Copiado!';
    setTimeout(() => { btn.innerHTML = '<span class="material-symbols-outlined">content_copy</span> Copiar Pedido'; }, 2000);
  });
  document.getElementById('btn-share-catalog')!.addEventListener('click', () => {
    const url = window.location.origin + '/catalogo?c=' + activeConsultantId;
    navigator.clipboard.writeText(url);
    const btn = document.getElementById('btn-share-catalog') as HTMLButtonElement;
    btn.innerHTML = '<span class="material-symbols-outlined text-lg">check</span> ¡Link copiado!';
    setTimeout(() => { btn.innerHTML = '<span class="material-symbols-outlined text-lg">share</span> Compartir Catálogo'; }, 2000);
  });

  loadProducts();
</script>
