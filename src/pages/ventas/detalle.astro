---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import PageLoader from '../../components/PageLoader.astro';
---

<DashboardLayout title="Detalle de Venta">
  <style is:global>
    @media print {
      body * { 
        visibility: hidden; 
      }
      #print-area, #print-area * {
        visibility: visible;
      }
      #print-area {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        margin: 0;
        padding: 0;
      }
      /* Hide buttons in print area */
      .print-hidden {
        display: none !important;
      }
      /* Transform Grids into Stacks for paper size to avoid cutoff */
      .grid {
        display: block !important;
      }
      /* Fix sticky headers running off screen */
      .sticky {
        position: static !important;
        top: auto !important;
      }
      /* Allow natural flow and multiple pages instead of 100vh scrolling */
      html, body, .min-h-screen, main, #print-area {
        height: auto !important;
        min-height: auto !important;
        overflow: visible !important;
        position: relative !important;
      }
      /* Prevent page breaks inside cards */
      .bg-surface-container-high, 
      .bg-surface-container-low, 
      .bg-surface-container-lowest {
        break-inside: avoid;
        page-break-inside: avoid;
        margin-bottom: 2rem !important;
      }
    }
  </style>

  <div class="max-w-7xl mx-auto" id="print-area">
    <!-- Loader & Error States -->
    <div id="loader" class="flex flex-col items-center justify-center py-20 text-primary">
      <PageLoader text="Cargando detalle" />
    </div>

    <div id="error-state" class="hidden py-20 text-center">
      <div class="w-20 h-20 bg-error-container rounded-full flex items-center justify-center mx-auto mb-4 text-error">
        <span class="material-symbols-outlined text-4xl">error</span>
      </div>
      <h3 class="text-xl font-bold text-on-surface">Venta no encontrada</h3>
      <p class="text-on-surface-variant max-w-sm mx-auto mt-2">No pudimos localizar esta venta. Verifica el ID o regresa al listado general.</p>
      <a href="/ventas" class="mt-6 inline-block bg-primary text-white font-bold py-3 px-8 rounded-xl shadow-lg hover:opacity-90 transition-opacity">Volver a Ventas</a>
    </div>

    <div id="detail-content" class="hidden">
      <!-- Header Section: Folio & State -->
      <div class="mb-12 flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="space-y-2">
          <div class="flex items-center gap-3 mb-2 print-hidden">
            <a href="/ventas" class="p-2 rounded-full hover:bg-surface-container-high transition-colors text-on-surface-variant flex items-center justify-center" title="Regresar">
              <span class="material-symbols-outlined">arrow_back</span>
            </a>
            <div class="flex flex-wrap gap-2" id="estado-badge"></div>
            <span class="flex items-center gap-1 text-primary-container font-medium">
              <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">calendar_today</span>
              <span id="order-date">--</span>
            </span>
          </div>
          <h1 class="text-5xl font-extrabold tracking-tight text-on-background" id="folio-title">Folio #---</h1>
          
          <div class="flex items-center gap-4 pt-2">
            <div class="flex items-center gap-2 bg-secondary-container/30 px-4 py-2 rounded-xl" id="method-container">
              <span class="w-3 h-3 bg-secondary rounded-full" id="method-dot"></span>
              <span class="text-on-secondary-container font-semibold" id="method-label">Cargando...</span>
            </div>
            <span class="text-on-surface-variant font-medium hidden" id="pending-balance">Saldo Pendiente: $0.00 MXN</span>
          </div>
        </div>
        
        <div class="flex flex-wrap gap-3 print-hidden">
          <button id="btn-print" onclick="window.print()" class="flex items-center gap-2 px-6 py-3 rounded-xl bg-surface-container-highest text-on-primary-container font-semibold hover:bg-surface-container-high transition-colors">
            <span class="material-symbols-outlined">print</span>
            Imprimir
          </button>
          <button id="btn-update-status" class="flex items-center gap-2 px-6 py-3 rounded-xl bg-gradient-to-r from-primary to-primary-container text-white font-semibold shadow-xl hover:opacity-90 transition-all active:scale-95">
            <span class="material-symbols-outlined">local_shipping</span>
            Marcar Entregado
          </button>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- Left Column: Products & Finance -->
        <div class="lg:col-span-8 space-y-8">
          
          <!-- Client Info Card -->
          <section class="bg-surface-container-low rounded-3xl p-8 flex flex-col md:flex-row items-center gap-8">
            <div class="relative">
              <div class="w-24 h-24 rounded-full bg-primary-fixed text-on-primary-fixed border-4 border-white shadow-md flex items-center justify-center text-3xl font-bold font-headline" id="client-initial">
                ?
              </div>
              <div class="absolute -bottom-1 -right-1 bg-secondary-container p-1 rounded-full border-2 border-white">
                <span class="material-symbols-outlined text-sm text-on-secondary-container" style="font-variation-settings: 'FILL' 1;">verified</span>
              </div>
            </div>
            <div class="flex-1 text-center md:text-left">
              <div class="flex items-center justify-center md:justify-start gap-2 mb-1 group">
                <p class="text-primary font-bold tracking-widest text-xs uppercase">Cliente</p>
                <button id="btn-edit-client" class="material-symbols-outlined text-sm text-primary/40 hover:text-primary transition-colors hover:scale-110">edit</button>
              </div>
              <h2 class="text-3xl font-bold text-on-surface mb-2" id="client-name">Cargando...</h2>
              <div class="flex flex-wrap justify-center md:justify-start gap-4 text-on-surface-variant hidden">
                <span class="flex items-center gap-1">
                  <span class="material-symbols-outlined text-lg">workspace_premium</span>
                  Consultora Natura
                </span>
              </div>
            </div>
            <button id="btn-view-profile" class="hidden px-5 py-2 rounded-full border border-outline-variant/30 text-primary font-medium hover:bg-white/50 transition-colors">
              Ver Perfil
            </button>
          </section>


          <!-- Product List -->
          <div class="bg-surface-container-lowest rounded-3xl p-8 shadow-sm">
            <h3 class="text-xl font-bold mb-6 flex items-center gap-2">
              <span class="material-symbols-outlined text-primary">shopping_bag</span>
              Desglose de Productos
            </h3>
            <div class="space-y-6" id="items-container">
              <!-- Rendered via JS -->
            </div>
          </div>

          <!-- Internal Sales Notes Section -->
          <div class="bg-surface-container-lowest rounded-3xl p-8 shadow-sm border border-primary/5">
            <div class="flex justify-between items-center mb-4">
              <h3 class="text-xl font-bold flex items-center gap-2">
                <span class="material-symbols-outlined text-primary">description</span>
                Notas de la Venta
              </h3>
              <button id="btn-edit-notes" class="text-primary font-bold text-sm flex items-center gap-1 hover:underline">
                <span class="material-symbols-outlined text-sm">edit_note</span>
                Editar Notas
              </button>
            </div>
            <div id="notes-display" class="text-on-surface-variant italic text-sm bg-surface-container-low/50 p-4 rounded-2xl border border-dashed border-outline-variant/30 min-h-[60px]">
              No hay notas adicionales para esta venta.
            </div>
          </div>


          <!-- WhatsApp CTA Section -->
          <div id="whatsapp-container" class="hidden bg-[#25D366]/10 border border-[#25D366]/20 rounded-3xl p-6 flex-col sm:flex-row items-center justify-between gap-4 print-hidden">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 bg-[#25D366] rounded-full flex items-center justify-center text-white shrink-0">
                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">send</span>
              </div>
              <div class="flex-1">
                <h4 class="font-bold text-on-background">Ticket Digital</h4>
                <p class="text-on-surface-variant text-sm">Envía el recibo al cliente por WhatsApp.</p>
              </div>
            </div>
            <button id="btn-whatsapp" class="w-full sm:w-auto px-8 py-3 bg-[#25D366] text-white font-bold rounded-xl shadow-md hover:bg-[#128C7E] transition-colors flex items-center justify-center gap-2">
              WhatsApp
            </button>
          </div>

        </div>

        <!-- Right Column: Totals & Payments -->
        <div class="lg:col-span-4 space-y-8">
          
          <!-- Financial Summary Card -->
          <div class="bg-surface-container-high rounded-3xl p-8 sticky top-28">
            <h3 class="text-xl font-bold mb-8 flex items-center gap-2">
              <span class="material-symbols-outlined text-primary">receipt</span>
              Resumen de Venta
            </h3>
            <div class="space-y-4 mb-8">
              <div class="flex justify-between text-on-surface-variant border-b border-outline-variant/10 pb-4">
                <span id="summary-items-count">Subtotal (0 productos)</span>
                <span id="summary-subtotal">$0.00</span>
              </div>
              <div class="flex justify-between text-secondary font-medium hidden" id="summary-discount-row">
                <span>Descuento</span>
                <span>-$0.00</span>
              </div>
              <div class="flex justify-between text-on-surface-variant hidden" id="summary-interest-row">
                <span>Interés Financiamiento</span>
                <span id="summary-interest">+$0.00</span>
              </div>
              <div class="pt-4 flex justify-between items-end">
                <span class="font-bold text-on-background text-lg">Total a Pagar</span>
                <div class="text-right">
                  <p class="text-3xl font-black text-primary" id="summary-total">$0.00</p>
                  <p class="text-xs text-on-surface-variant uppercase tracking-tighter">Moneda: MXN</p>
                </div>
              </div>
            </div>

            <!-- Payment Schedule (Cronograma) -->
            <div class="bg-surface-container-lowest rounded-2xl p-6 space-y-4 hidden" id="cronograma-container">
              <p class="text-sm font-bold uppercase tracking-widest text-on-surface-variant mb-4">Cronograma de Pagos</p>
              
              <div id="cronograma-list" class="space-y-0">
                <!-- Injected via JS -->
              </div>
            </div>

            <div class="mt-8 flex flex-col gap-3 print-hidden">
              <button id="btn-registrar-abono" class="hidden w-full py-4 bg-primary text-white font-bold rounded-xl shadow-md hover:shadow-lg transition-all active:scale-95 flex items-center justify-center gap-2">
                <span class="material-symbols-outlined">payments</span>
                Registrar Abono
              </button>
              
              <button class="w-full py-4 text-error font-bold hover:underline" id="btn-cancel">
                Cancelar Venta
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Notes / Audit Section -->
      <div class="mt-12 p-8 border-t border-surface-container-high hidden" id="notes-section">
        <h4 class="text-sm font-bold text-on-surface-variant uppercase tracking-widest mb-4">Notas de la Venta</h4>
        <p class="text-on-surface-variant italic leading-relaxed max-w-2xl" id="order-notes-text">
          <!-- JS -->
        </p>
      </div>

    <!-- Premium Payment Modal -->
    <div id="abono-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
      <div class="absolute inset-0 bg-background/80 backdrop-blur-sm" id="abono-modal-backdrop"></div>
      <div class="relative bg-surface-container-lowest rounded-3xl shadow-2xl p-8 max-w-sm w-full border border-outline-variant/20 animate-in fade-in zoom-in duration-200">
        <div class="w-16 h-16 bg-primary-container text-on-primary-container rounded-2xl flex items-center justify-center mb-6 mx-auto">
          <span class="material-symbols-outlined text-3xl">payments</span>
        </div>
        <h3 class="text-2xl font-bold text-center text-on-surface mb-2" id="modal-title">Registrar Abono</h3>
        <p class="text-center text-on-surface-variant mb-8" id="modal-desc">¿Confirmas el cobro de esta cuota?</p>
        
        <div class="bg-surface-container rounded-2xl p-4 mb-8 flex justify-between items-center">
          <span class="text-on-surface-variant font-medium uppercase tracking-wider text-xs">Monto a cobrar</span>
          <div class="flex items-center gap-1 border-b border-primary/30 focus-within:border-primary px-2 pb-1">
            <span class="text-primary font-black text-xl">$</span>
            <input id="modal-amount-input" type="number" step="0.01" class="text-primary font-black text-xl bg-transparent border-none focus:ring-0 focus:outline-none w-24 text-right p-0" value="0.00" />
          </div>
        </div>

        <div class="flex flex-col gap-3">
          <button id="btn-confirm-abono" class="w-full py-4 bg-primary text-white font-bold rounded-xl shadow-md hover:shadow-lg transition-all active:scale-95 flex items-center justify-center gap-2">
            Confirmar Cobro
          </button>
          <button id="btn-cancel-abono" class="w-full py-4 bg-surface-container text-on-surface font-bold hover:bg-surface-container-high rounded-xl transition-colors">
            Cancelar
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- MODALS -->

  <!-- Modal: Edit Client -->
  <div id="client-modal" class="fixed inset-0 z-50 hidden">
    <div id="client-modal-backdrop" class="absolute inset-0 bg-black/40 backdrop-blur-sm transition-opacity"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-md p-4">
      <div class="bg-surface-container-lowest rounded-[2rem] p-8 shadow-2xl border border-white/20">
        <div class="text-center mb-6">
          <div class="w-16 h-16 bg-primary-container/20 text-primary rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="material-symbols-outlined text-3xl">switch_account</span>
          </div>
          <h3 class="text-2xl font-bold text-on-surface font-display">Cambiar Cliente</h3>
          <p class="text-sm text-on-surface-variant">Reasigna esta venta a otro cliente registrado.</p>
        </div>

        <div class="space-y-4 mb-8">
          <div class="space-y-1.5">
            <label class="text-xs font-bold text-on-surface-variant px-1 uppercase tracking-wider">Seleccionar Cliente</label>
            <select id="edit-client-select" class="w-full bg-surface-container-low border-none rounded-xl py-3 px-4 focus:ring-2 focus:ring-primary appearance-none cursor-pointer">
              <option value="">Selecciona un cliente...</option>
              <!-- JS will populate options -->
            </select>
          </div>
        </div>

        <div class="flex flex-col gap-3">
          <button id="btn-save-client" class="w-full py-4 bg-primary text-white font-bold rounded-xl shadow-md hover:shadow-lg transition-all active:scale-95 flex items-center justify-center gap-2">
            Guardar Cambios
          </button>
          <button id="btn-close-client-modal" class="w-full py-4 bg-surface-container text-on-surface font-bold hover:bg-surface-container-high rounded-xl transition-colors">
            Cancelar
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal: Edit Notes -->
  <div id="notes-modal" class="fixed inset-0 z-50 hidden">
    <div id="notes-modal-backdrop" class="absolute inset-0 bg-black/40 backdrop-blur-sm transition-opacity"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-md p-4">
      <div class="bg-surface-container-lowest rounded-[2rem] p-8 shadow-2xl border border-white/20">
        <div class="text-center mb-6">
          <div class="w-16 h-16 bg-primary-container/20 text-primary rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="material-symbols-outlined text-3xl">edit_note</span>
          </div>
          <h3 class="text-2xl font-bold text-on-surface font-display">Notas de la Venta</h3>
          <p class="text-sm text-on-surface-variant">Agrega detalles o recordatorios privados sobre esta venta.</p>
        </div>

        <div class="mb-8">
          <textarea id="edit-notes-text" class="w-full bg-surface-container-low border-none rounded-2xl py-4 px-4 focus:ring-2 focus:ring-primary min-h-[150px] text-sm" placeholder="Escribe tus notas aquí..."></textarea>
        </div>

        <div class="flex flex-col gap-3">
          <button id="btn-save-notes" class="w-full py-4 bg-primary text-white font-bold rounded-xl shadow-md hover:shadow-lg transition-all active:scale-95 flex items-center justify-center gap-2">
            Guardar Nota
          </button>
          <button id="btn-close-notes-modal" class="w-full py-4 bg-surface-container text-on-surface font-bold hover:bg-surface-container-high rounded-xl transition-colors">
            Cerrar
          </button>
        </div>
      </div>
    </div>
    </div>
  </div>

</DashboardLayout>

<script>
  import { supabase } from '../../lib/supabase';
  import api from '../../lib/api';
  import { esc } from '../../lib/security';
  import { summarizeOrder, parseAmount, errorMessage, formatFolio, orderStatusChips } from '../../lib/orders';
  import { whatsappPhone } from '../../lib/phone';
  import { toast, confirmAction, chipHtml } from '../../lib/ui';

  // Shared UI (global toast + confirm dialog)
  const uiAlert = async (message: string, _title?: string) => { toast.error(message); };
  const uiConfirm = (message: string, title = 'Confirmar') =>
    confirmAction(title, { description: message, variant: 'warning', confirmText: 'Aceptar' });

  const urlParams = new URLSearchParams(window.location.search);
  const orderId = urlParams.get('id');

  const loader = document.getElementById('loader') as HTMLElement;
  const errorState = document.getElementById('error-state') as HTMLElement;
  const content = document.getElementById('detail-content') as HTMLElement;

  const orderDate = document.getElementById('order-date') as HTMLElement;
  const folioTitle = document.getElementById('folio-title') as HTMLElement;
  const estadoBadge = document.getElementById('estado-badge') as HTMLElement;
  const methodLabel = document.getElementById('method-label') as HTMLElement;
  const methodDot = document.getElementById('method-dot') as HTMLElement;
  const methodContainer = document.getElementById('method-container') as HTMLElement;
  const pendingBalance = document.getElementById('pending-balance') as HTMLElement;

  const clientName = document.getElementById('client-name') as HTMLElement;
  const clientInitial = document.getElementById('client-initial') as HTMLElement;
  
  const itemsContainer = document.getElementById('items-container') as HTMLElement;

  const summaryItemsCount = document.getElementById('summary-items-count') as HTMLElement;
  const summarySubtotal = document.getElementById('summary-subtotal') as HTMLElement;
  const summaryTotal = document.getElementById('summary-total') as HTMLElement;

  const cronogramaContainer = document.getElementById('cronograma-container') as HTMLElement;
  const cronogramaList = document.getElementById('cronograma-list') as HTMLElement;

  const btnUpdateStatus = document.getElementById('btn-update-status') as HTMLButtonElement;
  const btnCancel = document.getElementById('btn-cancel') as HTMLButtonElement;

  const abonoModal = document.getElementById('abono-modal') as HTMLElement;
  const abonoModalBackdrop = document.getElementById('abono-modal-backdrop') as HTMLElement;
  const modalDesc = document.getElementById('modal-desc') as HTMLElement;
  const modalAmountInput = document.getElementById('modal-amount-input') as HTMLInputElement;
  const btnConfirmAbono = document.getElementById('btn-confirm-abono') as HTMLButtonElement;
  const btnCancelAbono = document.getElementById('btn-cancel-abono') as HTMLButtonElement;

  const whatsappContainer = document.getElementById('whatsapp-container') as HTMLElement;
  const btnWhatsapp = document.getElementById('btn-whatsapp') as HTMLButtonElement;

  // Modals & Forms
  const clientModal = document.getElementById('client-modal') as HTMLElement;
  const clientModalBackdrop = document.getElementById('client-modal-backdrop') as HTMLElement;
  const btnEditClient = document.getElementById('btn-edit-client') as HTMLButtonElement;
  const btnSaveClient = document.getElementById('btn-save-client') as HTMLButtonElement;
  const btnCloseClientModal = document.getElementById('btn-close-client-modal') as HTMLButtonElement;
  const editClientSelect = document.getElementById('edit-client-select') as HTMLSelectElement;

  const notesModal = document.getElementById('notes-modal') as HTMLElement;
  const notesModalBackdrop = document.getElementById('notes-modal-backdrop') as HTMLElement;
  const btnEditNotes = document.getElementById('btn-edit-notes') as HTMLButtonElement;
  const btnSaveNotes = document.getElementById('btn-save-notes') as HTMLButtonElement;
  const btnCloseNotesModal = document.getElementById('btn-close-notes-modal') as HTMLButtonElement;
  const editNotesText = document.getElementById('edit-notes-text') as HTMLTextAreaElement;
  const notesDisplay = document.getElementById('notes-display') as HTMLElement;

  let globalOrder: any = null;
  let currentUserId = '';

  async function updateStatus(newStatus: string) {
    const msg = newStatus === 'cancelled'
      ? '¿Cancelar esta venta? Se devolverán los productos a tu inventario.'
      : '¿Marcar esta venta como entregada?';
    if(!(await uiConfirm(msg))) return;
    btnUpdateStatus.disabled = true;
    btnCancel.disabled = true;
    try {
      if (newStatus === 'cancelled') {
        await api.orders.cancel(orderId as string);
      } else if (newStatus === 'delivered') {
        await api.orders.deliver(orderId as string);
      }
      window.location.reload();
    } catch(e: any) {
      await uiAlert('No se pudo actualizar el estado: ' + errorMessage(e), 'Error');
      btnUpdateStatus.disabled = false;
      btnCancel.disabled = false;
    }
  }

  async function loadData() {
    if(!orderId) { showError(); return; }
    try {
      const { data: sessionData } = await supabase.auth.getSession();
      currentUserId = sessionData.session?.user.id || '';

      const { data: order, error } = await supabase
        .from('orders')
        .select(`
          *,
          customers:customer_id (id, full_name, phone, email),
          order_items (*, products (id, name, category, price)),
          order_payments (id, amount, kind, paid_at)
        `)
        .eq('id', orderId)
        .single();
        
      if (error || !order) { showError(); return; }

      globalOrder = order;

      // Load customers for the modal
      if (currentUserId && editClientSelect) {
        const { data: customers } = await supabase
          .from('customers')
          .select('id, full_name')
          .eq('consultant_id', currentUserId)
          .order('full_name');
        if (customers) {
          customers.forEach((c: any) => {
            const opt = document.createElement('option');
            opt.value = c.id;
            opt.textContent = c.full_name;
            editClientSelect.appendChild(opt);
          });
        }
      }

      renderOrder();
    } catch (e) { showError(); }
  }

  function showError() {
    loader.classList.add('hidden');
    errorState.classList.remove('hidden');
  }

  function renderOrder() {
    const order = globalOrder;
    const items = globalOrder.order_items;
    const sum = summarizeOrder(order);

    loader.classList.add('hidden');
    content.classList.remove('hidden');

    const d = new Date(order.created_at);
    orderDate.textContent = d.toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' });
    folioTitle.textContent = 'Folio #' + formatFolio(order.id);

    const cName = order.customers?.full_name || 'Cliente Mostrador';
    clientName.textContent = cName;
    clientInitial.textContent = cName.substring(0,2).toUpperCase();

    notesDisplay.textContent = order.notes || 'No hay notas adicionales.';

    const isAbonos = sum.isAbonos;
    const totalPaid = sum.paid;
    const debtRemaining = sum.balance;
    const isFullyPaid = sum.isFullyPaid;

    btnCancel.onclick = () => updateStatus('cancelled');

    const chips = orderStatusChips(order);
    estadoBadge.innerHTML = chipHtml(chips.delivery) + (chips.payment ? chipHtml(chips.payment) : '');
    if (order.status === 'delivered') {
      btnUpdateStatus.classList.add('hidden');
    } else if (order.status === 'pending') {
      btnUpdateStatus.onclick = () => updateStatus('delivered');
    } else {
      btnUpdateStatus.classList.add('hidden');
      btnCancel.classList.add('hidden');
    }

    if (order.customers && btnEditClient) {
      btnEditClient.onclick = () => {
        editClientSelect.value = order.customers.id || '';
        clientModal.classList.remove('hidden');
      };
    } else if (btnEditClient) {
      btnEditClient.classList.add('hidden');
    }

    [btnCloseClientModal, clientModalBackdrop].forEach(el => { el.onclick = () => clientModal.classList.add('hidden'); });
    [btnCloseNotesModal, notesModalBackdrop].forEach(el => { el.onclick = () => notesModal.classList.add('hidden'); });

    btnSaveClient.onclick = async () => {
      const newCustId = editClientSelect.value;
      if (!newCustId) return;
      
      btnSaveClient.disabled = true;
      btnSaveClient.textContent = 'Guardando...';
      try {
        await api.orders.changeCustomer(orderId as string, newCustId);
        window.location.reload();
      } catch(err: any) { await uiAlert(errorMessage(err)); btnSaveClient.disabled = false; btnSaveClient.textContent = 'Guardar Cambios'; }
    };

    btnEditNotes.onclick = () => {
      editNotesText.value = order.notes || '';
      notesModal.classList.remove('hidden');
    };

    btnSaveNotes.onclick = async () => {
      btnSaveNotes.disabled = true;
      btnSaveNotes.textContent = 'Guardando...';
      try {
        await api.orders.updateNotes(orderId as string, editNotesText.value);
        window.location.reload();
      } catch(err: any) {
        await uiAlert(errorMessage(err));
        btnSaveNotes.disabled = false;
        btnSaveNotes.textContent = 'Guardar Nota';
      }
    };

    const phone = whatsappPhone(order.customers?.phone);
    if (phone && whatsappContainer && btnWhatsapp) {
      whatsappContainer.classList.remove('hidden');
      whatsappContainer.classList.add('flex');
      const folioLabel = '#' + formatFolio(order.id);
      const totalAmountVal = Number(order.total_amount);
      let message = '¡Hola ' + cName + '! 👋 Espero que estés teniendo un excelente día.\n\n';
      message += 'Te comparto el detalle de tu compra 🛍️:\n\n';
      message += '🏷️ *Total de la compra:* $' + totalAmountVal.toFixed(2) + ' MXN\n';
      
      if (isAbonos || totalPaid < totalAmountVal) {
        message += '💸 *Llevas pagado:* $' + totalPaid.toFixed(2) + ' MXN\n';
        if (!isFullyPaid) message += '📌 *Saldo pendiente:* $' + debtRemaining.toFixed(2) + ' MXN\n';
        else message += '✨ ¡Tu cuenta ya está totalmente pagada! 🎉\n';
      } else {
        message += '✨ ¡Tu compra fue de contado y ya está totalmente pagada! 🎉\n';
      }
      
      message += '\n';
      
      if (order.status === 'delivered') {
        if (isFullyPaid) {
          message += 'Tu pedido ya fue entregado. ¡Espero que lo disfrutes mucho! 🥰\n\n';
        } else {
          message += '✅ *Pedido Entregado* 🌿\n\n';
        }
      } else {
        message += 'Tu pedido está *Pendiente de Entrega*. Te avisaré en cuanto lo tenga listo para entregártelo. 🌿\n\n';
      }
      
      message += '¡Muchísimas gracias por tu confianza! Cualquier duda, aquí estoy a la orden. ✨';
      message += '\n\n_(Folio: ' + folioLabel + ')_';
      const link = 'https://wa.me/' + phone + '?text=' + encodeURIComponent(message);
      btnWhatsapp.onclick = () => window.open(link, '_blank');
    }

    let totalQty = 0;
    itemsContainer.innerHTML = '';
    items.forEach((item: any, index: number) => {
      totalQty += item.quantity;
      const pName = item.products?.name || 'Producto';
      const pCat = item.products?.category || 'General';
      const rowTotal = item.quantity * Number(item.unit_price);
      const div = document.createElement('div');
      div.className = 'flex items-center gap-6 group ' + (index > 0 ? 'pt-6 border-t border-surface-container' : '');
      div.innerHTML = '<div class="w-16 h-16 rounded-2xl bg-surface-container overflow-hidden shrink-0 flex items-center justify-center text-primary-container"><span class="material-symbols-outlined text-3xl">spa</span></div>' +
        '<div class="flex-1"><h4 class="font-bold text-on-surface text-lg">' + esc(pName) + '</h4><p class="text-on-surface-variant text-sm">Categoría: ' + esc(pCat) + '</p></div>' +
        '<div class="text-right"><p class="text-on-surface-variant text-sm mb-1">' + item.quantity + ' x $' + Number(item.unit_price).toFixed(2) + '</p><p class="font-bold text-on-background">$' + rowTotal.toFixed(2) + '</p></div>';
      itemsContainer.appendChild(div);
    });

    const totalAmount = Number(order.total_amount);
    summaryItemsCount.textContent = 'Subtotal (' + totalQty + ' productos)';
    summaryTotal.textContent = '$' + totalAmount.toLocaleString('es-MX', {minimumFractionDigits:2});
    summarySubtotal.textContent = '$' + totalAmount.toFixed(2);

    const btnRegistrarAbono = document.getElementById('btn-registrar-abono') as HTMLButtonElement | null;
    if(btnRegistrarAbono) btnRegistrarAbono.classList.add('hidden');

    const isCancelled = order.status === 'cancelled';
    const dateFmt: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'short', day: 'numeric' };

    if (isAbonos) {
      methodLabel.textContent = 'En Abonos';
      methodDot.className = 'w-3 h-3 bg-primary rounded-full';
      methodContainer.className = 'flex items-center gap-2 bg-primary-container/20 px-4 py-2 rounded-xl';
    } else {
      methodLabel.textContent = 'Al Contado';
      methodDot.className = 'w-3 h-3 bg-secondary rounded-full';
      methodContainer.className = 'flex items-center gap-2 bg-secondary-container/30 px-4 py-2 rounded-xl';
    }

    // Payments history is shown for every sale that has payments or a balance
    const showSchedule = isAbonos || sum.payments.length > 0;
    cronogramaContainer.classList.toggle('hidden', !showSchedule);
    pendingBalance.classList.toggle('hidden', !showSchedule);
    pendingBalance.textContent = 'Saldo Pendiente: $' + debtRemaining.toFixed(2) + ' MXN';

    btnCancelAbono.onclick = () => abonoModal.classList.add('hidden');
    abonoModalBackdrop.onclick = () => abonoModal.classList.add('hidden');

    if (!isFullyPaid && btnRegistrarAbono && !isCancelled) {
      btnRegistrarAbono.classList.remove('hidden');
      btnRegistrarAbono.onclick = () => {
        modalDesc.textContent = 'Ingresa el monto que el cliente está abonando. Saldo pendiente: $' + debtRemaining.toFixed(2);
        modalAmountInput.value = (isAbonos ? sum.suggestedPayment : debtRemaining).toFixed(2);
        modalAmountInput.max = debtRemaining.toFixed(2);
        abonoModal.classList.remove('hidden');

        btnConfirmAbono.onclick = async () => {
          const inputVal = parseAmount(modalAmountInput.value);
          if (isNaN(inputVal) || inputVal <= 0) {
            await uiAlert('Por favor ingresa un monto válido mayor a 0.');
            return;
          }
          if (inputVal > debtRemaining + 0.005) {
            await uiAlert('El monto no puede ser mayor al saldo pendiente ($' + debtRemaining.toFixed(2) + ').');
            return;
          }
          btnConfirmAbono.disabled = true;
          btnConfirmAbono.textContent = 'Procesando...';
          try {
            await api.orders.addPayment(orderId as string, inputVal);
            window.location.reload();
          } catch(e: any) {
            await uiAlert('No se pudo registrar el abono: ' + errorMessage(e), 'Error');
            btnConfirmAbono.disabled = false;
            btnConfirmAbono.textContent = 'Confirmar Cobro';
          }
        };
      };
    }

    const kindLabel: Record<string, string> = { contado: 'Pago de contado', enganche: 'Enganche', abono: 'Abono registrado' };
    cronogramaList.innerHTML = '';
    sum.payments.forEach((pay) => {
      const el = document.createElement('div');
      el.className = 'flex items-start gap-3 relative group pb-6';
      el.innerHTML =
        '<div class="absolute left-[11px] top-6 bottom-0 w-[2px] bg-secondary-container"></div>' +
        '<div class="z-10 w-6 h-6 rounded-full bg-secondary flex items-center justify-center shrink-0"><span class="material-symbols-outlined text-white text-[16px]" style="font-variation-settings: \'FILL\' 1;">check</span></div>' +
        '<div class="flex-1"><div class="flex justify-between items-center">' +
          '<span class="font-bold text-on-surface">' + kindLabel[pay.kind] + '</span>' +
          '<div class="flex items-center gap-2"><span class="text-secondary font-bold">$' + Number(pay.amount).toFixed(2) + '</span>' +
          (isCancelled ? '' : '<button class="delete-payment-btn opacity-0 group-hover:opacity-100 focus:opacity-100 transition-opacity p-1.5 text-red-500 hover:bg-red-50 rounded-full flex items-center justify-center cursor-pointer" title="Eliminar pago" aria-label="Eliminar pago"><span class="material-symbols-outlined text-base">delete</span></button>') +
          '</div></div>' +
          '<p class="text-xs text-secondary font-medium">Cobrado el ' + new Date(pay.paid_at).toLocaleDateString('es-MX', dateFmt) + '</p></div>';

      el.querySelector('.delete-payment-btn')?.addEventListener('click', async () => {
        if (!(await uiConfirm('¿Eliminar este pago de $' + Number(pay.amount).toFixed(2) + '? El monto volverá al saldo pendiente.', 'Eliminar pago'))) return;
        try {
          await api.orders.deletePayment(pay.id);
          window.location.reload();
        } catch(e: any) {
          await uiAlert('No se pudo eliminar el pago: ' + errorMessage(e), 'Error');
        }
      });
      cronogramaList.appendChild(el);
    });

    if (!isFullyPaid && !isCancelled) {
      const pendingEl = document.createElement('div');
      pendingEl.className = 'flex items-start gap-3 relative';
      pendingEl.innerHTML =
        '<div class="z-10 w-6 h-6 rounded-full bg-primary-container flex items-center justify-center shrink-0"><span class="material-symbols-outlined text-on-surface text-[16px]" style="font-variation-settings: \'FILL\' 1;">schedule</span></div>' +
        '<div class="flex-1"><div class="flex justify-between"><span class="font-bold text-on-surface">Saldo Restante</span><span class="text-on-surface font-bold">$' + debtRemaining.toFixed(2) + '</span></div>' +
        (isAbonos ? '<p class="text-xs text-on-surface-variant">Sugerencia: ' + sum.installments + ' pagos ' + esc((order.frequency || 'periódicos').toLowerCase()) + '</p>' : '') + '</div>';
      cronogramaList.appendChild(pendingEl);
    }
  }

  if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', loadData); }
  else { loadData(); }
</script>
