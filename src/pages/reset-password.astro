---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Nueva Contraseña — Natura Manager">
  <div class="min-h-screen bg-surface flex items-center justify-center p-6 relative overflow-hidden">
    
    <!-- Background decoration -->
    <div class="absolute inset-0 bg-gradient-to-br from-secondary/3 via-transparent to-primary-container/5"></div>
    <div class="absolute top-[-8%] left-[-5%] w-[26rem] h-[26rem] bg-secondary-container/10 rounded-full blur-3xl animate-pulse" style="animation-duration: 12s;"></div>
    <div class="absolute bottom-[-8%] right-[-5%] w-[24rem] h-[24rem] bg-primary-container/8 rounded-full blur-3xl animate-pulse" style="animation-duration: 9s;"></div>
    <div class="absolute inset-0 opacity-[0.02]" style="background-image: radial-gradient(circle, var(--color-secondary) 1px, transparent 1px); background-size: 40px 40px;"></div>

    <div class="relative z-10 w-full max-w-md">
      <!-- Card -->
      <div class="bg-surface-container-lowest rounded-3xl p-8 sm:p-10 shadow-xl shadow-primary/5 border border-outline-variant/10">
        
        <!-- Header -->
        <div class="text-center mb-8">
          <div class="w-16 h-16 mx-auto rounded-2xl bg-secondary/8 flex items-center justify-center mb-5">
            <span class="material-symbols-outlined text-secondary text-2xl">enhanced_encryption</span>
          </div>
          <h2 class="text-2xl font-display font-bold text-on-surface">Crea tu nueva contraseña</h2>
          <p class="text-sm text-on-surface-variant mt-2 max-w-xs mx-auto">
            Elige una contraseña segura que no hayas usado antes.
          </p>
        </div>

        <!-- Reset form -->
        <form id="reset-form" class="space-y-5">
          <div id="error-message" class="hidden rounded-xl bg-error/8 border border-error/15 p-3.5 flex items-start gap-2.5">
            <span class="material-symbols-outlined text-error text-base mt-0.5 shrink-0">error</span>
            <p class="text-sm text-error font-medium" id="error-text"></p>
          </div>

          <div class="space-y-1.5">
            <label for="password" class="block text-xs font-bold text-on-surface-variant uppercase tracking-wider">Nueva contraseña</label>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-on-surface-variant/40 text-lg">lock</span>
              <input type="password" id="password" name="password" class="w-full input-editorial pl-11 pr-11" placeholder="Mínimo 6 caracteres" required minlength="6" autocomplete="new-password" />
              <button type="button" id="toggle-pw1" class="absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant/40 hover:text-on-surface-variant transition-colors">
                <span class="material-symbols-outlined text-lg">visibility</span>
              </button>
            </div>
            <!-- Strength bars -->
            <div class="flex gap-1 mt-2">
              <div id="str-1" class="h-1 flex-1 rounded-full bg-outline-variant/20 transition-colors"></div>
              <div id="str-2" class="h-1 flex-1 rounded-full bg-outline-variant/20 transition-colors"></div>
              <div id="str-3" class="h-1 flex-1 rounded-full bg-outline-variant/20 transition-colors"></div>
              <div id="str-4" class="h-1 flex-1 rounded-full bg-outline-variant/20 transition-colors"></div>
            </div>
            <p id="str-label" class="text-[10px] text-on-surface-variant/60 mt-0.5"></p>
          </div>

          <div class="space-y-1.5">
            <label for="confirm-password" class="block text-xs font-bold text-on-surface-variant uppercase tracking-wider">Confirmar contraseña</label>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-on-surface-variant/40 text-lg">lock_clock</span>
              <input type="password" id="confirm-password" name="confirm_password" class="w-full input-editorial pl-11 pr-11" placeholder="Repite tu contraseña" required minlength="6" autocomplete="new-password" />
              <button type="button" id="toggle-pw2" class="absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant/40 hover:text-on-surface-variant transition-colors">
                <span class="material-symbols-outlined text-lg">visibility</span>
              </button>
            </div>
            <!-- Match indicator -->
            <p id="match-label" class="text-[10px] mt-1 hidden"></p>
          </div>

          <button type="submit" class="w-full btn-primary flex items-center justify-center gap-2 !py-3.5 text-sm" id="submit-btn">
            <span class="material-symbols-outlined text-base">shield</span>
            Guardar Nueva Contraseña
          </button>
        </form>

        <!-- Success state -->
        <div id="success-state" class="hidden text-center">
          <div class="w-20 h-20 mx-auto rounded-full bg-secondary/10 flex items-center justify-center mb-5">
            <span class="material-symbols-outlined text-secondary text-3xl">check_circle</span>
          </div>
          <h3 class="text-xl font-display font-bold text-on-surface mb-2">¡Contraseña actualizada!</h3>
          <p class="text-sm text-on-surface-variant max-w-xs mx-auto mb-6">
            Tu contraseña se cambió exitosamente. Ya puedes iniciar sesión con tu nueva contraseña.
          </p>
          <a href="/login" class="inline-flex items-center gap-2 py-3 px-8 rounded-full btn-primary text-sm">
            <span class="material-symbols-outlined text-base">login</span>
            Ir a Iniciar Sesión
          </a>
        </div>

        <!-- Expired/invalid token state -->
        <div id="expired-state" class="hidden text-center">
          <div class="w-20 h-20 mx-auto rounded-full bg-error/8 flex items-center justify-center mb-5">
            <span class="material-symbols-outlined text-error text-3xl">link_off</span>
          </div>
          <h3 class="text-xl font-display font-bold text-on-surface mb-2">Enlace inválido o expirado</h3>
          <p class="text-sm text-on-surface-variant max-w-xs mx-auto mb-6">
            Este enlace de recuperación ya no es válido. Solicita uno nuevo.
          </p>
          <a href="/forgot-password" class="inline-flex items-center gap-2 py-3 px-8 rounded-full btn-primary text-sm">
            <span class="material-symbols-outlined text-base">refresh</span>
            Solicitar Nuevo Enlace
          </a>
        </div>

      </div>

      <p class="text-center text-xs text-on-surface-variant/60 mt-6">
        ¿Necesitas ayuda? <a href="mailto:soporte@naturamanager.com" class="text-primary font-bold hover:underline">Contáctanos</a>
      </p>
    </div>

  </div>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  const form = document.getElementById('reset-form') as HTMLFormElement;
  const errorDiv = document.getElementById('error-message') as HTMLDivElement;
  const errorText = document.getElementById('error-text') as HTMLParagraphElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const successState = document.getElementById('success-state') as HTMLDivElement;
  const expiredState = document.getElementById('expired-state') as HTMLDivElement;
  const pwInput = document.getElementById('password') as HTMLInputElement;
  const confirmInput = document.getElementById('confirm-password') as HTMLInputElement;

  // Check if we have the recovery token from Supabase
  const hashParams = new URLSearchParams(window.location.hash.substring(1));
  const type = hashParams.get('type');

  // Supabase will have set the session via the recovery link
  // If there's no recovery event, show expired state
  supabase.auth.onAuthStateChange((event) => {
    if (event === 'PASSWORD_RECOVERY') {
      form.classList.remove('hidden');
    }
  });

  // If no hash params or tokens, check if we already have a session with recovery
  (async () => {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session && !type) {
      form.classList.add('hidden');
      expiredState.classList.remove('hidden');
    }
  })();

  // Toggle password visibility
  function setupToggle(btnId: string, inputId: string) {
    document.getElementById(btnId)?.addEventListener('click', () => {
      const input = document.getElementById(inputId) as HTMLInputElement;
      const icon = document.querySelector(`#${btnId} .material-symbols-outlined`) as HTMLElement;
      if (input.type === 'password') { input.type = 'text'; icon.textContent = 'visibility_off'; }
      else { input.type = 'password'; icon.textContent = 'visibility'; }
    });
  }
  setupToggle('toggle-pw1', 'password');
  setupToggle('toggle-pw2', 'confirm-password');

  // Password strength
  const bars = [document.getElementById('str-1')!, document.getElementById('str-2')!, document.getElementById('str-3')!, document.getElementById('str-4')!];
  const strLabel = document.getElementById('str-label')!;
  const strengthColors = ['bg-red-400', 'bg-orange-400', 'bg-amber-400', 'bg-green-500'];
  const strengthLabels = ['Muy débil', 'Débil', 'Buena', 'Excelente'];

  pwInput?.addEventListener('input', () => {
    const pw = pwInput.value;
    let score = 0;
    if (pw.length >= 6) score++;
    if (pw.length >= 8 && /[A-Z]/.test(pw)) score++;
    if (/[0-9]/.test(pw)) score++;
    if (/[^a-zA-Z0-9]/.test(pw)) score++;

    bars.forEach((bar, i) => {
      bar.className = 'h-1 flex-1 rounded-full transition-colors ' + (i < score ? strengthColors[Math.min(score - 1, 3)] : 'bg-outline-variant/20');
    });
    strLabel.textContent = pw.length > 0 ? strengthLabels[Math.min(score - 1, 3)] || '' : '';
    checkMatch();
  });

  // Match check
  const matchLabel = document.getElementById('match-label')!;
  function checkMatch() {
    const pw = pwInput.value;
    const cpw = confirmInput.value;
    if (cpw.length === 0) { matchLabel.classList.add('hidden'); return; }
    matchLabel.classList.remove('hidden');
    if (pw === cpw) {
      matchLabel.textContent = '✓ Las contraseñas coinciden';
      matchLabel.className = 'text-[10px] mt-1 text-green-600 font-bold';
    } else {
      matchLabel.textContent = '✗ Las contraseñas no coinciden';
      matchLabel.className = 'text-[10px] mt-1 text-error font-bold';
    }
  }
  confirmInput?.addEventListener('input', checkMatch);

  // Submit
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorDiv.classList.add('hidden');

    const pw = pwInput.value;
    const cpw = confirmInput.value;

    if (pw !== cpw) {
      errorText.textContent = 'Las contraseñas no coinciden.';
      errorDiv.classList.remove('hidden');
      return;
    }

    submitBtn.innerHTML = '<span class="material-symbols-outlined text-base animate-spin">progress_activity</span> Guardando...';
    submitBtn.disabled = true;

    const { error } = await supabase.auth.updateUser({ password: pw });

    if (error) {
      errorText.textContent = error.message;
      errorDiv.classList.remove('hidden');
      submitBtn.innerHTML = '<span class="material-symbols-outlined text-base">shield</span> Guardar Nueva Contraseña';
      submitBtn.disabled = false;
    } else {
      form.classList.add('hidden');
      successState.classList.remove('hidden');
    }
  });
</script>
