---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="min-h-screen bg-surface flex items-center justify-center p-4">
    <div class="w-full max-w-md">
      <div class="bg-surface-container-lowest rounded-[2rem] p-10 shadow-xl border border-outline-variant/10">
        <div class="text-center mb-8">
          <div class="w-20 h-20 mx-auto mb-6 bg-primary-container/20 rounded-full flex items-center justify-center">
            <span class="material-symbols-outlined text-primary text-4xl">lock_open</span>
          </div>
          <h1 class="text-3xl font-display font-bold text-on-surface">Nueva Contraseña</h1>
          <p class="text-on-surface-variant mt-3">Crea una contraseña segura para tu cuenta.</p>
        </div>

        <div class="space-y-6">
          <div>
            <label class="text-sm font-semibold text-on-surface-variant block mb-2">Nueva contraseña</label>
            <input id="new-password" type="password" placeholder="Mínimo 6 caracteres"
              class="w-full bg-surface-container-highest border-none rounded-xl py-3 px-4 focus:ring-2 focus:ring-primary-container" />
          </div>
          <div>
            <label class="text-sm font-semibold text-on-surface-variant block mb-2">Confirmar contraseña</label>
            <input id="confirm-password" type="password" placeholder="Repite tu contraseña"
              class="w-full bg-surface-container-highest border-none rounded-xl py-3 px-4 focus:ring-2 focus:ring-primary-container" />
          </div>
          <button id="btn-update-pw" class="w-full py-4 rounded-xl font-bold shadow-lg shadow-primary/20 hover:scale-[1.02] bg-primary text-white transition-all flex items-center justify-center gap-2">
            <span class="material-symbols-outlined">check_circle</span>
            Actualizar Contraseña
          </button>
        </div>

        <div id="error-msg" class="mt-4 text-center text-error text-sm hidden"></div>
        <div id="success-msg" class="mt-4 text-center text-secondary text-sm hidden"></div>

        <div class="mt-8 pt-6 border-t border-surface-container">
          <div class="flex items-center gap-3 text-sm text-on-surface-variant">
            <span class="material-symbols-outlined text-secondary">security</span>
            <span>Usa una combinación de letras, números y símbolos para mayor seguridad.</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  const newPw = document.getElementById('new-password') as HTMLInputElement;
  const confirmPw = document.getElementById('confirm-password') as HTMLInputElement;
  const btnUpdate = document.getElementById('btn-update-pw') as HTMLButtonElement;
  const errorMsg = document.getElementById('error-msg') as HTMLElement;
  const successMsg = document.getElementById('success-msg') as HTMLElement;

  btnUpdate.addEventListener('click', async () => {
    errorMsg.classList.add('hidden');
    successMsg.classList.add('hidden');

    if (newPw.value.length < 6) {
      errorMsg.textContent = 'La contraseña debe tener al menos 6 caracteres.';
      errorMsg.classList.remove('hidden');
      return;
    }
    if (newPw.value !== confirmPw.value) {
      errorMsg.textContent = 'Las contraseñas no coinciden.';
      errorMsg.classList.remove('hidden');
      return;
    }

    btnUpdate.disabled = true;
    btnUpdate.innerHTML = '<span class="material-symbols-outlined animate-spin">refresh</span> Actualizando...';

    const { error } = await supabase.auth.updateUser({ password: newPw.value });

    if (error) {
      errorMsg.textContent = error.message;
      errorMsg.classList.remove('hidden');
      btnUpdate.disabled = false;
      btnUpdate.innerHTML = '<span class="material-symbols-outlined">check_circle</span> Actualizar Contraseña';
    } else {
      successMsg.textContent = '¡Contraseña actualizada! Redirigiendo...';
      successMsg.classList.remove('hidden');
      setTimeout(() => { window.location.href = '/'; }, 2000);
    }
  });
</script>
