---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import ScannerApp from '../../components/CatalogScanner';
---

<DashboardLayout title="Escaner de Catálogos - Natura Flow">
  <div class="px-4 sm:px-6 lg:px-8 py-8 w-full max-w-9xl mx-auto">
    <!-- Page Header -->
    <div class="sm:flex sm:justify-between sm:items-center mb-8">
      <div class="mb-4 sm:mb-0">
        <h1 class="text-2xl md:text-3xl font-bold text-white tracking-tight">Escaner de Catálogos (AI) ✨</h1>
      </div>
    </div>

    <!-- React App -->
    <ScannerApp client:load />

  </div>
</DashboardLayout>
