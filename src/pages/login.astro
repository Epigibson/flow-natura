---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="min-h-screen bg-surface flex relative overflow-hidden">
    
    <!-- Left Section: Decorative/Branding (Hidden on mobile) -->
    <div class="hidden md:flex flex-1 bg-surface-container-high relative items-center justify-center p-12">
      <!-- Decorative organic shapes -->
      <div class="absolute top-0 right-0 w-64 h-64 bg-primary-container opacity-10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3"></div>
      <div class="absolute bottom-0 left-0 w-96 h-96 bg-secondary-container opacity-20 rounded-full blur-3xl translate-y-1/3 -translate-x-1/3"></div>
      
      <div class="relative z-10 text-center max-w-md">
        <h1 class="text-5xl font-display font-bold text-primary mb-6">Natura Flow</h1>
        <p class="text-xl text-on-surface-variant font-body">
          Tu negocio en la palma de tu mano. Gestiona tu inventario, ventas y clientes de manera intuitiva y visual.
        </p>
      </div>
    </div>

    <!-- Right Section: Login Form -->
    <div class="w-full md:w-1/2 lg:w-2/5 flex items-center justify-center p-8 md:p-16 z-20">
      <div class="w-full max-w-sm surface-card p-10 shadow-lg border border-outline-variant/20">
        
        <div class="mb-8 text-center md:text-left">
          <h2 class="text-3xl font-display font-semibold text-on-surface">Bienvenida</h2>
          <p class="text-on-surface-variant mt-2 text-sm">Ingresa con tu correo de consultora</p>
        </div>

        <form id="login-form" class="space-y-6">
          <div id="error-message" class="hidden bg-error-container text-error p-3 rounded-md text-sm"></div>

          <div class="space-y-2">
            <label for="email" class="block text-sm font-semibold text-on-surface-variant">Correo electrónico</label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              class="w-full input-editorial" 
              placeholder="tu@correo.com" 
              required
            />
          </div>

          <div class="space-y-2">
            <label for="password" class="block text-sm font-semibold text-on-surface-variant">Contraseña</label>
            <input 
              type="password" 
              id="password" 
              name="password" 
              class="w-full input-editorial" 
              placeholder="••••••••" 
              required
            />
            <div class="flex justify-end mt-1">
              <a href="/forgot-password" class="text-xs font-semibold text-primary hover:text-primary-container transition-colors">¿Olvidaste tu contraseña?</a>
            </div>
          </div>

          <button type="submit" class="w-full btn-primary" id="submit-btn">
            Entrar a mi cuenta
          </button>
        </form>

        <div class="mt-8 text-center text-sm text-on-surface-variant">
          ¿Aún no eres consultora? <a href="/register" class="font-semibold text-secondary hover:underline">Regístrate aquí</a>
        </div>
      </div>
    </div>

  </div>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  const loginForm = document.getElementById('login-form') as HTMLFormElement;
  const errorDiv = document.getElementById('error-message') as HTMLDivElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  loginForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorDiv.classList.add('hidden');
    submitBtn.textContent = 'Iniciando...';
    submitBtn.disabled = true;

    const formData = new FormData(loginForm);
    const email = formData.get('email') as string;
    const password = formData.get('password') as string;

    const { error } = await supabase.auth.signInWithPassword({
      email,
      password,
    });

    if (error) {
      errorDiv.textContent = error.message;
      errorDiv.classList.remove('hidden');
      submitBtn.textContent = 'Entrar a mi cuenta';
      submitBtn.disabled = false;
    } else {
      window.location.href = '/';
    }
  });
</script>
