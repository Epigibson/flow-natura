---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Iniciar Sesión — Natura Manager">
  <div class="min-h-screen bg-surface flex relative overflow-hidden">
    
    <!-- Left Panel: Premium Branding -->
    <div class="hidden lg:flex flex-1 relative items-center justify-center p-16 overflow-hidden">
      <!-- Animated gradient background -->
      <div class="absolute inset-0 bg-gradient-to-br from-primary/8 via-secondary-container/12 to-primary-container/10"></div>
      
      <!-- Organic floating shapes -->
      <div class="absolute top-[-5%] right-[-10%] w-[30rem] h-[30rem] bg-primary-container/15 rounded-full blur-3xl animate-pulse" style="animation-duration: 8s;"></div>
      <div class="absolute bottom-[-10%] left-[-5%] w-[25rem] h-[25rem] bg-secondary-container/20 rounded-full blur-3xl animate-pulse" style="animation-duration: 12s;"></div>
      <div class="absolute top-1/2 left-1/3 w-64 h-64 bg-primary/5 rounded-full blur-2xl animate-pulse" style="animation-duration: 6s;"></div>
      
      <!-- Grid pattern overlay -->
      <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(circle, var(--color-primary) 1px, transparent 1px); background-size: 32px 32px;"></div>
      
      <div class="relative z-10 text-center max-w-lg">
        <!-- Logo -->
        <div class="w-20 h-20 mx-auto mb-8 rounded-3xl overflow-hidden shadow-2xl shadow-primary/20 ring-4 ring-white/50">
          <img src="/logo.png" alt="Natura Manager" class="w-full h-full object-cover" />
        </div>
        
        <h1 class="text-5xl font-display font-extrabold text-on-surface mb-4 tracking-tight">
          Natura <span class="text-primary">Manager</span>
        </h1>
        <p class="text-lg text-on-surface-variant font-body leading-relaxed max-w-sm mx-auto">
          Tu negocio en la palma de tu mano. Gestiona inventario, ventas y clientes de forma intuitiva.
        </p>
        
        <!-- Feature pills -->
        <div class="flex flex-wrap justify-center gap-3 mt-10">
          <div class="flex items-center gap-2 px-4 py-2 rounded-full bg-white/60 backdrop-blur-sm border border-white/40 shadow-sm">
            <span class="material-symbols-outlined text-primary text-base">inventory_2</span>
            <span class="text-xs font-bold text-on-surface">Inventario</span>
          </div>
          <div class="flex items-center gap-2 px-4 py-2 rounded-full bg-white/60 backdrop-blur-sm border border-white/40 shadow-sm">
            <span class="material-symbols-outlined text-secondary text-base">point_of_sale</span>
            <span class="text-xs font-bold text-on-surface">Ventas</span>
          </div>
          <div class="flex items-center gap-2 px-4 py-2 rounded-full bg-white/60 backdrop-blur-sm border border-white/40 shadow-sm">
            <span class="material-symbols-outlined text-primary-container text-base">group</span>
            <span class="text-xs font-bold text-on-surface">Clientes</span>
          </div>
          <div class="flex items-center gap-2 px-4 py-2 rounded-full bg-white/60 backdrop-blur-sm border border-white/40 shadow-sm">
            <span class="material-symbols-outlined text-secondary text-base">bar_chart</span>
            <span class="text-xs font-bold text-on-surface">Reportes</span>
          </div>
        </div>
        
        <!-- Social proof -->
        <div class="mt-12 flex items-center justify-center gap-3">
          <div class="flex -space-x-2">
            <img src="https://api.dicebear.com/8.x/micah/svg?seed=Ana" alt="" class="w-8 h-8 rounded-full border-2 border-white" />
            <img src="https://api.dicebear.com/8.x/micah/svg?seed=Maria" alt="" class="w-8 h-8 rounded-full border-2 border-white" />
            <img src="https://api.dicebear.com/8.x/micah/svg?seed=Rosa" alt="" class="w-8 h-8 rounded-full border-2 border-white" />
            <img src="https://api.dicebear.com/8.x/micah/svg?seed=Carmen" alt="" class="w-8 h-8 rounded-full border-2 border-white" />
          </div>
          <p class="text-xs text-on-surface-variant"><strong class="text-on-surface">+500</strong> consultoras confían en nosotros</p>
        </div>
      </div>
    </div>

    <!-- Right Panel: Login Form -->
    <div class="w-full lg:w-[480px] xl:w-[520px] flex items-center justify-center p-6 sm:p-8 lg:p-12 z-20 relative">
      <!-- Mobile logo -->
      <div class="lg:hidden absolute top-8 left-1/2 -translate-x-1/2 flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl overflow-hidden shadow-lg">
          <img src="/logo.png" alt="Natura Manager" class="w-full h-full object-cover" />
        </div>
        <span class="text-lg font-display font-bold text-on-surface">Natura <span class="text-primary">Manager</span></span>
      </div>

      <div class="w-full max-w-sm">
        <!-- Header -->
        <div class="mb-8 mt-16 lg:mt-0">
          <div class="w-12 h-12 rounded-2xl bg-primary/10 flex items-center justify-center mb-5">
            <span class="material-symbols-outlined text-primary text-xl">waving_hand</span>
          </div>
          <h2 class="text-3xl font-display font-bold text-on-surface">Bienvenida de nuevo</h2>
          <p class="text-on-surface-variant mt-2 text-sm">Ingresa con tu cuenta de consultora</p>
        </div>

        <!-- Form -->
        <form id="login-form" class="space-y-5">
          <div id="error-message" class="hidden rounded-xl bg-error/8 border border-error/15 p-3.5 flex items-start gap-2.5">
            <span class="material-symbols-outlined text-error text-base mt-0.5 shrink-0">error</span>
            <p class="text-sm text-error font-medium" id="error-text"></p>
          </div>

          <div class="space-y-1.5">
            <label for="email" class="block text-xs font-bold text-on-surface-variant uppercase tracking-wider">Correo electrónico</label>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-on-surface-variant/40 text-lg">mail</span>
              <input 
                type="email" 
                id="email" 
                name="email" 
                class="w-full input-editorial pl-11"
                placeholder="tu@correo.com" 
                required
                autocomplete="email"
              />
            </div>
          </div>

          <div class="space-y-1.5">
            <label for="password" class="block text-xs font-bold text-on-surface-variant uppercase tracking-wider">Contraseña</label>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-on-surface-variant/40 text-lg">lock</span>
              <input 
                type="password" 
                id="password" 
                name="password" 
                class="w-full input-editorial pl-11 pr-11"
                placeholder="••••••••" 
                required
                autocomplete="current-password"
              />
              <button type="button" id="toggle-pw" class="absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant/40 hover:text-on-surface-variant transition-colors">
                <span class="material-symbols-outlined text-lg">visibility</span>
              </button>
            </div>
            <div class="flex justify-end mt-1">
              <a href="/forgot-password" class="text-xs font-bold text-primary hover:text-primary-container transition-colors">¿Olvidaste tu contraseña?</a>
            </div>
          </div>

          <button type="submit" class="w-full btn-primary flex items-center justify-center gap-2 !py-3.5 text-sm" id="submit-btn">
            <span class="material-symbols-outlined text-base">login</span>
            Iniciar Sesión
          </button>
        </form>

        <!-- Divider -->
        <div class="relative my-7">
          <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-outline-variant/20"></div></div>
          <div class="relative flex justify-center"><span class="bg-surface px-4 text-xs text-on-surface-variant/60">o continúa con</span></div>
        </div>

        <!-- Social Login -->
        <button id="btn-google" class="w-full flex items-center justify-center gap-3 py-3 rounded-full border-2 border-outline-variant/15 bg-surface-container-lowest hover:bg-surface-container-low transition-all font-bold text-sm text-on-surface shadow-sm hover:shadow-md">
          <svg class="w-5 h-5" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
          Google
        </button>

        <!-- Register link -->
        <p class="mt-8 text-center text-sm text-on-surface-variant">
          ¿Aún no tienes cuenta? 
          <a href="/register" class="font-bold text-primary hover:text-primary-container transition-colors">Regístrate gratis</a>
        </p>
      </div>
    </div>

  </div>
</Layout>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-20px); }
  }
</style>

<script>
  import { supabase } from '../lib/supabase';

  const loginForm = document.getElementById('login-form') as HTMLFormElement;
  const errorDiv = document.getElementById('error-message') as HTMLDivElement;
  const errorText = document.getElementById('error-text') as HTMLParagraphElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  // Toggle password visibility
  document.getElementById('toggle-pw')?.addEventListener('click', () => {
    const pw = document.getElementById('password') as HTMLInputElement;
    const icon = document.querySelector('#toggle-pw .material-symbols-outlined') as HTMLElement;
    if (pw.type === 'password') {
      pw.type = 'text';
      icon.textContent = 'visibility_off';
    } else {
      pw.type = 'password';
      icon.textContent = 'visibility';
    }
  });

  loginForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorDiv.classList.add('hidden');
    submitBtn.innerHTML = '<span class="material-symbols-outlined text-base animate-spin">progress_activity</span> Iniciando...';
    submitBtn.disabled = true;

    const formData = new FormData(loginForm);
    const email = formData.get('email') as string;
    const password = formData.get('password') as string;

    const { error } = await supabase.auth.signInWithPassword({ email, password });

    if (error) {
      const messages: Record<string, string> = {
        'Invalid login credentials': 'Correo o contraseña incorrectos',
        'Email not confirmed': 'Confirma tu correo electrónico primero',
      };
      errorText.textContent = messages[error.message] || error.message;
      errorDiv.classList.remove('hidden');
      submitBtn.innerHTML = '<span class="material-symbols-outlined text-base">login</span> Iniciar Sesión';
      submitBtn.disabled = false;
    } else {
      window.location.href = '/';
    }
  });

  // Google Sign In
  document.getElementById('btn-google')?.addEventListener('click', async () => {
    const { error } = await supabase.auth.signInWithOAuth({
      provider: 'google',
      options: { redirectTo: window.location.origin + '/' }
    });
    if (error) {
      errorText.textContent = error.message;
      errorDiv.classList.remove('hidden');
    }
  });
</script>
