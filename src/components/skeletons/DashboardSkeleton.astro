---
/**
 * SkeletonDashboard — Skeleton placeholder for the main dashboard KPIs, 
 * recent sales, and top products sections.
 */
---

<!-- Skeleton Header -->
<header class="flex justify-between items-center mb-10">
  <div class="space-y-3">
    <div class="skeleton skeleton-title" style="width: 14rem;"></div>
    <div class="skeleton skeleton-subtitle" style="width: 10rem;"></div>
  </div>
  <div class="flex items-center gap-4">
    <div class="skeleton skeleton-button"></div>
    <div class="skeleton skeleton-button" style="width: 6rem;"></div>
    <div class="skeleton skeleton-avatar-lg"></div>
  </div>
</header>

<!-- Skeleton KPI Grid -->
<section class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-10">
  {[1,2,3,4].map(() => (
    <div class="surface-layer p-6 rounded-4xl space-y-3">
      <div class="skeleton skeleton-badge"></div>
      <div class="skeleton skeleton-kpi"></div>
      <div class="skeleton skeleton-bar w-full mt-4"></div>
      <div class="skeleton skeleton-text w-20 ml-auto"></div>
    </div>
  ))}
</section>

<!-- Skeleton Main Grid -->
<section class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-10">
  <!-- Skeleton Recent Sales -->
  <div class="lg:col-span-2 bg-surface-container-lowest rounded-4xl p-8 shadow-sm space-y-5">
    <div class="flex justify-between items-center mb-4">
      <div class="skeleton skeleton-subtitle" style="width: 10rem;"></div>
      <div class="skeleton skeleton-badge"></div>
    </div>
    {[1,2,3,4,5].map(() => (
      <div class="flex items-center gap-4">
        <div class="skeleton skeleton-avatar"></div>
        <div class="flex-1 space-y-2">
          <div class="skeleton skeleton-text w-3/4"></div>
          <div class="skeleton skeleton-text w-1/2" style="height: 0.625rem;"></div>
        </div>
        <div class="skeleton skeleton-badge" style="width: 5rem;"></div>
      </div>
    ))}
  </div>

  <!-- Skeleton Top Products -->
  <div class="bg-surface-container-lowest rounded-4xl p-8 shadow-sm space-y-5">
    <div class="skeleton skeleton-subtitle" style="width: 8rem;"></div>
    {[1,2,3,4].map(() => (
      <div class="flex items-center gap-3">
        <div class="skeleton skeleton-icon"></div>
        <div class="flex-1 space-y-2">
          <div class="skeleton skeleton-text w-2/3"></div>
          <div class="skeleton skeleton-bar w-full"></div>
        </div>
      </div>
    ))}
  </div>
</section>
